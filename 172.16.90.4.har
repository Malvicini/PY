          "content": {
            "size": 4234,
            "mimeType": "text/javascript",
            "compression": -1,
            "text": "if (!window.console) {\r\n    window.console = {log: function () {}};\r\n}\r\nvar getClass = {}.toString;\r\n\r\nfunction AdiPlugin() {\r\n    var _text = \"Plugin Adiuto\";\r\n    var _action = function () {\r\n        return false;\r\n    };\r\n    var _icon = \"/adiJed/img/adiPlugin.png\";\r\n    var _info = \"Plugin Adiuto\";\r\n    var _documents = [];\r\n    var _type = null;\r\n    \r\n    this.DOCUMENT_PLUGIN = 'DOCUMENT_PLUGIN';\r\n    this.MAIN_TOOLBAR    = 'MAIN_TOOLBAR';\r\n    this.HOMEPAGE_WIDGET = 'HOMEPAGE_WIDGET';\r\n}\r\n\r\nAdiPlugin.prototype.getType = function () {\r\n    return this._type;\r\n};\r\nAdiPlugin.prototype.setText = function (txt) {\r\n    this._text = txt;\r\n};\r\nAdiPlugin.prototype.getText = function () {\r\n    return this._text;\r\n};\r\nAdiPlugin.prototype.setIcon = function (iconUrl) {\r\n    this._icon = iconUrl;\r\n};\r\nAdiPlugin.prototype.getIcon = function () {\r\n    return this._icon;\r\n};\r\nAdiPlugin.prototype.setAction = function (action) {\r\n    if (action && getClass.call(action) != '[object Function]') {\r\n        console.log(\"ERRORE, action deve essere una funzione\");\r\n        throw(\"ERRORE, action deve essere una funzione\");\r\n    }\r\n    this._action = action;\r\n};\r\nAdiPlugin.prototype.getAction = function () {\r\n    return this._action;\r\n};\r\nAdiPlugin.prototype.setDocuments = function (fidds) {\r\n    if (fidds) {\r\n        this._documents = fidds;\r\n    }\r\n};\r\nAdiPlugin.prototype.getDocuments = function () {\r\n    return this._documents;\r\n};\r\n\r\nAdiPlugin.getNew = function () {\r\n    return new AdiPlugin();\r\n};\r\n\r\nAdiPlugin.prototype.getPluginConfiguration = function () {\r\n    return null;\r\n};\r\n\r\nAdiPlugin.prototype.getCurrentDocumentInfo = function () {\r\n    // questo metodo � disponibile solo per il tipo di plugin DOCUMENT_PLUGIN\r\n    if (this.type == AdiPlugin.DOCUMENT_PLUGIN) {\r\n        return null; // todo: implementare\r\n    } else {\r\n        console.log(\"ERRORE, getCurrentDocumentInfo può essere richiamato solo da un plugin di tipo AdiPlugin.DOCUMENT_PLUGIN\");\r\n        throw(\"ERRORE, getCurrentDocumentInfo può essere richiamato solo da un plugin di tipo AdiPlugin.DOCUMENT_PLUGIN\");\r\n    }\r\n};\r\n\r\nAdiPlugin.prototype.getDocumentInfo = function (fidd) {\r\n    // questo metodo � disponibile solo per il tipo di plugin DOCUMENT_PLUGIN\r\n    if (this.type == AdiPlugin.DOCUMENT_PLUGIN) {\r\n        return null; // todo: implementare\r\n    } else {\r\n        console.log(\"ERRORE, getCurrentDocumentInfo può essere richiamato solo da un plugin di tipo AdiPlugin.DOCUMENT_PLUGIN\");\r\n        throw(\"ERRORE, getCurrentDocumentInfo può essere richiamato solo da un plugin di tipo AdiPlugin.DOCUMENT_PLUGIN\");\r\n    }\r\n};\r\n\r\nvar AdiPluginManager = (function () {\r\n    var __instance;\r\n\r\n    function init() {\r\n        // Private methods and variables\r\n        var _allPlugins = [];\r\n\r\n        return {\r\n            // Public methods and variables\r\n            registerDocumentPlugins: function (documentID) {\r\n                for (var ipl = 0; ipl < _allPlugins.length; ipl++) {\r\n                    var currentPlugin = _allPlugins[ipl];\r\n                    if (currentPlugin.type == AdiPlugin.DOCUMENT_PLUGIN) {\r\n                        //                        add // todo: aggiungere il bottone alla toolbar\r\n                    }\r\n                }\r\n            },\r\n\r\n            register: function (_plugin, type) {\r\n                if (!_plugin instanceof AdiPlugin) {\r\n                    console.log(\"ERRORE, il plugin registrato deve essere una sottoclasse di AdiPlugin\");\r\n                    throw(\"ERRORE, il plugin registrato deve essere una sottoclasse di AdiPlugin\");\r\n                }\r\n                if (!type || (type != AdiPlugin.DOCUMENT_PLUGIN && type != AdiPlugin.MAIN_TOOLBAR && type != AdiPlugin.HOMEPAGE_WIDGET)) {\r\n                    console.log(\"ERRORE, tipo plugin '\" + type + \"' sconosciuto\");\r\n                    throw(\"ERRORE, tipo plugin '\" + type + \"' sconosciuto\");\r\n                }\r\n\r\n                _allPlugins.push({type: type, plugin: _plugin});\r\n            }\r\n        };\r\n    }\r\n    ;\r\n\r\n    return {\r\n        getInstance: function () {\r\n            if (!__instance) {\r\n                __instance = init();\r\n            }\r\n            return __instance;\r\n        }\r\n    };\r\n})();"
          },
