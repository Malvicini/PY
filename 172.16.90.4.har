tory = false;\r\n                break;\r\n            }\r\n            default:\r\n                Logger.error(\"Errore durante la chiamata di saveHistoryAndDisplayPage [common.js] (\"+hash+\",\"+url+\",\"+data+\",\"+saveHistory+\",\"+savePage+\",\"+historyBehaviour+\")\");\r\n                self.saveHistoryLocked = false;\r\n                clearTimeout(idTimeout);\r\n                return;\r\n        }\r\n    }\r\n\r\n    (self.hideOptions||function(){})();\r\n    window['_pageLoaded']=null;\r\n    $('.ad-has-tips').trigger(\"hideTips\");\r\n\r\n    if ($(\"#bd.tablet\")[0])\r\n    {\r\n        if( $(\"#main-container\").hammer )\r\n            $(\"#main-container\").hammer().off(\"swiperight\");\r\n\r\n        if( $(\"#application-top-bar\").hammer )\r\n            $(\"#application-top-bar\").hammer().off(\"swiperight\");\r\n    }\r\n\r\n    clearIOSPreview();\r\n\r\n    //mostro la finestra di attesa solo dopo 500ms\r\n    var waitTimeout = setTimeout( function() {\r\n        if(waitDisplayTimeouts['tout_'+waitTimeout]) {\r\n            delete waitDisplayTimeouts['tout_'+waitTimeout];\r\n            showWaitDialog();\r\n        }\r\n    }, 300);\r\n    waitDisplayTimeouts['tout_'+waitTimeout] = true;\r\n\r\n    var dfd = new jQuery.Deferred();\r\n\r\n    var iUH = iUniqueHtml;\r\n    var defaultParams = {url: url,\r\n            type: \"POST\",\r\n            data: data,\r\n            success: function(html) {\r\n                var sessionStatus = jqxhr.getResponseHeader('adijed-session-status');\r\n                if(sessionStatus && sessionStatus == 'expired') {\r\n                    DialogManager.showAlert(LangManager.get(\"ui.js.session.expired\"), doLogout); //\"La tua sessione è scaduta per inattività.<br/>Effettua nuovamente il login.\"\r\n                }\r\n                $(\".tooltip\").remove();\r\n\r\n                try {\r\n                    if(HistoryManager.getCurrentPage()[\"savePageHtml\"] === true) {\r\n                        savePage = true;\r\n                    }\r\n                    if(hash && saveHistory && historyBehaviour != HistoryConstants.REPLACE_CURRENT_HISTORY) {\r\n                        location.hash = hash;\r\n                    }\r\n                    console.log(\"url: \"+url);\r\n                    displayHtml(html, targetContainer, iUH);\r\n\r\n                    if(saveHistory) {\r\n                        HistoryManager.savePage(url, data, HistoryManager.getCurrentKey(), savePage ? html : null);\r\n                    } else if(savePage) {\r\n                        HistoryManager.savePageHTML(html);\r\n                    }\r\n\r\n                    dfd.resolve();\r\n                } catch(e) {\r\n                    Logger.error(e);\r\n                }\r\n            }\r\n        };\r\n\r\n    var opts = $.extend({}, defaultParams, jqueryParams);\r\n\r\n    var jqxhr = $.ajax(opts).always(\r\n        function(){\r\n            if( waitDisplayTimeouts['tout_'+waitTimeout] !== undefined ) {\r\n                clearTimeout(waitTimeout);\r\n            } else {\r\n                $.modal.close();\r\n            }\r\n            self.saveHistoryLocked = false;\r\n            clearTimeout(idTimeout);\r\n            delete waitDisplayTimeouts['tout_'+waitTimeout];\r\n        }\r\n    );\r\n\r\n    return dfd;\r\n}\r\nvar htmlDisplayStack = {};\r\nfunction displayHtml(html, targetContainer, iCallSeq)\r\n{\r\n    var dfd = new jQuery.Deferred();\r\n    console.log(\"displaying html with id: \" + iCallSeq + \" - last displayed id: \"+htmlDisplayStack[targetContainer]);\r\n    \r\n    if( htmlDisplayStack[targetContainer] && htmlDisplayStack[targetContainer] > iCallSeq ) {\r\n        setTimeout(function () {\r\n            dfd.reject();\r\n        }, 5);\r\n    } else {\r\n        htmlDisplayStack[targetContainer] = iCallSeq;\r\n        \r\n        var loadPageInto = targetContainer||\"#app-container\";\r\n        // baco ie, se metto direttamente l'html mi mostra tutta la pagina bianca\r\n        if(jQuery.browser.msie)\r\n            $(loadPageInto).html(\"\");\r\n        $(loadPageInto).html(html);\r\n        setTimeout(function () {\r\n            try {\r\n                (window['_pageLoaded'] || function () {}).call();\r\n            } catch (e) {\r\n            }\r\n            dfd.resolve();\r\n        }, 50);\r\n    }\r\n    return dfd;\r\n}\r\n\r\n(function(wnd) {\r\n\r\n    var Logger = function() {\r\n        this.logMessages = {\r\n            \"debug\": [],\r\n            \"info\": [],\r\n            \"error\": []\r\n        };\r\n    };\r\n\r\n    Logger.LEVEL_DEBUG = \"debug\";\r\n    Logger.LEVEL_INFO = \"info\";\r\n    Logger.LEVEL_ERROR = \"error\";\r\n\r\n    Logger.setup = function(container, logLevelFilterContainer) {\r\n        Logger.cont = container;\r\n        Logger.lvlFilterCont = logLevelFilterContainer;\r\n\r\n        if(this.lvlFilterCont) {\r\n            var s = $(\"<select id=\\\"log-filter-select\\\"/>\");\r\n            $(\"<option />\", {value: \"debug\", text: \"DEBUG\"}).appendTo(s);\r\n            $(\"<option />\", {value: \"info\",  text: \"INFO\", selected: true}).appendTo(s);\r\n            $(\"<option />\", {value: \"error\", text: \"ERROR\"}).appendTo(s);\r\n            s.change(function(e){\r\n                $(\".log-message\",Logger.cont).css(\"display\",\"none\");\r\n                $(\".log-\"+$(this).val(),Logger.cont).css(\"display\",\"block\");\r\n            });\r\n            s.css(\"font-size\",\"8pt\")\r\n             .css(\"margin-top\",\"-1px\");\r\n            s.appendTo(Logger.lvlFilterCont);\r\n            Logger.levelFilter = s;\r\n        }\r\n    };\r\n\r\n    var remoteLog = function(level, msg, trace) {\r\n        if(level === Logger.LEVEL_ERROR) {\r\n            $.ajax({url: \"/adiJed/system.client-log.do\",\r\n                type: \"POST\",\r\n                data: \"level=\"+level+\"&msg=\" + encodeURIComponent(msg),// + \"&trace=\" + encodeURIComponent(trace),\r\n                async: true,\r\n                success: function (){},\r\n                error: function(e) {\r\n                    console.error(e);\r\n                    throw e;\r\n                }\r\n            });\r\n        }\r\n    };\r\n    \r\n    Logger.debug = function(message) { if(console && typeof console.debug === 'function') console.debug(message); Logger.log(message, Logger.LEVEL_DEBUG); }\r\n    Logger.info  = function(message) { if(console && typeof console.info  === 'function') console.info(message);  Logger.log(message, Logger.LEVEL_INFO);  }\r\n    Logger.error = function(message) {\r\n        if(console && typeof console.error === 'function')\r\n            console.error(message);\r\n        Logger.log(message, Logger.LEVEL_ERROR);\r\n    }\r\n\r\n    Logger.log = function(message,level) {\r\n        if(!level)\r\n            level = Logger.LEVEL_INFO;\r\n\r\n        try {\r\n            remoteLog(level, message);\r\n        } catch(e) {\r\n            console.error(e);\r\n        }\r\n\r\n        var s = \"display: none;\";\r\n        if(this.levelFilter && this.levelFilter.val() == level) {\r\n            s = \"display: block;\";\r\n        }\r\n\r\n        if( this.cont ) {\r\n            try {\r\n                var writtenLogs = $(\"div.log-\"+level, this.cont);\r\n                if(writtenLogs.length > 35) // tengo 35 righe di log per tipo\r\n                    writtenLogs.last().remove();\r\n\r\n                var d = new Date();\r\n                this.cont.prepend(\r\n                    \"<div style=\\\"\"+s+\"\\\" class=\\\"log-message log-\"+level+\"\\\">\"+right('0'+d.getHours(),2)+\":\"+right('0'+d.getMinutes(),2)+\":\"+right('0'+d.getSeconds(),2)+\" - \"+message+\"</div>\"\r\n                );\r\n            }catch(e){\r\n                console.error(e);\r\n            }\r\n        }\r\n    };\r\n\r\n    wnd.Logger = Logger;\r\n\r\n})(window);\r\n\r\n(function(wnd) {\r\n\r\n    var UICommons = function() { };\r\n\r\n    UICommons.AlertManager = function(){\r\n        var _instance = this;\r\n\r\n        this.showInfoMessage = function(txt,layout,keepModal)\r\n        {\r\n            if(arguments.length>2) {\r\n                _instance.showMessage(txt, UICommons.AlertManager.MessageType.ALERT, layout,\r\n                    UICommons.AlertManager.DEFAULT_TIMEOUT, true, keepModal);\r\n            } else {\r\n                _instance.showMessage(txt, UICommons.AlertManager.MessageType.ALERT, layout);\r\n            }\r\n        };\r\n        this.showErrorMessage = function(txt,layout,keepModal)\r\n        {\r\n            if(arguments.length>2) {\r\n                _instance.showMessage(txt, UICommons.AlertManager.MessageType.ERROR, layout,\r\n                    UICommons.AlertManager.DEFAULT_ERROR_TIMEOUT, true, keepModal);\r\n            } else {\r\n                _instance.showMessage(txt, UICommons.AlertManager.MessageType.ERROR, layout);\r\n            }\r\n        };\r\n        this.showMessage = function(txt, type, layout, timeout, closable, keepModal, clickCallback)\r\n        {\r\n            if(!keepModal && $.modal) {\r\n                $.modal.close();\r\n            }\r\n\r\n            var _type   = type   || UICommons.AlertManager.MessageType.ALERT;\r\n            var _layout = layout || UICommons.AlertManager.MessageLayout.TOP_CENTER;\r\n\r\n            noty({\r\n                \"text\": txt,\r\n                \"layout\": _layout,\r\n                \"type\": _type,\r\n                \"textAlign\": \"left\",\r\n                \"easing\": \"linear\",\r\n                \"animateOpen\": {\"opacity\": 1,\"height\":\"toggle\"},\r\n                \"animateClose\": {\"opacity\": 0},\r\n                \"speed\": arguments.length > 3 ? 10 : 250,\r\n                \"timeout\": arguments.length > 3 ? timeout : UICommons.AlertManager.DEFAULT_TIMEOUT,\r\n                \"closable\": arguments.length > 4 ? closable : true,\r\n                \"closeOnSelfClick\": arguments.length > 4 ? closable : true,\r\n                \"noteClickEvent\": clickCallback\r\n            });\r\n        };\r\n\r\n        UICommons.AlertManager.DEFAULT_TIMEOUT = 3000;\r\n        UICommons.AlertManager.DEFAULT_ERROR_TIMEOUT = 5000;\r\n        UICommons.AlertManager.MessageLayout = {\r\n            \"TOP\": \"top\", \"TOP_CENTER\": \"topCenter\", \"TOP_LEFT\": \"topLeft\", \"TOP_RIGHT\": \"topRight\",\r\n            \"CENTER\": \"center\", \"CENTER_LEFT\": \"centerLeft\", \"CENTER_RIGHT\": \"centerRight\",\r\n            \"BOTTOM\": \"bottom\", \"BOTTOM_LEFT\": \"bottomLeft\", \"BOTTOM_CENTER\": \"bottomCenter\", \"BOTTOM_RIGHT\": \"bottomRight\"\r\n        };\r\n        UICommons.AlertManager.MessageType = {\r\n            \"ALERT\": \"alert\", \"ERROR\": \"error\", \"SUCCESS\": \"success\",\r\n            \"WARNING\": \"warning\", \"INFO\": \"information\", \"CONFIRM\": \"confirmation\"\r\n        };\r\n\r\n    };\r\n\r\n//    UICommons.DialogManager = DialogManager;\r\n\r\n    wnd.UICommons = UICommons;\r\n\r\n})(window);\r\n\r\nfunction left(str, n)\r\n{\r\n    if(n <= 0) {\r\n        return \"\";\r\n    } else if(n > String(str).length) {\r\n        return str;\r\n    }\r\n    else {\r\n        return String(str).substring(0, n);\r\n    }\r\n}\r\nfunction right(str, n)\r\n{\r\n    if(n <= 0) {\r\n        return \"\";\r\n    } else if(n > String(str).length) {\r\n        return str;\r\n    }\r\n    else {\r\n        var iLen = String(str).length;\r\n        return String(str).substring(iLen, iLen - n);\r\n    }\r\n}\r\n\r\nfunction viewDocForPrinting(docId, mode, dest, pages, aggregazione){\r\n    //window.open(\"/adiJed/ui/view-doc.do?mode=\" + mode + \"&username=\" + getUser() + \"&id=\" + docId + \"&text=\" + dest + \"&pages=\" + pages);\r\n    window.open(\"/adiJed/ui/view-doc.do?mode=\" + mode + \"&id=\" + docId + \"&text=\" + dest + \"&pages=\" + pages + \"&aggregazione=\" + aggregazione);\r\n    return;\r\n}\r\n\r\nfunction getPrintGxpToken(docId, mode, dest, pages, aggregazione){\r\n    var tkn = '';\r\n    $.ajax({url: \"/adiJed/ui/gxp.get-token.do\",\r\n        type: \"POST\",\r\n        data: \"mode=\" + mode + \"&id=\" + docId + \"&text=\" + encodeURIComponent(dest) + \"&pages=\" + pages + \"&aggregazione=\" + aggregazione,\r\n        async: false,\r\n        success: function (result) {\r\n            tkn = result[\"token\"];\r\n        }\r\n    });\r\n    \r\n    return tkn;\r\n}\r\n\r\nvar HISTORY_DOCUMENTID_PARAM = \"HDIPRM$\";\r\nvar historyDocumentIDStore = {};\r\n/**\r\n * Restituisce la stringa da utilizzare per passare il fidd come parametro, verrà trattato poi da saveHistoryAndDisplayPage\r\n * per tenerlo allineato dopo i vari modifica info\r\n * \r\n * @param {type} paramName - il nome del parametro da passare\r\n * @param {type} documentID - il fidd\r\n * @returns {String} HDIPRM$paramName$documentID=documentID che prima dell'invio al server diventerà paramName=documentID\r\n */\r\nfunction getHistoryDocumentKeyParam(paramName, documentID) {\r\n    var currentParamKey = HISTORY_DOCUMENTID_PARAM+paramName+\"$\"+documentID;\r\n    historyDocumentIDStore[currentParamKey] = {\"id\": documentID};\r\n    return currentParamKey+\"=\"+documentID;\r\n}\r\n\r\n/**\r\n *\r\n * @param {!number} id\r\n * @param {?number} historyBehaviour\r\n * @param {?string} view\r\n * @param {?boolean} seeAllLink\r\n */\r\nfunction viewDocInfo(id, historyBehaviour, view, seeAllLink) {\r\n    const params = new ViewDocumentInfoParams(id);\r\n    params.view = view;\r\n    params.seeAllLink = seeAllLink;\r\n    params.historyBehaviour = historyBehaviour;\r\n\r\n    viewDocumentInfo(params);\r\n}\r\n\r\n/**\r\n *\r\n * @param {!number} id\r\n * @return {!number | string | {view, seeAllLink, historyBehaviour, readonly viewDocumentInfoId: !number, fromLinkedDocumentId, getViewDocumentInfoQueryString(): string} | boolean | number}\r\n * @constructor\r\n */\r\nfunction ViewDocumentInfoParams(id) {\r\n    /** @type {!number} */\r\n    const viewDocumentInfoId = id;\r\n    /** @type {string} */\r\n    let view;\r\n    /** @type {boolean} */\r\n    let seeAllLink;\r\n    /** @type {number} */\r\n    let fromLinkedDocumentId;\r\n    /** @type {number} */\r\n    let historyBehaviour;\r\n\r\n    return {\r\n        get viewDocumentInfoId() { return viewDocumentInfoId },\r\n        get view() { return view },\r\n        set view(value) { view = value },\r\n        get seeAllLink() { return seeAllLink },\r\n        set seeAllLink(value) { seeAllLink = value },\r\n        get fromLinkedDocumentId() { return fromLinkedDocumentId },\r\n        set fromLinkedDocumentId(value) { fromLinkedDocumentId = value },\r\n        get historyBehaviour() { return historyBehaviour },\r\n        set historyBehaviour(value) { historyBehaviour = value },\r\n\r\n        getViewDocumentInfoQueryString() {\r\n            let queryString = \"\";\r\n            queryString += getHistoryDocumentKeyParam(\"id\", viewDocumentInfoId);\r\n\r\n            if(view) {\r\n                queryString += \"&__view=\" + view + \"&SeeAllLink=\" + seeAllLinkParam;\r\n            }\r\n\r\n            if(fromLinkedDocumentId) {\r\n                queryString += \"&fromLinkedDocumentId=\" + fromLinkedDocumentId;\r\n            }\r\n\r\n            return queryString;\r\n        }\r\n    }\r\n}\r\n\r\n/**\r\n *\r\n * @param {!ViewDocumentInfoParams} viewDocumentInfoParams\r\n */\r\nfunction viewDocumentInfo(viewDocumentInfoParams) {\r\n    let seeAllLinkParam = viewDocumentInfoParams.seeAllLink;\r\n    if (seeAllLinkParam === undefined){\r\n        seeAllLinkParam = false;\r\n    }\r\n    if(viewDocumentInfoParams.viewDocumentInfoId) {\r\n        HistoryManager.navigateTo(\r\n            '/info-doc/?',\r\n            \"/adiJed/ui/view-doc-info.do\",\r\n            viewDocumentInfoParams.getViewDocumentInfoQueryString(),\r\n            void (0),\r\n            viewDocumentInfoParams.historyBehaviour\r\n        );\r\n    }\r\n}\r\n\r\nfunction downloadThis(_url) {\r\n    var dfd = new $.Deferred();\r\n    \r\n    function downloadInIframe(downloadUrl) {\r\n        dfd.resolve();\r\n        $.modal.close();\r\n/*\r\n        if (target == \"\"){\r\n            target = \"downloadIFrame\";\r\n            if($(\"iframe[name='\"+target+\"']\").length === 0) {\r\n                $(\"<iframe>\").css({visibility: \"hidden\", height: 0, width: 0}).attr(\"name\", target).appendTo($(document.body));\r\n            }\r\n        }\r\n*/\r\n        loadIFrame(\"_blank\", downloadUrl);\r\n\r\n    }\r\n\tif(_url.indexOf(\"gxpp:\") != -1) {\r\n\t\twindow.open(_url);\r\n\t} else {\r\n        showWaitDialog(\"Attendere il download del file...\");\r\n\r\n\t\tvar xhr = new XMLHttpRequest();\r\n\t\txhr.open('GET', _url, true);\r\n\t\txhr.responseType = 'blob';\r\n\t\t\r\n\t\tvar filename = void(0);\r\n\t\t\r\n\t\txhr.onreadystatechange = function() {\r\n\t\t\tif(this.readyState == this.HEADERS_RECEIVED) {\r\n\t\t\t\tvar disposition = xhr.getResponseHeader(\"Content-Disposition\");\r\n\t\t\t\tif(disposition && disposition.indexOf('filename') !== -1) {\r\n\t\t\t\t\tdisposition = decodeURIComponent(disposition);\r\n\t\t\t\t\t\r\n\t\t\t\t\tvar filenameRegex = /filename[^;=\\n]*=((['\"]).*?\\2|[^;\\n]*)/;\r\n\t\t\t\t\tvar matches = filenameRegex.exec(disposition);\r\n\t\t\t\t\tif(matches != null && matches[1]) {\r\n\t\t\t\t\t\tfilename = matches[1].replace(/['\"]/g, '');\r\n\t\t\t\t\t}\r\n\t\t\t\t} else {\r\n\t\t\t\t\txhr.abort();\r\n\t\t\t\t\tdownloadInIframe(_url);\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t};\r\n\t\t\r\n\t\txhr.onload = function(e) {\r\n            if(this.status == 200) {\r\n\t\t\t\tdfd.resolve();\r\n\t\t\t\tif($.modal) $.modal.close();\r\n\t\t\t\tvar blob = this.response;\r\n\t\t\t\t\r\n\t\t\t\tif(navigator.msSaveBlob) {\r\n\t\t\t\t\tnavigator.msSaveBlob(blob, filename);\r\n\t\t\t\t} else {\r\n\t\t\t\t\tvar link = document.createElement('a');\r\n\t\t\t\t\t// per firefox devo aggiungere l'elemento al 