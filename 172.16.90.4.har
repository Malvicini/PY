          "content": {
            "size": 1656,
            "mimeType": "text/javascript",
            "compression": -1,
            "text": "\r\nfunction checkKey()\r\n{\r\n    document.onkeydown = function(ev) {\r\n        var key;\r\n        var isShift, isCtrl;\r\n        if (window.event) {\r\n            key = window.event.keyCode;\r\n            isShift = window.event.shiftKey ? true : false;\r\n            isCtrl = window.event.ctrlKey ? true : false;\r\n        } else {\r\n            key = ev.which;\r\n            isShift = ev.shiftKey ? true : false;\r\n            isCtrl = ev.ctrlKey ? true : false;\r\n        }\r\n        if ( isShift && isCtrl ) {\r\n            switch (key) {\r\n                case 113: // CTRL+SHIFT+F2 MagnoStyle!\r\n                    showHideDebugInfo();\r\n\r\n                    ev.preventDefault();\r\n                    ev.stopPropagation();\r\n                    break;\r\n                default:\r\n                    break;\r\n            }\r\n\r\n        } else if( isCtrl ) {\r\n            switch (key) {\r\n                case 113: // CTRL+F2 MagnoStyle!\r\n                    if( isCtrl )\r\n                    {\r\n                        if(debugWinState != Logger.DEBUG_WIN_VISIBLE)\r\n                            enableDebugWin();\r\n                        else\r\n                            hideDebugWin();\r\n\r\n                        ev.preventDefault();\r\n                        ev.stopPropagation();\r\n                        break;\r\n                    }\r\n                default:\r\n//                                alert(key);\r\n                    break;\r\n            }\r\n        } else if(key == 112) {\r\n            startIntro();\r\n            ev.preventDefault();\r\n            ev.stopPropagation();\r\n        } else {\r\n            return true;\r\n        }\r\n    };\r\n\r\n    checkIsDebug();\r\n}\r\n\r\n"
          },
