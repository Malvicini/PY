            "mimeType": "text/css",
            "compression": -1,
            "text": ".documents-table > tbody > tr.document-row > td.verde,\r\n.documents-table > tbody > tr.document-row > td.verde .fill\r\n{\r\n    background-color: rgb(133, 255, 133) !important;\r\n    color: black !important;\r\n}\r\n\r\n.documents-table > tbody > tr.document-row > td.rosso,\r\n.documents-table > tbody > tr.document-row > td.rosso .fill\r\n{\r\n    background-color: rgb(255, 178, 178) !important;\r\n}\r\n\r\n\r\n.documents-table > tbody > tr.document-row > td.giallo,\r\n.documents-table > tbody > tr.document-row > td.giallo .fill\r\n{\r\n    background-color: rgb(255, 255, 91) !important;\r\n}\r\n\r\n.documents-table > tbody > tr.document-row > td.salmone,\r\n.documents-table > tbody > tr.document-row > td.salmone .fill\r\n{\r\n    background-color: rgb(255, 160, 122) !important;\r\n}"
          },
