            "text": "(function(wnd) {\r\n    var VisualQuery = function(_pageUnique) {\r\n\r\n        createCustomEvent(\"visualQueryExecutedEvent\");\r\n\r\n        var __thisObject = this;\r\n        \r\n        this.createVisualQueryTree = function(tree,label,container) {\r\n            // tolgo il vecchio albero di navigazione doc.\r\n            $(\".visual-query-tree\").remove();\r\n            $(\".vq-title\").remove();\r\n            // nascondo configurazione ed elenco ricerche salvate\r\n            var $vq = $(\".visual-queries\");\r\n            (container||$vq.parent()).append($(\"<div>\").addClass(\"vq-title\").html(\"<span>\"+label+\"</span>\"));\r\n            // creo il nuovo contenitore per l'albero di navigazione doc.\r\n            var treeEl = (tree || $(\"<div>\")).addClass(\"visual-query-tree\").css(\"display\", \"none\").on('scroll', function(){\r\n                if($(this).scrollTop()>0) {\r\n                    if($(this).attr(\"scrolled\") != \"true\") {\r\n                        $(this).attr(\"scrolled\",\"true\").css(\"box-shadow\", \"inset -8px 7px 7px -3px rgba(211, 211, 211, 0.54)\").css(\"border-top-left-radius\",\"3px\");\r\n                    }\r\n                } else {\r\n                    $(this).css(\"box-shadow\", \"none\").removeAttr(\"scrolled\");\r\n                }\r\n            });\r\n            return treeEl.prependTo(container||$vq.parent()).fadeIn();\r\n        };\r\n\r\n        /**\r\n         * params: {\r\n         *   q, frid, ptf, parentContainer, queryParams,\r\n         *   rootContainer --> dove mettere tutto l'albero\r\n         * }\r\n         * @param params\r\n         */\r\n        this.executeVisualQuery = function(params) {\r\n            var dfd = new $.Deferred();\r\n\r\n            $(self).trigger(\"visualQueryExecutedEvent\");\r\n\r\n            var __objRef = this;\r\n            var _params = \"\";\r\n            $(\".vq-search\").css(\"visibility\",\"visible\");\r\n\r\n            var parentContainer = params.parentContainer;\r\n            if(!parentContainer) {\r\n                parentContainer = this.createVisualQueryTree(null,(params[\"q\"])[\"label\"],params[\"rootContainer\"]);\r\n            }\r\n\r\n            var queryFamilies = (params[\"q\"])[\"families\"];\r\n            for(var y=0; y<queryFamilies.length; y++)\r\n                _params += \"&fam=\"+(queryFamilies[y])[\"id\"];\r\n\r\n            var queryField = (params[\"q\"])[\"fields\"];\r\n            var isFirstSearch = true;\r\n            if(params[\"frid\"])\r\n            {\r\n                isFirstSearch = false;\r\n                while(1==1)\r\n                {\r\n                    if(queryField[\"id\"]==params[\"frid\"])\r\n                    {\r\n                        break;\r\n                    }\r\n                    queryField = queryField[\"nextField\"];\r\n                    if(!queryField)\r\n                    {\r\n                        var alertManager = new UICommons.AlertManager();\r\n                        alertManager.showErrorMessage(LangManager.get(\"ui.js.error.generic\"));\r\n                        return;\r\n                    }\r\n                }\r\n            }\r\n            var parentTreeFilter = (params[\"ptf\"]||\"\")+\"&df=\"+queryField[\"df\"]+\"&fval=\"+encodeURIComponent(queryField[\"id\"]);\r\n            if(isFirstSearch)\r\n                parentTreeFilter += \"&frid=\"+queryField[\"id\"]+\"&op=&q=\";\r\n//                parentTreeFilter += \"&frid=\"+queryField[\"id\"]+\"&op=6&q=\";\r\n\r\n            _params += parentTreeFilter;\r\n\r\n            $(\"<span>\").addClass(\"vq-loading\").css(\"font-weight\",\"normal\").css(\"color\",\"gray\").css(\"font-size\",\"9pt\").css(\"padding\", \"5px 10px\")\r\n                .text(LangManager.get(\"ui.js.loading.in.progress\"))\r\n                .appendTo(parentContainer).fadeIn();\r\n\r\n\r\n\r\n            $.ajax({\r\n                type: \"POST\",\r\n                url: \"/adiJed/ui/filter-dyn.do\",\r\n                dataType: \"json\",\r\n                data: \"action=search&allres=true\"+_params\r\n            }).always(function(json){\r\n                var container = parentContainer;\r\n\r\n                $(\".vq-loading\", container).fadeOut(jQuery.fx.speeds.fast);\r\n\r\n                if(json.result && json.result.values && json.result.values.length)\r\n                {\r\n                    $(json.result.values).each(function(idx,el){\r\n\r\n                        var hasSubTree = queryField[\"nextField\"] && (queryField[\"nextField\"])[\"id\"];\r\n                        var elText = el[\"text\"];\r\n                        var op = 3;\r\n                        console.log(\"elText:\"+elText);\r\n                        if(elText == \"\") {\r\n                            elText = LangManager.get(\"ui.js.vq.no.value\");\r\n                            op = 10; //empty string\r\n                        }/* else if(elText == null) {\r\n                            elText = LangManager.get(\"ui.js.vq.null\");\r\n                            op = 10; //is null\r\n                        }*/\r\n                        $(\"<span>\")\r\n                            .addClass(\"vq-folder\").addClass(\"vq-tree-line\").addClass(hasSubTree?\"\":\"vq-query\")\r\n                            .append(\r\n                                $(\"<span>\").text(el[\"v\"]||elText).click(function(e){\r\n                                    var _this = $(this).parent();\r\n                                    e.preventDefault();\r\n                                    e.stopPropagation();\r\n\r\n                                    if(!_this.hasClass(\"opened\")) {\r\n                                        if(!_this.find(\"> span.vq-folder\").length) {\r\n                                            _this.css(\"height\",_this.height())\r\n                                                .css(\"overflow-y\",\"hidden\")\r\n                                                .attr(\"origHeight\",_this.height());\r\n\r\n\r\n                                            var text = el[\"text\"];\r\n                                            if (el[\"fieldType\"] == 2){\r\n                                                text = text.replace(/\\./g,'');\r\n                                                text = text.replace(/\\,/g,'.');\r\n                                            }\r\n\r\n\r\n                                            if(hasSubTree) {\r\n                                                __thisObject.executeVisualQuery({\r\n                                                    \"q\": params[\"q\"],\r\n                                                    \"frid\": (queryField[\"nextField\"])[\"id\"],\r\n                                                    \"df\": (queryField[\"nextField\"])[\"df\"],\r\n                                                    \"ptf\": (params[\"ptf\"]||\"\")+\"&frid=\"+queryField[\"id\"]+\"&df=\"+queryField[\"df\"]+\"&op=\"+op+\"&q=\"+encodeURIComponent(text),\r\n                                                    \"parentContainer\": _this,\r\n                                                    \"queryParams\": (params[\"queryParams\"]||\"\")+\"&qf\"+(queryField[\"df\"]==\"true\"?\"D\":\"F\")+queryField[\"id\"]+\"=\"+(op == 10 ? \"isnull\" : \"eq\")+\"&df=\"+queryField[\"df\"]+\"&vl\"+(queryField[\"df\"]==\"true\"?\"D\":\"F\")+queryField[\"id\"]+\"=\"+encodeURIComponent(text)\r\n                                                });\r\n                                                _this.toggleClass(\"opened\");\r\n                                            } else {\r\n                                                var queryResultsPageID = getUniqueID();\r\n                                                var k = \"/results/?\"+queryResultsPageID;\r\n                                                var queryParams = (params[\"queryParams\"]||\"\")+\"&qf\"+(queryField[\"df\"]==\"true\"