            "mimeType": "text/javascript",
            "compression": -1,
            "text": "\r\n/********* funzione asincrona ***************************************/\r\nfunction GeneralInvoke(f)\r\n{\r\n\tthis.params = new Array();\r\n\tthis.func = f;\r\n\treturn this;\r\n}\r\nGeneralInvoke.prototype.setParams = function(prms)\r\n{\r\n\tif (prms.length)\r\n\t{\r\n\t\tfor (var i = 0; i < prms.length; i++)\r\n\t\t\tthis.params[i] = prms[i];\r\n\t}\r\n\telse\r\n\t{\r\n\t\tthis.params[i] = prms;\r\n\t}\r\n};\r\nGeneralInvoke.prototype.myInvoke = function()\r\n{\r\n\tvar f_to_call = 'this.func(';\r\n\tfor (var i = 0; i < this.params.length; i++)\r\n\t{\r\n\t\tif (i != 0)\r\n\t\t{\r\n\t\t\tf_to_call += ',';\r\n\t\t}\r\n\t\tf_to_call += 'this.params[' + i + ']';\r\n\t}\r\n\tf_to_call += ')';\r\n\teval(f_to_call);\r\n};\r\n/* array che contiene l'intervalID di ogni funzione asincrona */\r\nasyncFunctionsID = new Array();\r\n/* lancia la funzione func quando � valorizzato il valore di result */\r\nfunction aSyncFunction(func, result)\r\n{\r\n\t//alert('checkASyncFunction(\\''+func+'\\'');\r\n\tid = window.setInterval('checkASyncFunction(\\'' + func + '\\',\\'' + result + '\\')', 50);\r\n\tasyncFunctionsID[func] = id;\r\n\t//alert('id['+func+']='+asyncFunctionsID[func]);\r\n}\r\nfunction checkASyncFunction(func, result)\r\n{\r\n\tvar _test = eval(result);\r\n\t//alert('id['+func+']='+asyncFunctionsID[func]+'\\nvalue='+_test);\r\n\tif (typeof _test != 'undefined' && _test != null)\r\n\t{\r\n\t\t//alert(func);\r\n\t\twindow.clearInterval(asyncFunctionsID[func]);\r\n\t\teval(func + '()');\r\n\t}\r\n}\r\n//==================================================\r\n"
          },
