endo.de-DE.js\", function(){});\r\n                $.getScript(\"/adiJed/js/kendo/cultures/kendo.culture.de-DE.min.js\", function(){kendo.culture(\"de-DE\");});\r\n\r\n                break;\r\n            case 'Espagnol':\r\n                $.getScript(\"/adiJed/js/kendo/languages/kendo.es-ES.js\", function(){});\r\n                $.getScript(\"/adiJed/js/kendo/cultures/kendo.culture.es-ES.min.js\", function(){kendo.culture(\"es-ES\");});\r\n\r\n                break;\r\n            case 'Romana':\r\n                $.getScript(\"/adiJed/js/kendo/languages/kendo.it-IT.js\", function(){});\r\n                $.getScript(\"/adiJed/js/kendo/cultures/kendo.culture.it-IT.min.js\", function(){kendo.culture(\"it-IT\");});\r\n\r\n                break;\r\n            default:\r\n                $.getScript(\"/adiJed/js/kendo/languages/kendo.it-IT.js\", function(){});\r\n                $.getScript(\"/adiJed/js/kendo/cultures/kendo.culture.it-IT.min.js\", function(){kendo.culture(\"it-IT\");});\r\n        }\r\n        </script>\r\n\r\n        <link href=\"/adiJed/css/kendo/kendo.common.min.css?ver=6.7.2.20250507.P6\" rel=\"stylesheet\"/>\r\n        <link href=\"/adiJed/css/kendo/kendo.default.min.css?ver=6.7.2.20250507.P6\" rel=\"stylesheet\"/>\r\n        <link href=\"/adiJed/css/kendo.adijed.css?ver=6.7.2.20250507.P6\" rel=\"stylesheet\"/>\r\n        <link href=\"/adiJed/css/jquery.contextMenu.css?ver=6.7.2.20250507.P6\" rel=\"stylesheet\"/>\r\n        <link href=\"/adiJed/css/jquery.noty.css?ver=6.7.2.20250507.P6\" rel=\"stylesheet\"/>\r\n        <link href=\"/adiJed/css/nanoscroller.css?ver=6.7.2.20250507.P6\" rel=\"stylesheet\"/>\r\n        <link href=\"/adiJed/css/jquery-ui-1.8.23.custom.css?ver=6.7.2.20250507.P6\" rel=\"stylesheet\"/>\r\n        <link href=\"/adiJed/css/animate.min.css?ver=6.7.2.20250507.P6\" rel=\"stylesheet\"/>\r\n        <link href=\"/adiJed/css/common.css?ver=6.7.2.20250507.P6\" rel=\"stylesheet\"/>\r\n        <link href=\"/adiJed/css/waiting.css?ver=6.7.2.20250507.P6\" rel=\"stylesheet\"/>\r\n        <link href=\"/adiJed/css/homepage.css?ver=6.7.2.20250507.P6\" rel=\"stylesheet\"/>\r\n        <link href=\"/adiJed/css/introjs.css?ver=6.7.2.20250507.P6\" rel=\"stylesheet\"/>\r\n        <link href=\"/adiJed/css/font_awesome/font-awesome.min.css?ver=6.7.2.20250507.P6\" rel=\"stylesheet\"/>\r\n        \r\n\r\n        <style>\r\n\r\n        </style>\r\n        <!--[if IE]>\r\n        <style>\r\n            #logout {\r\n                background: url(\"/adiJed/img/toolbar/logout_w_22.png\") no-repeat 5px -9px !important;\r\n            }\r\n        </style>\r\n        <![endif]-->\r\n\r\n        <script type=\"text/javascript\">\r\n            var getSammyInstance = function() {\r\n                return Sammy(function()\r\n                {\r\n                    this.get('#/', function() {\r\n                        loadHome();\r\n                    });\r\n\r\n                    this.get('#/query/', function() {\r\n                        loadQuery(null);\r\n                    });\r\n                    this.get('#/multi-view/', function() {\r\n                        HistoryManager.loadPage();\r\n                    });\r\n\r\n                    this.get('#/results/', function() {\r\n                        if($(\".toolbar-button-selected\")) $(\".toolbar-button-selected\").removeClass(\"toolbar-button-selected\");\r\n                        $(\"#query\").addClass(\"toolbar-button-selected\");\r\n                        if( !HistoryManager.loadPage() ) {\r\n                            loadQuery(null);\r\n                        }\r\n                    });\r\n\r\n                    this.get('#/info-doc/', function() {\r\n                        if($(\".toolbar-button-selected\")) $(\".toolbar-button-selected\").removeClass(\"toolbar-button-selected\");\r\n                        $(\"#query\").addClass(\"toolbar-button-selected\");\r\n                        if( !HistoryManager.loadPage() ) {\r\n                            loadQuery(null);\r\n                        }\r\n                    });\r\n\r\n                    this.get('#/new/', function() {\r\n                        if($(\".toolbar-button-selected\")) $(\".toolbar-button-selected\").removeClass(\"toolbar-button-selected\");\r\n                        $(\"#new\").addClass(\"toolbar-button-selected\");\r\n                        loadNewDocument({openNewWin: false, familyLocked: false});\r\n                    });\r\n\r\n                    this.get('#/wf/', function() {\r\n                        if($(\".toolbar-button-selected\")) $(\".toolbar-button-selected\").removeClass(\"toolbar-button-selected\");\r\n                        $(\"#workflow\").addClass(\"toolbar-button-selected\");\r\n                        loadWorkflow();\r\n                    });\r\n\r\n                    this.get('#/messages/', function() {\r\n                        if($(\".toolbar-button-selected\")) $(\".toolbar-button-selected\").removeClass(\"toolbar-button-selected\");\r\n                        $(\"#messages\").addClass(\"toolbar-button-selected\");\r\n                        loadMessages();\r\n                    });\r\n\r\n                    this.get('#/msg/', function() {\r\n                        if($(\".toolbar-button-selected\")) $(\".toolbar-button-selected\").removeClass(\"toolbar-button-selected\");\r\n                        $(\"#messages\").addClass(\"toolbar-button-selected\");\r\n                        if( !HistoryManager.loadPage() ) {\r\n                            loadMessages();\r\n                        }\r\n                    });\r\n\r\n                    this.get('#/activity/', function() {\r\n                        if($(\".toolbar-button-selected\")) $(\".toolbar-button-selected\").removeClass(\"toolbar-button-selected\");\r\n                        $(\"#workflow\").addClass(\"toolbar-button-selected\");\r\n                        if( !HistoryManager.loadPage() ) {\r\n                            loadWorkflow();\r\n                        }\r\n                    });\r\n\r\n                    this.get('#/tutor/', function() {\r\n                        if($(\".toolbar-button-selected\")) $(\".toolbar-button-selected\").removeClass(\"toolbar-button-selected\");\r\n                        $(\"#tutor\").addClass(\"toolbar-button-selected\");\r\n                        if( !HistoryManager.loadPage() ) {\r\n                            loadTutor();\r\n                        }\r\n                    });\r\n\r\n                    this.get('#/training/', function() {\r\n                        if($(\".toolbar-button-selected\")) $(\".toolbar-button-selected\").removeClass(\"toolbar-button-selected\");\r\n                        $(\"#training\").addClass(\"toolbar-button-selected\");\r\n                        HistoryManager.loadPage();\r\n                    });\r\n\r\n                    this.get('#/tracking/', function() {\r\n                        loadTracking(null);\r\n                    });\r\n\r\n                    this.get('#/channel/', function() {\r\n                        if($(\".toolbar-button-selected\")) $(\".toolbar-button-selected\").removeClass(\"toolbar-button-selected\");\r\n                        $(\"#channel\").addClass(\"toolbar-button-selected\");\r\n                        if( !HistoryManager.loadPage() ) {\r\n                            showChannels(-1);\r\n                        }\r\n                    });\r\n\r\n                    this.get('#/view-doc/', function() {\r\n                        HistoryManager.loadPage();\r\n                    });\r\n\r\n                    this.get('#/view-att/', function() {\r\n                        HistoryManager.loadPage();\r\n                    });\r\n\r\n                    this.get('#/info-doc/', function() {\r\n                        HistoryManager.loadPage();\r\n                    });\r\n\r\n                    this.get('#/edit-doc/', function() {\r\n                        HistoryManager.loadPage();\r\n                    });\r\n\r\n                    //Training\r\n                    this.get('#/company-struct/', function() {\r\n                        HistoryManager.loadPage();\r\n                    });\r\n\r\n                    this.get('#/training-struct/', function() {\r\n                        HistoryManager.loadPage();\r\n                    });\r\n\r\n                    this.get('#/anag-base/', function() {\r\n                        HistoryManager.loadPage();\r\n                    });\r\n\r\n                    this.get('#/management-course/', function() {\r\n                        HistoryManager.loadPage();\r\n                    });\r\n\r\n                    this.get('#/trainingViews/', function() {\r\n                        HistoryManager.loadPage();\r\n                    });\r\n\r\n                    this.get('#/utenti-anag/', function() {\r\n                        HistoryManager.loadPage();\r\n                    });\r\n\r\n                    this.get('#/qualifiche-anag/', function() {\r\n                        HistoryManager.loadPage();\r\n                    });\r\n\r\n                    this.get('#/training-anag/', function() {\r\n                        HistoryManager.loadPage();\r\n                    });\r\n\r\n                    this.get('#/risorse-anag/', function() {\r\n                        HistoryManager.loadPage();\r\n                    });\r\n\r\n                    this.get('#/risorse-tipo-anag/', function() {\r\n                        HistoryManager.loadPage();\r\n                    });\r\n\r\n                    this.get('#/entita-anag/', function() {\r\n                        HistoryManager.loadPage();\r\n                    });\r\n\r\n                    this.get('#/piani-form-anag/', function() {\r\n                        HistoryManager.loadPage();\r\n                    });\r\n\r\n                    this.get('#/organigramma-anag/', function() {\r\n                        HistoryManager.loadPage();\r\n                    });\r\n\r\n                    this.get('#/training-cat-anag/', function() {\r\n                        HistoryManager.loadPage();\r\n                    });\r\n\r\n                    this.get('#/proposed-courses/', function() {\r\n                        HistoryManager.loadPage();\r\n                    });\r\n\r\n                    this.get('#/manage-courses/', function() {\r\n                        HistoryManager.loadPage();\r\n                    });\r\n\r\n                    this.get('#/evaluate-courses/', function() {\r\n                        HistoryManager.loadPage();\r\n                    });\r\n\r\n                    this.get('#/training-import/', function() {\r\n                        HistoryManager.loadPage();\r\n                    });\r\n\r\n                    this.get('#/users-view/', function() {\r\n                        HistoryManager.loadPage();\r\n                    });\r\n\r\n                    this.get('#/trainings-view/', function() {\r\n                        HistoryManager.loadPage();\r\n                    });\r\n\r\n                    this.get('#/calendar-view/', function() {\r\n                        HistoryManager.loadPage();\r\n                    });\r\n\r\n                    this.get('#/storicized-qualif-view/', function() {\r\n                        HistoryManager.loadPage();\r\n                    });\r\n\r\n                    this.get('#/audit-view/', function() {\r\n                        HistoryManager.loadPage();\r\n                    });\r\n                });\r\n            };\r\n            // initialize the application\r\n            var app = null;\r\n            if (top !== window && top.app) {\r\n                //sono in un sottoframe eredito Sammy dal top\r\n//                window.Sammy = $.sammy = top.$.sammy;\r\n                app = self.app = top.app;\r\n            } else if( !self.app ) {\r\n                app = self.app = getSammyInstance();\r\n            } else {\r\n                app = self.app;\r\n            }\r\n\r\n            $(document).ready(function() {\r\n                AdiutoUserSettings.restoreUserSettings(1234).then(themeSetup);\r\n            });\r\n        </script>\r\n\r\n        <script type=\"text/x-kendo-template\" id=\"prewCommentInfoTemplate\">\r\n            <div id=\"prew-comment-info-container\">\r\n\r\n                    # for (var i = 0; i < data.length; i++) { #\r\n                        <div class=\"prew-comment # if(i > 0){# separator#}#\">\r\n                            <span class=\"comment-info\">\r\n                                <span class=\"comment-info-element\">#=formatDataFromDB(data[i].data)#</span>\r\n                                <span class=\"comment-info-element\">#=data[i].ora#</span>\r\n                                <span class=\"comment-info-element\">#=data[i].sigla#</span>\r\n                            </span>\r\n                            <span class=\"comment-text\">\r\n                                #=data[i].commento#\r\n                            </span>\r\n                        </div>\r\n                    # } #\r\n\r\n            </div>\r\n        </script>\r\n\r\n        <script type=\"text/javascript\" src=\"/adiJed/js/ui/plugins.js?ver=6.7.2.20250507.P6\"></script>\r\n\r\n\r\n        <link href=\"/adiJed/css/main.css?ver=6.7.2.20250507.P6\" rel=\"stylesheet\"/>\r\n\r\n        \r\n\r\n        <script type=\"text/x-kendo-template\" id=\"channelNotifyTemplate\">\r\n            # var tipoCanale = \"Privato\";#\r\n            #if(channel.type=='PUBLIC'){#\r\n                #tipoCanale = \"Pubblico\";#\r\n            #}#\r\n            # var messaggio = num_notifies+\" nuovo messaggio nel canale\";#\r\n            #if(num_notifies>1){#\r\n                #messaggio = num_notifies+\" nuovi messaggi nel canale\";#\r\n            #}#\r\n            <div class=\"channelNotify\" messageid=\"#=id#\" channelid=\"#=idChannel#\" channelTitle=\"#=channel.title#\" channelType=\"#=channel.type#\" style=\"background-color: #=channel.background#; color:#=getTextColor(convertHexToRGB(channel.background))#; \">\r\n            \r\n                <div class=\"chat-notify\">\r\n                    <span class=\"msg\">#=messaggio# #=tipoCanale# <span style=\"font-weight: bold;\">#=channel.title#</span></span><br>\r\n                    #if(num_notifies==1){#\r\n                        <span class=\"author\" authorid=\"#=userId#\">#=userName#</span>\r\n                        <span class=\"date\" messageDate=\"#=formatDataTimeFromTimeStamp(time)#\">#=formatDataTimeFromTimeStamp(time)#</span>\r\n                    #}#\r\n                </div>\r\n            </div>\r\n        </script>\r\n\r\n        <style type=\"text/css\">\r\n            #crumbs:before {\r\n                content: 'Ti trovi in: (Jobs) '; \r\n            }\r\n            div.chat-notify > span.msg{\r\n                text-align: justify;\r\n                margin-bottom: 15px;\r\n                white-space: pre-line;\r\n                word-break: break-all;\r\n                word-break: break-word;\r\n            }\r\n            div.chat-notify > span.author, div.chat-notify > span.date {\r\n                font-size: 90%;\r\n                display: inline-block;\r\n            }\r\n            div.chat-notify > span.author::after {\r\n                content: ', il: ';\r\n            }\r\n            div.chat-notify > span.date {\r\n                font-style: italic;\r\n            }\r\n            div.chat-notify > span.author::before {\r\n                /*color: rgb(139, 139, 139);*/\r\n                content: 'Inserito da:';\r\n            }\r\n\r\n            #mainDebugBox:hover {\r\n                width: auto;\r\n                height: auto;\r\n                padding: 10px;\r\n            }\r\n            span#mainDebugBox {\r\n                width: 20px;\r\n                height: 20px;\r\n                overflow: hidden;\r\n                position: absolute;\r\n                transition: all .3s ease-out;\r\n            }\r\n            span#mainDebugBox:hover:before {\r\n                opacity: 0;\r\n                height: 0;\r\n                position: absolute;\r\n            }\r\n            span#mainDebugBox:before {\r\n                content: '';\r\n                width: 20px;\r\n                height: 20px;\r\n                background: url('/adiJed/img/icons/gear.png') no-repeat center #ffffff;\r\n                display: inline-block;\r\n                background-size: 16px;\r\n                transition: all .3s ease-out;\r\n                cursor: pointer;\r\n            }\r\n        </style>\r\n    </head>\r\n    \r\n    <body id=\"bd\">\r\n        <script type=\"text/javascript\" src=\"/adiJed/js/ui/device.js?ver=6.7.2.20250507.P6\"></script>\r\n        <script type=\"text/javascript\">\r\n            if(isSmartphone()) {\r\n                location = \"/adiJed/ui/touch.home.do?dvc=1\";\r\n            }\r\n\r\n            var trainingDivisions = [];\r\n        </script>\r\n        <div id=\"train-divisions-choice-list-container\" class=\"adi-modal-dialog-container\">\r\n            <div id=\"train-divisions-choice-list\">\r\n                <div class=\"adi-modal-title\">Seleziona la divisione</div>       \r\n                <div>\r\n                    <ul>\r\n                        \r\n                    </ul>\r\n                </div>\r\n            </div>\r\n        </div>\r\n\r\n        \r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n<div id=\"application-top-bar\">\r\n    <span class=\"toolbar-button\" id=\"home\"><span>Home</span></span>\r\n    \r\n\r\n    <span class=\"toolbar-button\" id=\"new\"><span>Nuovo</span></span>         \r\n\r\n\r\n\r\n    <span class=\"toolbar-button\" id=\"query\"><span>Ricerche</span></span>     \r\n\r\n\r\n\r\n    <span class=\"toolbar-button\" id=\"workflow\">\r\n        <span>ATTIVITÀ</span>                                                 \r\n        <span id=\"workflow-num-bullet\" class=\"bullet-indicator right-item-bullet\"></span>\r\n    </span>\r\n\r\n\r\n    <span class=\"toolbar-button\" id=\"messages\"><span>Messaggi</span></span>     \r\n\r\n\r\n\r\n\r\n    \r\n    \r\n\r\n\r\n    <div id=\"user-box\">\r\n        <span class=\"toolbar-button infoAdiuto\"></span>\r\n        \r\n        <span class=\"toolbar-button last-button logout-action-button\" id=\"logout\">ESCI</span>         \r\n        \r\n        \r\n        <span id=\"user-name\">mmalvicini (Malvicini)</span>\r\n    </div>\r\n    <div id=\"extra-options\" style=\"position: absolute; left: 70px; right: 0; top: 0; bottom: 0; display: none; background-color: #252e30; border-left: 1px groove #4e4e4e;\">\r\n        <span style=\"padding-top: 10px; padding-bottom: 10px; display: inline-block; left: 0; right: 0; border-bottom: 1px groove #4e4e4e; text-align: center; width: 100%;\">\r\n            OPZIONI                         \r\n        </span>\r\n        <span class=\"options-text\">\r\n            Utente collegato: mmalvicini (Malvicini)      \r\n        </span>\r\n        <span class=\"options-button change-password\">\r\n            <span>Cambia la tua password</span>                \r\n        </span>\r\n    </div>\r\n</div>\r\n\r\n\r\n        <div id=\"aboutAdiuto\" style=\"backface-visibility: hidden; display: none;\">\r\n            <div style=\"position: relative; display: inline-block; vertical-align: middle; padding-left: calc(50% - 300px); padding-top: 5%;\">\r\n               \t\t<b class=\"rtop\"><b class=\"r1\"></b><b class=\"r2\"></b><b class=\"r3\"></b><b class=\"r4\"></b></b>\r\n               \t\t<div id=\"imgDiv\" style=\"visibility:hidden; float:right; margin-right: 56px;\"></div>\r\n               \t\t<p>Adiuto version:  <label id=\"adijedVersion\"></label></p>\r\n               \t\t<p>Contract code:<br>\r\n               \t\t<label id=\"customerName\"></label><br>\r\n               \t\t</p>\r\n               \t\t<p style=\"text-align:justify; width: 600px;\">Attention:<br>\r\n                    This program is protected by international copyright laws. Unauthorized reproduction or distribution of this program, or any portion thereof, will be prosecuted civilly and penally to the fullest extent permitted by law.<br><br>\r\n\r\n                    Adiuto is a brand owned by Bluenext Ltd.<br>\r\n\r\n                    All rights reserved.<img class=\"logoAbout\" src=\"/adiJed/img/Marchio_costruzione2023_2.png\"><br><br>\r\n               \t\tweb site: <a href=\"http://www.adiuto.it\" target=\"_new\">www.adiuto.it</a> <br>\r\n               \t\tinfo: <a href=\"mailto:marketing@adiuto.it\">marketing@adiuto.it</a> <br>\r\n                    manual: <a href=\"/adiJed/workfolder/Manuale/Manuale_Adiuto_utente.pdf\" target=\"_new\">Adiuto</a>&nbsp;&nbsp;&nbsp;<a href=\"/adiJed/workfolder/Manuale/Manuale_Aditraining.pdf\" target=\"_new\">AdiTraining</a>\r\n               \t\t</p>\r\n               \t\t<b class=\"rbottom\"><b class=\"r4\"></b><b class=\"r3\"></b><b class=\"r2\"></b><b class=\"r1\"></b></b>\r\n            </div>\r\n        </div>\r\n        <div id=\"themeChooser\" style=\"height: 0;\">\r\n            <span style=\"position: relative; white-space: nowrap; display: inline-block; vertical-align: middle; padding-left: 15px; padding-top: 15px;\">\r\n                Stile font: <select id=\"fontChooser\" onchange=\"saveFont()\">\r\n                <optgroup style=\"font-family: Arial !important; padding: 4px; margin: 0;\"><option value=\"Arial\">Arial</option></optgroup>\r\n                <optgroup style=\"font-family: Courier !important; padding: 4px; margin: 0;\"><option value=\"Courier\">Courier</option></optgroup>\r\n                <optgroup style=\"font-family: 'Segoe UI' !important; padding: 4px; margin: 0;\"><option value=\"Segoe UI\">Segoe UI</option></optgroup>\r\n                <optgroup style=\"font-family: Tahoma !important; padding: 4px; margin: 0;\"><option value=\"Tahoma\">Tahoma</option></optgroup>\r\n                <optgroup style=\"font-family: 'Times new roman' !important; padding: 4px; margin: 0;\"><option value=\"Times new roman\">Times new roman</option></optgroup>\r\n                <optgroup style=\"font-family: Verdana !important; padding: 4px; margin: 0;\"><option value=\"Verdana\">Verdana</option></optgroup>\r\n            </select>\r\n            </span>\r\n        </div>\r\n        <div id=\"crumbsDiv\">\r\n            <span id=\"mainDebugBox\" class=\"__d\">\r\n            \r\n                <span style=\"display: block; padding: 4px;\">\r\n                    <input type=\"text\" size=\"5\" id=\"___fidd\" placeholder=\"FIDD\" style=\"margin-right: 2px;height: 18px;margin-top: 2px;margin-bottom: 2px;\"><input onclick=\"if($('#___fidd').val() != '') viewDocInfo($('#___fidd').val());return false;\" type=\"button\" value=\"VAI\">\r\n                    <script type=\"text/javascript\">try { $('#___fidd').on('keypress',function(e){if(e.keyCode == 13){if($('#___fidd').val()!='')viewDocInfo($('#___fidd').val());}});}catch(e){}</script>\r\n                </span>\r\n            </span>\r\n            <ul id=\"crumbs\">\r\n            </ul>\r\n        </div>\r\n        <div id=\"main-container\" style=\"backface-visibility: hidden;\">\r\n            <div id=\"app-container\">\r\n                \r\n            </div>\r\n        </div>\r\n        <div id=\"right-app-container\" class=\"cc\">\r\n            <span id=\"pin-right-app-container\" title=\"Mostra/Nascondi\"></span>      \r\n<!--            <div id=\"right-app-user-info\">\r\n                <span class=\"infoAdiuto\"></span>\r\n                <span style=\"display: block;\">Utente collegato: mmalvicini (Malvicini)</span>         \r\n                \r\n                <span style=\"margin-left: -6px; margin-bottom: 10px; padding-left: 30px; line-height: 22px; vertical-align: middle; display: block;\" class=\"logout-action-button\">ESCI</span>    \r\n                \r\n            </div>-->\r\n            <div id=\"right-app-content\">\r\n\r\n            </div>\r\n            \r\n        </div>\r\n        <div id=\"ipad-document-frame-container\" style=\"width: 100%; height: 100%; box-shadow: 14px 25px 12px 15px #000; display: none;\">\r\n            <iframe id=\"ipad-document-frame\" name=\"ipad-document-frame\" height=\"100%\" style=\"height:100%; background-color: RGB(251, 251, 251); z-index: 2; width: 100%; border:0;\"></iframe>\r\n        </div>\r\n        <div id=\"debug-info-box\" style=\"padding-top: 25px;\">\r\n            <div id=\"debug-title\" style=\"text-align: left; padding-top: 4px; position: absolute; top: 0; left: 0; right: 0; height: 21px; background-color: darkgray; color: white; font-weight: bold;\">\r\n                DEBUG WIN\r\n                <input type=\"text\" id=\"weinre_base_url\" style=\"margin-left: 4px; padding-top: 1px; padding-bottom: 1px; font-size: 8pt; height: 14px; width: 120px;\" value=\"172.16.90.4:8080\"/>\r\n                <a href=\"javascript:void(0)\" onclick=\"(function(e){e.setAttribute('src','http://'+document.getElementById('weinre_base_url').value+'/target/target-script-min.js#anonymous');document.getElementsByTagName('body')[0].appendChild(e);})(document.createElement('script'));return false;\">Weinre Connect</a>\r\n                <span id=\"log-filter\" style=\"float: right; display: inline-block; margin-top: -5px;\"></span>\r\n                <span id=\"log-clear\" style=\"float: right; display: inline-block; margin-top: -5px;\"></span>\r\n            </div>\r\n            <div id=\"debug-messages\" style=\"cursor: text; overflow-y: auto; position: absolute; top: 25px; left: 0; right: 0; bottom: 0;\"></div>\r\n        </div>\r\n\r\n        \r\n\r\n\r\n<div id=\"confim-dialog\" class=\"adi-modal-dialog-container\" style=\"z-index: 100000;\">\r\n    <div class=\"adi-modal-title\"></div>\r\n    <div id=\"confim-dialog-message\" class=\"adi-modal-message\"></div>                                                                                                                                                                                                       \r\n    <div class=\"adi-modal-button-bar\"><input class=\"adi-button adi-button-red button-left\" type=\"submit\" id=\"confim-dialog-ok\" value=\"Conferma\"><input class=\"adi-button adi-button-gray button-right\" type=\"button\" id=\"confim-dialog-cancel\" value=\"Annulla\"></div>\r\n</div>\r\n\r\n<div id=\"input-dialog\" class=\"adi-modal-dialog-container\">\r\n    <div class=\"adi-modal-title\"></div>\r\n    <div class=\"adi-modal-message adi-modal-textbox\">\r\n        <span id=\"input-dialog-message\" style=\"display: block; margin-bottom: 10px;\"></span>\r\n        <span style=\"width: 100%; display: inline-block;\">\r\n            <form onsubmit=\"return false;\" name=\"frmInputDialog\">\r\n                <input type=\"text\" name=\"input-dialog-textbox\" id=\"input-dialog-textbox\" style=\"width: 300px;\"/>\r\n                \r\n                <textarea name=\"input-dialog-textarea\" id=\"input-dialog-textarea\" style=\"display: none; width: 300px; height: 6em;\"></textarea>\r\n            </form>\r\n        </span>\r\n    </div>\r\n    <div class=\"adi-modal-button-bar\"><input class=\"adi-button adi-button-red button-left\" type=\"submit\" id=\"input-dialog-ok\" value=\"Conferma\"><input class=\"adi-button adi-button-gray button-right\" type=\"button\" id=\"input-dialog-cancel\" value=\"Annulla\"></div>\r\n</div>\r\n\r\n<script type=\"text/javascript\" src=\"/adiJed/js/ui/confirm-dialog.js?ver=6.7\"></script>\r\n<script type=\"text/javascript\" src=\"/adiJed/js/ui/confirm-dialog-impl.js?ver=6.7\"></script>\r\n\r\n        \r\n<div id=\"change-password-dialog-container\" class=\"adi-modal-dialog-container\">\r\n    <div id=\"change-password-dialog\" class=\"adi-modal-dialog\">\r\n        <h2>Cambia la tua password di Adiuto</h2>     \r\n        <form name=\"form-change-password\" id=\"form-change-password\" action=\"#\" method=\"post\">\r\n                                                                \r\n            <label>Vecchia password: <input placeholder=\"Digita la tua password\" type=\"password\" id=\"pwd-chg-old-pwd\" name=\"pwd-chg-old-pwd\">\r\n                <input type=\"text\" id=\"passwordType\" name=\"passwordType\" style=\"display:none;\">\r\n            </label>\r\n                                                                  \r\n            <label>Nuova password: <input placeholder=\"Nuova password\" type=\"password\" id=\"pwd-chg-new-pwd\" name=\"pwd-chg-new-pwd\"></label>\r\n                                                                   \r\n            <label>Conferma password: <input placeholder=\"Conferma la nuova password\" type=\"password\" id=\"pwd-chg-new-pwd2\" name=\"pwd-chg-new-pwd2\"></label>\r\n            <div id=\"changePasswordBtnBar\">\r\n                                                                                                                                                                                                                                       \r\n                <input class=\"adi-button adi-button-red\" type=\"submit\" id=\"doChangePassword\" value=\"Conferma\"><input class=\"adi-button adi-button-gray\" type=\"button\" id=\"doClosePwdDialog\" value=\"Annulla\">\r\n            </div>\r\n        </form>\r\n    </div>\r\n</div>\r\n\r\n\r\n\r\n        \r\n        \r\n\r\n<script type=\"text/javascript\" src=\"/adiJed/plugins/adijed/aSyncFunction.js\"></script>\r\n\r\n\r\n<script type=\"text/javascript\">\r\n    var printerApplet;\r\n\r\n    var printEnded = null;\r\n    var printFiles = _printFiles;\r\n    function _printFiles(selectedDocuments, addInfo, mode, dest, pages)\r\n    {\r\n\r\n        printEnded = null;\r\n    \t/*se non è ancora stata scaricata l'applet*/\r\n    \tif(!printerApplet)\r\n    \t{\r\n            $(\".document-iframe\").addClass(\"hiddenForWindow\");\r\n            openWindow(\"iprDownloader\", \"/adiJed/ui/utils/printerApplet.jsp\",\r\n                    {\"width\": \"700px\", \"height\": \"400px\", \"title\": \"Stampa GxP\", \"modal\": true, \"Maximize\":false, \"resizable\":false},\r\n                    function(){\r\n                        $(\".document-iframe\").removeClass(\"hiddenForWindow\");\r\n                        if(printerApplet){\r\n                            printerApplet.cancel();\r\n                        }\r\n\r\n                    }\r\n            );\r\n    \t\tself.doPrintFiles = new GeneralInvoke(_printFiles);\r\n    \t\tvar prm = new Array();\r\n    \t\tprm[0] = selectedDocuments;\r\n    \t\tprm[1] = addInfo;\r\n    \t\tprm[2] = mode;\r\n            prm[3] = dest;\r\n            prm[4] = pages;\r\n    \t\tself.doPrintFiles.setParams(prm);\r\n    \t\taSyncFunction('self.doPrintFiles.myInvoke','printerApplet');\r\n    \t}\r\n    \telse if(!printerApplet.startNewDownload)\r\n    \t{\r\n    \t\tself.doPrintFiles = new GeneralInvoke(_printFiles);\r\n    \t\tvar prm = new Array();\r\n    \t\tprm[0] = selectedDocuments;\r\n    \t\tprm[1] = addInfo;\r\n    \t\tprm[2] = mode;\r\n            prm[3] = dest;\r\n            prm[4] = pages;\r\n    \t\tself.doPrintFiles.setParams(prm);\r\n    \t\taSyncFunction('self.doPrintFiles.myInvoke','printerApplet.startNewDownload');\r\n    \t}\r\n    \t/*applet scaricata faccio iniziare il download dei documenti*/\r\n    \telse\r\n    \t{\r\n            if( !$(\".document-iframe\").hasClass(\"hiddenForWindow\"))\r\n                      $(\".document-iframe\").addClass(\"hiddenForWindow\");\r\n    \t\t//g.pageRef.closeWaiting();\r\n    \t\t//printerApplet.status = document.getElementById('downloadProgress');\r\n    \t\tprinterApplet.startNewDownload(selectedDocuments,addInfo,mode,dest,pages);\r\n            //var effect = new Fx.Style($('cOperations'),'opacity');\r\n            //effect.start(0,100);\r\n    \t\tprinterApplet.hideManager = function(){\r\n/*                if($(\"#iprDownloader\").size()>0) {\r\n                    $(\"#iprDownloader\").data(\"kendoWindow\").close();\r\n                }*/\r\n                self.clearTimeout(printerApplet.timeoutHide);\r\n                $(\"#printApplet\").remove();\r\n                printerApplet = null;\r\n            };\r\n    \t}\r\n    }\r\n\r\n    var waitAndPrintFiles = _waitAndPrintFiles;\r\n    function _waitAndPrintFiles(selectedDocuments, addInfo, mode, dest, pages)\r\n    {\r\n        self.doPrintFiles2 = new GeneralInvoke(_printFiles);\r\n        var prm = new Array();\r\n        prm[0] = selectedDocuments;\r\n        prm[1] = addInfo;\r\n        prm[2] = mode;\r\n        prm[3] = dest;\r\n        prm[4] = pages;\r\n        self.doPrintFiles2.setParams(prm);\r\n        aSyncFunction('self.doPrintFiles2.myInvoke','printEnded');\r\n    }\r\n</script>\r\n\r\n        \r\n\r\n        <iframe id=\"downloadFrame\" name=\"downloadFrame\" height=\"0\" style=\"display: none;\"></iframe>\r\n        <script type=\"text/javascript\" src=\"/adiJed/js/ui/notification.js\"></script>\r\n        \r\n\r\n\r\n\r\n\r\n\r\n<script type=\"text/javascript\">\r\nfunction checkSessionLifeAndNotifies()\r\n{\r\n    var url = '/adiJed/system/checkNotifies?uid=1234';\r\n    var jqxhr = $.ajax({\r\n        type: \"GET\", url: url, dataType: 'json'\r\n    }).done(function(result){\r\n        var nextCheckID     = setTimeout(checkSessionLifeAndNotifies, 5 * 1000);\r\n        var sessionStatus   = jqxhr.getResponseHeader('adijed-session-status');\r\n        if( typeof loggingOut !== \"undefined\" && loggingOut ) {\r\n            clearTimeout(nextCheckID);\r\n        } else {\r\n            if(sessionStatus && sessionStatus == 'expired')\r\n            {\r\n                clearTimeout(nextCheckID);\r\n                if(typeof loadRightAppTimeoutID !== 'undefined') clearTimeout(loadRightAppTimeoutID);\r\n                HistoryManager.cancelConfirmBeforeProceed();\r\n\t\t\t\ttry { $.modal.close(); } catch(e) {}\r\n                DialogManager.showAlert(\"La tua sessione è scaduta per inattività<br\\/>Effettua nuovamente il login.\", doLogout);\r\n            }\r\n            else\r\n            {\r\n                var checkNotifiesResult = result['unreadMessages'];\r\n                var action              = result['action'];\r\n                var message             = result['message'];\r\n                var userMessages        = result['userMessages'];\r\n                var theresAnError       = checkNotifiesResult < 0;\r\n\r\n                if(!theresAnError && !checkNotifiesResult > 0)\r\n                {\r\n                }\r\n                else if(theresAnError)\r\n                {\r\n                    clearTimeout(nextCheckID);\r\n                    if(typeof loadRightAppTimeoutID !== 'undefined') clearTimeout(loadRightAppTimeoutID);\r\n                    switch(checkNotifiesResult)\r\n                    {\r\n                        case -100:\r\n                                DialogManager.showAlert(\"Sei stato scollegato da Adiuto, ricollegati.\", doLogout);\r\n                                break;\r\n                        default:\r\n\t\t\t\t\t\t\t\ttry { $.modal.close(); } catch(e) {}\r\n                                DialogManager.showAlert(\"La tua sessione è scaduta per inattività<br\\/>Effettua nuovamente il login.\", doLogout);\r\n                                break;\r\n                    }\r\n                }\r\n\r\n                if(!theresAnError)\r\n                {\r\n                    switch(action)\r\n                    {\r\n                        case -98:\r\n                                DialogManager.showAlert(\r\n                                    \"Tra un minuto verrai scollegato dal server per manutenzione. Terminare l\\x27attività corrente!\", null, \"Messaggio da Adiuto Admin\"\r\n                                );\r\n                                break;\r\n                        case -97:\r\n                                if(message && message != '')\r\n                                    DialogManager.showAlert(message, null, \"Messaggio da Adiuto Admin\");\r\n                                break;\r\n                        default:\r\n                                break;\r\n                    }\r\n\r\n                    for (let i = 0; i < userMessages.length; i++) {\r\n                        const userMessage = userMessages[i];\r\n                        if(userMessage!=null){\r\n                            switch (userMessage.type) {\r\n                                case 0://simple view\r\n                                    showMessage(userMessage.message, \"alert\", null, 6000);\r\n                                    break;\r\n                                case 1://link message\r\n                                        showMessage(userMessage.message+ \"<BR>\"+\"<a href=\\\"\"+userMessage.link+\"\\\" target=\\\"_blank\\\">\"+userMessage.linkMessage+\"</a>\", \"alert\", null, 60000);\r\n                                    break;\r\n                                case 2://download link message\r\n                                    let _message = '<div style=\" display: inline-block;white-space: nowrap;\" class=\"downloadable\" onclick=\"downloadThis(\\''+userMessage.link+'\\')\">' +\r\n                                        userMessage.message+'<BR>'+\r\n                                        '<span class=\"icon file-icon\" style=\"background:url(\\'/adiJed/getDocumentIcon?fileName='+userMessage.fileName+'\\') no-repeat center\"></span>'+\r\n                                        userMessage.linkMessage+'</div>';\r\n                                    showMessage(_message, \"alert\", null, 60000);\r\n                                    break;\r\n                            }\r\n                        }\r\n                    }\r\n                }\r\n            }\r\n        }\r\n    });\r\n}\r\n\r\nfunction checkOKTASessionLife()\r\n{\r\n    var nextCheckID = -1;\r\n\r\n    var baseUrl = '';\r\n    $.ajax({\r\n        //url: baseUrl + '/api/v1/sessions/me',\r\n        url: baseUrl + '/api/v1/sessions/me/lifecycle/refresh',\r\n        type: 'POST',\r\n        xhrFields: { withCredentials: true },\r\n        accept: 'application/json'\r\n    }).done(function(data) {\r\n        //alert(JSON.stringify(data));\r\n        var tokenCheckInterval = parseInt('');\r\n        if(!isNaN(tokenCheckInterval)) {\r\n            nextCheckID = setTimeout( checkOKTASessionLife, Math.max(tokenCheckInterval, 5000) );\r\n        }\r\n    })\r\n\t.fail(function(xhr, textStatus, error) {\r\n\t\tclearTimeout(nextCheckID);\r\n\t\tif(xhr.status == 404){\r\n\t\t\tHistoryManager.cancelConfirmBeforeProceed();\r\n\t\t\ttry { $.modal.close(); } catch(e) {}\r\n\t\t\tDialogManager.showAlert(\"La tua sessione è scaduta per inattività<br\\/>Effettua nuovamente il login.\", doLogout);\r\n\t\t}\r\n\t});\r\n}\r\n</script>\r\n        <script type=\"text/javascript\" defer=\"true\">\r\n            var listOfValuesLocked = '[{\"listId\":0,\"lock\":false},{\"listId\":1,\"lock\":false},{\"listId\":1001,\"lock\":false},{\"listId\":1002,\"lock\":false},{\"listId\":1003,\"lock\":false},{\"listId\":1004,\"lock\":false},{\"listId\":1005,\"lock\":false},{\"listId\":1006,\"lock\":false},{\"listId\":1007,\"lock\":false},{\"listId\":1008,\"lock\":false},{\"listId\":1009,\"lock\":false},{\"listId\":1010,\"lock\":false},{\"listId\":1011,\"lock\":false},{\"listId\":1012,\"lock\":false},{\"listId\":1013,\"lock\":false},{\"listId\":1014,\"lock\":false},{\"listId\":1015,\"lock\":false},{\"listId\":1016,\"lock\":false},{\"listId\":1017,\"lock\":false},{\"listId\":1018,\"lock\":false},{\"listId\":1019,\"lock\":false},{\"listId\":1020,\"lock\":false},{\"listId\":1021,\"lock\":false},{\"listId\":1022,\"lock\":false},{\"listId\":1023,\"lock\":false},{\"listId\":1024,\"lock\":false},{\"listId\":1025,\"lock\":false},{\"listId\":1026,\"lock\":false},{\"listId\":1027,\"lock\":false},{\"listId\":1028,\"lock\":false},{\"listId\":1029,\"lock\":false},{\"listId\":1030,\"lock\":false},{\"listId\":1031,\"lock\":false},{\"listId\":1032,\"lock\":false},{\"listId\":1033,\"lock\":false},{\"listId\":1034,\"lock\":false},{\"listId\":1035,\"lock\":false},{\"listId\":1036,\"lock\":false},{\"listId\":1037,\"lock\":false},{\"listId\":1038,\"lock\":false},{\"listId\":1039,\"lock\":false},{\"listId\":1040,\"lock\":false},{\"listId\":1041,\"lock\":false},{\"listId\":1042,\"lock\":false},{\"listId\":1043,\"lock\":false},{\"listId\":1044,\"lock\":false},{\"listId\":1045,\"lock\":false},{\"listId\":1046,\"lock\":false},{\"listId\":1047,\"lock\":false},{\"listId\":1048,\"lock\":false},{\"listId\":1049,\"lock\":false},{\"listId\":1050,\"lock\":false},{\"listId\":1051,\"lock\":false},{\"listId\":1052,\"lock\":false},{\"listId\":1053,\"lock\":false},{\"listId\":1054,\"lock\":false},{\"listId\":1055,\"lock\":false},{\"listId\":1056,\"lock\":false},{\"listId\":1057,\"lock\":false},{\"listId\":1058,\"lock\":false},{\"listId\":1059,\"lock\":false},{\"listId\":1060,\"lock\":false},{\"listId\":1061,\"lock\":false},{\"listId\":1062,\"lock\":false},{\"listId\":1063,\"lock\":false},{\"listId\":1064,\"lock\":false},{\"listId\":1065,\"lock\":false}]'=='true';\r\n            adiutoTopWin.isMainContainer = true;\r\n            var loggingOut = false;\r\n            \r\n\r\n            function doLogout()\r\n            {\r\n                loggingOut = true;\r\n                AdiutoUserSettings.save(\"view-document-sequence\", false);\r\n                $(\"body\").fadeOut();\r\n                showWaitDialog();\r\n                document.location.replace('/adiJed/ui/logout.do');\r\n            }\r\n\r\n            /**\r\n            * l'id della setTimeout per mostrare il menu di destra quando ci si ferma sopra per un certo periodo con il mouse\r\n            * @type {number}\r\n            * @private\r\n             */\r\n            var _trmh = -1;\r\n            /**\r\n            * Il timeout prima di aprire il menu di destra restandoci sopra con il mouse\r\n            * @type {number}\r\n             */\r\n            var MENU_HOVER_TIMEOUT = 600;\r\n\r\n            function updateDivisionChoiceInfo(idDivisione){\r\n                var currentChoiceInfo = trainingDivisions[idDivisione];\r\n\r\n                if(currentChoiceInfo && currentChoiceInfo!=null){\r\n                    AdiutoUserSettings.save(\"division-choice\", JSON.stringify(currentChoiceInfo));\r\n                }\r\n\r\n                return currentChoiceInfo;\r\n            }\r\n\r\n            function init()\r\n            {\r\n                AdiutoUserSettings.restoreUserSettings(1234).then(initRightAppContainer);\r\n\r\n                $(\".logout-action-button\").confirmedClick(doLogout);\r\n\r\n                $(\"#home\").click(function(){\r\n                    HistoryManager.navigateTo(\"/\");\r\n                });\r\n                $(\"#new\").click(function() {\r\n                    HistoryManager.navigateTo(\"/new/\");\r\n                });\r\n                $(\"#query\").click(function() {\r\n                    HistoryManager.navigateTo(\"/query/\");\r\n                });\r\n                $(\"#tutor\").click(function() {\r\n                    HistoryManager.navigateTo(\"/tutor/\");\r\n                });\r\n                $(\"#tracking\").click(function() {\r\n                    HistoryManager.navigateTo(\"/tracking/\");\r\n                });\r\n                var fWorkflow = function(){\r\n                    HistoryManager.navigateTo(\"/wf/\");\r\n                };\r\n                $(\"#workflow\").click(fWorkflow);\r\n\r\n                var fMessages = function(){\r\n                    HistoryManager.navigateTo(\"/messages/\");\r\n                };\r\n                var fWebAdmin = function(){\r\n                    location = '/adiJed/admin.web-admin.do';\r\n                };\r\n                $(\"#messages\").click(fMessages);\r\n\r\n                $(\"#webadmin\").click(fWebAdmin);\r\n\r\n                $(\"#training\").confirmedClick(function(){\r\n                    HistoryManager.navigateTo(\"/training/\");\r\n                    if('0' > '0'){\r\n                        if('0' == '1'){\r\n                            loadTraining({\"idDivisione\":\"\" ,\r\n                                \"nomeDivisione\":\"\",\r\n                                \"needSign\":\"\",\r\n                                \"idListaCommentoFirma\":\"\",\r\n                                \"giorniDecadimento\":\"\"});\r\n                        }else{\r\n                            var choiceInfo = JSON.parse(AdiutoUserSettings.load(\"division-choice\",\"{}\"));\r\n                            if(choiceInfo.idDivisione && choiceInfo.idDivisione>=1000){\r\n                                //Se era giÃ  stata selezionata una divisione,\r\n                                // aggiorno le info altrimenti non verrebbero piÃ¹ aggiornate fino al cambio divisione\r\n                                choiceInfo = updateDivisionChoiceInfo(choiceInfo.idDivisione);\r\n                                loadTraining(choiceInfo);\r\n                            }\r\n                            else{\r\n                                showTrainingDivisonsChoice();\r\n                            }\r\n\r\n                        }\r\n                    }else{\r\n                        DialogManager.showAlert(\"Nessuna divisione associata all\\x27utente.\",null);    \r\n                    }\r\n                });\r\n\r\n                var timeoutChannelNotifies = null;\r\n                $(\"#channel\").mouseover(function() {\r\n                    if(timeoutChannelNotifies!=null){\r\n                        clearInterval(timeoutChannelNotifies);\r\n                        timeoutChannelNotifies = null;\r\n                    }else{\r\n                        var position = $(\"#channel\").offset();\r\n                        position.top+=28;\r\n                        //position.left+=10;\r\n                        $(\"#channelNotifiesContainer\").css(position);\r\n                        $(\"#channelNotifiesContainer\").removeClass(\"hiddenElement\");\r\n                    }\r\n                });\r\n\r\n                $(\"#channel\").mouseout(function() {\r\n                    timeoutChannelNotifies = setTimeout(function(){\r\n                        $(\"#channelNotifiesContainer\").addClass(\"hiddenElement\");\r\n                        timeoutChannelNotifies = null;\r\n                    }, 30);\r\n                });\r\n\r\n                $(\"#channelNotifiesContainer\").mouseover(function() {\r\n                    clearInterval(timeoutChannelNotifies);\r\n                    timeoutChannelNotifies = null;\r\n                });\r\n\r\n                $(\"#channelNotifiesContainer\").mouseout(function() {\r\n                    timeoutChannelNotifies = setTimeout(function(){\r\n                        $(\"#channelNotifiesContainer\").addClass(\"hiddenElement\");\r\n                        timeoutChannelNotifies = null;\r\n                    }, 30);\r\n                });\r\n\r\n                $(\"#testOKTA\").click(function(){\r\n                    var baseUrl = 'https://dev-637056.oktapreview.com';\r\n                    $.ajax({\r\n                        url: baseUrl + '/api/v1/users/me',\r\n                        type: 'GET',\r\n                        xhrFields: { withCredentials: true },\r\n                        accept: 'application/json'\r\n                    }).done(function(data) {\r\n                        alert(JSON.stringify(data));\r\n                    })\r\n                            .fail(function(xhr, textStatus, error) {\r\n                                var title, message;\r\n                                switch (xhr.status) {\r\n                                    case 403 :\r\n                                        title = xhr.responseJSON.errorSummary;\r\n                                        message = 'Please login to your Okta organization before running the test';\r\n                                        break;\r\n                                    default :\r\n                                        title = 'Invalid URL or Cross-Origin Request Blocked';\r\n                                        message = 'You must explicitly add this site (' + window.location.origin + ') to the list of allowed websites in your administrator UI';\r\n                                        break;\r\n                                }\r\n                                alert(title + ': ' + message);\r\n                            });\r\n                });\r\n\r\n\r\n                $(\"#channel\").click(function(){\r\n                    HistoryManager.navigateTo(\"/channel/\");\r\n                });\r\n\r\n                $(\"#channelNotifiesContainer\").on(\"click\", \".channelNotify\", function(event) {\r\n                    //event.stopPropagation();\r\n                    HistoryManager.navigateTo(\"/channel/\");\r\n                    var channelId = $(this).attr(\"channelid\");\r\n                    var channelTitle = $(this).attr(\"channelTitle\");\r\n                    var channelType = $(this).attr(\"channelType\");\r\n                    showChannels(channelId,channelTitle,channelType);\r\n                });\r\n\r\n                $(\"#form-change-password\").submit(function() {\r\n                    if(!$(this).attr(\"isSubmittingData\"))\r\n                    {\r\n                        var _form = $(this);\r\n                        _form.attr(\"isSubmittingData\",true);\r\n                        var qs = _form.serialize();\r\n                        $.ajax({\r\n                            type: \"POST\",\r\n                            url: \"/adiJed/ui/change-password.do\",\r\n                            dataType: 'json',\r\n                            data: qs\r\n                        }).done(function(result){\r\n                            _form.removeAttr(\"isSubmittingData\");\r\n                            if(result.ok)\r\n                            {\r\n                                $.modal.close();\r\n\r\n                                if(typeof result.message != 'undefined')\r\n                                    showInfoMessage(result.message);\r\n                            }\r\n                            else if(result.error)\r\n                            {\r\n                                showMessage(result.message, \"error\", \"topCenter\", 5000, false, true);\r\n                                var passwordType = $(\"#passwordType\").val();\r\n                                $(\"#form-change-password\")[0].reset();\r\n                                $(\"#passwordType\").val(passwordType);\r\n                                $(\"#pwd-chg-old-pwd\").focus();\r\n                            }\r\n                        });\r\n                    }\r\n                    return false;\r\n                });\r\n\r\n                $(\"#doClosePwdDialog\").click(function(){\r\n                    $.modal.close();\r\n                });\r\n\r\n                $(\"#adijedVersion\").text(\"6.7.2.20250507.P6\");\r\n                \r\n                \r\n                $(\"#customerName\").text(\"TMGR-AIHO-MBSO-TFTG\");\r\n\r\n                var flipDurationMillis = 1000;\r\n                var effect = kendo.fx(\"#bd\").flipHorizontal($(\"#main-container\"), $(\"#aboutAdiuto\")).duration(flipDurationMillis),\r\n                    reverse = false;\r\n\r\n                $(\".infoAdiuto\").click(function() {\r\n                    effect.stop();\r\n                    reverse ? effect.reverse() : effect.play();\r\n                    reverse = !reverse;\r\n                    if(!reverse) {\r\n                        $(\"#aboutAdiuto\").css(\"transform\",\"rotateY(-180deg) !important\");\r\n                        $(\"#main-container\").css(\"transform\",\"rotateY(0deg) !important\");\r\n                    } else {\r\n                        $(\"#aboutAdiuto\").css(\"transform\",\"rotateY(0deg) !important\");\r\n                        $(\"#main-container\").css(\"transform\",\"rotateY(-180deg) !important\");\r\n                    }\r\n                });\r\n\r\n                $(\"#aboutAdiuto\").click(function() {\r\n                    effect.stop();\r\n                    reverse ? effect.reverse() : effect.play();\r\n                    reverse = !reverse;\r\n                    setTimeout((function(){\r\n                        if(!reverse) {\r\n                            $(\"#aboutAdiuto\").css(\"transform\",\"rotateY(-180deg) !important\");\r\n                            $(\"#main-container\").css(\"transform\",\"rotateY(0deg) !important\");\r\n                        } else {\r\n                            $(\"#aboutAdiuto\").css(\"transform\",\"rotateY(0deg) !important\");\r\n                            $(\"#main-container\").css(\"transform\",\"rotateY(-180deg) !important\");\r\n                        }\r\n                    }), flipDurationMillis);\r\n                });\r\n\r\n                $(\"#switchCompany\").click(function() {\r\n                    showCompaniesChoice();\r\n                });\r\n\r\n                if($(\"#channel\").length>0)\r\n                    checkChannels();\r\n\r\n                // setto l'opacity per evitare che si veda il cambiamento di stile all'apertura\r\n                setTimeout( function() {$(\"#bd\").css('opacity',1) }, 500 );\r\n            }\r\n\r\n            function initRightAppContainer() {\r\n                var savedRightAppView = AdiutoUserSettings.load(\"rightAppView\", false);\r\n                if(savedRightAppView) {\r\n                    if(savedRightAppView == \"pinned\" && !$(\"#bd\").hasClass(\"small\") && !$(\"#bd\").hasClass(\"w1024\")) {\r\n                        $(\"#right-app-container\").addClass(\"pinned\");\r\n                        $(\"body#bd\").addClass(\"pinned-right-container\");\r\n                    } else {\r\n                        $(\"#right-app-container\").removeClass(\"pinned\");\r\n                        $(\"body#bd\").removeClass(\"pinned-right-container\");\r\n                    }\r\n                }\r\n                // carico il menu a dx con gli iter ecc.ecc.\r\n                loadRightApp(true);\r\n                $(\"#pin-right-app-container\").click(function(){\r\n                    $(\"#right-app-container\").toggleClass(\"pinned\");\r\n                    $(\"body#bd\").toggleClass(\"pinned-right-container\");\r\n                    var ra_status = $(\"#right-app-container\").hasClass(\"pinned\") ? \"pinned\" : \"floating\";\r\n                    AdiutoUserSettings.save(\"rightAppView\",ra_status);\r\n                });\r\n                $(\"#right-app-container\").hover(\r\n                    function(){\r\n                        if(!$(this).hasClass(\"pinned\")) {\r\n                            var $this = $(this);\r\n                            if(_trmh == -1) {\r\n                                _trmh = setTimeout(function(){\r\n                                    $this.removeClass(\"cc\");\r\n                                    _trmh = -1;\r\n                                }, MENU_HOVER_TIMEOUT);\r\n                            }\r\n                        }\r\n                    },\r\n                    function(){\r\n                        if(!$(this).hasClass(\"pinned\")) {\r\n                            var $this = $(this);\r\n                            if(_trmh != -1) {\r\n                                clearTimeout(_trmh);\r\n                                _trmh = -1;\r\n                            } else {\r\n                                $this.addClass(\"cc\");\r\n                            }\r\n                        }\r\n                    }\r\n                );\r\n            }\r\n\r\n            loadRightApp();\r\n\r\n/*            var loadRightAppTimeoutID = -1;\r\n            function loadRightApp(loadView){\r\n\r\n                if(loadRightAppTimeoutID != -1)\r\n                    clearTimeout(loadRightAppTimeoutID);\r\n\r\n                $.ajax({url: \"/adiJed/ui/system/right-app-content.do\", data: \"view=\"+(loadView||\"false\"),\r\n                    success: function(html) {\r\n                        var refreshFunction = function(){ loadRightAppTimeoutID = setTimeout(loadRightApp, 15000);};\r\n                        $(\"#right-app-content\").html(html);\r\n                        $(\".worflow-right-app\").hover(\r\n                            function(){ if(loadRightAppTimeoutID != -1) clearTimeout(loadRightAppTimeoutID); },\r\n                            refreshFunction\r\n                        );\r\n                        refreshFunction.call();\r\n                    }\r\n                });\r\n            }*/\r\n\r\n            var checkChannelsTimeoutID = -1;\r\n            function checkChannels(){\r\n                if(checkChannelsTimeoutID != -1)\r\n                    clearTimeout(checkChannelsTimeoutID);\r\n\r\n                var postData = \"action=getUnreadNotifyMsg\";\r\n                $.ajax({url: \"/adiJed/ui/system/channels.channels.do\", data: postData, dataType: 'json',\r\n                    success: function(result) {\r\n                        $(\"#channelNotifiesBody\").html(\"\");\r\n                        var chatMessages = result['chatMessages'];\r\n                        var messagesCount = result['messagesCount'];\r\n                        if(chatMessages && chatMessages.length>0){\r\n                            for (var i = 0; i < chatMessages.length; i++) {\r\n                                var chatMessage = chatMessages[i];\r\n                                var messageTemplate = kendo.template($(\"#channelNotifyTemplate\").html());\r\n                                var result = messageTemplate(chatMessage);\r\n                                $(result.replace(/\\n/g, '').trim()).appendTo(\"#channelNotifiesBody\");\r\n                            }\r\n\r\n                        }else{\r\n                            $(\"<div>\").addClass(\"channelNotify\").html(\"Nessuna Notifica!\").appendTo(\"#channelNotifiesBody\");\r\n                        }\r\n                        if(messagesCount==0){\r\n                            $(\"#channel .bullet-indicator\").remove();\r\n                        }else{\r\n                            if($(\"#channel .bullet-indicator\").length == 0){\r\n                                $(\"<span>\").addClass(\"bullet-indicator\").css(\"right\", \"1px\").text(messagesCount).appendTo($(\"#channel > span\"));\r\n                            }else{\r\n                                $($(\"#channel .bullet-indicator\")[0]).text(messagesCount);\r\n                            }\r\n                        }\r\n\r\n\r\n                        var refreshFunction = function(){ checkChannelsTimeoutID = setTimeout(checkChannels, 15000);};\r\n\r\n\r\n                        refreshFunction.call();\r\n                    }\r\n                });\r\n            }\r\n\r\n            function showTrainingDivisonsChoice()\r\n            {\r\n                $(\".train-division-choice\").unbind(\"click\").bind(\"click\", function(){\r\n                    var chosenNextActionID = $(this).attr(\"nextActionID\");\r\n                    var needSign = $(this).attr(\"needSign\");\r\n                    var idListaCommentoFirma = $(this).attr(\"idListaCommentoFirma\");\r\n                    var giorniDecadimento = $(this).attr(\"giorniDecadimento\");\r\n                    var chosenLabel = $(this).text();\r\n                    $.modal.close();\r\n                    var choiceInfo = { \"idDivisione\":chosenNextActionID, \"nomeDivisione\":chosenLabel, \"needSign\":needSign, \"idListaCommentoFirma\":idListaCommentoFirma, \"giorniDecadimento\":giorniDecadimento };\r\n                    AdiutoUserSettings.save(\"division-choice\", JSON.stringify(choiceInfo));\r\n                    loadTraining(choiceInfo);\r\n                });\r\n                    $(\"#train-divisions-choice-list-container\").modal({\r\n                        overlayClose:true,\r\n                        opacity:65,\r\n                        overlayCss: {backgroundColor:\"#F8F8F8\"}\r\n                    });\r\n            }\r\n\r\n            function showCompaniesChoice()\r\n            {\r\n                $(\".company-choice\").unbind(\"click\").bind(\"click\", function(){\r\n                    var chosenNextActionID = $(this).attr(\"nextActionID\");\r\n                    var chosenLabel = $(this).text();\r\n                    $.modal.close();\r\n                    var choiceInfo = { \"companyId\":chosenNextActionID };\r\n//                    AdiutoUserSettings.save(\"company-choice\", JSON.stringify(choiceInfo));\r\n                    changeCompany(chosenNextActionID);\r\n                });\r\n                $(\"#company-choice-list-container\").modal({\r\n                    overlayClose:true,\r\n                    opacity:65,\r\n                    overlayCss: {backgroundColor:\"#F8F8F8\"}\r\n                });\r\n            }\r\n\r\n            var _log = function(message) {};\r\n            var resizeTimeout = null;\r\n            window.onresize = function()\r\n            {\r\n                clearTimeout(resizeTimeout);\r\n                resizeTimeout = setTimeout(fitToScreen, 50);\r\n            };\r\n            function destroySession()\r\n            {\r\n                $.ajax({ type: \"POST\", url: \"/adiJed/ui/logout.do\", dataType: 'json' })\r\n            }\r\n\r\n            $(document).ready(function(){\r\n                (function(){\r\n                    if (top.app_inited)\r\n                            return;\r\n                    top.app_inited = true;\r\n                    //checkIsDebug();\r\n                    //checkIsIntro();\r\n                    checkKey();\r\n                    fitToScreen(1234, 'false');\r\n                    checkSessionLifeAndNotifies();\r\n\r\n                    if('' !='')\r\n                        checkOKTASessionLife();\r\n\r\n                    //initVoiceCommands();\r\n                    $(document).bind(\"contextmenu\", function(e){return false; });\r\n                    Logger.log('Utente collegato: mmalvicini FIUS=1234'); //TODO Multilingua\r\n                    init();\r\n                })();\r\n                if (false){\r\n                    documentLocation(\"/adiJed/ui/touch.home.do\");\r\n                } else if (false){\r\n                    var somewhereHistoryKey = getUniqueID();\r\n                    app.get('#/somewhere/', function() {\r\n                        if($(\".toolbar-button-selected\")) $(\".toolbar-button-selected\").removeClass(\"toolbar-button-selected\");\r\n                        $(\"#workflow\").addClass(\"toolbar-button-selected\");\r\n                        if( !HistoryManager.loadPage() ) {\r\n                            saveHistoryAndDisplayPage('/somewhere/?' + somewhereHistoryKey, \"\", \"\", true, false, HistoryConstants.REPLACE_CURRENT_HISTORY);\r\n                        }\r\n                    });\r\n                    \r\n                    location.hash = \"#/somewhere/?\" + somewhereHistoryKey;\r\n                    app.run(location.hash);\r\n                } else{\r\n                    app.run('#/');\r\n                }\r\n                \r\n                \r\n            });\r\n            function initVoiceCommands()\r\n            {\r\n                try {\r\n                    var voix = new Voix('it-IT'); //TODO Multilingua\r\n\r\n                    voix.setCommand('ricerca', function() {\r\n                    loadQuery(null);\r\n                    }).setCommand('back', function() {\r\n                    HistoryManager.reloadLastPage();\r\n                    }).setCommand('indietro', function() {\r\n                    HistoryManager.reloadLastPage();\r\n                    }).setCommand('ok adiuto', function() {\r\n                    showInfoMessage(\"Ciao mmalvicini\");\r\n                    });\r\n                    voix.start();\r\n                } catch (e) {\r\n                    Logger.error(e);\r\n                }\r\n            }\r\n\r\n            function hideRightApp(event)\r\n            {\r\n                if (event) {\r\n                    try {\r\n                        event.preventDefault();\r\n                        event.stopPropagation();\r\n                    } catch (e) {\r\n                    }\r\n                }\r\n                if ($(\"#application-top-bar\").hasClass(\"swiped\"))\r\n                {\r\n                    $(\"#main-container\").css('-webkit-transform', 'none');\r\n                    $(\"#application-top-bar\").css('width', '70px');\r\n                    $(\"#swipe-fog\").remove();\r\n                    $(\"#application-top-bar\").removeClass(\"swiped\");\r\n                    $(\"#right-app-container\").css(\"padding-left\", \"0\").css(\"width\", \"0\");\r\n                    $(\"#main-container\").css(\"right\", \"0\");\r\n                }\r\n            }\r\n            function showRightApp(event)\r\n            {\r\n                if (event)\r\n                    event.preventDefault();\r\n                \r\n                if (!$(\"#application-top-bar\").hasClass(\"swiped\"))\r\n                {\r\n                    $(\"#application-top-bar\").addClass(\"swiped\");\r\n                    $(\"#main-container\").css(\"right\", \"0\").css('-webkit-transform', 'translate(-300px, 0)');\r\n                    $(\"<div></div>\").attr(\"id\", \"swipe-fog\")\r\n                            .css('display', 'block')\r\n                            .css('height', '100%')\r\n                            .css('left', '0')\r\n                            .css('width', '100%')\r\n                            .css('right', '0')\r\n                            .css('background-color', '#000')\r\n                            .css('opacity', '.5')\r\n                            .css('z-index', '999')\r\n                            .css('position', 'absolute')\r\n                            .appendTo($(\"#main-container\"));\r\n                    $(\"#right-app-container\").css(\"display\", \"block\").css(\"width\", \"295px\").css(\"padding-left\", \"5px\");\r\n                    if($(\"#bd.tablet\")[0])\r\n                    {\r\n                        $(\"#swipe-fog\").hammer().on(\"touchmove\", hideRightApp);\r\n                        $(\"#extra-options\").hammer().on(\"swiperight\", hideRightApp);\r\n                        $(\"#swipe-fog\").hammer().on(\"swiperight\", hideRightApp);\r\n                        $(\"#swipe-fog\").hammer().on(\"tap\", hideRightApp);\r\n                    }\r\n                }\r\n            }\r\n\r\n            function showOptions(event)\r\n            {\r\n                if (event)\r\n                    event.preventDefault();\r\n                \r\n                if (!$(\"#application-top-bar\").hasClass(\"swiped\"))\r\n                {\r\n                    $(\"#application-top-bar\").addClass(\"swiped\");\r\n                    $(\"#application-top-bar\").css('width', '475px');\r\n                    $(\"#main-container\").css('-webkit-transform', 'translate(400px, 0)');\r\n                    $(\"<div></div>\").attr(\"id\", \"swipe-fog\")\r\n                            .css('display', 'block')\r\n                            .css('height', '100%')\r\n                            .css('width', '100%')\r\n                            .css('background-color', '#000')\r\n                            .css('opacity', '.5')\r\n                            .css('z-index', '999')\r\n                            .css('position', 'relative')\r\n                            .appendTo($(\"#main-container\"));\r\n                    \r\n                    setTimeout(function() {\r\n                        $(\"#extra-options\").css('display', 'inline-block');\r\n                        $(\"#extra-options\").css('opacity', '1');\r\n                    }, 300);\r\n                    \r\n                    if($(\"#bd.tablet\")[0])\r\n                    {\r\n                        $(\"#swipe-fog\").hammer().on(\"touchmove\", hideOptions);\r\n                        $(\"#swipe-fog\").hammer().on(\"tap\", hideOptions);\r\n                        $(\"#extra-options\").hammer().on(\"swipeleft\", hideOptions);\r\n                    }\r\n                }\r\n            }\r\n            function hideOptions(event)\r\n            {\r\n                if (event) {\r\n                    try {\r\n                        event.preventDefault();\r\n                        event.stopPropagation();\r\n                    } catch (e) {\r\n                    }\r\n                }\r\n                if ($(\"#application-top-bar\").hasClass(\"swiped\"))\r\n                {\r\n                    $(\"#main-container\").css('-webkit-transform', 'none');\r\n                    $(\"#application-top-bar\").css('width', '70px');\r\n                    $(\"#swipe-fog\").remove();\r\n                    $(\"#extra-options\").css('display', 'none');\r\n                    $(\"#extra-options\").css('opacity', '0');\r\n                    setTimeout(function() { $(\"#application-top-bar\").removeClass(\"swiped\"); }, 250);\r\n                }\r\n            }\r\n\r\n            $('body#bd').bind(\"touchmove\", {}, function(event){\r\n                event.preventDefault();\r\n            });\r\n        </script>\r\n        <div id=\"company-choice-list-container\" class=\"adi-modal-dialog-container\">\r\n            <div id=\"company-choice-list\">\r\n                <div class=\"adi-modal-title\">Seleziona una società</div>       \r\n                <div>\r\n                    <ul>\r\n                        \r\n                            \r\n                        \r\n                    </ul>\r\n                </div>\r\n            </div>\r\n        </div>\r\n\r\n        \r\n    </body>\r\n</html>\r\n\r\n"
