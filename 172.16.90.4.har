            "text": "\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n<div id=\"content\" class=\"homepage resolution-adapt\">\r\n    <div id=\"pinned-documents\">\r\n        \r\n\r\n\r\n\r\n\r\n\r\n        <div onclick=\"changeWindowLocation('SELF', '/adiJed/touch.home.do');return false;\" class=\"pinned-doc touch\" style=\"background-color: white; background-image: url('/adiJed/img/logo/Adiuto_Touch_2.png'); background-repeat: no-repeat; background-position: bottom 10px center; background-size: 96px; display: none;top: 0;color: black;font-size: 16pt;opacity: 1;font-weight: bold;text-align: center;padding-top: 10px;padding-left: 4px;padding-right: 4px;box-sizing: border-box;\">Adiuto<br/>Touch</div>\r\n        \r\n        \r\n            \r\n            <div id=\"lastOpenedFolder\" class=\"pinned-doc folder folderLocked\" folderid=\"-1\">\r\n                <span class=\"folder-title uppercase\">Ultimi documenti aperti</span>\r\n            </div>\r\n        \r\n        \r\n        \r\n        \r\n        \r\n\r\n        \r\n            \r\n\r\n            <div class=\"pinned-doc-inner\" docid=\"717627\" id=\"lastOpenedInnerdoc717627\" style=\"background-size: 22px; background: #fff url('/adiJed/getDocumentIcon?fileName=TUNI032.PDF') no-repeat right 5px top 3px;\">\r\n                \r\n                <div class=\"pinned-doc-family\" style=\"font-weight: bold; padding-right: 18px;\">01. Ufficio Tecnico - Disegni</div>\r\n                \r\n                    <div class=\"pinned-doc-data\"><span class=\"pinned-doc-col\">Stato Documento:</span> VALIDO</div>\r\n                \r\n                    <div class=\"pinned-doc-data\"><span class=\"pinned-doc-col\">Codice Disegno:</span> TUNI032</div>\r\n                \r\n                    <div class=\"pinned-doc-data\"><span class=\"pinned-doc-col\">Descrizione:</span> </div>\r\n                \r\n                    <div class=\"pinned-doc-data\"><span class=\"pinned-doc-col\">Apice / Revisione:<