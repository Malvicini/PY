            "mimeType": "text/html",
            "compression": -109,
            "text": "\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n<style type=\"text/css\">\r\nul#family-list, ul#family-list ul {\r\n    list-style: none;\r\n}\r\nul#family-list\r\n{\r\n    margin: 0;\r\n    padding-top: 6px;\r\n    padding-left: 6px;\r\n    padding-bottom: 100px;\r\n    position: absolute;\r\n    top: 0;\r\n    bottom: 0;\r\n    right: 0;\r\n    left: 0;\r\n    border-top: 1px #d3d3d3 solid;\r\n    border-right: 1px #d3d3d3 solid;\r\n    overflow-y: auto;\r\n}\r\n#bd.tablet ul#family-list {\r\n    padding-bottom: 150px;\r\n    overflow-y: visible;\r\n    height: 100%;\r\n    -webkit-overflow-scrolling: touch;\r\n}\r\nul#family-list li {\r\n    -webkit-transition: all .1s;\r\n    transition: all .1s;\r\n    vertical-align: middle;\r\n    border: 1px solid transparent;\r\n    color: #636363;\r\n    padding: 2px 5px;\r\n    font-style: normal;\r\n}\r\n#bd.tablet ul#family-list li {\r\n    padding-top: 5px;\r\n    padding-bottom: 5px;\r\n}\r\nul.group > label {\r\n    padding-top: 6px;\r\n}\r\nul#family-list li:hover, ul.group > label:hover {\r\n    cursor: pointer;\r\n}\r\nul#family-list li div.checker {\r\n    top: 2px;\r\n}\r\nul#family-list li div.checker span {\r\n    transition: opacity 1s;\r\n    -webkit-transition: opacity 1s;\r\n    opacity: .2;\r\n}\r\nul#family-list li div.checker span.checked, ul#family-list li div.checker span:hover, ul#family-list li:hover div.checker span {\r\n    opacity: 1;\r\n}\r\nul#family-list li label, ul#family-list ul label {\r\n    display: block;\r\n    padding-top: 2px;\r\n    padding-bottom: 2px;\r\n    margin: 0;\r\n}\r\nbody#bd.tablet ul#family-list li label, body#bd.tablet ul#family-list ul label {\r\n    padding-top: 5px;\r\n    padding-bottom: 4px;\r\n    display: inline-block;\r\n}\r\n#table-fields {\r\n    margin-top: 10px;\r\n}\r\ntr#fields-list td {\r\n    padding: 10px 5px;\r\n    text-align: left;\r\n    border-bottom: 1px solid #f5f5f5;\r\n    vertical-align: middle;\r\n}\r\ntr#fields-list td.fld-cell {\r\n    max-width: 100%;\r\n    width: 80%;\r\n    padding-left: 20px;\r\n    padding-right: 25px;\r\n    position: relative;\r\n}\r\ntr#fields-list td label {\r\n    text-align: right;\r\n    max-width: 360px;\r\n    min-width: 100px;\r\n    display: block;\r\n    white-space: nowrap;\r\n}\r\ntr#fields-list td input[type=text] {\r\n    width: 95%;\r\n}\r\nul#family-list li:hover label {\r\n    cursor: pointer;\r\n}\r\ntd.fld-lbl-cell {\r\n    max-width: 30%;\r\n    width: 15%;\r\n    padding-top: 11px !important;\r\n}\r\n#form-fields, #no-fields-message {\r\n    display: block;\r\n    position: absolute;\r\n    top: 41px;\r\n    bottom: 0;\r\n    left: 0;\r\n    right: 0;\r\n    overflow-y: auto;\r\n    overflow-x: hidden;\r\n    padding-left: 15px;\r\n    padding-right: 15px;\r\n    padding-bottom: 100px;\r\n}\r\n#bd.tablet #form-fields {\r\n    -webkit-overflow-scrolling: touch;\r\n}\r\n#bd.smaller #form-fields {\r\n    height: auto;\r\n    overflow-y: visible;\r\n}\r\n#form-fields select {\r\n}\r\n#back:before {\r\n    background: url(\"/adiJed/img/toolbar/back.png\") no-repeat center;\r\n}\r\n#do-search:before {\r\n    background: url(\"/adiJed/img/toolbar/query_white_22.png\") no-repeat center;\r\n}\r\n#do-search.button-disabled, #do-search.button-disabled-no-field {\r\n    opacity: .3 !important;\r\n}\r\n#filter2:before {\r\n    background: url(\"/adiJed/img/toolbar/wizard.png\") no-repeat center;\r\n}\r\n#vq-filter:before {\r\n    background: url(\"/adiJed/img/toolbar/wizfolder.png\") no-repeat center;\r\n}\r\n#load-saved-queries:before {\r\n    background: url(\"/adiJed/img/toolbar/open.png\") no-repeat center;\r\n}\r\n#clean-values:before {\r\n    background: url(\"/adiJed/img/toolbar/svuotaFiltri.png\") no-repeat center;\r\n}\r\n#showThumbnails:before {\r\n    background: url(\"/adiJed/img/toolbar/thumb_bw.png\") no-repeat center;\r\n}\r\n#showThumbnails.pressed:before {\r\n    background: url(\"/adiJed/img/toolbar/thumb.png\") no-repeat center;\r\n}\r\n#showThumbnails.pressed {\r\n    background-image: -webkit-linear-gradient(top, #c8c8c8,#c8c8c8);\r\n}\r\n#application-left-bar {\r\n    padding-top: 5px;\r\n    left: 0;\r\n    overflow: hidden;\r\n}\r\n#content {\r\n    left: 252px;\r\n    -webkit-box-shadow: 0 0 9px gray;\r\n    box-shadow: 0 0 9px gray;\r\n}\r\n#bd.tablet #content {\r\n    box-shadow: none;\r\n}\r\n#application-left-bar h4 {\r\n    font-size: 100%;\r\n}\r\n#application-left-bar h4 {\r\n    margin: 1px;\r\n}\r\n#application-left-bar span#unselect-all-families {\r\n    display: inline-block;\r\n    text-align: center;\r\n    width: 100%;\r\n}\r\n#bd.tablet #application-left-bar {\r\n    top: 41px;\r\n}\r\n#bd.smaller #application-left-bar {\r\n    display: none;\r\n}\r\n#unselect-all-families {\r\n    text-decoration: underline;\r\n    font-weight: bold;\r\n}\r\n#family-list-scroll {\r\n    display: inline-block;\r\n    position: absolute;\r\n    bottom: 0;\r\n    top: 30px;\r\n    right: 0;\r\n    width: 100%;\r\n}\r\n#bd.tablet #family-list-scroll {\r\n    border-top: 1px solid #d3d3d3;\r\n    overflow: auto;\r\n    height: 100%;\r\n}\r\n#bd.tablet #family-list-scroll, #bd.tablet #family-list-scroll ul {\r\n    -webkit-overflow-scroll: touch;\r\n}\r\n#unselect-all-families.enabled_true:hover {\r\n    cursor: pointer;\r\n    color: #E7B900;\r\n}\r\n#app-container {\r\n    -webkit-transition-property: left, top, background, -webkit-transform;\r\n    -webkit-transition-duration: 1s, 1s, 1s, 1s;\r\n    -webkit-transition-timing-function: ease-out, ease-in, linear, ease-in-out;\r\n    -webkit-transition-delay: 0, 0, 0, 1s;\r\n}\r\n.exit-left-anim {\r\n    -webkit-transform: translate(-10000px,0);\r\n}\r\nspan#unselect-all-families.enabled_false {\r\n    opacity: .3;\r\n}\r\nli.enabled_true {\r\n}\r\ninput.txtField2 {\r\n    margin-top: 5px;\r\n}\r\ninput.txtField2.type3 {\r\n    margin-top: 0;\r\n}\r\nul#family-list > li, ul#family-list ul.group > li {\r\n    padding-left: 25px;\r\n    background-image: url('/adiJed/img/icons/fam-documentale.png');\r\n    background-position: left 5px top 7px;\r\n    background-repeat: no-repeat;\r\n}\r\nul#family-list > li > li.famD, ul#family-list ul.group > li > li.famD {\r\n    background-image: url('/adiJed/img/icons/zoom.png');\r\n    padding-left: 25px;\r\n    background-position: left 5px top 7px;\r\n    background-repeat: no-repeat;\r\n}\r\nul.group {\r\n    background-image: url('/adiJed/img/icons/folder-open.png');\r\n    background-repeat: no-repeat;\r\n    background-position: 5px 2px;\r\n    padding-left: 30px;\r\n    color: #656565;\r\n}\r\nul.group > label {\r\n    line-height: 20px;\r\n}\r\nul.group.collapsed * {\r\n    display: none;\r\n}\r\nul.group.collapsed {\r\n    background-image: url('/adiJed/img/icons/folder.png');\r\n}\r\nul#family-list > li.phantom, ul#family-list ul.group > li.phantom {\r\n    background-image: url('/adiJed/img/icons/fam-processo.gif');\r\n}\r\nul#family-list li > label {\r\n    white-space: nowrap;\r\n}\r\nul#family-list li > label > span {\r\n    padding-top: 6px;\r\n    display: inline-block;\r\n}\r\n#bd.tablet div.query div.ad-toolbar {\r\n    position: fixed;\r\n    left: 71px;\r\n}\r\ndiv#filter2-fields, div#saved-queries, div#vq-container {\r\n    display: none;\r\n    opacity: 0;\r\n    margin-top: 41px;\r\n}\r\ndiv#filter2-fields.opened, div#saved-queries.opened, div#vq-container.opened {\r\n    display: block;\r\n    position: absolute;\r\n    top: 0;\r\n    bottom: 0;\r\n    left: 0;\r\n    right: 0;\r\n    overflow-y: auto;\r\n    padding: 10px 20px 80px 20px;\r\n}\r\ndiv#vq-container.opened {\r\n    padding-bottom: 20px;\r\n    padding-left: 0;\r\n    padding-right: 0;\r\n}\r\nspan.field-available {\r\n    display: inline-block;\r\n    cursor: pointer;\r\n    border: 1px solid lightgray;\r\n    padding: 6px;\r\n    border-radius: 3px;\r\n    background-color: rgba(245, 245, 245, 0.37);\r\n    margin-left: 15px;\r\n    margin-top: 15px;\r\n    font-weight: bold;\r\n}\r\ndiv#active-filters.hovered {\r\n    background-color: rgba(208, 255, 185, 0.81);\r\n}\r\ndiv#active-filters {\r\n    display: block;\r\n    padding: 10px 20px 20px;\r\n    border: 2px dashed lightgray;\r\n    margin: 40px 15px 15px;\r\n    font-size: 130%;\r\n    color: darkgray;\r\n    font-weight: bold;\r\n    position: relative;\r\n}\r\ndiv#filter2-fields > div:last-child {\r\n    margin-bottom: 35px;\r\n    margin-top: 40px;\r\n}\r\nspan.filter2-label {\r\n    display: inline-block;\r\n    width: 150px;\r\n    padding-left: 10px;\r\n    padding-right: 10px;\r\n    font-weight: bold;\r\n    text-align: right;\r\n}\r\n.filter2-field {\r\n    margin-left: 15px;\r\n    margin-right: 15px;\r\n    padding-top: 15px;\r\n    padding-bottom: 15px;\r\n    border-bottom: 1px solid #f5f5f5;\r\n}\r\n.filter2-field > span.k-autocomplete {\r\n    width: auto;\r\n}\r\n.filter2-field input {\r\n    min-width: 250px;\r\n    max-width: 80%;\r\n}\r\n#available-fields {\r\n    position: relative;\r\n}\r\n.block-fields {\r\n    height: 100%;\r\n    z-index: 2;\r\n    width: 100%;\r\n    position: absolute;\r\n    top: 0;\r\n}\r\n#result-count {\r\n    display: block;\r\n    color: #76c2fe;\r\n    padding-bottom: 5px;\r\n    padding-top: 5px;\r\n}\r\na {\r\n    color: #76c2fe;\r\n}\r\n#show-results {\r\n    display: none;\r\n}\r\ndiv#saved-queries.opened {\r\n    position: relative;\r\n    width: 100%;\r\n    height: 100%;\r\n    margin-top: 60px !important;\r\n    overflow: visible;\r\n}\r\ntr#fields-list td label.secondOp {\r\n    width: 15px;\r\n    min-width: 0;\r\n    display: inline-block;\r\n    padding-right: 5px;\r\n}\r\n.iconAction{\r\n    width: 18px;\r\n    padding-right: 8px;\r\n    vertical-align: middle;\r\n}\r\n.emptyIcon{\r\n    cursor: default !important;\r\n}\r\n#list-data-container {\r\n    overflow-y: auto;\r\n}\r\nbody#bd.smaller #list-data-container {\r\n    overflow: hidden !important;\r\n}\r\n.cboOP{\r\n    width: 150px;\r\n}\r\n#form-fields span.clear-input-value{\r\n    position: relative !important;\r\n}\r\ndiv.tabbed-container {\r\n    position: relative;\r\n    height: 100%;\r\n    width: 100%;\r\n}\r\ndiv.tab-bar {\r\n    position: absolute;\r\n    height: 30px;\r\n    top: 0;\r\n    left: 0;\r\n    right: 0;\r\n    padding-left: 20px;\r\n    border-bottom: 3px solid #007fd4;\r\n}\r\nspan.tab {\r\n    opacity: .75;\r\n    display: inline-block;\r\n    line-height: 27px;\r\n    vertical-align: middle;\r\n    padding-left: 7px;\r\n    padding-right: 7px;\r\n    margin-right: -4px;\r\n    box-sizing: border-box;\r\n    border: 1px solid rgb(223, 223, 223);\r\n    border-bottom: 0;\r\n    margin-bottom: 0;\r\n    border-top-left-radius: 2px;\r\n    border-top-right-radius: 2px;\r\n    background-color: rgba(245, 245, 245, 0.5);\r\n    cursor: pointer;\r\n    font-weight: bold;\r\n    z-index: 0;\r\n    border-top-width: 3px;\r\n}\r\n.tab-bar > span.tab:first-child {\r\n    border-top-right-radius: 0;\r\n}\r\nspan.tab.selected {\r\n    border-color: #007fd4;\r\n    background-color: rgba(245, 245, 245, 0.3);\r\n    margin-top: 0;\r\n    opacity: 1;\r\n    z-index: 1;\r\n}\r\ndiv.tabbed-container > .tab-content {\r\n    visibility: hidden;\r\n    position: absolute;\r\n    top: 33px;\r\n    left: 0;\r\n    right: 0;\r\n    bottom: 100%;\r\n    overflow: auto;\r\n}\r\ndiv.tabbed-container > .tab-content.tab-content-vis {\r\n    visibility: visible;\r\n    bottom: 0;\r\n    overflow-y: auto;\r\n}\r\ntbody tr.family-type-F:last-child > td {\r\n    padding-bottom: 25px;\r\n}\r\ntr.family-type-D > td:first-child {\r\n    /*border-left: 2px solid lightgreen;*/\r\n}\r\n.family-type-D > td {\r\n    padding-top: 20px !important;\r\n    border-top: 2px solid lightgreen;\r\n}\r\n.family-type-D ~ .family-type-D > td {\r\n    padding-top: 10px !important;\r\n    border-top: 0;\r\n}\r\ntr.family-type-D > td:first-child::before {\r\n    content: \"Campi di dettaglio\";\r\n    text-transform: uppercase;\r\n    display: inline-block;\r\n    margin-top: -37px;\r\n    position: absolute;\r\n    background-color: white;\r\n    padding-top: 3px;\r\n    padding-bottom: 3px;\r\n    padding-right: 3px;\r\n    margin-left: -10px;\r\n    color: green;\r\n    font-weight: bold;\r\n}\r\n.family-type-D ~ .family-type-D > td:first-child::before {\r\n    display: none;\r\n}\r\ntr#fields-list.family-type-D:last-of-type > td {\r\n    /*border-bottom: 2px solid lightgreen;*/\r\n}\r\ntr.family-type-D > td:last-child {\r\n    /*border-right: 2px solid lightgreen;*/\r\n}\r\n\r\ntr.family-type-T > td:first-child {\r\n    /*border-left: 2px solid lightgreen;*/\r\n}\r\n.family-type-T > td {\r\n    padding-top: 20px !important;\r\n    border-top: 2px solid lightgreen;\r\n}\r\n.family-type-T ~ .family-type-T > td {\r\n    padding-top: 10px !important;\r\n    border-top: 0;\r\n}\r\ntr.family-type-T > td:first-child::before {\r\n    content: \"Campi di tracking\";\r\n    text-transform: uppercase;\r\n    display: inline-block;\r\n    margin-top: -37px;\r\n    position: absolute;\r\n    background-color: white;\r\n    padding-top: 3px;\r\n    padding-bottom: 3px;\r\n    padding-right: 3px;\r\n    margin-left: -10px;\r\n    color: green;\r\n    font-weight: bold;\r\n}\r\n.family-type-T ~ .family-type-T > td:first-child::before {\r\n    display: none;\r\n}\r\ntr#fields-list.family-type-T:last-of-type > td {\r\n    /*border-bottom: 2px solid lightgreen;*/\r\n}\r\ntr.family-type-T > td:last-child {\r\n    /*border-right: 2px solid lightgreen;*/\r\n}\r\n\r\n.text-check-button{\r\n    display: inline;\r\n    background-position: center left;\r\n    background-repeat: no-repeat;\r\n    height: 28px;\r\n    valign: center;\r\n} \r\n\r\n.text-combo-button{\r\n    display: inline;\r\n    background-position: center left;\r\n    background-repeat: no-repeat;\r\n    height: 28px;\r\n    left: 6px;\r\n}\r\n#families-tree-container {\r\n    position: absolute;\r\n    top: 41px;\r\n    bottom: 0;\r\n    left: 0;\r\n    right: 0;\r\n}\r\n\r\n.text-combo-button:before{\r\n    content: none !important;\r\n}\r\n\r\ndiv.ad-toolbar li.text-combo-button {\r\n    color: #49585a !important;\r\n    padding-left: 5px;\r\n    height: 30px;\r\n    padding-top: 0;\r\n    padding-bottom: 0;\r\n    padding-left: 0;\r\n    padding-right: 0;\r\n}\r\ndiv.ad-toolbar li.text-combo-button > div {\r\n    font-size: 80%;\r\n    height: 30px;\r\n    display: table-cell;\r\n    vertical-align: middle;\r\n    white-space: nowrap;\r\n    overflow-x: hidden;\r\n    background-color: #FDFDFD;\r\n    box-sizing: border-box;\r\n    border: none;\r\n}\r\ndiv.ad-toolbar li.text-combo-button span {\r\n    height: 30px;\r\n    display: table-cell;\r\n    vertical-align: middle;\r\n    white-space: nowrap;\r\n    overflow-x: hidden;\r\n    box-sizing: border-box;\r\n    margin: 0;\r\n}\r\n\r\n.text-check-button:before{\r\n    content: none !important;\r\n}\r\n\r\ndiv.ad-toolbar li.text-check-button {\r\n    color: #49585a !important;\r\n    padding-left: 5px;\r\n    height: 30px;\r\n    padding-top: 0;\r\n    padding-bottom: 0;\r\n    padding-left: 0;\r\n    padding-right: 0;\r\n}\r\ndiv.ad-toolbar li.text-check-button > div {\r\n    font-size: 80%;\r\n    height: 30px;\r\n    display: table-cell;\r\n    vertical-align: middle;\r\n    white-space: nowrap;\r\n    overflow-x: hidden;\r\n    box-sizing: border-box;\r\n    border: none;\r\n}\r\ndiv.ad-toolbar li.text-check-button span {\r\n    height: 30px;\r\n    display: table-cell;\r\n    vertical-align: middle;\r\n    white-space: nowrap;\r\n    overflow-x: hidden;\r\n    box-sizing: border-box;\r\n    margin: 0;\r\n}\r\n.detail-field{\r\n    background-color: #CCEFE6 !important;\r\n}\r\n\r\n</style>\r\n\r\n\r\n\r\n<div id=\"application-left-bar\">\r\n    <div id=\"family-tree-container\">\r\n    </div>\r\n</div>\r\n\r\n<div id=\"content\" class=\"query resolution-adapt\">\r\n    <form id=\"frmDoQuery\" name=\"frmDoQuery\" action=\"#\" method=\"post\">\r\n\r\n        <div id=\"search-toolbar\" class=\"ad-toolbar\">\r\n            <ul>\r\n                \r\n                    <li class=\"toolbar-button image-only\" id=\"back\" title=\"Indietro\"></li>      \r\n                \r\n                <li class=\"toolbar-button action-to-do-button\" id=\"do-search\" title=\"Cerca in Adiuto\"></li>   \r\n                <li class=\"toolbar-button image-only big\" id=\"vq-filter\" title=\"Ricerche visuali\"></li>\r\n                <li class=\"toolbar-button image-only\" id=\"load-saved-queries\" title=\"Ricerche salvate\"></li>     \r\n                <li class=\"toolbar-button image-only\" id=\"clean-values\" title=\"Pulisci filtri\">      \r\n                </li>\r\n                \r\n                <li class=\"toolbar-button image-only\" id=\"showThumbnails\" title=\"Anteprime\">      \r\n                </li>\r\n                \r\n\r\n                <li class=\"toolbar-button text-combo-button\" id=\"showOnly\" title=\"Mostra solo:\">      \r\n                    <div>\r\n                        <span>\r\n                            <select id=\"wfStatus\" class='combobox'>\r\n                               <option value=\"0\" selected disabled>Mostra solo:</option>\r\n                               <option value=\"0\"></option>\r\n                               <option value=\"1\">Workflow attivi</option>\r\n                               <option value=\"2\">Workflow finiti</option>\r\n                               <option value=\"3\">Senza workflow</option>\r\n                               <option value=\"21\" disabled>-</option>\r\n                               <option value=\"-1\">Non validato</option>\r\n                               <option value=\"-2\">Errore durante conservazione presso provider</option>\r\n                               <option value=\"5\">Ancora da Trattare</option>\r\n                               <option value=\"11\">Inviabile a conservatore</option>\r\n                               <option value=\"12\">Inviato a conservatore</option>\r\n                               <option value=\"13\">Confermata la ricezione da conservatore</option>\r\n                               <option value=\"14\">Inviato a SDI</option>\r\n                               <option value=\"15\">Ancora da Trattare (Allegati presenti)</option>\r\n                               <option value=\"18\">Archiviati in sostitutiva in House</option>\r\n                               <option value=\"19\">Archiviati in sostitutiva presso conservatore</option>\r\n                               <option value=\"20\">Pronto per conservazione presso provider</option>\r\n                               <option value=\"21\">Pronto per conservazione in House</option>\r\n                               <option value=\"22\">Inviato a provider con conservazione</option>\r\n                               <option value=\"30\">Non Archiviati in Sostitutiva</option>\r\n                            </select>\r\n                        </span>\r\n                    </div>\r\n                </li>\r\n\r\n                <li class=\"toolbar-button text-check-button\" id=\"showTrack-li\" title=\"Visualizza invii\">      \r\n                    <div>\r\n                        <span>\r\n                            <select id=\"showTrack\" class='combobox'>\r\n                               <option value=\"0\" selected>Non Visualizzare</option>\r\n                               <option value=\"1\">Tutto (anche annullati)</option>\r\n                               <option value=\"2\">Solo documenti attivi</option>\r\n                            </select>\r\n                            <label style=\"vertical-align: middle;\" for=\"showTrack\">&nbsp;Visualizza invii&nbsp;</label>\r\n                        </span>\r\n                    </div>\r\n                </li>\r\n                \r\n                \r\n            </ul>\r\n        </div>\r\n        <div id=\"form-fields\">\r\n            <table id=\"table-fields\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\r\n                <tbody>\r\n                </tbody>\r\n            </table>\r\n        </div>\r\n        <div id=\"filter2-fields\" class=\"aTab\">\r\n            <div id=\"active-filters\">\r\n                <span id=\"result-count\"></span>                                                                   \r\n                <span class=\"add-filter-droppable\">Aggiungi un filtro</span><span id=\"show-results\">, oppure <a href=\"javascript:void(0)\">mostra tutti i risultati</a></span>     \r\n            </div>\r\n            <div id=\"available-fields\"></div>\r\n        </div>\r\n        <div id=\"vq-container\" class=\"aTab\">\r\n            <div class=\"tabbed-container\">\r\n                <div class=\"tab-bar\">\r\n                    <span class=\"tab\" tabid=\"vq-config\">Configurazione</span> \r\n                    <span class=\"tab selected\" tabid=\"saved-queries-container\">Ricerche visuali</span>   \r\n                    <span class=\"tab\" tabid=\"current-queries-container\">Risultato ricerca</span>    \r\n                </div>\r\n\r\n                <div class=\"current-queries-container tab-content\">\r\n                    <div class=\"vq-search search-box\">\r\n                        <input type=\"text\" id=\"vq-search-term\" placeholder=\"Cerca nell&#39;albero\">    \r\n                    </div>\r\n                </div>\r\n                <div class=\"saved-queries-container tab-content tab-content-vis\">\r\n                </div>\r\n                <div class=\"vq-config tab-content\">\r\n                    <div id=\"vq-active-filters\" style=\"display: none;\">\r\n                        <span class=\"add-filter-droppable\">Aggiungi un raggruppamento</span>    \r\n                    </div>\r\n                    <div id=\"vq-available-fields\"></div>\r\n                    <div id=\"vq-toolbar\" style=\"display: none; position: relative; height: 40px; margin-left: 0; margin-top: 20px;\">\r\n                        <div class=\"ad-toolbar\">\r\n                            <ul>\r\n                                <li class=\"toolbar-button toolbar-text-button action-to-do-button\" id=\"save-visual-query\" title=\"Salva\">Salva</li> \r\n                                <li class=\"toolbar-button toolbar-text-button\" id=\"execute-visual-query\" title=\"ui.generic.bbbbbuttons.save\">Esegui</li>      \r\n                            </ul>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n        <div id=\"saved-queries\" class=\"aTab\">\r\n        </div>\r\n        <div id=\"no-fields-message\" style=\"display: none;\">\r\n            <h4>Nessun campo disponibile come filtro per le famiglie selezionate.</h4>   \r\n        </div>\r\n        <input type=\"submit\" style=\"display: none;\" name=\"_smtDoQry\">\r\n    </form>\r\n</div>\r\n\r\n<div id=\"list-data-container\" class=\"adi-modal-dialog-container\"></div>\r\n\r\n<script type=\"text/javascript\">\r\nfunction FamilyFields()\r\n{\r\n    this.__instance = this;\r\n}\r\nFamilyFields.prototype = {\r\n    constructor: FamilyFields,\r\n    __instance: null,\r\n    fieldsTable: null,\r\n    currentAjaxCall: null,\r\n    selectedFamilies: null,\r\n    selectedTrackingFamilies: null,\r\n\r\n    displayFields: function(famTree, container, callback) {\r\n        var _this = this;\r\n        var fieldsLoaded = callback||function(){};\r\n        this.fieldsTable = container;\r\n        this.selectedFamilies = famTree.getFamiliesSelected();\r\n\r\n        var selectedFamiliesIDList=[];\r\n        for(var ifam=0; ifam<this.selectedFamilies.length; ifam++) {\r\n            var exists = false;\r\n            for(var icheck=0; icheck<selectedFamiliesIDList; icheck++) {\r\n                if(selectedFamiliesIDList[icheck] == this.selectedFamilies[ifam].id) {\r\n                    exists = true;\r\n                    break;\r\n                }\r\n            }\r\n            if(!exists)\r\n                selectedFamiliesIDList.push(this.selectedFamilies[ifam].id);\r\n        }\r\n\r\n        if(this.currentAjaxCall != null) {\r\n            this.currentAjaxCall.abort();\r\n            this.currentAjaxCall = null;\r\n        }\r\n\r\n        this.currentAjaxCall = $.ajax({\r\n            type: \"POST\",\r\n            url: \"/adiJed/ui/families/fields.get-family-fields.do\",\r\n            dataType: 'json',\r\n            data: \"famid=\"+selectedFamiliesIDList.join(\",\")\r\n        }).done(function(result){\r\n            if(result[\"ok\"])\r\n            {\r\n                selectedTrackingFamilies = result.trackingFamilies;\r\n                if (selectedTrackingFamilies == null || selectedTrackingFamilies.length == 0){\r\n                    $(\"#showTrack-li\").hide();\r\n                }else{\r\n                    $(\"#showTrack-li\").show();\r\n                }\r\n                \r\n                _this.removeAllFields();\r\n                _this.addAllFields(result.fields, _this.currentAjaxCall);\r\n\r\n                $(\"#queryFamDebug\").html(\"\");\r\n                if(result.panelsInfo && result.panelsInfo.length) {\r\n                    $(\"#queryFamDebug\").append(\"<div>Pannelli Query:</div>\");\r\n\r\n                    for(var ip=0; ip<result.panelsInfo.length; ip++) {\r\n                        var p=result.panelsInfo[ip];\r\n                        $(\"#queryFamDebug\").append(\"<div>A\"+p[\"famid\"]+\" -> \"+p[\"panelName\"]+\" (\"+p[\"panid\"]+\")</div>\");\r\n                    }\r\n                }\r\n            }\r\n            else if(result[\"error\"])\r\n            {\r\n                $(\"#queryFamDebug\").html(\"\");\r\n                var msg = result[\"message\"]||\"Si è verificato un errore.\"; //Si è verificato un errore.\r\n                showErrorMessage(msg);\r\n            }\r\n            fieldsLoaded.call(_this);\r\n            _this.currentAjaxCall = null;\r\n        });\r\n    },\r\n    setEvents: function() {\r\n        $(\".cboOP\").change(function(ev) {\r\n            var fieldID = $(this).attr(\"fieldID\");\r\n            var betweenSelected = false;\r\n            if($(this).val() == '') {\r\n                $(\"#\"+fieldID).val(\"\");\r\n            }\r\n            if($(this).val() == 'between') {\r\n                $(\"#lbl\"+fieldID).css(\"visibility\",\"visible\");\r\n                $(\"#2fldspan\"+fieldID).css(\"display\",\"block\");\r\n                var fld2 = $(\"#2fld\"+fieldID);\r\n                fld2.removeAttr(\"disabled\");\r\n\r\n                if( fld2.attr(\"aditype\") == 3 )\r\n                {\r\n                    fld2.kendoDatePicker({format: \"dd/MM/yyyy\", min: new Date(1000, 0, 1)});\r\n                    fld2.inputmask(\"d/m/y\",{\r\n                        \"placeholder\": \"_\",\r\n                        \"onincomplete\": function(){\r\n                            if($(this).val() != \"\")\r\n                            {\r\n                                $(this).parent().addClass(\"field-value-err\");\r\n                            }\r\n                            else\r\n                            {\r\n                                $(this).parent().removeClass(\"field-value-err\");\r\n                            }\r\n                        },\r\n                        \"oncomplete\": function(){\r\n                            $(this).parent().removeClass(\"field-value-err\");\r\n                        }\r\n                    });\r\n                }\r\n\r\n                betweenSelected = true;\r\n            } else {\r\n                $(\"#lbl\"+fieldID).css(\"visibility\",\"hidden\");\r\n                $(\"#2fldspan\"+fieldID).css(\"display\",\"none\");\r\n                $(\"#2fld\"+fieldID).val(\"\").attr(\"disabled\",\"true\");\r\n            }\r\n            if($(this).val() == 'isnull') {\r\n                $(\"#\"+fieldID).val(\"\").attr(\"disabled\",\"true\");\r\n            } else {\r\n                $(\"#\"+fieldID).removeAttr(\"disabled\");\r\n\r\n                if(!betweenSelected || $(\"#\"+fieldID).val()==\"\")\r\n                    $(\"#\"+fieldID).focus();\r\n                else\r\n                    $(\"#2fld\"+fieldID).focus();\r\n            }\r\n\r\n            if($(this).val() == 'in' || $(this).val() == 'notin'){\r\n                $(\"#\"+fieldID).attr(\"placeholder\", \"Separare i valori usando la virgola Es. val1,val2,val3\");\r\n            }else if ($(\"#\"+fieldID).attr(\"aditype\") != 3 ){\r\n                $(\"#\"+fieldID).attr(\"placeholder\", \"\");\r\n            }\r\n        });\r\n\r\n        var inputFieldEvt = function() {\r\n            var fieldID = $(this).attr(\"id\");\r\n            var cbo = $(\"#qf\"+fieldID);\r\n            var type = $(this).attr(\"aditype\");\r\n            var op = $(this).attr(\"defaultop\");\r\n\r\n            if(op && $(this).val() != '' && cbo.val() == '')\r\n            {\r\n                cbo.val(op);\r\n                cbo.change();\r\n            }\r\n            else if($(this).val() == '')\r\n            {\r\n                cbo.val('');\r\n                cbo.change();\r\n            }\r\n        };\r\n\r\n        $(\".family-type-T input\").change(function(){\r\n            inputFieldEvt.apply(this);\r\n        });\r\n\r\n        $(\".txtField\").change(function(){\r\n            inputFieldEvt.apply(this);\r\n        });\r\n\r\n        $(\".txtField\").keyup(function(evt){\r\n            if(evt.keyCode != 13) {\r\n                var $this = $(this);\r\n                if($this.attr(\"aditype\") == 2) {\r\n                    $this.val($this.val().replace(/\\./g,''));\r\n                }\r\n                \r\n                inputFieldEvt.apply(this);\r\n                return true;\r\n            } else {\r\n                if(doQuery()) {\r\n                    doQuery = function(){};\r\n                }\r\n                evt.stopPropagation();\r\n                return false;\r\n            }\r\n        });\r\n\r\n        $(\"#frmDoQuery\").submit(function() {\r\n            if(doQuery()) {\r\n                doQuery = function(){};\r\n            }\r\n            return false;\r\n        });\r\n\r\n        for( var i=0; i<$(\".txtField\").length; i++ )\r\n        {\r\n            var fld = $($(\".txtField\")[i]);\r\n            var emptyIcon = true;\r\n            if( fld.attr(\"aditype\") == 3 )\r\n            {\r\n                $(fld).kendoDatePicker({format: \"dd/MM/yyyy\", min: new Date(1000, 0, 1)});\r\n                $(fld).inputmask(\"d/m/y\",{\r\n                    \"placeholder\": \"_\",\r\n                    \"onincomplete\": function(){ if($(this).val() != \"\") $(this).parent().addClass(\"field-value-err\"); else $(this).parent().removeClass(\"field-value-err\"); },\r\n                    \"oncomplete\": function(){$(this).parent().removeClass(\"field-value-err\");} })\r\n                ;\r\n            }\r\n            var fieldRegId = fld.attr(\"id\");\r\n            $(\".iconAction\"+fieldRegId).attr(\"src\",\"/adiJed/res/img/empty.gif\");\r\n            if(fld.attr(\"fillType\") == 94)  //Multivalue\r\n            {\r\n                $(\".iconAction\"+fieldRegId).addClass(\"open-list\")\r\n                        .attr(\"src\",\"/adiJed/img/icons/multivalue.png\")\r\n                        .attr(\"title\",'Scegliere i valori dalla lista')  //Scegliere i valori dalla lista\r\n                ;\r\n                emptyIcon = false;\r\n            }\r\n\r\n            if(fld.attr(\"fillType\") == 96)  //Fill Roles\r\n            {\r\n                $(\".iconAction\"+fieldRegId).addClass(\"open-roles\")\r\n                        .attr(\"src\",\"/adiJed/img/icons/role.png\")\r\n                        .attr(\"title\",'Seleziona un elenco di ruoli dalla lista')\r\n                ;\r\n                emptyIcon = false;\r\n            }\r\n\r\n            if(fld.attr(\"fillType\") == 99)  //Fill Users\r\n            {\r\n                $(\".iconAction\"+fieldRegId).addClass(\"open-users\")\r\n                        .attr(\"src\",\"/adiJed/img/icons/group.png\")\r\n                        .attr(\"title\",'Seleziona un elenco di utenti dalla lista')\r\n                ;\r\n                emptyIcon = false;\r\n            }\r\n\r\n            if(fld.attr(\"fillType\") == 100) //Fill Sector\r\n            {\r\n                $(\".iconAction\"+fieldRegId).addClass(\"open-sectors\")\r\n                        .attr(\"src\",\"/adiJed/img/icons/sectors.png\")\r\n                        .attr(\"title\",'Seleziona un reparto dalla lista')\r\n                ;\r\n                emptyIcon = false;\r\n            }\r\n\r\n            if(fld.attr(\"fillType\") == 101) //Fill Sector\r\n            {\r\n                $(\".iconAction\"+fieldRegId).addClass(\"open-aliases\")\r\n                        .attr(\"src\",\"/adiJed/img/icons/group.png\")\r\n                        .attr(\"title\",'Seleziona un alias dalla lista')\r\n                ;\r\n                emptyIcon = false;\r\n            }\r\n\r\n            if( (this.selectedFamilies.length==1 || $(\".iconAction\"+fieldRegId).attr(\"familytype\")==\"D\" || $(\".iconAction\"+fieldRegId).attr(\"familytype\")==\"T\") && (fld.attr(\"fillType\") == 7 || fld.attr(\"fillType\") == 8 || fld.attr(\"fillType\") == 81)) //Fill List\r\n            {\r\n                $(\".iconAction\"+fieldRegId).addClass(\"open-lov\")\r\n                        .attr(\"src\",\"/adiJed/img/icons/list.png\")\r\n                        .attr(\"title\",'Seleziona un valore dalla lista')\r\n                ;\r\n                emptyIcon = false;\r\n            }\r\n\r\n            if(emptyIcon){\r\n                $(\".iconAction\"+fieldRegId).addClass(\"emptyIcon\");\r\n            }\r\n\r\n            //Se il tipo di riempimento è Multivalue | Fill Roles | Fill Users | Fill Sector disabilito l'editazione manuale della textbox\r\n            if(fld.attr(\"fillType\") == 94 || fld.attr(\"fillType\") == 96 || fld.attr(\"fillType\") == 99 || fld.attr(\"fillType\") == 100 || fld.attr(\"fillType\") == 101) {\r\n                fld.attr(\"readonly\", \"readonly\");\r\n            }\r\n        }\r\n        $(\".clear-input-value\").click(function(){\r\n            var fieldRegID = $(this).attr(\"fieldRegID\");\r\n\r\n            //Svuoto tutte le input del FieldRegId\r\n            $(\"#\"+fieldRegID).val(\"\");\r\n            $(\"#hidden\"+fieldRegID).val(\"\");\r\n            $(\"#2fld\"+fieldRegID).val(\"\");\r\n            $(\"#hidden-2fld\"+fieldRegID).val(\"\");\r\n\r\n            //Deseleziono la combo dell'operatore\r\n            $(\"#qf\"+fieldRegID).val(\"\");\r\n            $(\"#qf\"+fieldRegID).change();\r\n\r\n            $(\"#\"+fieldRegID).focus();\r\n        });\r\n\r\n        $(\".open-lov\").click(function(){\r\n            $(\"#list-data-container\").removeClass(\"fixed-size\");\r\n            var preFilterVal = \"\", $this = $(this);\r\n            var fillType = $this.attr(\"fillType\");\r\n            var familyType = $this.attr(\"familyType\");\r\n            var familyId = $this.attr(\"familyid\");\r\n            var fieldId = $(this).attr(\"fieldRegID\"); //fieldId con la F\r\n            fieldId = fieldId.substring(1, fieldId.length);\r\n\r\n            ListManager.setFamilyId(familyId);\r\n            if(!$(this).hasClass(\"secondOp\")) {\r\n                 preFilterVal = $(\"#\"+$this.attr(\"fieldRegID\")).val();\r\n                ListManager.displayList($this.attr(\"list-id\"), fieldId, function(values){listValueSelected.call(this, values, true);}, preFilterVal, fillType);\r\n            } else {\r\n                preFilterVal = $(\"#2fld\"+$this.attr(\"fieldRegID\")).val();\r\n                ListManager.displayList($this.attr(\"list-id\"), fieldId, function(values){listValueSelected.call(this, values, false);}, preFilterVal, fillType);\r\n            }\r\n            ListManager.setFamilyType(familyType);\r\n        });\r\n\r\n        $(\".open-users\").click(function(){\r\n            var familyType = $(this).attr(\"familyType\");\r\n            var fieldId = $(this).attr(\"fieldRegID\"); //fieldId con la F\r\n            fieldId = fieldId.substring(1, fieldId.length);\r\n            $(\"#list-data-container\").removeClass(\"fixed-size\");\r\n            if(!$(this).hasClass(\"secondOp\")) {\r\n                ListManager.displayUsers(ListManager.FROM_QUERY, -1, fieldId, function(values){usersSelected(values, true);}, $(\"#hidden\"+$(this).attr(\"fieldRegID\")).val());\r\n            } else {\r\n                ListManager.displayUsers(ListManager.FROM_QUERY, -1, fieldId, function(values){usersSelected(values, false);}, $(\"#hidden-2fld\"+$(this).attr(\"fieldRegID\")).val());\r\n            }\r\n            ListManager.setFamilyType(familyType);\r\n        });\r\n\r\n        $(\".open-roles\").click(function(){\r\n            var familyType = $(this).attr(\"familyType\");\r\n            var fieldId = $(this).attr(\"fieldRegID\"); //fieldId con la F\r\n            fieldId = fieldId.substring(1, fieldId.length);\r\n            $(\"#list-data-container\").removeClass(\"fixed-size\");\r\n            if(!$(this).hasClass(\"secondOp\")) {\r\n                ListManager.displayRoles(ListManager.FROM_QUERY, -1, fieldId, function(values){rolesSelected(values, true);}, $(\"#hidden\"+$(this).attr(\"fieldRegID\")).val());\r\n            } else {\r\n                ListManager.displayRoles(ListManager.FROM_QUERY, -1, fieldId, function(values){rolesSelected(values, false);}, $(\"#hidden-2fld\"+$(this).attr(\"fieldRegID\")).val());\r\n            }\r\n            ListManager.setFamilyType(familyType);\r\n        });\r\n\r\n        $(\".open-sectors\").click(function(){\r\n            var familyType = $(this).attr(\"familyType\");\r\n            var fieldId = $(this).attr(\"fieldRegID\"); //fieldId con la F\r\n            fieldId = fieldId.substring(1, fieldId.length);\r\n            $(\"#list-data-container\").removeClass(\"fixed-size\");\r\n            if(!$(this).hasClass(\"secondOp\")) {\r\n                ListManager.displaySectors(ListManager.FROM_QUERY, -1, fieldId, function(values){sectorsSelected(values, true);}, $(\"#hidden\"+$(this).attr(\"fieldRegID\")).val());\r\n            } else {\r\n                ListManager.displaySectors(ListManager.FROM_QUERY, -1, fieldId, function(values){sectorsSelected(values, false);}, $(\"#hidden-2fld\"+$(this).attr(\"fieldRegID\")).val());\r\n            }\r\n            ListManager.setFamilyType(familyType);\r\n        });\r\n\r\n        $(\".open-aliases\").click(function(){\r\n            var familyType = $(this).attr(\"familyType\");\r\n            var fieldId = $(this).attr(\"fieldRegID\"); //fieldId con la F\r\n            fieldId = fieldId.substring(1, fieldId.length);\r\n            $(\"#list-data-container\").removeClass(\"fixed-size\");\r\n            if(!$(this).hasClass(\"secondOp\")) {\r\n                ListManager.displayAliases(ListManager.FROM_QUERY, fieldId, function(values){sectorsSelected(values, true);}, $(\"#hidden\"+$(this).attr(\"fieldRegID\")).val());\r\n            } else {\r\n                ListManager.displayAliases(ListManager.FROM_QUERY, fieldId, function(values){sectorsSelected(values, false);}, $(\"#hidden-2fld\"+$(this).attr(\"fieldRegID\")).val());\r\n            }\r\n            ListManager.setFamilyType(familyType);\r\n        });\r\n\r\n        $(\".open-list\").click(function(){\r\n            var familyType = $(this).attr(\"familyType\");\r\n            var fieldId = $(this).attr(\"fieldRegID\"); //fieldId con la F\r\n            fieldId = fieldId.substring(1, fieldId.length);\r\n            $(\"#list-data-container\").removeClass(\"fixed-size\");\r\n            if(!$(this).hasClass(\"secondOp\")) {\r\n                ListManager.displayMultivalue($(this).attr(\"list-id\"), fieldId, function(values){valuesSelected(values, true);}, $(\"#hidden\"+$(this).attr(\"fieldRegID\")).val());\r\n            } else {\r\n                ListManager.displayMultivalue($(this).attr(\"list-id\"), fieldId, function(values){valuesSelected(values, false);}, $(\"#hidden-2fld\"+$(this).attr(\"fieldRegID\")).val());\r\n            }\r\n            ListManager.setFamilyType(familyType);\r\n        });\r\n    },\r\n    removeAllFields: function() {\r\n        this.fieldsTable.empty();\r\n    },\r\n    addAllFields: function(fields, ajaxCallContext){\r\n        var _this = this;\r\n\r\n        if(fields.length) {\r\n            $(\"#do-search\").removeClass(\"button-disabled-no-field\");\r\n            $(\"#no-fields-message\").hide();\r\n\r\n            $(fields).each(function(ifield,el) {\r\n                if(ajaxCallContext == _this.currentAjaxCall)\r\n                    _this.addField(el);\r\n                else\r\n                    return false;\r\n            });\r\n\r\n            _this.setEvents();\r\n        } else {\r\n            if( $(\"#form-fields\").css(\"display\") == \"block\" )\r\n                $(\"#no-fields-message\").fadeIn(jQuery.fx.speeds.fast);\r\n            $(\"#do-search\").addClass(\"button-disabled-no-field\");\r\n        }\r\n    },\r\n    addOperators: function(select, fieldType, fieldFillType) {\r\n        select.append($(\"<option>\").text(\"\"));\r\n\r\n        if(fieldType != 1 && fieldType != 2 && fieldType != 3) {\r\n            if (fieldFillType == 94){\r\n                select.append($(\"<option>\").attr(\"value\",\"cont\").text(\"Contiene\"));  /*Contiene*/\r\n           }else{\r\n                select.append($(\"<option>\").attr(\"value\",\"like\").text(\"Contiene\"));  /*Contiene*/\r\n            }\r\n        }\r\n        select.append($(\"<option>\").attr(\"value\",\"eq\").text(\"Uguale a\"));     /*Uguale a*/\r\n        select.append($(\"<option>\").attr(\"value\",\"noteq\").text(\"Diverso da\"));   /*Diverso da*/\r\n\r\n        if(fieldFillType != 94 && fieldFillType != 96 && fieldFillType != 99 && fieldFillType != 100 && fieldFillType != 101) {  //Fill Multivalue//Fill Roles //Fill Users //Fill Sector\r\n            select.append($(\"<option>\").attr(\"value\", \"less\").text(\"Minore di\"));   /*Minore di*/\r\n            select.append($(\"<option>\").attr(\"value\", \"lesseq\").text(\"Minore uguale di\"));   /*Minore o uguale di*/\r\n            select.append($(\"<option>\").attr(\"value\", \"more\").text(\"Maggiore di\"));      /*Maggiore di*/\r\n            select.append($(\"<option>\").attr(\"value\", \"moreeq\").text(\"Maggiore uguale di\"));    /*Maggiore o uguale di*/\r\n            select.append($(\"<option>\").attr(\"value\", \"between\").text(\"Compreso tra\"));    /*Compreso tra*/\r\n            if(fieldType==4||fieldType==1){\r\n                select.append($(\"<option>\").attr(\"value\", \"in\").text(\"Compreso in\"));    /*Compreso In*/\r\n                select.append($(\"<option>\").attr(\"value\", \"notin\").text(\"Non compreso in\"));    /*Non compreso In*/\r\n            }\r\n        }\r\n\r\n        select.append($(\"<option>\").attr(\"value\",\"isnull\").text(\"Nessun valore\"));     /* Nessun valore*/\r\n    },\r\n    addField: function(f) {\r\n        var fieldRegID      = f[\"frid\"],\r\n            fieldType       = f[\"type\"],\r\n            fieldFillType   = f[\"fillType\"],\r\n            fieldListId     = f[\"list-id\"],\r\n            fieldDefaultOp  = f[\"dop\"],\r\n            fieldLabel      = f[\"label\"],\r\n            fieldName       = f[\"name\"],\r\n            familyID        = f[\"fid\"],\r\n            familyType      = f[\"ftyp\"];\r\n\r\n        var fieldRow  = $(\"<tr>\").attr(\"id\",\"fields-list\").addClass(\"family-type-\"+familyType).appendTo(this.fieldsTable);;\r\n\r\n        // TD con label del campo\r\n        var fieldLabelCol =\r\n            $(\"<td>\").addClass(\"fld-op-cell\")\r\n                .css(\"min-width\", \"250px\")\r\n                .append($(\"<label>\").attr(\"for\", fieldRegID).text(fieldLabel).css(\"white-space\",\"normal\"))\r\n                \r\n                .appendTo(fieldRow);\r\n\r\n        // TD con operatore di ricerca\r\n        var operatorSelect =\r\n            $(\"<select>\").addClass(\"cboOP\")\r\n                .attr(\"defaultOp\", fieldDefaultOp)\r\n                .attr(\"fieldID\", fieldRegID)\r\n                .attr(\"id\", \"qf\"+fieldRegID)\r\n                .attr(\"name\", \"qf\"+fieldRegID);\r\n\r\n        var fieldOperatorCol =\r\n            $(\"<td>\").append(operatorSelect)\r\n                .appendTo(fieldRow);\r\n\r\n        this.addOperators(operatorSelect, fieldType, fieldFillType);\r\n\r\n        // TD con input box\r\n        var firstInputValue =\r\n                $(\"<span>\").css({\"display\":\"block\", \"white-space\": \"nowrap\"}).append(\r\n                    $(\"<label>\").addClass(\"secondOp\").css(\"visibility\",\"hidden\").attr(\"id\",\"lbl\"+fieldRegID).attr(\"for\",fieldRegID).text(\"tra\") //tra\r\n                ).append(\r\n                    $(\"<img>\").addClass(\"iconAction\").addClass(\"iconAction\"+fieldRegID)\r\n                            .attr(\"id\",\"iconAction\"+fieldRegID)\r\n                            .attr(\"fieldRegID\",fieldRegID)\r\n                            .attr(\"fillType\",fieldFillType)\r\n                            .attr(\"familyID\",familyID)\r\n                            .attr(\"familyType\",familyType)\r\n                            .attr(\"list-id\",fieldListId)\r\n                ).append(\r\n                    $(\"<input>\").addClass(\"txtField\").addClass(\"type\"+fieldType)\r\n                            .attr(\"type\",\"text\")\r\n                            .attr(\"id\",fieldRegID)\r\n                            .attr(\"name\",\"vl\"+fieldRegID)\r\n                            .attr(\"defaultOp\", fieldDefaultOp)\r\n                            .attr(\"aditype\",fieldType)\r\n                            .attr(\"adilabel\",fieldLabel)\r\n                            .attr(\"fillType\",fieldFillType)\r\n                            .attr(\"fieldRegID\",fieldRegID)\r\n                            .attr(\"list-id\",fieldListId)\r\n                ).append(\r\n                    $(\"<input>\")\r\n                            .attr(\"type\",\"hidden\")\r\n                            .attr(\"id\",\"hidden\"+fieldRegID)\r\n                            .attr(\"name\",\"hidden-vl\"+fieldRegID)\r\n                            .attr(\"defaultOp\", fieldDefaultOp)\r\n                            .attr(\"aditype\",fieldType)\r\n                            .attr(\"adilabel\",fieldLabel)\r\n                            .attr(\"fillType\",fieldFillType)\r\n                )\r\n\r\n        var secondInputValue =\r\n                $(\"<span>\").attr(\"id\",\"2fldspan\"+fieldRegID).css({\"display\":\"none\", \"white-space\": \"nowrap\"}).append(\r\n                    $(\"<label>\").addClass(\"secondOp\").attr(\"id\",\"lbl\"+fieldRegID).attr(\"for\",fieldRegID).text(\"e\") //e\r\n                ).append(\r\n                    $(\"<img>\").addClass(\"iconAction\").addClass(\"iconAction\"+fieldRegID).addClass(\"secondOp\")\r\n                            .attr(\"id\",\"iconAction\"+fieldRegID)\r\n                            .attr(\"fieldRegID\",fieldRegID)\r\n                            .attr(\"fillType\",fieldFillType)\r\n                            .attr(\"familyID\",familyID)\r\n                            .attr(\"familyType\",familyType)\r\n                            .attr(\"list-id\",fieldListId)\r\n                ).append(\r\n                    $(\"<input>\").addClass(\"txtField\").addClass(\"txtField2\").addClass(\"type\"+fieldType)\r\n                            .attr(\"disabled\",\"disabled\")\r\n                            .attr(\"type\",\"text\")\r\n                            .attr(\"id\",\"2fld\"+fieldRegID)\r\n                            .attr(\"name\",\"2vl\"+fieldRegID)\r\n                            .attr(\"defaultOp\", fieldDefaultOp)\r\n                            .attr(\"aditype\",fieldType)\r\n                            .attr(\"adilabel\",fieldLabel)\r\n                            .attr(\"fillType\",fieldFillType)\r\n                            .attr(\"fieldRegID\",fieldRegID)\r\n                            .attr(\"list-id\",fieldListId)\r\n                ).append(\r\n                    $(\"<input>\")\r\n                            .attr(\"disabled\",\"disabled\")\r\n                            .attr(\"type\",\"hidden\")\r\n                            .attr(\"id\",\"hidden-2fld\"+fieldRegID)\r\n                            .attr(\"name\",\"hidden-2vl\"+fieldRegID)\r\n                            .attr(\"defaultOp\", fieldDefaultOp)\r\n                            .attr(\"aditype\",fieldType)\r\n                            .attr(\"adilabel\",fieldLabel)\r\n                            .attr(\"fillType\",fieldFillType)\r\n                )\r\n\r\n        var fieldValueCol = $(\"<td>\").addClass(\"fld-cell\").append(firstInputValue).append(secondInputValue).appendTo(fieldRow);\r\n        $(\"<td>\").append(\r\n            $(\"<span>\").addClass(\"clear-input-value\").addClass(\"clear-input-value\"+fieldRegID)\r\n                                        .attr(\"fieldRegID\",fieldRegID)\r\n        ).appendTo(fieldRow);\r\n    }\r\n};\r\n\r\nfunction QueryPage()\r\n{\r\n    this.init();\r\n}\r\nQueryPage.prototype = {\r\n    constructor: QueryPage,\r\n    __instance: null,\r\n    dfdJsLibs: new $.Deferred(),\r\n    familiesSelected: [],\r\n\r\n    getFamiliesSelected: function() {\r\n        return this.familiesSelected;\r\n    },\r\n    serializeTrackFamilies: function() {\r\n        var _fams = [];\r\n        for(var ifam=0; ifam<selectedTrackingFamilies.length; ifam++) {\r\n\r\n            _fams.push(\"fam=\"+selectedTrackingFamilies[ifam]);\r\n        }\r\n        return _fams.join(\"&\");\r\n    },\r\n    serializeFamilies: function() {\r\n        var _fams = [];\r\n        for(var ifam=0; ifam<this.familiesSelected.length; ifam++) {\r\n            _fams.push(\"fam=\"+this.familiesSelected[ifam].id);\r\n        }\r\n        return _fams.join(\"&\");\r\n    },\r\n    hide: function()\r\n    {\r\n    },\r\n    restoreQueryState: function(visualQuery) {\r\n        var thereWasAPreviousState = false;\r\n        var _this = this;\r\n        var oldQuery = HistoryManager.getCurrentPage()[\"queryFilters\"];\r\n        if( ( oldQuery && oldQuery[\"mode\"]==\"VisualQuery\" ) || visualQuery ) {\r\n\t\t\t$(\".tab.selected\").removeClass(\"selected\");\r\n\t\t\t$(\".tab[tabid='current-queries-container']\").addClass(\"selected\");\r\n\t\t\t$(\".tab-content.tab-content-vis\").removeClass(\"tab-content-vis\");\r\n\t\t\t$(\".tab-content.current-queries-container\").addClass(\"tab-content-vis\");\r\n            vqFilter_click(true);\r\n            setTimeout(function(){\r\n                DivSplitter.hideLeft($(\"#application-left-bar\"), $(\"#content\"));\r\n                if(visualQuery) {\r\n                    VisualQuery.executeVisualQuery({ \"q\": visualQuery, \"rootContainer\": $(\".current-queries-container.tab-content\") }).then(function(){\r\n                        _this.hideQueryFilters();\r\n                        setTimeout(function(){\r\n                            $(\".tab[tabid='current-queries-container']\").trigger(\"click\");\r\n                        }, 200);\r\n                    });\r\n                } else {\r\n                    VisualQuery.createVisualQueryTree(oldQuery[\"tree\"], (oldQuery[\"q\"])[\"label\"], $(\".current-queries-container.tab-content\"));\r\n                }\r\n\t\t\t\t\r\n\t\t\t\tvar c = $(\"#vq-container\");\r\n                c.addClass(\"opened\").animate({opacity: 1},300);\r\n                $(\"#form-fields\").css({top: '500px', opacity: 0}).css(\"display\",\"none\");\r\n                $(\"#no-fields-message\").fadeOut(jQuery.fx.speeds.fast);\r\n                c.fadeIn();\r\n\t\t\t\t\r\n                _this.dfdJsLibs.then(function(){\r\n                    visualQuerySearch = GenericSearch.getInstance($(\".visual-query-tree\"), '.vq-tree-line', ' > span:first');\r\n                    visualQuerySearch.setup($(\"#vq-search-term\"));\r\n                    $(\".vq-search\").css(\"visibility\",\"visible\");\r\n                    \r\n                    setTimeout(function(){\r\n                        $(\".tab[tabid='current-queries-container']\").trigger(\"click\");\r\n                        if(oldQuery && oldQuery[\"treeSearchTerm\"]) {\r\n                            $(\"#vq-search-term\").val(oldQuery[\"treeSearchTerm\"]);\r\n                        }\r\n                        if(oldQuery && oldQuery[\"tree\"]) {\r\n                            $(\".visual-query-tree\").stop(true, false).animate({\r\n                                scrollTop: oldQuery[\"treeScrollTop\"]\r\n                            }, 50);\r\n                        }\r\n                    }, 300);\r\n                });\r\n\r\n                thereWasAPreviousState = true;\r\n            }, 100);\r\n        } else {\r\n            var _families = HistoryManager.getCurrentPage()[\"families\"];\r\n\r\n            if(_families) {\r\n                for(var ifam=0; ifam<_families.length; ifam++) {\r\n                    this.familiesTree.checkFamily(_families[ifam]);\r\n                }\r\n                _this.familiesSelected = this.familiesTree.getFamiliesSelected();\r\n                var fields = new FamilyFields();\r\n                fields.displayFields(this.familiesTree, $(\"#form-fields > table#table-fields > tbody\"),function(){\r\n                    var data = HistoryManager.getCurrentPage()[\"data\"];\r\n                    if(data) {\r\n                        var fields = data[\"fieldsState\"]||[];\r\n                        for(var ifield=0; ifield<fields.length; ifield++) {\r\n                            var f=fields[ifield];\r\n                            var _fill_from_model = f[\"fill-from-model\"]==true;\r\n                            var isSecondField = f[\"isSecondField\"]==true;\r\n\r\n                            if(_fill_from_model){\r\n                                var fieldRegId = f[\"fieldRegId\"];\r\n                                $(\"#\"+f[\"id\"]).val(f[\"val\"]);\r\n\r\n                                if(!isSecondField)\r\n                                    $(\"#hidden\"+fieldRegId).val(f[\"model-val\"]);\r\n                                else\r\n                                    $(\"#hidden-2fld\"+fieldRegId).val(f[\"model-val\"]);\r\n                            }else{\r\n                                $(\"#\"+f[\"id\"]).val(f[\"val\"]);\r\n                            }\r\n                            $(\"#qf\"+f[\"id\"]).val(f[\"op\"]);\r\n                            $(\"#qf\"+f[\"id\"]).change();\r\n                        }\r\n                    }\r\n                });\r\n\r\n                if(HistoryManager.getCurrentPage()[\"famTreeScroll\"]) {\r\n                    this.familiesTree.familiesTreeContainer.stop(true, false).animate({\r\n                        scrollTop: HistoryManager.getCurrentPage()[\"famTreeScroll\"]\r\n                    }, 50);\r\n                }\r\n\r\n                if(HistoryManager.getCurrentPage()[\"workflowStatus\"]) {\r\n                    $(\"#wfStatus\").val(HistoryManager.getCurrentPage()[\"workflowStatus\"]);\r\n                }\r\n                if(HistoryManager.getCurrentPage()[\"showTrack\"]) {\r\n                    $(\"#showTrack\").val(HistoryManager.getCurrentPage()[\"showTrack\"]);\r\n                }\r\n\r\n                thereWasAPreviousState = true;\r\n            }\r\n        }\r\n\r\n        return thereWasAPreviousState;\r\n    },\r\n    assignTasso: function(pk, kind, to, val, action){\r\n        ADA.assignTasso(pk, kind, to, val, action);\r\n    },\r\n    tassoInHomepage: function(pk, kind, to, action){\r\n        ADA.tassoInHomepage(pk, kind, to, action);\r\n    },\r\n    /**\r\n     * Carica le famiglie, al termine del caricamento richiama la callback (vedi loadCallback)\r\n     */\r\n    showFamilies: function(callback) {\r\n        var viewStatus = AdiutoUserSettings.load(\"queryFamiliesViewStatus\");\r\n        var viewStatusArray = [];\r\n\r\n        if(viewStatus){\r\n            for (var o in viewStatus) {\r\n                if(viewStatus[o]!=null)\r\n                    viewStatusArray.push(viewStatus[o]);\r\n            }\r\n        }\r\n        var _jsonViewStatus = JSON.stringify(viewStatusArray);\r\n\r\n        var _this = this;\r\n        var _params = {\r\n            url: \"/adiJed/ui/families.get-query-families.do\",\r\n            data: {viewStatus: _jsonViewStatus},\r\n            showCheckbox: true,\r\n            onChangeFunctionCall: function(item,_this){\r\n                if(item.attr(\"checked\")!= undefined)\r\n                    if(item.attr(\"kind\")==\"detail\"){\r\n                        $(\".res-chk\").attr(\"checked\",false);\r\n                        $(\".res-chk\").closest(\"span.k-in\").removeClass(\"adiuto-tree-selected\");\r\n                        $(item).closest(\"span.k-in\").addClass(\"adiuto-tree-selected\");\r\n                        $(item).attr(\"checked\",true);\r\n                    }else{\r\n                        $(\".res-chk[kind=detail]\").attr(\"checked\",false).closest(\"span.k-in\").removeClass(\"adiuto-tree-selected\");\r\n                    }\r\n            },\r\n            selectCallback: function(fam) {\r\n                $(\"#showTrack\").val(\"0\");\r\n\r\n                var fields = new FamilyFields();\r\n                fields.displayFields(this, $(\"#form-fields > table#table-fields > tbody\"), function(){\r\n                    window.dispatchEvent(window[\"familyFieldsLoadedEvent\"]);\r\n                });\r\n                _this.familiesSelected = this.getFamiliesSelected();\r\n                window.dispatchEvent(window[\"familySelectedEvent\"]);\r\n            },\r\n            loadCallback: function() {\r\n\r\n                $(\"#families-list-background\").removeClass(\"hidden\");\r\n\r\n                if( !_this.restoreQueryState() ) {\r\n                    setTimeout(function(){\r\n                        var fields = new FamilyFields();\r\n                        // spostata come callback di displayFields, perchè istanziando l'albero a mano lo chiamava dopo un\r\n                        // eventuale displayFields richiamato esternamente\r\n                        fields.displayFields(_this, $(\"#form-fields > table#table-fields > tbody\"), callback);\r\n                    }, 250);\r\n                } else {\r\n                    callback.apply(_this);\r\n                }\r\n                familiesLoaded = true;\r\n            }\r\n        };\r\n        return new FamiliesTree(this.familyTreeContainer, _params);\r\n    },\r\n    loadSavedVisualQueries: function(_savedSettings) {\r\n        if(!_savedSettings) {\r\n            var _mySavedVQ = AdiutoUserSettings.load(\"visualQueries%\", {}, true);\r\n            var _assignedVQ = AdiutoUserSettings.load(\"assigned-vq\", {}, true);\r\n\r\n            _savedSettings = {data: []};\r\n            _savedSettings[\"data\"] = _savedSettings[\"data\"].concat(_mySavedVQ[\"data\"]||[]);\r\n            _savedSettings[\"data\"] = _savedSettings[\"data\"].concat(_assignedVQ[\"data\"]||[]);\r\n        }\r\n        $(\".saved-queries-container\").find(\"> .no-visual-queries\").remove();\r\n\r\n        var c = $(\"#vq-container\");\r\n        $(\"div.visual-queries\").remove();\r\n        var visualQueriesContainer = $(\"<div>\").addClass(\"visual-queries\").appendTo($(\".saved-queries-container\"));\r\n\r\n        for( var i=0; i < _savedSettings[\"data\"].length; i++ )\r\n        {\r\n            var query = (_savedSettings[\"data\"])[i].$;\r\n            if(query == null || $(\".visual-query-\"+query[\"pk\"]).length)\r\n                continue;\r\n\r\n            var queryDiv = $(\"<div>\")\r\n                    .addClass(\"visual-query\")\r\n                    .addClass(\"visual-query-\"+query[\"pk\"])\r\n                    .attr(\"idx\",i)\r\n                    .data(\"vqData\", query)\r\n                    .click(function() {\r\n                        $(\".tab[tabid='current-queries-container']\").trigger(\"click\");\r\n                        VisualQuery.executeVisualQuery({\r\n                            \"q\": $(this).data(\"vqData\"), \"rootContainer\": $(\".current-queries-container.tab-content\")\r\n                        });\r\n                        $(this).addClass(\"opened\");\r\n                        visualQuerySearch = GenericSearch.getInstance($(\".visual-query-tree\"), '.vq-tree-line', ' > span:first');\r\n                        visualQuerySearch.setup($(\"#vq-search-term\"));\r\n                    })\r\n                .appendTo(visualQueriesContainer);\r\n\r\n            if((_savedSettings[\"data\"])[i].mine && (_savedSettings[\"data\"])[i].pinned)\r\n            {\r\n                queryDiv.append($(\"<span>\").addClass(\"visual-query-open-menu\").addClass(\"visual-query-menu-pinned\").attr(\"idx\",i).data(\"vqData\", query));\r\n            }\r\n            else if((_savedSettings[\"data\"])[i].mine)\r\n            {\r\n                queryDiv.append($(\"<span>\").addClass(\"visual-query-open-menu\").attr(\"idx\",i).data(\"vqData\", query));\r\n            }\r\n            \r\n\r\n            $(\"<span>\").addClass(\"vq-family\").text(query[\"label\"]).appendTo(queryDiv).click(function(ev){ev.preventDefault();ev.stopPropagation();});\r\n\r\n            var queryField = query[\"fields\"];\r\n            var lastQueryFieldSpan = null;\r\n            while(1==1) {\r\n                if(!queryField[\"id\"])\r\n                    break;\r\n\r\n                lastQueryFieldSpan = $(\"<span>\")\r\n                        .addClass(\"vq-field\").addClass(\"vq-folder\")\r\n                        .text(queryField[\"label\"])\r\n                        .appendTo(lastQueryFieldSpan||queryDiv)\r\n                ;\r\n                queryField = queryField[\"nextField\"];\r\n            }\r\n            var queryFamilies = query[\"families\"];\r\n            var familyLabelContainer = $(\"<span>\").addClass(\"vq-family-label\").appendTo(queryDiv);\r\n            for(var ifam=0; ifam<queryFamilies.length; ifam++) {\r\n                var queryFamily = queryFamilies[ifam];\r\n                $(\"<span>\").text(queryFamily[\"label\"]).appendTo(familyLabelContainer);\r\n            }\r\n        }\r\n\r\n        var contextMenuItems = {                           /*Apri*/\r\n            openVisualQuery: {name: \"Apri\", className: \"cm-search\", callback: function(key, opt){\r\n                $(\".tab[tabid='current-queries-container']\").trigger(\"click\");\r\n                VisualQuery.executeVisualQuery({\r\n                    \"q\": opt.$trigger.data(\"vqData\"), \"rootContainer\": $(\".current-queries-container.tab-content\")\r\n                });\r\n                visualQuerySearch = GenericSearch.getInstance($(\".visual-query-tree\"), '.vq-tree-line', ' > span:first');\r\n                visualQuerySearch.setup($(\"#vq-search-term\"));\r\n            }}\r\n            , deleteVisualQuery: {name: \"Elimina\", className: \"cm-delete\", callback: function(key, opt){    /*Elimina*/\r\n                DialogManager.showConfirm(\"Cancellare questa ricerca salvata?\",function(){     /*Cancellare questa ricerca salvata?*/\r\n                    var idx = opt.$trigger.attr(\"idx\");\r\n                    AdiutoUserSettings.deleteSettings(\"visualQueries_\"+opt.$trigger.data(\"vqData\")[\"pk\"], true, false);\r\n                    var _vq =\r\n                    queryPage.loadSavedVisualQueries();\r\n                    $.modal.close();\r\n                });\r\n            }}\r\n            \r\n            \r\n            \r\n            /*, tassoHomepage: {name: \"Aggiungi in homepage\", className: \"cm-tassohp\", callback: function(key, opt){\r\n                var pk = opt.$trigger.data(\"vqData\")[\"pk\"];\r\n                queryPage.tassoInHomepage(pk, \"us\", 1234);\r\n            }}*/\r\n            \r\n            \r\n        };\r\n\r\n        var pinnedContextMenuItems = $.extend({}, contextMenuItems, {removeTassoFromHomepage: {name: \"Rimuovi dalla homepage\", className: \"cm-tassohp\", callback: function(key, opt){\r\n            var pk = opt.$trigger.data(\"vqData\")[\"pk\"];\r\n            queryPage.tassoInHomepage(pk, \"us\", 1234, \"del\");\r\n        }}});\r\n\r\n        var nonPinnedContextMenuItems = $.extend({}, contextMenuItems, {tassoHomepage: {name: \"Aggiungi in homepage\", className: \"cm-tassohp\", callback: function(key, opt){\r\n            var pk = opt.$trigger.data(\"vqData\")[\"pk\"];\r\n            queryPage.tassoInHomepage(pk, \"us\", 1234);\r\n        }}});\r\n\r\n        var selForContextMenu = \".visual-query-open-menu:not(.visual-query-menu-pinned)\", selForContextMenuPinned = \".visual-query-open-menu.visual-query-menu-pinned\";\r\n        $.contextMenu({\r\n            selector: selForContextMenu,\r\n            trigger: \"left\",\r\n            position: function(obj) {\r\n                if(obj.$menu) {\r\n                    $(obj.$menu).position({my: \"left top\", at: \"right bottom\", of: this}).css(\"left\", $(obj.$menu).offset().left - 15);\r\n                }\r\n            },\r\n            items: nonPinnedContextMenuItems\r\n        });\r\n        $.contextMenu({\r\n            selector: selForContextMenuPinned,\r\n            trigger: \"left\",\r\n            position: function(obj) {\r\n                if(obj.$menu) {\r\n                    $(obj.$menu).position({my: \"left top\", at: \"right bottom\", of: this}).css(\"left\", $(obj.$menu).offset().left - 15);\r\n                }\r\n            },\r\n            items: pinnedContextMenuItems\r\n        });\r\n\r\n        $(\".visual-query, .visual-query-open-menu\").mousedown(function(ev){\r\n            if( ev.button == 2 ) {\r\n                ev.preventDefault();\r\n                ev.stopPropagation();\r\n\r\n                $(this).find(\".visual-query-open-menu\").contextMenu();\r\n            }\r\n        }).mouseup(function(ev){\r\n            if( ev.button == 2 ) {\r\n                ev.preventDefault();\r\n                ev.stopPropagation();\r\n            }\r\n        });\r\n        $(\".visual-query-open-menu\").click(function(ev){\r\n            ev.preventDefault();\r\n            ev.stopPropagation();\r\n\r\n            $(this).parent().find(\".visual-query-open-menu\").contextMenu();\r\n        });\r\n    },\r\n    setupCrumb: function() {\r\n        $(\"#crumbs\").html('<li><a href=\"#/\">Home</a></li><li>Ricerche</li>');  /*Ricerche*/\r\n    },\r\n    setupSplitter: function() {\r\n        var leftDiv = $(\"#application-left-bar\"), rightDiv = $(\"#content\");\r\n        DivSplitter.split(leftDiv,rightDiv,function(ev,pos) {\r\n            AdiutoUserSettings.save(\"querySplitterSize\",pos);\r\n        });\r\n        var splitterPreferredSize = AdiutoUserSettings.load(\"querySplitterSize\",false);\r\n        if(splitterPreferredSize) {\r\n            DivSplitter.setPositions(leftDiv,rightDiv,splitterPreferredSize);\r\n        }\r\n    },\r\n    restoreFamiliesTreeViewState: function() {\r\n        //NON UTILIZZATO, Viene fatto lato server\r\n        // ripristino lo stato dei raggruppamenti\r\n/*        var _this = this;\r\n        var groupView;\r\n        if(groupView = AdiutoUserSettings.load(\"queryFamiliesViewStatus\"))\r\n        {\r\n            for(var group in groupView) {\r\n                var currentGroup = groupView[group];\r\n                if(currentGroup && currentGroup.expanded == false){\r\n                    var _item = $(\"#node\"+currentGroup.nodeId).closest(\".k-item\");\r\n\r\n                    var familiesTree = _this.familiesTree.familiesTreeObject;\r\n                    var kItem = familiesTree.findByUid(_item.attr(\"data-uid\"));\r\n\r\n                    familiesTree.collapse(kItem);\r\n                }\r\n\r\n            }\r\n        }*/\r\n    },\r\n    attachPageEvents: function() {\r\n        $(\"#do-search\").click(function(){\r\n            if(!$(this).hasClass(\"button-disabled\")) {\r\n                \r\n                if(!$(this).hasClass(\"button-disabled-no-field\"))\r\n                    doQuery.apply(this);\r\n            } else {\r\n                queryPage.hideCurrentOpenTab();\r\n                queryPage.showQueryFilters();\r\n                DivSplitter.restore($(\"#application-left-bar\"), $(\"#content\"));\r\n            }\r\n        });\r\n        $(\"#back\").click(displayPreviousPage);\r\n\r\n        $(\".tab-bar\").find(\">.tab\").click(function(){\r\n            var tabToDisplay = $(this);\r\n            var tabid = tabToDisplay.attr(\"tabid\");\r\n            $(\".tab.selected\").removeClass(\"selected\");\r\n            $(\".tab-content.tab-content-vis\").removeClass(\"tab-content-vis\");\r\n            tabToDisplay.addClass(\"selected\");\r\n            $(\".tab-content.\"+tabid).addClass(\"tab-content-vis\");\r\n        });\r\n    },\r\n    loadSavedQueryFamilies: function() {\r\n        var _this = this;\r\n        if(''!=''){\r\n            $.ajax({\r\n                type: \"POST\",\r\n                url: \"/adiJed/ui/saved-search.do\",\r\n                dataType: 'json',\r\n                data: \"action=getInfo&name=\"+''\r\n            }).done(function(result){\r\n                var items = result[\"savedQuery\"].famiglie;\r\n                if(items && items.length>0) {\r\n                    for(var ifam=0; ifam<items.length; ifam++) {\r\n                        _this.familiesTree.checkFamily({id:items[ifam]});\r\n                    }\r\n                    _this.familiesSelected = _this.familiesTree.getFamiliesSelected();\r\n                    var fields = new FamilyFields();\r\n                    fields.displayFields(_this.familiesTree, $(\"#form-fields > table#table-fields > tbody\"),function(){\r\n                        loadSavedQuery();\r\n                    });\r\n                }\r\n            });\r\n        }\r\n    },\r\n\r\n    setupLinkPage: function() {\r\n        $.ajax({url: \"/adiJed/ui/link-to-document.do\",\r\n            type: \"POST\",\r\n            data: \"action=num&pageUnique=\"+pageUnique}).done(\r\n                function(result)\r\n                {\r\n                    if(result[\"ok\"] && result[\"num\"] > 0)\r\n                    {\r\n                        $(\"#remove-all-links\").fadeIn();\r\n                    }\r\n                }\r\n        );\r\n        $(\"#remove-all-links\").click(function(){\r\n            $.ajax({url: \"/adiJed/ui/link-to-document.do\",\r\n                type: \"POST\",\r\n                data: \"action=remove-all&pageUnique=\"+pageUnique,\r\n                success: function(result)\r\n                {\r\n                    if(result[\"ok\"])\r\n                    {\r\n                        var containerWindow = getContainerWindow(\"#add-links-container\");\r\n                        containerWindow.attr(\"dirty\", true);\r\n                        $(\"#remove-all-links\").remove();\r\n                    }\r\n                }\r\n            });\r\n        });\r\n    },\r\n    hideQueryFilters: function()\r\n    {\r\n        $(\"#form-fields\").animate({top: '500px', opacity: 0},300,function(){\r\n            $(\"#form-fields\").css(\"display\",\"none\");\r\n        });\r\n        $(\"#do-search\").addClass(\"button-disabled\");\r\n    },\r\n    showQueryFilters: function()\r\n    {\r\n        $(\"#form-fields\").css(\"display\",\"block\").animate({top: '41px', opacity: 1},300);\r\n        $(\"#do-search\").removeClass(\"button-disabled\");\r\n    },\r\n    hideTab: function(tabContainer)\r\n    {\r\n        tabContainer.animate({opacity: 0},300,function(){\r\n            tabContainer.removeClass(\"opened\");\r\n        });\r\n    },\r\n    hideCurrentOpenTab: function()\r\n    {\r\n        this.hideTab($(\".aTab.opened\"));\r\n    },\r\n    init: function()\r\n    {\r\n        (function(){\r\n            createCustomEvent(\"familySelectedEvent\");\r\n            createCustomEvent(\"familyFieldsLoadedEvent\");\r\n        })();\r\n\r\n        var _this = this;\r\n\r\n        $.when(\r\n            $.getScript( \"/adiJed/js/ui/list.js?ver=6.7.2.20250507.P6\" ),\r\n            $.getScript( \"/adiJed/js/ui/generic-search.js?ver=6.7.2.20250507.P6\" ),\r\n            $.Deferred(function( deferred ){\r\n                $( deferred.resolve );\r\n            })\r\n        ).done(function(){\r\n            _this.familyTreeContainer = $(\"#family-tree-container\");\r\n            _this.familiesTree = _this.showFamilies(function(){\r\n                \r\n                _this.restoreFamiliesTreeViewState();\r\n                \r\n                _this.attachPageEvents();\r\n                _this.loadSavedQueryFamilies();\r\n                \r\n            });\r\n\r\n            _this.dfdJsLibs.resolve();\r\n        });\r\n        this.setupCrumb();\r\n        this.setupSplitter();\r\n\r\n        this.__instance = this;\r\n    },\r\n    attachEvents: function()\r\n    {\r\n    }\r\n};\r\n\r\nvar mode = \"\";\r\nvar pageUnique = \"\";\r\nvar MAX_SUGGEST_RESULT = 300;\r\n\r\nfunction doQuery() {\r\n    var c = $(\"#filter2-fields\");\r\n    var frmDoQuery = $(\"#frmDoQuery\");\r\n    var i;\r\n\r\n    if(c.hasClass(\"opened\"))\r\n    {\r\n        $(\".filter2-field input\").each(function(){\r\n            $(\"#\"+$(this).attr(\"id\")+\".txtField\", frmDoQuery).val($(this).val());\r\n            $(\"select#qf\"+$(this).attr(\"id\"), frmDoQuery).val(\"eq\");\r\n        });\r\n    }\r\n\r\n    for(i=0; i<$(\".txtField\", frmDoQuery).length; i++)\r\n    {\r\n        var fld = $($(\".txtField\", frmDoQuery)[i]);\r\n\r\n        if(fld.attr(\"aditype\") == 3)\r\n        {\r\n            if(fld.val() != '' && ! fld.val().match(datePattern))\r\n            {                     /*Il campo*/                                                                          /*contiene dati non validi.*/\r\n                showErrorMessage(\"Il campo \"+fld.attr(\"adilabel\")+\" contiene dati non validi.\");\r\n                return false;\r\n            }\r\n        }\r\n        else if(fld.attr(\"aditype\") == 1)\r\n        {\r\n            var thisOp = $(\".cboOP[fieldid=\"+fld.attr(\"fieldregid\")+\"]\").val();\r\n            if(fld.val() != '') {\r\n                if(thisOp != \"in\") {\r\n                    if(fld.val() != '' && isNaN(fld.val())) \r\n                    {                      /*Il campo*/                                                                  /*contiene dati non validi.*/\r\n                        showErrorMessage(\"Il campo \"+fld.attr(\"adilabel\")+\" contiene dati non validi.\");\r\n                        return false;\r\n                    }\r\n                } else {\r\n                    var allValues = fld.val().split(\",\");\r\n                    for(var iv=0; iv<allValues.length; iv++) {\r\n                        if(allValues[iv] == \"\" || isNaN(allValues[iv])) {\r\n                            showErrorMessage(\"Il campo \"+fld.attr(\"adilabel\")+\" contiene dati non validi.\");\r\n                            return false;\r\n                        }\r\n                    }\r\n                }\r\n            }\r\n        }\r\n        else if(fld.attr(\"aditype\") == 4)\r\n        {\r\n            if(fld.val() != '' && fld.val().length > 255)\r\n            {                      /*Il campo*/                                                                     /*contiene dati non validi.*/\r\n                showErrorMessage(\"Il campo \"+fld.attr(\"adilabel\")+\" contiene dati non validi.\");\r\n                return false;\r\n            }\r\n        }\r\n    }\r\n\r\n    // controllo campi ok, esegue la ricerca\r\n    var filterPageState = {};\r\n    var fields = [];\r\n    $(\".txtField\", frmDoQuery).each(function(){\r\n        var _this = $(this);\r\n        var _id = _this.attr(\"id\");\r\n        var _model_val = \"\";\r\n        var _fill_from_model = false;\r\n        var isSecondField = _this.hasClass(\"txtField2\");\r\n        var fieldRegId = _this.attr(\"fieldRegID\");\r\n        if(_this.attr(\"fillType\") == 94 || _this.attr(\"fillType\") == 96 || _this.attr(\"fillType\") == 99 || _this.attr(\"fillType\") == 100 || _this.attr(\"fillType\") == 101)  //Fill Multivalue//Fill Roles //Fill Users //Fill Sector\r\n        {\r\n            _fill_from_model = true;\r\n            _model_val = (!isSecondField ? $(\"#hidden\"+fieldRegId).val() : $(\"#hidden-2fld\"+fieldRegId).val());\r\n        }\r\n\r\n        var _op = $(\"#qf\"+fieldRegId).val();\r\n        if(_op && _op != \"\") {\r\n            fields.push({\r\n                \"id\": _id,\r\n                \"val\": _this.val(),\r\n                \"fieldRegId\": fieldRegId,\r\n                \"isSecondField\": isSecondField,\r\n                \"model-val\": _model_val,\r\n                \"fill-from-model\": _fill_from_model,\r\n                \"op\": _op\r\n            });\r\n        }\r\n    });\r\n    filterPageState[\"fieldsState\"] = fields;\r\n\r\n    for(i=0; i<$(\".txtField\", frmDoQuery).length; i++)\r\n    {\r\n        var fld = $($(\".txtField\", frmDoQuery)[i]);\r\n\r\n        if(fld.attr(\"aditype\") == 3)\r\n        {\r\n            if(fld.val() != '')\r\n            {\r\n                // prendo il valore con i '/' perch?quando faccio il remove di inputmask me li toglieva\r\n                var _val = fld.val();\r\n                // rimuovo la inputmask sul campo altrimenti non mi fa scrivere la data in formato yyyymmdd che usiamo per la ricerca\r\n                fld.inputmask(\"remove\");\r\n                var dateArray = _val;\r\n                // lo riscrivo nel campo come yyyymmdd\r\n                fld.val(dateArray.split(\"/\")[2]+''+dateArray.split(\"/\")[1]+''+dateArray.split(\"/\")[0]);\r\n            }\r\n        }\r\n\r\n        if(fld.attr(\"aditype\") == 2)\r\n        {\r\n            if(fld.val() != '')\r\n            {\r\n                var _val = fld.val();\r\n                fld.val(_val.replace(/\\,/g,'.'));\r\n            }\r\n        }\r\n\r\n        //Setto gli id degli users, roles, sector nel field che verrà utilizzato lato server per fare la query\r\n        if(fld.attr(\"fillType\") == 94 || fld.attr(\"fillType\") == 96 || fld.attr(\"fillType\") == 99 || fld.attr(\"fillType\") == 100 || fld.attr(\"fillType\") == 101)  //Fill Multivalue//Fill Roles //Fill Users //Fill Sector\r\n        {\r\n            var isSecondField = fld.hasClass(\"txtField2\");\r\n            var fieldRegId = fld.attr(\"id\");\r\n            fld.val(!isSecondField ? $(\"#hidden\"+fieldRegId).val() : $(\"#hidden-2fld\"+fieldRegId).val());\r\n        }\r\n    }\r\n\r\n    var workflowStatus = $(\"#wfStatus\").val();\r\n    //var thumbSelected = $(\"#checkThumb\").is(':checked');\r\n    var thumbSelected = $(\"#showThumbnails\").hasClass(\"pressed\");\r\n    var filterParams = frmDoQuery.serialize();\r\n    var families = queryPage.serializeFamilies();\r\n    var showTrack = $(\"#showTrack\").val();\r\n    \r\n    frmDoQuery.submit(function() { return false; });\r\n    var resultsPageKey = getUniqueID();\r\n    var k = \"/results/?\"+resultsPageKey;\r\n    var q = filterParams+\"&\"+families+\"&mode=\"+mode+\"&pageUnique=\"+pageUnique+\"&workflowStatus=\"+workflowStatus+\"&thumbSelected=\"+thumbSelected;\r\n    if (showTrack)\r\n        q = q+\"&showTrack=\"+showTrack;\r\n\r\n    if(''=='true'){\r\n        q = q+\"&fromLoadedQuery=true\";\r\n        q = q+\"&savedQueryName=\";\r\n    }\r\n\r\n    HistoryManager.getCurrentPage()[\"data\"] = filterPageState;\r\n    HistoryManager.getCurrentPage()[\"families\"] = queryPage.getFamiliesSelected();\r\n    HistoryManager.getCurrentPage()[\"famTreeScroll\"] = queryPage.familiesTree.familiesTreeContainer.scrollTop();\r\n    HistoryManager.getCurrentPage()[\"workflowStatus\"] = workflowStatus;\r\n    HistoryManager.getCurrentPage()[\"showTrack\"] = showTrack;\r\n    HistoryManager.saveQueryToHistory(k, q, undefined);\r\n\r\n    //ROSSTE - 20190820 - In caso di aggiunta link non memorizzo la pagina\r\n    if (mode == \"addLink\"){\r\n        saveHistoryAndDisplayPage('/results/?', \"/adiJed/ui/query/find.do\", q, false, false, HistoryConstants.LOAD_AND_FORGET);\r\n    }else{\r\n        HistoryManager.navigateTo('/results/?', \"/adiJed/ui/query/find.do\", q, resultsPageKey);\r\n    }\r\n    return true;\r\n}\r\n\r\nvar listFields = null;\r\nfunction listValueSelected(values, firstVal) {\r\n    var listValue;\r\n    var selectedListID = this._listID;\r\n    var compileAll = values.compileAll;\r\n    while( (listValue = values.getNextValue()) != null ) {\r\n        var listField = listValue.getFieldID();\r\n        if(listField.indexOf(ListManager.getFamilyType())!=0) {\r\n            listField = ListManager.getFamilyType()+listField;\r\n        }\r\n        var fieldId = listField;\r\n        if(fieldId.indexOf('F')==0||fieldId.indexOf('D')==0||fieldId.indexOf('T')==0){\r\n            fieldId = fieldId.substring(1, listField.length);\r\n        }\r\n\r\n        if(compileAll || (fieldId == ListManager.getFieldID())){   //Compilo solo il campo dove ho cliccato oppure tutti se nella lista ho cliccato seleziona tutti\r\n            var _field = firstVal? $(\"#\"+listField) : $(\"#2fld\"+listField);\r\n            var fieldListID = _field.attr(\"list-id\");\r\n            if(selectedListID == fieldListID) {\r\n                if(_field.attr(\"disabled\") == \"disabled\") {\r\n                    $(\"#qf\"+listField).val(\"\");\r\n                }\r\n                _field.val(listValue.getValue());\r\n                try {\r\n                    _field.trigger(\"change\");\r\n                } catch(e) {\r\n                }\r\n            }\r\n        }\r\n    }\r\n    $(\"#\"+ListManager.getFieldID()).select();\r\n}\r\nfunction usersSelected(values, firstVal) {\r\n    var selectedUsersLabel = [], selectedUsersID = [];\r\n    for(var iu=0; iu<values.length; iu++) {\r\n        selectedUsersLabel.push(values[iu].text);\r\n        selectedUsersID.push(values[iu].id);\r\n    }\r\n\r\n    if(firstVal){\r\n        var $fld = $(\"#\"+ListManager.getFamilyType()+ListManager.getFieldID());\r\n        $fld.val(selectedUsersLabel.join(', '));\r\n        $(\"#hidden\"+ListManager.getFamilyType()+ListManager.getFieldID()).val(selectedUsersID.join(','));\r\n        $fld.select();\r\n        try { $fld.trigger(\"change\"); } catch(e) { }\r\n    }else{\r\n        var $fld = $(\"#2fld\"+ListManager.getFamilyType()+ListManager.getFieldID());\r\n        $fld.val(selectedUsersLabel.join(', '));\r\n        $(\"#hidden-2fld\"+ListManager.getFamilyType()+ListManager.getFieldID()).val(selectedUsersID.join(','));\r\n        $fld.select();\r\n        try { $fld.trigger(\"change\"); } catch(e) { }\r\n    }\r\n}\r\nfunction rolesSelected(values, firstVal) {\r\n    var selectedRolesLabel = [], selectedRolesID = [];\r\n    for(var iu=0; iu<values.length; iu++) {\r\n        selectedRolesLabel.push(values[iu].text);\r\n        selectedRolesID.push(values[iu].id);\r\n    }\r\n\r\n    if(firstVal){\r\n        var $fld = $(\"#\"+ListManager.getFamilyType()+ListManager.getFieldID());\r\n        $fld.val(selectedRolesLabel.join(', '));\r\n        try { $fld.trigger(\"change\"); } catch(e) { }\r\n        $(\"#hidden\"+ListManager.getFamilyType()+ListManager.getFieldID()).val(selectedRolesID.join(','));\r\n        $fld.select();\r\n    }else{\r\n        var $fld = $(\"#2fld\"+ListManager.getFamilyType()+ListManager.getFieldID());\r\n        $fld.val(selectedRolesLabel.join(', '));\r\n        try { $fld.trigger(\"change\"); } catch(e) { }\r\n        $(\"#hidden-2fld\"+ListManager.getFamilyType()+ListManager.getFieldID()).val(selectedRolesID.join(','));\r\n        $fld.select();\r\n    }\r\n}\r\nfunction sectorsSelected(values, firstVal) {\r\n    var selectedSectorsLabel = [], selectedSectorsID = [];\r\n    for(var iu=0; iu<values.length; iu++) {\r\n        selectedSectorsLabel.push(values[iu].text);\r\n        selectedSectorsID.push(values[iu].id);\r\n    }\r\n    if(firstVal){\r\n        var $fld = $(\"#\"+ListManager.getFamilyType()+ListManager.getFieldID());\r\n        $fld.val(selectedSectorsLabel.join(', '));\r\n        $(\"#hidden\"+ListManager.getFamilyType()+ListManager.getFieldID()).val(selectedSectorsID.join(','));\r\n        $fld.select();\r\n        try { $fld.trigger(\"change\"); } catch(e) { }\r\n    }else{\r\n        var $fld = $(\"#2fld\"+ListManager.getFamilyType()+ListManager.getFieldID());\r\n        $fld.val(selectedSectorsLabel.join(', '));\r\n        $(\"#hidden-2fld\"+ListManager.getFamilyType()+ListManager.getFieldID()).val(selectedSectorsID.join(','));\r\n        $fld.select();\r\n        try { $fld.trigger(\"change\"); } catch(e) { }\r\n    }\r\n}\r\nfunction valuesSelected(values, firstVal) {\r\n    var listField = ListManager.getFieldID();\r\n    if(listField.indexOf(ListManager.getFamilyType())!=0) {\r\n        listField = ListManager.getFamilyType()+listField;\r\n    }\r\n    var fieldId = listField;\r\n    if(fieldId.indexOf('F')==0||fieldId.indexOf('D')==0){\r\n        fieldId = fieldId.substring(1, listField.length);\r\n    }\r\n    if(firstVal){\r\n        var $fld = $(\"#\"+listField);\r\n        $fld.val(values.join(', '));\r\n        $(\"#hidden\"+listField).val(values.join(','));\r\n        $fld.select();\r\n        try { $fld.trigger(\"change\"); } catch(e) { }\r\n    }else{\r\n        var $fld = $(\"#2fld\"+listField);\r\n        $fld.val(values.join(', '));\r\n        $(\"#hidden-2fld\"+listField).val(values.join(','));\r\n        $fld.select();\r\n        try { $fld.trigger(\"change\"); } catch(e) { }\r\n    }\r\n}\r\n\r\nfunction vqFilter_click(restoringPreviousState){\r\n    // nascondo configurazione ed elenco ricerche salvate\r\n    $(\".visual-queries\").remove();\r\n    $(\"#no-fields-message\").fadeOut(jQuery.fx.speeds.fast);\r\n\r\n    var c = $(\"#vq-container\");\r\n    var cf = c.find(\".vq-config > #vq-available-fields\");\r\n    var af = $(\"#vq-active-filters > .add-filter-droppable\");\r\n    var _mySavedVQ = AdiutoUserSettings.load(\"visualQueries%\", {}, true);\r\n    var _assignedVQ = AdiutoUserSettings.load(\"assigned-vq\", {}, true);\r\n\r\n    var _savedSettings = {data: []};\r\n    _savedSettings[\"data\"] = _savedSettings[\"data\"].concat(_mySavedVQ[\"data\"]||[]);\r\n    _savedSettings[\"data\"] = _savedSettings[\"data\"].concat(_assignedVQ[\"data\"]||[]);\r\n\r\n    if(_savedSettings[\"data\"] && _savedSettings[\"data\"].length) {\r\n        queryPage.loadSavedVisualQueries(_savedSettings);\r\n    } else if( !$(\".saved-queries-container\").find(\"> .no-visual-queries\").length ) {\r\n        $(\".saved-queries-container\").append(\r\n            $(\"<h4>\").css({\r\n                \"font-size\": \"120%\", \"padding-left\": \"15px\", \"position\": \"absolute\",\r\n                \"top\": 0, \"left\": 0\r\n            }).addClass(\"no-visual-queries\").text(\"Nessuna query visuale salvata\") //Nessuna query visuale salvata\r\n        );\r\n    }\r\n\r\n    af.droppable({\r\n        drop: function( event, ui ) {\r\n            var draggable = ui.draggable;\r\n\r\n            $(\"<div>\").addClass(\"vq-folder\")\r\n                    .attr(\"frid\", draggable.attr(\"frid\"))\r\n                    .attr(\"df\", draggable.attr(\"isDetail\"))\r\n                    .attr(\"label\", draggable.attr(\"adilabel\"))\r\n                    .append(\r\n                            $(\"<span>\").text(draggable.attr(\"adilabel\")).append($(\"<span>\").addClass(\"clear-input-value\").click(function(){\r\n                                var _this = $(this);\r\n                                var parentNode = _this.parent().parent();\r\n                                var parentNodeContainer = parentNode.parent();\r\n                                var childNode = parentNode.find(\"> div\");\r\n\r\n                                if(parentNodeContainer.hasClass(\"vq-config\"))\r\n                                {\r\n                                    childNode.prependTo(parentNodeContainer);\r\n                                }\r\n                                else\r\n                                {\r\n                                    childNode.appendTo(parentNodeContainer);\r\n                                }\r\n                                $(\"span[frid=\"+parentNode.attr(\"frid\")+\"]\",cf).css(\"display\",\"inline-block\");\r\n                                parentNode.remove();\r\n                            }))\r\n                    ).insertBefore(af.parent()).append(af.parent());\r\n\r\n            draggable.css(\"display\",\"none\");\r\n        },\r\n        hoverClass: 'hovered'\r\n    });\r\n\r\n    var loadAvailableFieldsForVisualQuery = function(){\r\n        var cf = c.find(\".vq-config > #vq-available-fields\");\r\n        if( queryPage.getFamiliesSelected().length ) {\r\n            var existsInput = false;\r\n            $(\"td.fld-cell > span:first-child input.txtField[type='text']\").each(function(){\r\n                existsInput = true;\r\n                var f = $(this);\r\n                if(!f.hasClass(\"txtField2\")) {\r\n                    var frid = f.attr(\"id\").replace(/\\D/g,'');\r\n\r\n                    $(\"<span>\")\r\n                            .text(f.attr(\"adilabel\"))\r\n                            .attr(\"adilabel\", f.attr(\"adilabel\"))\r\n                            .attr(\"frid\", frid)\r\n                            .attr(\"isDetail\", f.attr(\"id\").substring(0,1) === \"D\")\r\n                            .addClass(\"field-available\")\r\n                            .addClass((f.attr(\"id\").substring(0,1) === \"D\") ? \"detail-field\" :\"\")\r\n                            \r\n                            .appendTo(cf)\r\n                            .draggable({helper: 'clone'})\r\n                    ;\r\n                }\r\n            });\r\n\r\n            if(existsInput) {\r\n                $(\".vq-config\").fadeIn();\r\n            }\r\n        }\r\n    };\r\n\r\n    var displayVisualQueryFiltersForm = function() {\r\n        var cf = c.find(\".vq-config > #vq-available-fields\");\r\n        if(c.find(\".vq-config > .vq-folder\").length)\r\n            $(\"#vq-active-filters\").prependTo(c.find(\".vq-config\"));\r\n        c.find(\".vq-config > .vq-folder\").remove();\r\n        if( queryPage.getFamiliesSelected().length ) {\r\n            cf.html(\"\");\r\n            $(\"#vq-active-filters\").fadeIn();\r\n            $(\"#vq-toolbar\").fadeIn();\r\n        } else {\r\n            $(\"#vq-active-filters\").fadeOut();\r\n            $(\"#vq-toolbar\").fadeOut();\r\n            cf.html('<h4 style=\"cursor:pointer;font-size:120%;padding-left:15px;position:absolute;top:0;left:0;\"><a href=\"javascript:void(0)\">Selezionare almeno una famiglia</a></h4>');//Selezionare almeno una famiglia\r\n            cf.find(\"> h4\").off('click').on('click', function(){\r\n                DivSplitter.restore($(\"#application-left-bar\"), $(\"#content\"));\r\n            });\r\n        }\r\n    };\r\n\r\n    if(!restoringPreviousState) {\r\n        displayVisualQueryFiltersForm();\r\n    }\r\n    loadAvailableFieldsForVisualQuery();\r\n    $(self).off(\"familyFieldsLoadedEvent\", null, loadAvailableFieldsForVisualQuery).on(\"familyFieldsLoadedEvent\", loadAvailableFieldsForVisualQuery);\r\n    $(self).off(\"familySelectedEvent\").on(\"familySelectedEvent\", displayVisualQueryFiltersForm);\r\n    $(self).off(\"visualQueryExecutedEvent\").on(\"visualQueryExecutedEvent\",function(){DivSplitter.hideLeft($(\"#application-left-bar\"), $(\"#content\"));})\r\n};\r\n\r\nvar loadSavedQuery = function(){\r\n    if(''!=''){\r\n        $.ajax({\r\n            type: \"POST\",\r\n            url: \"/adiJed/ui/saved-search.do\",\r\n            dataType: 'json',\r\n            data: \"action=getInfo&name=\"+''\r\n        }).done(function(result){\r\n            var items = result[\"savedQuery\"].campi;\r\n            \r\n            $.each(items, function(j,item){\r\n                try{\r\n                    if(result[\"savedQuery\"].campiDettaglio[j]==false){\r\n                        $(\"#qfF\"+item).val(result[\"savedQuery\"].operatori[j]).change();\r\n                        if ($(\"#F\"+item).hasClass(\"type3\")){\r\n                            var sVal1 = result[\"savedQuery\"].val1[j];\r\n                            var sVal2 = result[\"savedQuery\"].val2[j];\r\n                            \r\n                            if (sVal1)\r\n                                sVal1 = sVal1.substring(6, 8)+'/'+sVal1.substring(4, 6)+'/'+sVal1.substring(0, 4);\r\n                            if (sVal2)\r\n                                sVal2 = sVal2.substring(6, 8)+'/'+sVal2.substring(4, 6)+'/'+sVal2.substring(0, 4);\r\n                            \r\n                            $(\"#F\"+item).val(sVal1);\r\n                            $(\"#2fldF\"+item).val(sVal2);\r\n                        }else{\r\n                            if(result[\"savedQuery\"].valDesc[j]!=\"\"){\r\n                                $(\"#hiddenF\"+item).val(result[\"savedQuery\"].val1[j]);\r\n                                $(\"#F\"+item).val(result[\"savedQuery\"].valDesc[j]);\r\n                            } else {\r\n                            $(\"#F\"+item).val(result[\"savedQuery\"].val1[j]);\r\n                            $(\"#2fldF\"+item).val(result[\"savedQuery\"].val2[j]);\r\n                        }\r\n                        }\r\n                    }else{\r\n                        $(\"#qfD\"+item).val(result[\"savedQuery\"].operatori[j]).change();\r\n                        if ($(\"#D\"+item).hasClass(\"type3\")){\r\n                            var sVal1 = result[\"savedQuery\"].val1[j];\r\n                            var sVal2 = result[\"savedQuery\"].val2[j];\r\n                            \r\n                            if (sVal1)\r\n                                sVal1 = sVal1.substring(6, 8)+'/'+sVal1.substring(4, 6)+'/'+sVal1.substring(0, 4);\r\n                            if (sVal2)\r\n                                sVal2 = sVal2.substring(6, 8)+'/'+sVal2.substring(4, 6)+'/'+sVal2.substring(0, 4);\r\n                            \r\n                            $(\"#D\"+item).val(sVal1);\r\n                            $(\"#2fldD\"+item).val(sVal2);\r\n                        }else{\r\n                            if(result[\"savedQuery\"].valDesc[j]!=\"\"){\r\n                                $(\"#hiddenD\"+item).val(result[\"savedQuery\"].val1[j]);\r\n                                $(\"#D\"+item).val(result[\"savedQuery\"].valDesc[j]);\r\n                            } else {\r\n                            $(\"#D\"+item).val(result[\"savedQuery\"].val1[j]);\r\n                            $(\"#2fldD\"+item).val(result[\"savedQuery\"].val2[j]);\r\n                        }\r\n                    }\r\n                    }\r\n                }catch(e){}\r\n            });\r\n\r\n            if(result[\"savedQuery\"].isThumbView==true){\r\n                $(\"#showThumbnails\").click();\r\n            }\r\n            \r\n            if(result[\"savedQuery\"].showTrack>0){\r\n                $(\"#showTrack\").val(result[\"savedQuery\"].showTrack);\r\n            }\r\n            \r\n            if(result[\"savedQuery\"].workflowStatus>0){\r\n                $(\"#wfStatus\").val(result[\"savedQuery\"].workflowStatus);\r\n            }\r\n        });\r\n    }\r\n};\r\n\r\nvar queryPage = null;\r\n\r\n$(document).ready(function () {\r\n    if(queryPage == null)\r\n        queryPage = new QueryPage();\r\n\r\n    $(\"ul#family-list\").scroll(function(e){\r\n        adiutoTopWin.familiesLastScrollPosition = $(\"ul#family-list\").scrollTop();\r\n    });\r\n\r\n    if(adiutoTopWin.familiesLastScrollPosition)\r\n        $(\"ul#family-list\").scrollTop(adiutoTopWin.familiesLastScrollPosition);\r\n\r\n    var loadSavedQueries_click = function(){\r\n        var c = $(\"#saved-queries\");\r\n        $(\"#saved-queries\").load(\"/adiJed/ui/saved-search.do\",\"action=load-all&mode=\"+mode+\"&pageUnique=\"+pageUnique,function(){\r\n            $(\".aTab.opened\", $(\"#content.query\")).removeClass(\"opened\");\r\n            $(\"#no-fields-message\").fadeOut(jQuery.fx.speeds.fast);\r\n            c.addClass(\"opened\").animate({opacity: 1},300);\r\n\r\n            var filter2 = $(\"#filter2-fields\");\r\n            if(filter2.hasClass(\"opened\"))\r\n            {\r\n                filter2.animate({opacity: 0},300,function(){\r\n                    filter2.removeClass(\"opened\");\r\n                });\r\n            }\r\n            else\r\n            {\r\n                $(\"#form-fields\").animate({top: '500px', opacity: 0},300,function(){\r\n                    $(\"#form-fields\").css(\"display\",\"none\");\r\n                });\r\n            }\r\n        });\r\n    };\r\n    $(\"#load-saved-queries\").click(function(){\r\n        onTabClick($(\"#saved-queries\"), function(){}, loadSavedQueries_click);\r\n    });\r\n\r\n    var onTabClick = function(tabContainer, callbackBefore, callbackAfter)\r\n    {\r\n        callbackBefore.apply(this);\r\n        tabContainer.addClass(\"tabContainer\");\r\n\r\n        if(!tabContainer.hasClass(\"opened\"))\r\n        {\r\n            $(\".aTab.opened\", $(\"#content.query\")).removeClass(\"opened\");\r\n            tabContainer.addClass(\"opened\").animate({opacity: 1},300);\r\n            queryPage.hideQueryFilters();\r\n            callbackAfter.apply(this);\r\n        }\r\n        else\r\n        {\r\n            queryPage.hideTab(tabContainer);\r\n            DivSplitter.restore($(\"#application-left-bar\"), $(\"#content\"));\r\n            queryPage.showQueryFilters();\r\n        }\r\n    };\r\n    \r\n    $(\".family-type-T\")\r\n\r\n    $(\"#clean-values\").click(function(){\r\n        $(\".txtField\").val(\"\");\r\n        $(\"input[type=hidden][filltype]\").val(\"\");\r\n        $(\".cboOP\").val(\"\");\r\n        $(\".cboOP\").change();\r\n        $(\".txtField:first\").focus();\r\n    });\r\n    var filter2_click = function(){\r\n        var c = $(\"#filter2-fields\");\r\n        var cf = c.find(\"> #available-fields\");\r\n        $(\"#show-results\").unbind('click').click(doQuery);\r\n        var af = $(\"#active-filters\");\r\n\r\n        var countResults = function(){\r\n            var qq2 = [];\r\n            $(\".filter2-field input\").each(function(){\r\n                qq2.push( $(this).attr(\"name\")+\"=\"+encodeURIComponent($(this).val()) );\r\n            });\r\n\r\n            $.ajax({\r\n                type: \"POST\",\r\n                url: \"/adiJed/ui/filter-dyn.do\",\r\n                dataType: \"json\",\r\n                data: \"action=count&\"+queryPage.serializeFamilies()+\"&\"+qq2.join(\"&\")\r\n            }).done(function(result){\r\n                var txt = \"Documenti trovati: \"+result.result.count;   /*Documenti trovati:*/\r\n                if(result.result.count >= MAX_SUGGEST_RESULT)\r\n                    txt += \"+\";\r\n                $(\"#result-count\").text(txt);\r\n                $(\"#show-results\").css(\"display\",\"inline\");\r\n            });\r\n        };\r\n\r\n        af.droppable({\r\n            drop: function( event, ui ) {\r\n                af.css(\"opacity\",\".3\");\r\n                cf.css(\"opacity\",\".3\");\r\n                cf.append($(\"<div>\").addClass(\"block-fields\").css(\"height\",\"100%\").css(\"z-index\",\"2\"));\r\n                af.append($(\"<div>\").addClass(\"block-fields\").css(\"height\",\"100%\").css(\"z-index\",\"2\"));\r\n\r\n                var draggable = ui.draggable;\r\n                var newField = $(\"#\"+draggable.attr(\"frid\")).clone().removeAttr(\"data-bind\");\r\n\r\n                $(\"<div>\").append(newField)\r\n                        .addClass(\"filter2-field\")\r\n                        .prepend($(\"<span>\").addClass(\"filter2-label\").text(draggable.text()))\r\n                        .insertBefore(af);\r\n\r\n                var qq = [];\r\n                $(\".filter2-field input\").each(function(){\r\n                    qq.push( $(this).attr(\"name\")+\"=\"+encodeURIComponent($(this).val()) );\r\n                    qq.push( \"df=\"+encodeURIComponent($(this).attr(\"isDetail\")) );\r\n                });\r\n\r\n                newField.kendoAutoComplete({\r\n                    dataTextField: \"text\",\r\n                    minLength: 0,\r\n                    dataSource: new kendo.data.DataSource({\r\n                        serverFiltering: true,\r\n                        type: \"json\",\r\n                        transport: {\r\n                            read: { url: \"/adiJed/ui/filter-dyn.do?\"+queryPage.serializeFamilies()+\"&\"+qq.join(\"&\") },\r\n                            parameterMap: function (data, action) {\r\n                                if(action === \"read\" && data.filter) {\r\n                                    return {\r\n                                        action: \"search\",\r\n                                        q: data.filter.filters[0].value,\r\n                                        frid: newField.attr(\"id\")\r\n                                    };\r\n                                } else {\r\n                                    return data;\r\n                                }\r\n                            }\r\n                        },\r\n                        schema: {\r\n                            data: function(response) { return response.result.values; },\r\n                            model: { val: \"text\", familyID: \"f\" }\r\n                        }\r\n                    }),\r\n                    select: function(e) {\r\n                        var item = e.item;\r\n                        var text = item.text();\r\n                        if(text != \"\")\r\n                        {\r\n                            $(this).val(text);\r\n                            newField\r\n                                    .attr(\"disabled\", \"disabled\")\r\n                                    .attr(\"readonly\", \"true\")\r\n                                    .css(\"background-color\",\"whitesmoke\")\r\n                                    .css(\"background-color\",\"whitesmoke\")\r\n                            ;\r\n                            af.css(\"opacity\",\"1\");\r\n                            cf.css(\"opacity\",\"1\");\r\n                            $(\".block-fields\").remove();\r\n                            setTimeout(countResults, 500);\r\n                        }\r\n                    }\r\n                });\r\n\r\n                newField.focus();\r\n\r\n                $(\"<span>\").addClass(\"clear-input-value\").css(\"right\",\"-25px\").click(function(){\r\n                    newField.parent().parent().remove();\r\n                    af.css(\"opacity\",\"1\");\r\n                    cf.css(\"opacity\",\"1\");\r\n                    $(\"#result-count\").text(\"\");\r\n                    $(\"#show-results\").css(\"display\",\"none\");\r\n                    $(\".block-fields\").remove();\r\n\r\n                    if($(\".filter2-field input\").length){\r\n                        countResults();\r\n                    }\r\n\r\n                    $(\"<span>\").text(newField.attr(\"adilabel\"))\r\n                            .attr(\"frid\", newField.attr(\"id\"))\r\n                            .addClass(\"field-available\")\r\n                            .appendTo(cf)\r\n                            .draggable({helper: 'clone'})\r\n                    ;\r\n                }).insertAfter(newField);\r\n\r\n                draggable.remove();\r\n            },\r\n            hoverClass: 'hovered'\r\n        });\r\n\r\n        cf.html(\"\");\r\n\r\n        $(\"td.fld-cell > span:first-child > input.txtField[type='text']\").each(function(){\r\n            var f = $(this);\r\n            if(!f.hasClass(\"txtField2\")) {\r\n                $(\"<span>\")\r\n                        .text(f.attr(\"adilabel\"))\r\n                        .attr(\"adilabel\", f.attr(\"adilabel\"))\r\n                        .attr(\"frid\", f.attr(\"id\"))\r\n                        .attr(\"isDetail\", f.attr(\"id\").substring(0,1) === \"D\")\r\n                        .addClass(\"field-available\")\r\n                        .appendTo(cf)\r\n                        .draggable({helper: 'clone'})\r\n                ;\r\n            }\r\n        });\r\n    };\r\n\r\n    $(\"#filter2\").click(function(){\r\n        onTabClick($(\"#filter2-fields\"), function(){}, filter2_click);\r\n    });\r\n\r\n    var visualQuerySearch;\r\n\r\n    $(\"#save-visual-query\").click(function(){\r\n        DialogManager.inputBox(\r\n                \"Scegli un nome per la ricerca salvata\",     /*Scegli un nome per la ricerca salvata*/\r\n                function(searchName){salvaQueryVisuali(searchName); $.modal.close();},\r\n                function(){$.modal.close();},\r\n                \"Salva ricerca\"         /*Salva ricerca*/\r\n        );\r\n    });\r\n    $(\"#execute-visual-query\").click(function(){\r\n        $(\".tab[tabid='current-queries-container']\").trigger(\"click\");\r\n        VisualQuery.executeVisualQuery({\"q\": createVisualQueryObject(),\"rootContainer\": $(\".current-queries-container.tab-content\")});\r\n        visualQuerySearch = GenericSearch.getInstance($(\".visual-query-tree\"), '.vq-tree-line', ' > span:first');\r\n        visualQuerySearch.setup($(\"#vq-search-term\"));\r\n    });\r\n\r\n    var createVisualQueryObject = function(searchName) {\r\n        var currentVQ = {                                  /*Nuova ricerca*/\r\n            \"pk\": getUniqueID(), \"label\": searchName||\"Nuova ricerca*\", \"families\": [], \"fields\": []\r\n        };\r\n\r\n        var selectedFamilies = [];\r\n        for(var ifam=0; ifam<queryPage.getFamiliesSelected().length; ifam++) {\r\n            selectedFamilies.push({\r\n                \"id\": queryPage.getFamiliesSelected()[ifam].id, \"label\": queryPage.getFamiliesSelected()[ifam].text\r\n            });\r\n        }\r\n        currentVQ[\"families\"] = selectedFamilies;\r\n\r\n        var selectedFields = {};\r\n        var currField = null, _container = $(\".vq-config\");\r\n        while( $(\".vq-folder\", _container).length )\r\n        {\r\n            var vqElement = $( $(\".vq-folder\", _container)[0] );\r\n            var obj = {\r\n                \"id\": vqElement.attr(\"frid\"), \"label\": vqElement.attr(\"label\"), \"nextField\": {}, \"df\": vqElement.attr(\"df\")\r\n            };\r\n\r\n            if(currField == null)\r\n                selectedFields = obj;\r\n            else\r\n                currField[\"nextField\"] = obj;\r\n\r\n            currField = obj;\r\n            _container = vqElement;\r\n        }\r\n        currentVQ[\"families\"] = selectedFamilies;\r\n        currentVQ[\"fields\"] = selectedFields;\r\n        return currentVQ;\r\n    }\r\n\r\n    var salvaQueryVisuali = function(searchName){\r\n        var _mySavedVQ = AdiutoUserSettings.load(\"visualQueries%\", {}, true);\r\n        var _assignedVQ = AdiutoUserSettings.load(\"assigned-vq\", {}, true);\r\n\r\n        var _savedSettings = {data: []};\r\n        _savedSettings[\"data\"] = _savedSettings[\"data\"].concat(_mySavedVQ[\"data\"]||[]);\r\n        _savedSettings[\"data\"] = _savedSettings[\"data\"].concat(_assignedVQ[\"data\"]||[]);\r\n\r\n        var currentVQ = createVisualQueryObject(searchName);\r\n        _savedSettings[\"data\"].push({$: currentVQ});\r\n\r\n        AdiutoUserSettings.save(\"visualQueries_\"+currentVQ.pk, currentVQ, true);\r\n        queryPage.loadSavedVisualQueries(_savedSettings);\r\n    };\r\n    $(\"#vq-filter\").click(function(){\r\n        onTabClick($(\"#vq-container\"), function(){}, vqFilter_click);\r\n    });\r\n\r\n    var _evt_type = isTablet() ? \"tap\" : \"click\";\r\n\r\n    $(\"#showThumbnails\").unbind(_evt_type).on(_evt_type, function(){\r\n        if($(this).hasClass(\"pressed\")){\r\n            $(this).removeClass(\"pressed\");\r\n        }else{\r\n            $(this).addClass(\"pressed\");\r\n        }\r\n    });\r\n\r\n    try { $.modal.close(); } catch(e) {}\r\n});\r\n\r\n//# sourceURL=http://172.16.90.4:8080/adiJed/ui/query/page.jsp\r\n</script>\r\n"
