          "content": {
            "size": 10908,
            "mimeType": "text/javascript",
            "compression": -1,
            "text": "/**\r\n * Created by lorenzo on 05/08/14.\r\n */\r\n\r\nfunction getLastMemoryObjectDate(key, doneCallback){\r\n    var utilityActionsBaseUrl = \"/adiJed/ui/train-utility-actions.do\";\r\n    var postData = \"action=getLastMemoryObjectDate\"+\r\n        \"&key=\"+key;\r\n    $.ajax({\r\n        url: utilityActionsBaseUrl,\r\n        dataType: 'json',\r\n        data: postData,\r\n        async: true, type: 'POST'\r\n    }).done(\r\n        function(result){\r\n            if(doneCallback)\r\n                doneCallback(result)\r\n        }\r\n    );\r\n}\r\n\r\n\r\nfunction isUpdatePropPlanCacheThreadRunning(dfd){\r\n    var utilityActionsBaseUrl = \"/adiJed/ui/train-utility-actions.do\";\r\n    var postData = \"action=checkUpdatePropPlanCacheRunning\";\r\n    $.ajax({\r\n        url: utilityActionsBaseUrl,\r\n        dataType: 'json',\r\n        data: postData,\r\n        async: true, type: 'POST'\r\n    }).done(function(result){\r\n            dfd.resolve(result['running']);\r\n        }\r\n    ).fail(function(){\r\n            dfd.resolve(false);\r\n    });\r\n}\r\n\r\nfunction isUpdateUsersViewStatusCacheThreadRunning(dfd){\r\n    var utilityActionsBaseUrl = \"/adiJed/ui/train-utility-actions.do\";\r\n    var postData = \"action=checkUpdateUsersViewStatusCacheRunning\";\r\n    $.ajax({\r\n        url: utilityActionsBaseUrl,\r\n        dataType: 'json',\r\n        data: postData,\r\n        async: true, type: 'POST'\r\n    }).done(function(result){\r\n            return result['running'];\r\n        }\r\n    ).fail(function(){\r\n            return false;\r\n    });\r\n}\r\n\r\nfunction updatePropToPlan(){\r\n    var utilityActionsBaseUrl = \"/adiJed/ui/train-utility-actions.do\";\r\n    var postData = \"action=updatePropPlanCache\";\r\n    $.ajax({\r\n        url: utilityActionsBaseUrl,\r\n        dataType: 'json',\r\n        data: postData,\r\n        async: true, type: 'POST'\r\n    })\r\n}\r\n\r\nfunction updateUsersViewStatus(){\r\n    var utilityActionsBaseUrl = \"/adiJed/ui/train-utility-actions.do\";\r\n    var postData = \"action=updateUsersViewStatusCache\";\r\n    $.ajax({\r\n        url: utilityActionsBaseUrl,\r\n        dataType: 'json',\r\n        data: postData,\r\n        async: true, type: 'POST'\r\n    })\r\n}\r\n\r\nfunction viewScheduleInfo(idProp, idSched, idUser){\r\n\r\n    //var _url = \"/adiJed/ui/training/trainingView/utils/windowSchedulesInfo.jsp\"+\"?\";\r\n    var _url = \"/adiJed/ui/view-actions.do\"+\"?\";\r\n\r\n    var _params = [];\r\n    _params.push(\"action=getWinScheduleInfo\");\r\n    _params.push(\"idUser=\"+idUser);\r\n    _params.push(\"idSched=\"+idSched);\r\n    _params.push(\"idProp=\"+idProp);\r\n    _url += _params.join(\"&\");\r\n\r\n    openWindow(\"windowSchedulesInfo\", _url,\r\n        {\"title\": LangManager.get(\"training.schedulazioni\"), \"modal\": true, \"width\": \"80%\", \"height\": \"80%\"});\r\n}\r\n\r\nfunction onScheduleInfoWindowClose() {\r\n    if($(\"#windowSchedulesInfo\").data(\"kendoWindow\"))\r\n        $(\"#windowSchedulesInfo\").data(\"kendoWindow\").destroy();\r\n}\r\n\r\nfunction viewUserTrainingInfo(idTrain, idUser){\r\n\r\n    var _url = \"/adiJed/ui/view-actions.do\"+\"?\";\r\n\r\n    var _params = [];\r\n    _params.push(\"action=getWinTrainInfo\");\r\n    _params.push(\"idUser=\"+idUser);\r\n    _params.push(\"idTrain=\"+idTrain);\r\n    _url += _params.join(\"&\");\r\n\r\n    openWindow(\"windowUserTrainingInfo\", _url,\r\n        {\"title\": LangManager.get(\"training.train.utente\"), \"modal\": true, \"width\": \"80%\", \"height\": \"80%\"});\r\n}\r\n\r\nfunction onUserTrainingInfoWindowClose() {\r\n    if($(\"#windowUserTrainingInfo\").data(\"kendoWindow\"))\r\n        $(\"#windowUserTrainingInfo\").data(\"kendoWindow\").destroy();\r\n}\r\n\r\nfunction viewUserQualifTrainingInfo(idUserQual, idQual, idUserQualInfo, status) {\r\n\r\n    var url = \"/adiJed/ui/training/trainingView/utils/windowQualifTrainingInfo.jsp?idUserQual=\" + idUserQual+\"&idQual=\"+idQual+\"&idUserQualInfo=\"+idUserQualInfo+\"&status=\"+status;\r\n    openWindow(\"windowUserQualifTrainingInfo\", url,\r\n        {\"title\": \"Training della Qualifica\", \"modal\": true, \"width\": \"80%\", \"height\": \"80%\"});\r\n    /*TODO Multilingua*/\r\n}\r\n\r\nfunction viewTrainingInfo(idTrain, progressivo, propId, codice) {\r\n    var titolo = progressivo>=0? codice+\" (Ver. \"+progressivo+\")\" : codice;\r\n    var url = \"/adiJed/ui/training/trainingView/utils/windowTrainingInfo.jsp?\"+\r\n        \"idTrain=\"+idTrain+\r\n        \"&progressivo=\"+progressivo+\r\n        \"&propId=\"+propId+\r\n        \"&checkValid=false\";\r\n    openWindow(\"windowTrainingInfo\", url,\r\n        {\"title\": LangManager.get(\"training.info\")+\" - \"+titolo, \"modal\": true, \"width\": \"80%\", \"height\": \"80%\"});\r\n}\r\n\r\nfunction gestioneModuliTraining(userId, trainingId, propId, schedId, requireSign, parms, callback){\r\n    var url = \"/adiJed/ui/training/management-course/utils/manageModule.jsp?\"+\r\n        \"userId=\"+userId+\r\n        \"&trainingId=\"+trainingId+\r\n        \"&propId=\"+propId+\r\n        \"&schedId=\"+schedId+\r\n        \"&requireSign=\"+requireSign+\r\n        ((parms && parms!='')? \"&parms=\"+encodeURIComponent(parms) : \"\");\r\n    openWindow(\"windowManageModule\", url,\r\n        {\"title\":LangManager.get(\"generic.attach.docs\") , \"modal\": true, \"width\": \"80%\"}, callback);\r\n}\r\n\r\nfunction decodeSessionType(sessionType){\r\n    var result = \"\";\r\n    switch(sessionType){\r\n        case 0:\r\n            result = LangManager.get(\"training.prop.ediz.singole\");\r\n            break;\r\n        case 1:\r\n            result = LangManager.get(\"training.prop.multi.sessione\");\r\n            break;\r\n        case 2:\r\n            result = LangManager.get(\"training.prop.intervallo\");\r\n            break;\r\n    }\r\n\r\n    return result;\r\n}\r\n\r\n\r\nvar dataCourse = null;\r\nvar singleIdCourse = null;\r\nvar idProp = null;\r\n\r\nfunction openWindowPinCourse(_dataCourse, _singleIdCourse, _idProp, rangeDateScheduled, sessionType, pianPassato, closeCallBack){\r\n    dataCourse = _dataCourse;\r\n    singleIdCourse = _singleIdCourse;\r\n    idProp = _idProp;\r\n    if((!singleIdCourse || singleIdCourse<1000) && rangeDateScheduled==true){\r\n        return false;\r\n    }\r\n\r\n    //var rangeDateScheduled=scheduledRange[checkedItems[0]]==true;\r\n\r\n    var currentViewData = kendo.toString(dataCourse, \"dd/MM/yyyy\");\r\n    var _url = \"/adiJed/ui/training/management-course/utils/windowPinCourse.jsp\"+\"?\";\r\n\r\n    var _params = [];\r\n    _params.push(\"sessionType=\"+sessionType);\r\n    _params.push(\"rangeDateScheduled=\"+rangeDateScheduled);\r\n    _params.push(\"singleIdCourse=\"+singleIdCourse);\r\n    _params.push(\"dataCourse=\"+dataCourse);\r\n    _params.push(\"idProp=\"+idProp);\r\n    _params.push(\"pianPassato=\"+pianPassato);\r\n    //_params.push(\"idPropSelected=\"+idPropSelected);\r\n    _url += _params.join(\"&\");\r\n\r\n    openWindow(\"windowPinCourse\", _url, {\"title\":LangManager.get(\"training.gest.corso\")+\" \"+currentViewData ,\r\n        \"modal\": true, \"width\": \"800px\", \"height\": \"initial\", \"maxHeight\": \"80%\", Minimize: false, Maximize: false, resizable: false}, closeCallBack);\r\n}\r\n\r\nfunction onWindowPinCourseClose(closeCallBack) {\r\n    inEditCourse=false;\r\n    lastEditedCourseId=-1;\r\n    lastEditedCourseTitle='';\r\n    lastEditedCourseData=null;\r\n    lastEditedCourseDalle=null;\r\n    lastEditedCourseAlle=null;\r\n    lastEditedCourseAllChecked=true;\r\n    lastEditedCourseUsersCheck=null;\r\n    //$(\"#windowPinCourse\").css(\"display\", \"none\");\r\n    var scheduler = $(\"#scheduler\").data(\"kendoCalendar\");\r\n    var lastDate = scheduler.current();\r\n    scheduler.destroy();\r\n    $(\"#scheduler\").html(\"\");\r\n    loadTrainingScheduler(lastDate);\r\n    $(\"#windowPinCourse\").data(\"kendoWindow\").destroy();\r\n\r\n\r\n\r\n    if($(\"#windowPinCourse\").data(\"kendoWindow\"))\r\n        $(\"#windowPinCourse\").data(\"kendoWindow\").destroy();\r\n}\r\n\r\nfunction enableTab(tabstripid, index, enable){\r\n    var itemIndex = index;\r\n    var tabStrip = $(\"#\"+tabstripid).kendoTabStrip().data(\"kendoTabStrip\");\r\n    if(tabStrip)\r\n        tabStrip.enable(getTab(tabstripid, itemIndex), enable);\r\n}\r\n\r\nfunction isEnableTab(tabstripid, index){\r\n    var itemIndex = index;\r\n    var tabStrip = $(\"#\"+tabstripid).kendoTabStrip().data(\"kendoTabStrip\");\r\n    if(tabStrip)\r\n        return tabStrip.enable(getTab(tabstripid, itemIndex));\r\n}\r\n\r\nfunction selectTab(tabstripid, index){\r\n    var tabToSelect = getTab(tabstripid, index);\r\n    tabToSelect.click();\r\n}\r\n\r\nfunction getTab(tabstripid, itemIndex) {\r\n    if(!itemIndex)\r\n        itemIndex = 0;\r\n    var tabStrip = $(\"#\"+tabstripid).kendoTabStrip().data(\"kendoTabStrip\");\r\n    if(tabStrip)\r\n        return tabStrip.tabGroup.children(\"li\").eq(itemIndex);\r\n}\r\n\r\nfunction getValutazione(val, note){\r\n    var valutazione = '';\r\n    if(val && val!=''){\r\n        if(val=='C')\r\n            valutazione = LangManager.get(\"generic.conforme\");\r\n        else\r\n            valutazione = LangManager.get(\"generic.non.conforme\");\r\n    }\r\n\r\n    valutazione = valutazione!=''? '<a  href=\"#\" title=\\\"'+note+'\\\" class=\\\"noteValutazione\\\">'+valutazione+'</a>' : '';\r\n    return valutazione;\r\n}\r\n\r\nfunction getStatoTraining(stato, note){\r\n    var result = LangManager.get(stato);\r\n    if(stato=='NON_NECESSARIO'){\r\n        result = '<a  href=\"#\" title=\\\"'+note+'\\\"  class=\\\"noteStato\\\">'+result+'</a>';\r\n    }\r\n\r\n    return result;\r\n}\r\n\r\nfunction expireCacheByQualif(qualId){\r\n    var utilityActionsBaseUrl = \"/adiJed/ui/train-utility-actions.do\";\r\n    var postData = \"action=expireCache&qualId=\"+qualId;\r\n    $.ajax({\r\n        url: utilityActionsBaseUrl,\r\n        dataType: 'json',\r\n        data: postData,\r\n        async: true, type: 'POST'\r\n    })\r\n}\r\nfunction expireCacheByTrain(trainId){\r\n    var utilityActionsBaseUrl = \"/adiJed/ui/train-utility-actions.do\";\r\n    var postData = \"action=expireCache&trainId=\"+trainId;\r\n    $.ajax({\r\n        url: utilityActionsBaseUrl,\r\n        dataType: 'json',\r\n        data: postData,\r\n        async: true, type: 'POST'\r\n    })\r\n}\r\nfunction expireCacheByUser(userId){\r\n    var utilityActionsBaseUrl = \"/adiJed/ui/train-utility-actions.do\";\r\n    var postData = \"action=expireCache&idUser=\"+userId;\r\n    $.ajax({\r\n        url: utilityActionsBaseUrl,\r\n        dataType: 'json',\r\n        data: postData,\r\n        async: true, type: 'POST'\r\n    })\r\n}\r\nfunction expireCacheByEntityId(entityId){\r\n    var utilityActionsBaseUrl = \"/adiJed/ui/train-utility-actions.do\";\r\n    var postData = \"action=expireCache&entityId=\"+entityId;\r\n    $.ajax({\r\n        url: utilityActionsBaseUrl,\r\n        dataType: 'json',\r\n        data: postData,\r\n        async: true, type: 'POST'\r\n    })\r\n}\r\nfunction getDifferenceBetweenHours(startHour, endHour){\r\n    let result = 0;\r\n    let startDataFormatted = kendo.parseDate(\"19700101 \"+startHour, \"yyyyMMdd HH:mm:ss\");\r\n    let endDataFormatted = kendo.parseDate(\"19700101 \"+endHour, \"yyyyMMdd HH:mm:ss\");\r\n    if(endDataFormatted==null || startDataFormatted==null)\r\n        return 0;\r\n    //in milliseconds\r\n    let diff = endDataFormatted.getTime() - startDataFormatted.getTime();\r\n\r\n    let diffMinutes = diff / (60 * 1000);\r\n\r\n    let hours = diffMinutes / 60;\r\n    let mins = diffMinutes % 60;\r\n\r\n    result = parseInt(hours);\r\n    if(mins>=30)\r\n        result+=0.5;\r\n\r\n    return result;\r\n}"
          },
