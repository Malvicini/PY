            "mimeType": "text/css",
            "compression": -1,
            "text": "div.k-window {\r\n    border-radius: 0;\r\n\r\n    -moz-box-shadow: 0 4px 8px -6px lightgray;\r\n    box-shadow: 0 4px 8px -6px lightgray;\r\n    -webkit-box-shadow: 0 6px 10px -2px lightgray;\r\n}\r\n.k-window-titlebar, .k-window-content {\r\n    border-radius: 0;\r\n}\r\n/*\r\n.k-window-titlebar {\r\n    height: 1.2em;\r\n}\r\n*/\r\n.k-window-title {\r\n    text-align: center;\r\n    font-weight: bold;\r\n    color: rgb(134, 134, 134);\r\n}\r\n.k-overlay {\r\n    background-color: rgb(248, 248, 248);\r\n}\r\nspan.k-datepicker, span.k-timepicker, span.k-datetimepicker, span.k-colorpicker, span.k-numerictextbox, span.k-combobox, span.k-dropdown {\r\n    background-color: transparent;\r\n}\r\nspan.k-datepicker, span.k-timepicker, span.k-datetimepicker {\r\n    max-width: 200px;\r\n}\r\n.k-picker-wrap, .k-picker-wrap .k-input, .k-numeric-wrap .k-input, .k-dropdown-wrap .k-input, .k-selectbox .k-input {\r\n    border-radius: 0;\r\n}\r\n.k-autocomplete.k-state-default, .k-picker-wrap.k-state-default, .k-numeric-wrap.k-state-default, .k-dropdown-wrap.k-state-default {\r\n    border-radius: 0;\r\n    border-color: #ebe9e9;\r\n    box-shadow: none;\r\n}\r\n.k-picker-wrap.k-state-focused, .k-picker-wrap.k-state-focused, .k-numeric-wrap.k-state-focused, .k-dropdown-wrap.k-state-focused, .k-selectbox.k-state-focused, .k-autocomplete.k-state-focused, .k-widget.k-multiselect.k-header.k-state-focused {\r\n    border-radius: 0;\r\n    border: 1px solid #b6c8ff;\r\n}\r\n.k-autocomplete.k-state-focused .k-input {\r\n    border: 0;\r\n}\r\n.k-picker-wrap.k-state-focused .k-input, .k-picker-wrap.k-state-focused .k-input, .k-numeric-wrap.k-state-focused .k-input, .k-dropdown-wrap.k-state-focused .k-input, .k-selectbox.k-state-focused  .k-input {\r\n    border-radius: 0;\r\n    border: 0;\r\n}\r\n.k-window-titlebar .k-window-actions {\r\n    padding-top: .1em;\r\n}\r\n.k-window .k-link {\r\n    padding: 4px 6px;\r\n    border: 1px solid transparent;\r\n}\r\n.k-in.k-state-selected.k-state-focused {\r\n    box-shadow: none;\r\n}\r\n.k-state-selected{\r\n    background-color: #76c2fe;\r\n    border-color: #76c2fe;\r\n    color: white;\r\n    background-image: none;\r\n/*    background-image: none,-webkit-linear-gradient(top,#007fd4 0,#0000fa 90%);\r\n    background-image: none,-moz-linear-gradient(top,#007fd4 0,#0000fa 90%);\r\n    background-image: none,-o-linear-gradient(top,#007fd4 0,#0000fa 90%);\r\n    background-image: none,linear-gradient(to bottom,#007fd4 0,#0000fa 90%);*/\r\n}\r\n\r\n.k-state-selected.currentHighlighted span.nodeText {\r\n    color: white;\r\n}\r\n.k-textbox>input, .k-autocomplete .k-input, .k-multiselect-wrap, .k-widget.k-multiselect.k-header {\r\n    border-radius: 0;\r\n}\r\n.k-autocomplete .k-input {\r\n    border: 0;\r\n}\r\n.k-autocomplete.k-state-focused {\r\n    background: none;\r\n}\r\n.k-autocomplete.k-state-border-down .k-input {\r\n    border-radius: 0;\r\n}\r\n.k-block, .k-button, .k-textbox, .k-drag-clue, .k-touch-scrollbar, .k-window, .k-window-titleless .k-window-content, .k-window-action, .k-inline-block, .k-grid .k-filter-options, .k-grouping-header .k-group-indicator, .k-autocomplete, .k-multiselect, .k-combobox, .k-dropdown, .k-dropdown-wrap, .k-datepicker, .k-timepicker, .k-colorpicker, .k-datetimepicker, .k-numerictextbox, .k-picker-wrap, .k-numeric-wrap, .k-colorpicker.k-list-container, .k-calendar-container, .k-calendar td, .k-calendar .k-link, .k-treeview .k-in, .k-editor-inline, .k-tooltip, .k-tile, .k-slider-track, .k-slider-selection, .k-upload {\r\n    border-radius: 2px;\r\n}\r\nspan.k-in.adiuto-tree-selected {\r\n    box-sizing: border-box;\r\n    border: 1px solid #76c2fe;\r\n    background: #76c2fe !important;\r\n    background: -webkit-linear-gradient(top,#76c2fe,#76c2fe) !important;\r\n    background-image: none;\r\n    color: #fff;\r\n    padding: 1px 3px 1px 2px;\r\n}\r\n"
