            "mimeType": "text/javascript",
            "compression": -1,
            "text": "var FamilySearch = {\r\n    familiesTreeObject: null,\r\n    familiesTreeContainer: null,\r\n    textbox: null,\r\n\r\n    _TIMEOUT_SEARCH_MS: 100,\r\n\r\n    _lastHighlighted: 0,\r\n    timeoutScrollFamilies: -1,\r\n    timeoutSearchFamilies: -1,\r\n    lastSearchTerm: null,\r\n\r\n    getInstance: function(tree, ftc) {\r\n        this.familiesTreeObject = tree;\r\n        this.familiesTreeContainer = ftc;\r\n        this.cachedTreeElements = null;\r\n        return this;\r\n    },\r\n    setup: function(textbox) {\r\n        var _this = this;\r\n        this.textbox = textbox;\r\n        this.textbox.on('keyup', function(e) {_this.keyUp.call(_this,e,this);});\r\n\r\n        if(this.textbox.length)\r\n            this.textbox[0].focus();\r\n    },\r\n    clearSearch: function() {\r\n        $(\".filtered\").removeClass('filtered');\r\n        $(\".filtered-out\").removeClass(\"filtered-out\");\r\n        $(\".currentHighlighted\").removeClass('currentHighlighted');\r\n        $(this.textbox).val(\"\")[0].focus();\r\n        this.lastSearchTerm = null;\r\n        var $searchBox = $(this.textbox).closest(\".search-box\");\r\n        $searchBox.removeClass(\"filters-active\");\r\n        $searchBox.find(\"> .search-controls\").remove();\r\n        $searchBox.find(\"> .results-found\").remove();\r\n    },\r\n    keyUp: function(e,textbox) {\r\n        if(e.keyCode == 27)\r\n        {\r\n            if(this.timeoutSearchFamilies != -1) {\r\n                clearTimeout(this.timeoutSearchFamilies);\r\n                this.timeoutSearchFamilies = -1;\r\n            }\r\n            this.clearSearch();\r\n        }\r\n        else\r\n        {\r\n            if(this.timeoutSearchFamilies != -1) {\r\n                clearTimeout(this.timeoutSearchFamilies);\r\n                this.timeoutSearchFamilies = -1;\r\n            }\r\n\r\n            var _e = e, _this = this;\r\n\r\n            this.timeoutSearchFamilies = setTimeout(function(){\r\n                _this.doSearchFamilies.call(_this,_e,textbox);\r\n            }, this._TIMEOUT_SEARCH_MS);\r\n        }\r\n    },\r\n    doSearchFamilies: function(e,textbox) {\r\n        if(this.timeoutSearchFamilies != -1) {\r\n            clearTimeout(this.timeoutSearchFamilies);\r\n            this.timeoutSearchFamilies = -1;\r\n        }\r\n\r\n        e.preventDefault();\r\n        var _this = this;\r\n\r\n        var filterText = $(textbox).val();\r\n        if (kendo.keys.ENTER != e.keyCode) {\r\n            if(this.lastSearchTerm == null || this.lastSearchTerm != filterText){\r\n                this.lastSearchTerm = filterText;\r\n\r\n                if(filterText == \"\") {\r\n                    _this.clearSearch();\r\n                } else {\r\n                    $(\".filtered\").each(function() {\r\n                        var $this = $(this);\r\n                        var $parent = $this.parent();\r\n                        $parent.html($parent.attr(\"origHtml\"));\r\n                    });\r\n\r\n                    $(\".filtered-out\").removeClass(\"filtered-out\");\r\n                    $(\".currentHighlighted\").removeClass('currentHighlighted');\r\n\r\n                    this._lastHighlighted = -1;\r\n\r\n                    if(filterText != \"\") {\r\n                        if(!this.cachedTreeElements) {\r\n                            this.cachedTreeElements = $(\".k-in\");\r\n                        }\r\n                        this.cachedTreeElements.find(\"> .tree-item-label:_notContainsIgnoreCase('\"+filterText+\"')\").closest(\".k-in\").addClass(\"filtered-out\");\r\n                        var _searchResult = this.cachedTreeElements.find(\"> .tree-item-label:_containsIgnoreCase('\"+filterText+\"')\");\r\n                        _searchResult.closest(\".k-in\").removeClass(\"k-state-selected\");\r\n\r\n                        var $searchBox = $(this.textbox).closest(\".search-box\");\r\n                        var $searchControls = $searchBox.find(\"> .search-controls\");\r\n\r\n                        if(_searchResult.length && !$searchControls.length) {\r\n                            $searchBox.addClass(\"filters-active\").append(\r\n                                ($searchControls = $(\"<span>\").append(\r\n                                        $(\"<span>\").text(\"\").prop(\"title\",LangManager.get(\"ui.js.clear.search\")).addClass(\"search-clear\").click(function(){_this.clearSearch();})//\"Pulisci la ricerca\"\r\n                                    ).append(\r\n                                        $(\"<span>\").text(\"\").prop(\"title\",LangManager.get(\"ui.js.go.prev.result\")).addClass(\"search-prev\").click(function(){_this.scrollToPrevResult.apply(_this);})//\"Scorri fino al risultato precedente\"\r\n                                    ).append(\r\n                                        $(\"<span>\").text(\"\").prop(\"title\",LangManager.get(\"ui.js.go.next.result\")).addClass(\"search-next\").click(function(){_this.scrollToNextResult.apply(_this);})//\"Scorri fino al prossimo risultato\"\r\n                                    ).addClass(\"search-controls\"))\r\n                            );\r\n\r\n                            _this.textbox.css(\"padding-right\", $searchControls.width());\r\n                        } else if(_searchResult.length) {\r\n                            $searchBox.addClass(\"filters-active\");\r\n                        }\r\n                        var $resultsFoundText = $searchBox.find(\"> .results-found\");\r\n                        if( !$resultsFoundText.length ) {\r\n                            $searchBox.append(($resultsFoundText = $(\"<span>\").addClass(\"results-found\")));\r\n                        }\r\n\r\n                        $resultsFoundText.text(_searchResult.length+' '+LangManager.get(\"ui.js.results.found\"));//\" risultati trovati...\"\r\n                        if(_searchResult.length) {\r\n                            $resultsFoundText.removeClass(\"search-ko\")\r\n                        } else {\r\n                            $resultsFoundText.addClass(\"search-ko\")\r\n                        }\r\n\r\n                        _searchResult.each(function(){\r\n                            var $this = $(this);\r\n                            var $text = $this.text();\r\n                            if( !$this.attr(\"origHtml\") ) {\r\n                                $this.attr(\"origHtml\", $this.html());\r\n                            }\r\n                            $this.html($text.replace(new RegExp(\"(\"+filterText+\")\", \"gi\"), \"<span class=\\\"filtered\\\">$1</span>\"));\r\n                        });\r\n\r\n                        this.expandAll($(\".filtered\"));\r\n                        this.timeoutScrollFamilies = setTimeout(function(){_this.scrollToNextResult.apply(_this)}, this._TIMEOUT_SEARCH_MS);\r\n                    }\r\n                }\r\n            }\r\n        } else if(kendo.keys.ENTER == e.keyCode && filterText != '') {\r\n            this.timeoutScrollFamilies = setTimeout(function(){_this.scrollToNextResult.apply(_this)}, this._TIMEOUT_SEARCH_MS);\r\n        }\r\n    },\r\n    expandAll: function(nodes) {\r\n        var _this = this;\r\n        $.each(nodes,function(i,node) {\r\n            _this.expand(node, true);\r\n        });\r\n    },\r\n    expand: function(node, programCall) {\r\n        var _node = this.familiesTreeObject.dataItem(node);\r\n        delete _node[\"programCall\"];\r\n        if(programCall){\r\n            _node.programCall = true;\r\n            this.familiesTreeObject.expand(node);\r\n        }\r\n        else{\r\n            this.familiesTreeObject.expand(node);\r\n        }\r\n\r\n        if(this.familiesTreeObject.parent(node).length>0) {\r\n            try { this.expand(this.familiesTreeObject.parent(node), programCall); } catch(e) {}\r\n        }\r\n    },\r\n    scrollTo: function(_scrollTo) {\r\n        $(\".currentHighlighted\").removeClass('currentHighlighted');\r\n        _scrollTo.addClass('currentHighlighted');\r\n        var skrollTop = _scrollTo.offset().top - this.familiesTreeContainer.offset().top + this.familiesTreeContainer.scrollTop();\r\n        this.familiesTreeContainer.stop(true, false).animate({\r\n            scrollTop: skrollTop - 50\r\n        }, 450);\r\n    },\r\n    scrollToNextResult: function() {\r\n        var allResults = $(\".filtered\");\r\n        if(allResults && allResults.length) {\r\n            if(!$(allResults[this._lastHighlighted+1]).length)\r\n                this._lastHighlighted = -1;\r\n\r\n            this._lastHighlighted++;\r\n            this.scrollTo($(allResults[this._lastHighlighted]));\r\n        }\r\n    },\r\n    scrollToPrevResult: function() {\r\n        var allResults = $(\".filtered\");\r\n        if(allResults && allResults.length) {\r\n            if(!$(allResults[this._lastHighlighted-1]).length)\r\n                this._lastHighlighted = allResults.length;\r\n\r\n            this._lastHighlighted--;\r\n            this.scrollTo($(allResults[this._lastHighlighted]));\r\n        }\r\n    }\r\n};\r\n\r\n/**\r\n * Costruisce un albero di famiglie\r\n *\r\n * @param container  il nodo dove andare a costruire l'albero\r\n * @param params  parametri disponibili sono:<ol>\r\n * <li>\r\n * url l'indirizzo che contiene il json con le famiglie\r\n * </li>\r\n * <li>\r\n * data i parametri da passare a url - [\"\"]\r\n * </li>\r\n * <li>\r\n * showCheckbox se mostrare o meno le checkbox di selezione, altrimenti al click su un elemento viene chiamata subito la selectCallback - [false]\r\n * </li>\r\n * <li>\r\n * selectCallback la funzione da richiamare quando viene selezionato un elemento - [nop]\r\n * </li>\r\n * <li>\r\n * loadCallback la funzione da richiamare quando ha terminato il caricamento dell'albero - [nop]\r\n * </li>\r\n *\r\n * @constructor\r\n */\r\nfunction FamiliesTree(container, params)\r\n{\r\n    var defaults = {\r\n        url: \"/adiJed/ui/families.get-insert-families.do\",\r\n        data: \"\",\r\n        showCheckbox: false,\r\n        selectCallback: function(){},\r\n        loadCallback: function(){}\r\n    };\r\n    var opts = $.extend({}, defaults, params);\r\n\r\n    this.url = opts.url;\r\n    this.data = opts.data;\r\n    this.showCheckbox = opts.showCheckbox;\r\n    this._familiesJSON = null;\r\n\r\n    // private attributes\r\n    var __instance = this;\r\n    var onSelect = opts.selectCallback;\r\n    var onLoadFamiliesComplete = opts.loadCallback;\r\n    var onChangeFunctionCall = undefined;\r\n\r\n    if(params[\"onChangeFunctionCall\"]!= undefined){\r\n        onChangeFunctionCall = params[\"onChangeFunctionCall\"];\r\n    }\r\n\r\n    // private methods\r\n    var chooseFamily = function(familyID, kind) {\r\n        onSelect.call(__instance, {\"familyID\": familyID, \"kind\": kind});\r\n    };\r\n\r\n    var loadTree = function(_url, _data)\r\n    {\r\n        var _this = this;\r\n        $.ajax({\r\n            url: _url,\r\n            data: _data,\r\n            dataType: 'json',\r\n            async: true, type: 'POST', success: function(familiesJSON) {\r\n                \r\n                var     chkTreeTpl = $(\"#family-tree-with-checkbox-template\").html(),\r\n                        treeTpl    = $(\"#family-tree-template\").html();\r\n                \r\n                if( typeof chkTreeTpl === \"undefined\" ) chkTreeTpl = \"\";\r\n                if( typeof treeTpl    === \"undefined\" ) treeTpl    = \"\";\r\n                \r\n                _familiesJSON = familiesJSON[\"data\"];\r\n                _this.familiesTreeObject = _this.familiesTreeContainer.kendoTreeView({\r\n                    dataSource: familiesJSON[\"data\"],\r\n                    dataSpriteCssClassField: \"kind\",\r\n                    template: _this.showCheckbox ? kendo.template(chkTreeTpl) : kendo.template(treeTpl)\r\n                }).data(\"kendoTreeView\");\r\n\r\n                var familySelectedEvent = function(e) {\r\n                    var dataItem = this.dataItem(e.node);\r\n                    if(dataItem.kind != \"group\") {\r\n                        chooseFamily(dataItem.id, dataItem.kind);\r\n                    }\r\n                    console.log('familySelectedEvent');\r\n                };\r\n                var treeChangedEvent = function(dataItem) {\r\n                    if(dataItem.kind != \"group\") {\r\n                        chooseFamily();\r\n                    }\r\n                    console.log('treeChangedEvent');\r\n                };\r\n\r\n                if(_this.showCheckbox) {\r\n                    _this.familiesTreeObject.bind(\"select\", function(){\r\n\r\n                    });\r\n                    _this.familiesTreeContainer.on(\"change\", \":checkbox\", function(ev, params) {\r\n                        var params = params||{};\r\n                        var $this = $(this);\r\n                        if(onChangeFunctionCall != undefined){\r\n                            onChangeFunctionCall($this, _this);\r\n                        }\r\n                        if($this.prop(\"checked\")) {\r\n                            $this.closest(\"span.k-in\").addClass(\"adiuto-tree-selected\");\r\n                            $(\"input[type=checkbox][famid=\"+$this.attr(\"famid\")+\"]\", _this.familiesTreeContainer)\r\n                                .prop(\"checked\",true)\r\n                                .closest(\"span.k-in\").addClass(\"adiuto-tree-selected\")\r\n                            ;\r\n                        } else {\r\n                            $this.closest(\"span.k-in\").removeClass(\"adiuto-tree-selected\");\r\n                            $(\"input[type=checkbox][famid=\"+$this.attr(\"famid\")+\"]\", _this.familiesTreeContainer)\r\n                                .prop(\"checked\",false)\r\n                                .closest(\"span.k-in\").removeClass(\"adiuto-tree-selected\")\r\n                            ;\r\n                        }\r\n                        if(params[\"propagate\"] === undefined || params[\"propagate\"] != false)\r\n                            treeChangedEvent($this);\r\n                    });\r\n                } else {\r\n                    _this.familiesTreeObject.bind(\"select\", familySelectedEvent);\r\n                }\r\n\r\n                _this.familiesTreeObject.bind(\"collapse\", function(e){\r\n                    //Quando chiudo un elemento mi salvo il suo stato in modo di ricaricarlo in questo stato\r\n                    var node = _this.familiesTreeObject.dataItem(e.node);\r\n                    node.collapsed = true;\r\n                    //var nodes = _this.familiesTreeObject.dataSource.view();\r\n                    var viewStatus = AdiutoUserSettings.load(\"queryFamiliesViewStatus\");\r\n                    if(!viewStatus){\r\n                        viewStatus = {};\r\n                    }\r\n                    if(node.nodeId>=1000){\r\n                        viewStatus[node.nodeId] = {id:node.nodeId, expanded: false};\r\n                        AdiutoUserSettings.save(\"queryFamiliesViewStatus\", viewStatus);\r\n                    }\r\n                });\r\n\r\n                _this.familiesTreeObject.bind(\"expand\", function(e){\r\n                    //Quando apro un elemento mi salvo il suo stato in modo di ricaricarlo in questo stato\r\n                    var node = _this.familiesTreeObject.dataItem(e.node);\r\n                    if(!node.programCall || node.programCall==false){\r\n                        node.collapsed = false;\r\n                        //var nodes = _this.familiesTreeObject.dataSource.view();\r\n\r\n                        var viewStatus = AdiutoUserSettings.load(\"queryFamiliesViewStatus\");\r\n                        if(!viewStatus){\r\n                            viewStatus = {};\r\n                        }\r\n                        if(node.nodeId>=1000){\r\n                            viewStatus[node.nodeId] = {id:node.nodeId, expanded: true};\r\n                            AdiutoUserSettings.save(\"queryFamiliesViewStatus\", viewStatus);\r\n                        }\r\n                    }else{\r\n                        delete node[\"programCall\"];\r\n                    }\r\n                });\r\n\r\n                FamilySearch.getInstance(_this.familiesTreeObject, _this.familiesTreeContainer).setup($(\"#familyTreeFilter\"));\r\n                onLoadFamiliesComplete.call(this);\r\n            }\r\n        });\r\n    };\r\n\r\n    var init = function() {\r\n        this.dialog = $(\"#families-tree-dialog\");\r\n        this.familiesTreeContainer = $(\"#families-tree-container\");\r\n\r\n        loadTree.call(this, this.url, this.data);\r\n    };\r\n\r\n    // privilige methods\r\n    this.reloadTree = function(url, data) {\r\n        loadTree.call(this, url||this.url, data||(url?\"\":this.data));\r\n    };\r\n\r\n    container.load(\"/adiJed/ui/includes/families.jsp\", function() {\r\n        $(\".tooltip\").remove();\r\n        init.apply(__instance);\r\n    });\r\n}\r\n\r\nFamiliesTree.prototype = {\r\n    constructor: FamiliesTree,\r\n\r\n    url: null,\r\n    data: null,\r\n    dialog: null,\r\n    familiesTreeContainer: null,\r\n    familiesTreeObject: null,\r\n\r\n    /**\r\n     * Ritorna i nodi delle famiglie selezionate, se ho selezionato un dettaglio ne torna uno solo anche se è associato\r\n     * a più famiglie e quindi nell'albero ce n'è selezionato più di uno\r\n     * @returns {Array}\r\n     */\r\n    getFamiliesSelected: function() {\r\n        var checkedNodes = [];\r\n        var nodes = this.familiesTreeObject.dataSource.view();\r\n\r\n        var findSelectedNodes = function(n){\r\n            var node;\r\n            for (var i = 0; i < n.length; i++) {\r\n                node = n[i];\r\n                if(node.kind != \"group\") {\r\n                    var chkFamily = $(\"#res-chk\"+node.id);\r\n                    if(chkFamily.attr(\"checked\")) {\r\n                        var exists = false;\r\n                        for(var iCheck=0; iCheck<checkedNodes.length; iCheck++) {\r\n                            if(node.id == checkedNodes[iCheck].id) {\r\n                                exists = true;\r\n                                break;\r\n                            }\r\n                        }\r\n                        if(!exists) {\r\n                            checkedNodes.push(node);\r\n                        }\r\n                    }\r\n                }\r\n                if(node.kind != \"group\" || node.items.length) {\r\n                    if(node.hasChildren) {\r\n                        findSelectedNodes(node.children.view());\r\n                    }\r\n                }\r\n            }\r\n        };\r\n\r\n        findSelectedNodes(nodes);\r\n\r\n        return checkedNodes;\r\n    },\r\n\r\n    checkFamily: function(fam) {\r\n        var famNode = $(\"#res-chk\"+fam.id);\r\n        famNode.attr(\"checked\", true).trigger(\"change\", {\"propagate\": false});\r\n//        famNode.attr(\"checked\", true).closest(\"span.k-in\").addClass(\"adiuto-tree-selected\").addClass(\"k-state-selected\");\r\n        var _node = this.familiesTreeObject.dataItem(famNode);\r\n        var __node = this.familiesTreeObject.findByUid(_node.uid);\r\n        this.expandTo(__node);\r\n    },\r\n\r\n    expandTo: function(node) {\r\n\r\n        this.familiesTreeObject.expand(node);\r\n\r\n        if(this.familiesTreeObject.parent(node).length>0) {\r\n            try { this.expandTo(this.familiesTreeObject.parent(node)); } catch(e) {}\r\n        }\r\n    },\r\n\r\n    getFamiliesLoaded: function(){\r\n        var families = [];\r\n        var node;\r\n        for (var i = 0; i < _familiesJSON.length; i++) {\r\n            node = _familiesJSON[i];\r\n            if(node.kind != \"group\")\r\n            {\r\n                families.push(node);\r\n            }\r\n        }\r\n    }\r\n};\r\n"
          },
