            "text": "var NOTIFICATION_PERMISSION_DENIED = \"denied\";\r\n\r\n(function(wnd) {\r\n    var AdiJedNotification;\r\n\r\n    AdiJedNotification = function() {\r\n        this.started = true;\r\n        this.pollingInProgress = false;\r\n        this.nextPoll = -1;\r\n\r\n        try {\r\n            chrome.notifications.onPermissionLevelChanged.addListener(this.grantedPermission);\r\n            chrome.notifications.getPermissionLevel(this.grantedPermission);\r\n        } catch(e) {\r\n        }\r\n\r\n        this.grantedPermission = function(permissionLevel) {\r\n            if(permissionLevel != NOTIFICATION_PERMISSION_DENIED) {\r\n                this.init();\r\n            }\r\n        };\r\n\r\n        this.init = function() {\r\n            var that = this;\r\n            $.ajax({\r\n                type: \"POST\",\r\n                url: \"/adiJed/ui/initialize-notification.do\",\r\n                dataType: 'json'\r\n            }).done(function(result){\r\n                if(result[\"ok\"]) {\r\n                    Logger.debug(\"Notifiche inizializzate correttamente.\");\r\n                    that.startPolling();\r\n                } else if (result[\"error\"]) {\r\n                    Logger.error(\"Errore durante l'inizializzazione delle notifiche. Causa: \"+result[\"message\"]);\r\n                }\r\n            });\r\n        };\r\n\r\n        this.stop = function() {\r\n            if(this.nextPoll != -1) {\r\n                clearTimeout(this.nextPoll);\r\n            }\r\n            this.started = false;\r\n        }\r\n\r\n        this.startPolling = function() {\r\n            if(this.started) {\r\n                if(!this.pollingInProgress) {\r\n                    this.pollNotification();\r\n                }\r\n                this.nextPoll = setTimeout(this.startPolling, 2500);\r\n            }\r\n        };\r\n\r\n        this.pollNotification = function() {\r\n            var that = this;\r\n            that.pollingInProgress = true;\r\n\r\n            $.ajax({\r\n                type: \"POST\",\r\n                url: \"/adiJed/ui/poll.do\",\r\n                dataType: 'json'\r\n            }).done(function(result){\r\n                that.pollingInProgress = false;\r\n                if(result[\"ok\"]) {\r\n                    that.notifyDesktop(result[\"message\"]);\r\n                } else if (result[\"error\"]) {\r\n                    Logger.error(\"Errore. Causa: \"+result[\"message\"]);\r\n                }\r\n            });\r\n        };\r\n\r\n        this.notifyDesktop = function() {\r\n            try {\r\n//                chrome.notifications.create(string notificationId, NotificationOptions options, function callback);\r\n                chrome.notifications.create(\"\", {}, function(){});\r\n            } catch(e) {\r\n\r\n            }\r\n        };\r\n    }\r\n    wnd.AdiJedNotification = new AdiJedNotification();\r\n\r\n})(window);\r\n"
          },
