\"#lastOpenedFolder\")); </script>\r\n        \r\n\r\n        \r\n\r\n        \r\n    </div>\r\n    <div id=\"empty-home\">\r\n        <img width=\"100%\" class=\"help-pin\" src=\"/adiJed/workfolder/SystemFiles/1001/Images/main-image.png\" align=\"middle\" alt=\"\"/>\r\n    </div>\r\n\r\n    \r\n\r\n    \r\n        <div class=\"in-evidenza\">IN EVIDENZA</div>            \r\n    \r\n    <div id=\"vq-container\">\r\n        <span class=\"in-evidenza\" style=\"display:none;position:relative;left:initial;margin-left:30px;\">QUERY VISUALI</span>       \r\n    </div>\r\n    \r\n    \r\n</div>\r\n\r\n<script type=\"text/javascript\">\r\n    function loadPinnedVisualQuery(_savedSettings) {\r\n        var c = $(\"#vq-container\");\r\n        $(\"div.visual-queries\").remove();\r\n        var visualQueriesContainer = $(\"<div>\").addClass(\"visual-queries\").addClass(\"vq-homepage\").appendTo(c);\r\n\r\n        var pinnedVQ = (_savedSettings[\"data\"]);\r\n        var showInEvidenza = function(){\r\n            //$(\"#empty-home\").addClass(\"hiddenElement\");\r\n            c.find(\"> .in-evidenza\").fadeIn();\r\n\r\n            showInEvidenza = function(){};\r\n        };\r\n\r\n        for( var i=0; i < pinnedVQ.length; i++ )\r\n        {\r\n            var query = ADA.loadSettings(\"visualQueries_\"+(pinnedVQ[i])['$'], function(){}, \"everybody\")[\"val\"];\r\n            if((query[\"data\"]).length) {\r\n                query = ((query[\"data\"])[0])['$'];\r\n            } else {\r\n                query = null;\r\n            }\r\n\r\n            if(query == null)\r\n                continue;\r\n\r\n            var queryDiv = $(\"<div>\").addClass(\"visual-query\")/*.addClass(\"visual-query2\")*/.attr(\"idx\", i).data(\"vqData\", query)\r\n                    .click(function() {\r\n                        var __thisQuery = $(this);\r\n                        var __query = __thisQuery.data(\"vqData\");\r\n                        $.when( HistoryManager.navigateTo(\"/query/\",\"/adiJed/ui/query.filters.do\",null) ).then(function(){\r\n                            setTimeout(function(){\r\n                                queryPage.restoreQueryState(__query);\r\n                            }, 250);\r\n                        });\r\n                    }).appendTo(visualQueriesContainer);\r\n\r\n            var tassoTitle = $(\"<span>\").addClass(\"vq-family\").text(query[\"label\"]).appendTo(queryDiv);\r\n            \r\n\r\n            var queryField = query[\"fields\"];\r\n            var lastQueryFieldSpan = null;\r\n            while(1==1) {\r\n                if(!queryField[\"id\"])\r\n                    break;\r\n\r\n                lastQueryFieldSpan = $(\"<span>\").addClass(\"vq-field\").addClass(\"vq-folder\").text(queryField[\"label\"])\r\n                        .appendTo(lastQueryFieldSpan||queryDiv);\r\n                queryField = queryField[\"nextField\"];\r\n            }\r\n            var queryFamilies = query[\"families\"];\r\n            var familyLabelContainer = $(\"<span>\").addClass(\"vq-family-label\").appendTo(queryDiv);\r\n            for(var ifam=0; ifam<queryFamilies.length; ifam++) {\r\n                var queryFamily = queryFamilies[ifam];\r\n                $(\"<span>\").text(queryFamily[\"label\"]).appendTo(familyLabelContainer);\r\n            }\r\n\r\n            showInEvidenza();\r\n        }\r\n\r\n        setTimeout(function(){\r\n            $(\".visual-query\").addClass(\"loaded\");\r\n        }, 50);\r\n    }\r\n    function bindData()\r\n    {\r\n        $(\".news-channel\").click(function(){\r\n            var channelId = $(this).attr(\"channelId\");\r\n            var titolo = $(this).attr(\"titolo\");\r\n            openNews(channelId, titolo);\r\n        });\r\n        $(\".news-channel\").mouseover(function() {\r\n            if($(this).hasClass(\"current-news\")){\r\n                if(changeNewsTimeoutID != -1)\r\n                    clearTimeout(changeNewsTimeoutID);\r\n                changeNewsTimeoutID = -1;\r\n            }\r\n        });\r\n\r\n        $(\".news-channel\").mouseleave(function() {\r\n            if($(this).hasClass(\"current-news\")){\r\n                changeNews();\r\n            }\r\n        });\r\n\r\n        $(\".pantaRheiOut\").click(function(){\r\n            document.getElementById(\"loginForm\").action = \"/rest/outQueue.do\";\r\n            document.getElementById(\"loginForm\").submit();\r\n\r\n//            window.open(\"/rest/outQueue.do&username=&password=[C@1fc1890\");\r\n//            openLink(\"/rest/outQueue.do\", \"\", \"[C@1fc1890\");\r\n\r\n        });\r\n        $(\".pantaRheiIn\").click(function(){\r\n\r\n            \r\n            document.getElementById(\"loginForm\").action = \"/rest/inQueue.do\";\r\n            document.getElementById(\"loginForm\").submit();\r\n\r\n\r\n//            window.open(\"/rest/inQueue.do&username=&password=[C@1fc1890\");\r\n//            openLink(\"/rest/inQueue.do\", \"\", \"[C@1fc1890\");\r\n        });\r\n\r\n    }\r\n    \r\n    function openLink(restURL, username, password){\r\n        var postData = \"\"; //\"onlyBody=false\";\r\n        postData += \"username=\"+username;\r\n        postData += \"&password=\"+password;\r\n        \r\n        $.ajax({\r\n            url: restURL,\r\n//            dataType: 'jsonp',\r\n            data: postData,\r\n            async: true, type: 'POST'})\r\n                .done(function(res){\r\n                    var w = window.open('about:blank');\r\n                    w.document.open();\r\n                    w.document.write(res);\r\n                    w.document.close();\r\n                }).fail(function (XHR, status, error) {\r\n                    console.log(error);\r\n                });\r\n    }    \r\n    \r\n    function Message()\r\n    {\r\n    }\r\n    function pinnedDocumentClickHandler(e){\r\n        var _this = $(this);\r\n        if( _this.hasClass('dragging-no-click') || ( _this.hasClass('dropping-here') || (_this.parent(\".folder\").length > 0 && !_this.parent(\".folder\").hasClass(\"folder-expanded\") ) ) )\r\n            return;\r\n\r\n        var documentID = _this.attr(\"docid\");\r\n        if(documentID) {\r\n            viewDocInfo(documentID);\r\n        }\r\n    }\r\n    function LastMessagesModel() {\r\n        var self = this;\r\n        self.lastMessagesData = ko.observable(null);\r\n    }\r\n    var pdAni = true;\r\n    $(document).ready(function () {\r\n        $(\"#crumbs\").html('<li>Home</li>');\r\n\r\n        setTimeout(function(){\r\n            if(pdAni) {\r\n                pdAni = false;\r\n                $(\".pinned-doc\").addClass(\"loaded\");\r\n            }\r\n        }, 50);\r\n        ADA.loadSettings(\"pinned-vq\", function(res) {\r\n            loadPinnedVisualQuery(res[\"val\"]);\r\n        });\r\n\r\n        $(\".news-channel\").each(function(){\r\n            var background = $(this).css(\"background-color\");\r\n            $(this).css(\"color\", getTextColor(background));\r\n        });\r\n        \r\n        if( location.href.indexOf(\"touch.switch-interface\") > 0 ) {\r\n\t\t\t$(\".pinned-doc.touch\").css(\"display\", \"inline-block\");\r\n\t\t}\r\n\r\n        changeNews();\r\n\r\n        \r\n\r\n        \r\n\r\n        \r\n    });\r\n\r\n    bindData();\r\n    clearIOSPreview();\r\n    addDragEvents();\r\n\r\n    if(!isTablet()) {\r\n        $(\".pinned-doc-inner\").click(pinnedDocumentClickHandler);\r\n        $(\".folder\").one('click',folderClickHandler);\r\n    } else {\r\n        $(\".pinned-doc-inner\").on(\"tap\", pinnedDocumentClickHandler);\r\n        $(\".folder\").one(\"tap\", folderClickHandler);\r\n    }\r\n\r\n    function folderClickHandler(event)\r\n    {\r\n        var _this = $(this);\r\n        var isLocked = _this.hasClass(\"folderLocked\");\r\n        var _closeFolder = function(callback) {\r\n            $.modal.close();\r\n//            $(\".simplemodal-overlay\").remove();\r\n//            $(\".simplemodal-container\").remove();\r\n            if(typeof callback === 'function')\r\n                callback();\r\n        };\r\n        var _afterClose = function() {\r\n            _this.removeClass('folder-expanded');\r\n            _this.droppable('destroy');\r\n            addDragEvents();\r\n            _this.one('click',folderClickHandler);\r\n        };\r\n        _this.modal({\r\n            skipAnimation: true, overlayClose: true, minHeight: '450px', minWidth: '600px',\r\n            escClose: true, opacity: 65, persist: true, overlayCss: {backgroundColor:\"#F8F8F8\"},\r\n            afterClose: _afterClose\r\n        });\r\n        _this.addClass('folder-expanded');\r\n        setTimeout(function(){\r\n            removeDragEvents();\r\n            _this.addClass('folder-expanded');\r\n\r\n            $(\".pinned-doc-inner\", _this)\r\n                    .unbind('click')\r\n                    .click(function(e) {\r\n                        var __arguments=arguments, __this = this;\r\n                        _closeFolder(function() {\r\n                            setTimeout(function(){\r\n                                var documentID = $(__this).attr(\"docid\");\r\n                                if(documentID) {\r\n                                    viewDocInfo(documentID);\r\n                                }\r\n                            }, 50);\r\n                        });\r\n                        e.stopPropagation();\r\n                    });\r\n            if(!isLocked){\r\n                $(\".pinned-doc-inner\", _this).draggable({\r\n                    revert: function( event, ui ) {\r\n                        return !$( event.toElement ).hasClass('simplemodal-overlay');\r\n                    },\r\n                    addClasses: false,\r\n                    start: function( event, ui ) {\r\n                        _this.addClass('overflow-visible');\r\n                        $( event.target ).unbind('click');\r\n                        ui.helper.data('dropped', false);\r\n                    },\r\n                    stop: function( event, ui ) {\r\n                        _this.removeClass('overflow-visible');\r\n                        $( event.toElement ).one('click', function(e){ e.stopImmediatePropagation(); return false; } );\r\n\r\n                        if(ui.helper.data('dropped')) {\r\n                            $( event.target ).click(pinnedDocumentClickHandler);\r\n                        } else {\r\n                            var docRemovedFromFolder = $(this);\r\n                            ADA.addToFolder(0, docRemovedFromFolder.attr(\"docid\"));\r\n                            docRemovedFromFolder.draggable('destroy');\r\n                            docRemovedFromFolder.appendTo($('<div class=\"pinned-doc\" docid=\"'+docRemovedFromFolder.attr(\"docid\")+'\"></div>').appendTo($(\"#pinned-documents\")));\r\n                            docRemovedFromFolder.parent(\".pinned-doc\").click(pinnedDocumentClickHandler).addClass(\"loaded\").draggable({\r\n                                opacity: 0.7, revert: \"invalid\", containment: $(\"#content\"), stack: \"#pinned-documents div\",\r\n                                addClasses: false,\r\n                                start: function( event, ui ) {\r\n                                    $(\".pinned-doc-inner\", $( event.target )).unbind('click');\r\n                                },\r\n                                stop: function( event, ui ) {\r\n                                    $( event.toElement ).one('click', function(e){ e.stopImmediatePropagation(); } );\r\n                                    $(\".pinned-doc-inner\", $( event.target )).click(pinnedDocumentClickHandler);\r\n                                    $(\".folder\").one('click',folderClickHandler);\r\n                                }\r\n                            });\r\n                            if( $('.folder-expanded .pinned-doc-inner').length==0 ) {\r\n                                $.modal.close();\r\n                                $(\".folder\").each(function() {\r\n                                    if($(this).attr(\"folderid\") == _this.attr(\"folderid\"))\r\n                                        $(this).remove();\r\n                                });\r\n                            }\r\n                        }\r\n                    }\r\n                });\r\n\r\n                _this.droppable({\r\n                    tolerance: \"pointer\",\r\n                    drop: function( event, ui ) {\r\n                        ui.draggable.data('dropped', true);\r\n                    },\r\n                    over: function( event, ui ) {\r\n                    }\r\n                });\r\n            }\r\n\r\n        },50);\r\n    }\r\n\r\n    function removeDragEvents()\r\n    {\r\n        $( \".pinned-doc\" ).draggable('destroy');\r\n        $( \".pinned-doc\" ).droppable('destroy');\r\n\r\n        $(\".ui-draggable\").removeClass(\"ui-draggable\");\r\n        $(\".ui-droppable\").removeClass(\"ui-droppable\");\r\n    }\r\n\r\n    function addDragEvents()\r\n    {\r\n        $( \".pinned-doc:not(.plugin)\" ).draggable({\r\n            opacity: 0.7, revert: \"invalid\", stack: \"#pinned-documents div\", containment: $(\"#pinned-documents\"),\r\n            addClasses: false,\r\n            start: function( event, ui ) {\r\n                $(\".pinned-doc-inner\", this).addClass('dragging-no-click');\r\n            },\r\n            stop: function( event, ui ) {\r\n                // evito che al drop chiami anche il click dell'elemento trascinato\r\n                $( event.toElement ).one('click', function(e){ e.stopImmediatePropagation(); } );\r\n                $(\".pinned-doc-inner\", this).removeClass('dragging-no-click');\r\n                $(\".folder\").one('click',folderClickHandler);\r\n            }\r\n        });\r\n\r\n        $( \".pinned-doc:not(.plugin)\" ).droppable({\r\n            activeClass: \"can-drop-here\", hoverClass: \"dropping-here\", tolerance: \"pointer\",\r\n            drop: function( event, ui ) {\r\n                $(this).addClass(\"dropping-here\");\r\n                var _this=$(this);\r\n\r\n                var _dragged = $( '.ui-draggable-dragging' );\r\n                if(!_this.hasClass(\"folder\")) {\r\n                    _this.unbind('click');\r\n                    $(\"div.pinned-doc-inner\", ui.draggable).unbind('click');\r\n\r\n                    DialogManager.inputBox(\"Dai un nome alla nuova cartella:\",         /*Dai un nome alla nuova cartella:*/\r\n                            function(txt){\r\n                                _this.addClass(\"folder\");\r\n                                $(\"<span>\").text(txt).addClass(\"folder-title\").appendTo(_this);\r\n                                $(\"div.pinned-doc-inner\", ui.draggable).appendTo(_this);\r\n                                ui.draggable.remove();\r\n                                _this.removeClass(\"dropping-here\");\r\n                                _this.one('click',folderClickHandler);\r\n                                var _folder = _this;\r\n                                var _dragged = ui.draggable;\r\n                                ADA.createFolder(txt,function(idFolder) {\r\n                                    _this.attr(\"folderid\", idFolder);\r\n                                    ADA.addToFolder(idFolder, _folder.attr(\"docid\"));\r\n                                    ADA.addToFolder(idFolder, _dragged.attr(\"docid\"));\r\n                                });\r\n                                DialogManager.closeDialog();\r\n                            },\r\n                            function(){\r\n                                _this.removeClass(\"dropping-here\");\r\n                                _dragged.trigger('mouseup').css('left','auto').css('top','auto');\r\n                                _this.click(pinnedDocumentClickHandler);\r\n       