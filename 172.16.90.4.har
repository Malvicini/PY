          "content": {
            "size": 3811,
            "mimeType": "text/css",
            "compression": -1,
            "text": "/*{\"name\": \"\", \"prefix\": \"light-greenblue\", \"bg-color\": \"rgb(139, 174, 175)\", \"color\": \"#fff\"}*/\r\n\r\n.theme-preview-light-greenblue {\r\n    box-shadow: 1px 1px 1px 1px rgb(139, 174, 175);\r\n}\r\n#bd.theme-light-greenblue {\r\n    background-color: rgb(139, 174, 175);\r\n}\r\n#bd.theme-light-greenblue #crumbs:before, #bd.theme-light-greenblue #crumbs li, #bd.theme-light-greenblue #crumbs li a:link, #bd.theme-light-greenblue #crumbs li a:visited {\r\n    color: white;\r\n}\r\n#bd.theme-light-greenblue #application-top-bar .toolbar-button-selected {\r\n    color: white !important;\r\n}\r\n#bd.theme-light-greenblue #crumbs li a {\r\n    background: none;\r\n}\r\n#bd.theme-light-greenblue #crumbs li:after {\r\n    content: \" \";\r\n    display: block;\r\n    width: 0;\r\n    height: 0;\r\n    border-top: 6px solid transparent;\r\n    border-bottom: 6px solid transparent;\r\n    border-left: 11px solid hsl(180, 29%, 82%);\r\n    position: relative;\r\n    margin-top: -19px;\r\n    right: 17px;\r\n    z-index: 2;\r\n}\r\n#bd.theme-light-greenblue #crumbs li:first-child:after {\r\n    display: none;\r\n}\r\n#bd.theme-light-greenblue #main-container {\r\n    background-color: rgba(255, 255, 255, 0.9) !important;\r\n}\r\n#bd.theme-light-greenblue div#families-list {\r\n    background-color: rgba(255, 255, 255, 0.95) !important;\r\n}\r\n#bd.theme-light-greenblue #main-container {\r\n    box-shadow: 0 0 10px rgb(92, 117, 150) !important;\r\n}\r\n\r\n#bd.theme-light-greenblue #application-top-bar .toolbar-button-selected#home {\r\n    background-image: url(\"/adiJed/img/toolbar/home_w_22_white.png\") !important;\r\n}\r\n#bd.theme-light-greenblue #application-top-bar .toolbar-button-selected#new {\r\n    background-image: url(\"/adiJed/img/toolbar/new-document_white.png\") !important;\r\n}\r\n#bd.theme-light-greenblue #application-top-bar .toolbar-button-selected#query {\r\n    background-image: url(\"/adiJed/img/toolbar/query_white_22.png\") !important;\r\n}\r\n#bd.theme-light-greenblue #application-top-bar .toolbar-button-selected#workflow {\r\n    background-image: url(\"/adiJed/img/toolbar/workflow_w_22_white.png\") !important;\r\n}\r\n#bd.theme-light-greenblue #application-top-bar .toolbar-button-selected#messages {\r\n    background-image: url(\"/adiJed/img/toolbar/messages_w_22_white.png\") !important;\r\n}\r\n#bd.theme-light-greenblue #application-top-bar .toolbar-button-selected#training {\r\n    background-image: url(\"/adiJed/img/toolbar/training_w_22_white.png\") !important;\r\n}\r\n#bd.theme-light-greenblue #application-top-bar .toolbar-button-selected {\r\n    border-bottom-color: rgb(139, 174, 175) !important;\r\n    background-color: rgb(139, 174, 175) !important;\r\n}\r\n#bd.theme-light-greenblue .documents-table > tbody > tr.document-row:nth-child(odd) {\r\n    background-color: rgba(250, 250, 250, 1) !important;\r\n}\r\n#bd.theme-light-greenblue .documents-table > tbody > tr.document-row:nth-child(even) {\r\n    background-color: rgb(240, 240, 240) !important;\r\n}\r\n\r\n#bd.theme-light-greenblue .pinned-doc-inner {\r\n    /*background-color: rgba(118, 152, 153, 0.3) !important;*/\r\n}\r\n#bd.theme-light-greenblue .pinned-doc-data, #bd.theme-light-greenblue .pinned-doc-family {\r\n    color: #000000;\r\n}\r\n#bd.theme-light-greenblue .pinned-doc > .pinned-doc-inner > .pinned-doc-workflow {\r\n    background-color: rgba(236, 240, 255, 1) !important;\r\n    box-shadow: none !important;\r\n    border-top-color: rgb(228, 232, 247) !important;\r\n    border-bottom-color: rgb(228, 232, 247) !important;\r\n}\r\n\r\n#bd.theme-light-greenblue input[type=text], #bd.theme-light-greenblue input[type=password], #bd.theme-light-greenblue textarea {\r\n    /*background-color: rgba(250, 250, 250, 1) !important;*/\r\n}\r\n#bd.theme-light-greenblue .field-label {\r\n    background-color: rgba(226, 238, 241, 0.32) !important;\r\n}\r\n#bd.theme-light-greenblue table.document-info tr td.field-label-split {\r\n    border-top-color: #D8D2D2;\r\n}\r\n"
          },
