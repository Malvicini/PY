            "text": "function __cl__(){};\r\n__cl__.__create__ = function(gname, implClass, classInterface) {\r\n    __cl__.__implements__.call(implClass.prototype, classInterface.prototype, gname);\r\n    window[gname] = Object.create(implClass.prototype);\r\n};\r\n__cl__.__implements__ = function(iface, gname) {\r\n    var impl = this;\r\n    for(var __method in iface) {\r\n        if( iface.hasOwnProperty(__method) && typeof impl[__method] !== \"function\" ) {\r\n            console.error(\"Class \"+gname+\"Impl must implement I\"+gname+\" method \"+__method);\r\n        }\r\n    }\r\n};\r\n\r\n/**\r\n * Aggiungere tutti i metodi esposti da DialogManager qui.\r\n * Implementati in ui/confirm-dialog-impl.js e ui/touch/confirm-dialog-impl.js\r\n * \r\n * @type {type}\r\n */\r\nfunction IDialogManager() {};\r\nIDialogManager.prototype.showConfirm = function (txt, fnOK, fnCancel, title, okLabel, cancelLabel)  {console.error(\"Not implemented!\");};\r\nIDialogManager.prototype.showAlert   = function (txt, fnOK, title, okLabel)                         {console.error(\"Not implemented!\");};\r\nIDialogManager.prototype.inputBox    = function (txt, fnOK, fnCancel, title, def)                   {console.error(\"Not implemented!\");};\r\n\r\nfunction MultiChoice()\r\n{\r\n    var container;\r\n    /**\r\n     * Mostra una finestra con una scelta multipla\r\n     * @param choices Array di Choice\r\n     */\r\n    this.show = function(title, choices) {\r\n        var _this = this;\r\n        _this.container = $(\"<div>\").attr(\"id\",\"multi-choice\").addClass(\"multi-choice\");\r\n\r\n        if(title) {\r\n            $(\"<span>\").addClass(\"choice-title\").text(title).appendTo(_this.container);\r\n        }\r\n        $(choices).each(function(i,choice){\r\n            $(\"<span>\").addClass(\"choice\").text(choice.description).click(function(ev){\r\n                $.modal.close();\r\n                choice.callback.call(this, choice);\r\n            }).appendTo(_this.container);\r\n        });\r\n\r\n        _this.container.modal({overlayClose:true, escClose:true, opacity:65, zIndex:100000, overlayCss:{backgroundColor:\"#F8F8F8\"}});\r\n    };\r\n\r\n    /**\r\n     *\r\n     * @param description La stringa da mostrare nel menu di scelta\r\n     * @param callback La funzione da richiamare quando viene fatta una scelta (viene passato l'elemento Choice scelto)\r\n     * @param data [optional] Un oggetto da salvare nell'instanza\r\n     * @constructor\r\n     */\r\n    function Choice(description, callback, data)\r\n    {\r\n        this.description = description;\r\n        this.callback = callback;\r\n        this.data = data;\r\n    }\r\n    Choice.prototype.constructor = Choice;\r\n\r\n    MultiChoice.Choice = Choice;\r\n}\r\nMultiChoice.prototype.constructor = MultiChoice;\r\n"
          },
