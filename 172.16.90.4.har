            "text": "try {\r\n    console.info(\"generic-search.js loaded, click on my row number for debugging...\");\r\n} catch(e){}\r\n\r\nvar GenericSearch = function() {\r\n\t\r\n\treturn {\r\n\t\t_container: null,\r\n\t\t_elementsSelector: null,\r\n\t\t_highlightSelector: null,\r\n\t\t_textbox: null,\r\n\r\n\t\t_TIMEOUT_SEARCH_MS: 100,\r\n\r\n\t\t_lastHighlighted: 0,\r\n\t\t_timeoutScroll: -1,\r\n\t\t_timeoutSearch: -1,\r\n\t\t_lastSearchTerm: null,\r\n\t\t_scrollMarginTop: null,\r\n        \r\n        _searchPreFunction: null,\r\n\r\n\t\t/**\r\n\t\t * Crea una nuova istanza di GenericSearch\r\n\t\t * @param ftc L'elemento contenitore del box di ricerca\r\n\t\t * @param elSelector La query css per trovare gli elementi all'interno dei quali cercare\r\n\t\t * @param highlightSelector La query css per trovare cosa evidenziare all'interno di elSelector\r\n\t\t * @param scrollMarginTop (valore da aggiungere alla funzione scroll)\r\n\t\t * @returns {GenericSearch}\r\n\t\t */\r\n\t\t_getInstance: function(ftc, elSelector, highlightSelector, scrollMarginTop) {\t\r\n                        this._container = ftc;\r\n\t\t\tthis._elementsSelector = elSelector;\r\n\t\t\tthis._highlightSelector = highlightSelector;\r\n\t\t\tthis._cachedElements = null;\r\n                        this._scrollMarginTop = arguments.length > 3 || (!scrollMarginTop) ? scrollMarginTop : 0;\r\n                        if (!this._scrollMarginTop)\r\n                            this._scrollMarginTop = 0;\r\n\t\t\treturn this;\r\n\t\t},\r\n\t\t/**\r\n\t\t * Inizializza la textbox con i controlli per muoversi tra i risultati della ricerca\r\n\t\t * @param textbox\r\n\t\t */\r\n\t\tsetup: function(textbox, searchPreFunction) {\r\n\t\t\tvar _this = this;\r\n\t\t\tthis._textbox = textbox;\r\n\t\t\tthis._textbox.off('keyup').on('keyup', function(e) {_this.keyUp.call(_this,e,this); e.stopPropagation();});\r\n\t\t\tthis._textbox.off('keydown').on('keydown', function(e) { if(e.keyCode == 13) { e.preventDefaul