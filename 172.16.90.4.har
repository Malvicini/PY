  }\r\n            return isSupported;\r\n        }\r\n\r\n        function lookupTokenInUri(location, tokenName) {\r\n            const tokenValueMatcher = new RegExp('(?:' + tokenName + '=)([^?|#|&]+)', 'gi');\r\n            const tokenMatches = tokenValueMatcher.exec(location);\r\n\r\n            return {\r\n                \"tokenIsPresent\": !(tokenMatches === null || tokenMatches.length === 0),\r\n                \"tokenMatches\": tokenMatches\r\n            };\r\n        }\r\n\r\n        function getNewLocation(location, tokenName, tokenValue, pageTokens) {\r\n            let newLocation = location;\r\n\r\n            if (location != null && isValidUrl(location) && !isUnprotectedExtension(location)) {\r\n                const uri = parseUri(location);\r\n                const calculatedPageToken = calculatePageTokenForUri(pageTokens, tokenValue, uri);\r\n                const value = calculatedPageToken == null ? tokenValue : calculatedPageToken;\r\n\r\n                const tokenRegExpResult = lookupTokenInUri(location, tokenName);\r\n\r\n                if (!tokenRegExpResult.tokenIsPresent) {\r\n                    const anchorIndex = location.indexOf('#');\r\n                    if (anchorIndex !== -1) {\r\n                        const baseLocation = location.split('#')[0];\r\n                        const anchor = location.substring(anchorIndex);\r\n\r\n                        newLocation = addTokenToLocation(baseLocation, tokenName, value) + anchor;\r\n                    } else {\r\n                        newLocation = addTokenToLocation(location, tokenName, value);\r\n                    }\r\n                } else {\r\n                    tokenRegExpResult.tokenMatches.slice(1).forEach(function (match) {\r\n                        return newLocation = newLocation.replace(match, value);\r\n                    });\r\n                }\r\n            }\r\n\r\n            return newLocation;\r\n        }\r\n\r\n        function injectToElements(domElements, tokenName, tokenValue, pageTokens) {\r\n            var len = domElements.length;\r\n\r\n            var injectForms = true;\r\n            var injectGetForms = true;\r\n            var injectFormAttributes = true;\r\n            var injectAttributes = true;\r\n\r\n            for (let i = 0; i < len; i++) {\r\n                let element = domElements[i];\r\n\r\n                const disableCsrfInject =   element.getAttribute &&\r\n                                            element.getAttribute(DISABLE_CSRF_INJECT_PROPERTY) &&\r\n                                            element.getAttribute(DISABLE_CSRF_INJECT_PROPERTY) === 'true';\r\n\r\n                if (!disableCsrfInject) {\r\n                    if (element.tagName && element.tagName.toLowerCase() === 'form') {\r\n                        let injectedTokenInForm = false;\r\n                        if (injectForms) {\r\n                            injectedTokenInForm = injectTokenForm(element, tokenName, tokenValue, pageTokens, injectGetForms);\r\n\r\n                            /* adjust array length after addition of new element */\r\n                            len = domElements.length; // TODO review\r\n                        }\r\n                        if (injectFormAttributes && !injectedTokenInForm) {\r\n                            injectTokenAttribute(element, 'action', tokenName, tokenValue, pageTokens);\r\n                        }\r\n                        /* inject into attribute */\r\n                    } else if (injectAttributes) {\r\n                        injectTokenAttribute(element, 'src', tokenName, tokenValue, pageTokens);\r\n                        injectTokenAttribute(element, 'href', tokenName, tokenValue, pageTokens);\r\n                    }\r\n                }\r\n            }\r\n        }\r\n\r\n        /**\r\n         *  inject csrf prevention tokens throughout dom\r\n         */\r\n        function injectTokens(tokenName, tokenValue, existingPageTokens) {\r\n            /* obtain reference to page tokens if enabled */\r\n            var pageTokens = {};\r\n\r\n            if (true) {\r\n                pageTokens = existingPageTokens;\r\n            }\r\n\r\n            /* iterate over all elements and injection token */\r\n            var all = document.all ? document.all : document.getElementsByTagName('*');\r\n\r\n            injectToElements(all, tokenName, tokenValue, pageTokens);\r\n        }\r\n\r\n        function triggerParentPageTokensUpdate(pageTokens) {\r\n            try{\r\n                if(parent !== self) {\r\n                    if (!parent.document)\r\n                        throw new Error('Unaccessible');\r\n                    // accessible\r\n\r\n                    parent.document.dispatchEvent(new CustomEvent('pageTokensUpdated', {detail: pageTokens}));\r\n                }\r\n            }catch(e){\r\n                // not accessible\r\n            }\r\n        }\r\n\r\n        /**\r\n         *  obtain array of page specific tokens\r\n         */\r\n        function requestPageTokens(tokenName, tokenValue, callback, callbackFail, sync) {\r\n            const xhr = window.XMLHttpRequest ? new window.XMLHttpRequest : new window.ActiveXObject('Microsoft.XMLHTTP');\r\n\r\n            xhr.open('POST', '/adiJed/csrfguard', sync ? true : true);\r\n\r\n            /* if AJAX is enabled, the token header will be automatically added, no need to set it again */\r\n            if (true !== true) {\r\n                if (tokenName !== undefined && tokenValue !== undefined) {\r\n                    xhr.setRequestHeader(tokenName, tokenValue);\r\n                }\r\n            }\r\n\r\n            xhr.onreadystatechange = function () {\r\n                if (xhr.readyState === XmlHttpRequestReadyState.DONE) {\r\n                    if (xhr.status === 200) {\r\n                        let pageTokens = JSON.parse(xhr.responseText)['pageTokens'];\r\n                        //console.debug('Received page tokens: 