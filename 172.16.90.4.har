          "content": {
            "size": 7278,
            "mimeType": "text/css",
            "compression": -1,
            "text": ".adiuto-tree-container {\r\n    display: inline-block;\r\n    padding: 12px 5px;\r\n    top: 41px;\r\n    left: 0;\r\n    position: absolute;\r\n    bottom: 0;\r\n    right: 0;\r\n}\r\nlabel.tree-item-label {\r\n    font-size: 90%;\r\n    line-height: 20px;\r\n    display: inline-block;\r\n    padding-top: 3px;\r\n    padding-right: 10px;\r\n    vertical-align: top;\r\n    cursor: pointer;\r\n}\r\nbody#bd.smaller .adiuto-tree-container {\r\n    max-height: inherit;\r\n    position: absolute;\r\n    top: 41px;\r\n    margin-top: auto;\r\n    bottom: 0;\r\n}\r\n.ad-toolbar .search-box {\r\n    display: inline-block;\r\n    position: absolute;\r\n    right: 10px;\r\n    left: 10px;\r\n    top: 6px;\r\n    bottom: 6px;\r\n}\r\n.ad-toolbar .search-box input {\r\n    position: relative;\r\n    box-sizing: border-box;\r\n    width: 100%;\r\n    height: 100%;\r\n    min-height: 20px;\r\n    /*background: white url(\"/adiJed/img/toolbar/find_bkg.png\") no-repeat right center;*/\r\n}\r\n\r\n.ad-toolbar .status-filter-box {\r\n    display: inline-block;\r\n    position: absolute;\r\n    right: 10px;\r\n    left: 10px;\r\n    top: 6px;\r\n    bottom: 6px;\r\n}\r\n.ad-toolbar .status-filter-box select {\r\n    position: relative;\r\n    box-sizing: border-box;\r\n    width: 100%;\r\n    height: 100%;\r\n    min-height: 20px;\r\n    /*background: white url(\"/adiJed/img/toolbar/find_bkg.png\") no-repeat right center;*/\r\n}\r\n\r\nbody#bd.tablet .ad-toolbar {\r\n    position: absolute;\r\n    left: 0;\r\n}\r\n.filtered {\r\n    background-image: none;\r\n    background-color: #ffff00 !important;\r\n    box-shadow: 0 0 6px -2px #000 !important;\r\n    padding-top: 3px;\r\n    padding-bottom: 3px;\r\n    border-radius: 3px;\r\n}\r\n.filtered *, .filtered span.nodeText {\r\n    font-weight: bold;\r\n    color: blue;\r\n}\r\n.currentHighlighted.filtered *, .currentHighlighted.filtered span.nodeText {\r\n    color: white;\r\n}\r\n.search-box > input[type=\"text\"] {\r\n    box-sizing: border-box;\r\n}\r\n.search-box > input[type=\"text\"]:not(:focus) {\r\n    background: url('/adiJed/img/toolbar/find_bkg.png') left 2px top 50% no-repeat transparent;\r\n    color: black;\r\n    border: 0;\r\n    border-bottom: 1px solid #d3d3d3;\r\n    padding-left: 26px;\r\n    transition: all .1s ease-in;\r\n}\r\n\r\n.search-box > input[type=\"text\"] {\r\n    box-sizing: border-box;\r\n}\r\n.search-box > input[type=\"text\"]:not(:focus) {\r\n    background: url('/adiJed/img/toolbar/find_bkg.png') left 2px top 50% no-repeat transparent;\r\n    color: black;\r\n    border: 0;\r\n    border-bottom: 1px solid #d3d3d3;\r\n    padding-left: 26px;\r\n    transition: all .1s ease-in;\r\n}\r\n/*\r\n.search-box.filters-active > input[type=\"text\"]:not(:focus) {\r\n    border: 1px solid lightgray;\r\n    background-color: white;\r\n}\r\n*/\r\n.search-box > input[type=\"text\"]::-webkit-input-placeholder { /* WebKit browsers */\r\n    color:    #4f4f4f;\r\n}\r\n.search-box > input[type=\"text\"]:-moz-placeholder { /* Mozilla Firefox 4 to 18 */\r\n    color:    #4f4f4f;\r\n    opacity:  1;\r\n}\r\n.search-box > input[type=\"text\"]::-moz-placeholder { /* Mozilla Firefox 19+ */\r\n    color:    #4f4f4f;\r\n    opacity:  1;\r\n}\r\n.search-box > input[type=\"text\"]:-ms-input-placeholder { /* Internet Explorer 10+ */\r\n    color:    #4f4f4f;\r\n}\r\n.search-box > .search-controls {\r\n    position: absolute;\r\n    display: flex;\r\n    right: 0;\r\n    top: 0;\r\n    bottom: 0;\r\n    box-sizing: border-box;\r\n    height: 100%;\r\n}\r\n.search-box > .search-controls > span {\r\n    width: 25px;\r\n    vertical-align: middle;\r\n    /*border: 1px solid #E0E0E0;*/\r\n    height: 100%;\r\n    position: relative;\r\n    box-sizing: border-box;\r\n    margin-left: -1px;\r\n    text-align: center;\r\n    cursor: pointer;\r\n    /*box-shadow: 0px 0px 1px 0px rgba(211, 211, 211, 0.55);*/\r\n    /*background-color: #F7F7F7;*/\r\n    background-position: center;\r\n    background-repeat: no-repeat;\r\n}\r\n.search-box > .search-controls > span:active {\r\n    box-shadow: inset 0 0 1px 1px rgba(211, 211, 211, 0.55);\r\n}\r\n.search-box > .search-controls > .search-clear > .status-filter-box{\r\n    background-color: transparent;\r\n    border: none;\r\n    box-shadow: none;\r\n}\r\n.status-filter-box > select {\r\n    box-sizing: border-box;\r\n    color: black;\r\n    border: 0;\r\n    border-bottom: 1px solid #d3d3d3;\r\n    padding-left: 26px;\r\n    transition: all .1s ease-in;\r\n}\r\n.status-filter-box > select::-webkit-input-placeholder { /* WebKit browsers */\r\n    color:    #4f4f4f;\r\n}\r\n.status-filter-box > select:-moz-placeholder { /* Mozilla Firefox 4 to 18 */\r\n    color:    #4f4f4f;\r\n    opacity:  1;\r\n}\r\n.status-filter-box > select::-moz-placeholder { /* Mozilla Firefox 19+ */\r\n    color:    #4f4f4f;\r\n    opacity:  1;\r\n}\r\n.status-filter-box > select-ms-input-placeholder { /* Internet Explorer 10+ */\r\n    color:    #4f4f4f;\r\n}\r\n.search-controls > .search-next {\r\n    background-size: 18px;\r\n    background-image: url('/adiJed/img/toolbar/right2_20.png');\r\n}\r\n.search-controls > .search-prev {\r\n    background-size: 18px;\r\n    background-image: url('/adiJed/img/toolbar/left2_20.png');\r\n}\r\n.search-controls > .search-clear {\r\n    background-size: 14px;\r\n    background-image: url('/adiJed/img/toolbar/cross_20.png');\r\n}\r\n.search-box .results-found {\r\n    position: absolute;\r\n    top: 100%;\r\n    left: 0;\r\n    right: 0;\r\n    background-color: rgb(252, 252, 252);\r\n    box-shadow: inset 0px 3px 6px -4px rgba(128, 128, 128, 0.5);\r\n    border: 1px solid #ebe9e9;\r\n    padding: 3px 4px 3px 7px;\r\n    border-top: 0;\r\n    z-index: 1;\r\n    color: #000000;\r\n    margin-left: 1px;\r\n    margin-right: 1px;\r\n    border-bottom-left-radius: 4px;\r\n    border-bottom-right-radius: 4px;\r\n}\r\n.search-box .results-found.search-ko {\r\n    color: red;\r\n}\r\n.currentHighlighted {\r\n    background-image: none;\r\n    background-color: #0000ff !important;\r\n    box-shadow: 0 0 6px -2px #000 !important;\r\n    color: white;\r\n}\r\n.currentHighlighted label.tree-item-label {\r\n    color: white !important;\r\n}\r\n.k-sprite {\r\n    background-repeat: no-repeat;\r\n    background-position: center left;\r\n    height: 20px;\r\n    width: 20px;\r\n}\r\n.k-treeview span.k-in {\r\n    line-height: 20px;\r\n    -webkit-transition: opacity .2s ease-in-out;\r\n    -moz-transition: opacity .2s ease-in-out;\r\n    -o-transition: opacity .2s ease-in-out;\r\n    transition: opacity .2s ease-in-out;\r\n    padding: 0;\r\n    padding-right: 4px;\r\n    border: 1px solid transparent;\r\n}\r\n.k-treeview span.k-in.k-state-hover, .k-treeview span.k-in.k-state-selected, .k-treeview span.k-in.k-state-focused {\r\n    padding: 0;\r\n    padding-right: 4px;\r\n}\r\n.filtered-out {\r\n    opacity: .45;\r\n}\r\n.k-sprite.group {\r\n    background-image: url('/adiJed/img/icons/folder-open.png');\r\n}\r\nli[aria-expanded=\"false\"] .k-sprite.group {\r\n    background-image: url('/adiJed/img/icons/folder.png');\r\n}\r\n.k-sprite.family, .k-sprite.mixed {\r\n    background-image: url('/adiJed/img/icons/fam-documentale.png');\r\n    background-position: center;\r\n    margin-right: 0;\r\n}\r\n.k-sprite.phantom {\r\n    background-image: url('/adiJed/img/icons/fam-processo.gif');\r\n    margin-right: 0;\r\n}\r\n.k-sprite.detail {\r\n    background-image: url('/adiJed/img/icons/zoom.png');\r\n    background-position: 2px 5px;\r\n}\r\nspan.nodeText {\r\n    cursor: pointer;\r\n    font-weight: bold;\r\n    color: #636363;\r\n    padding-right: 5px;\r\n}\r\n.k-state-selected span.nodeText {\r\n    color: white;\r\n}\r\nbody#bd.tablet div#families-tree-toolbar.ad-toolbar {\r\n    position: relative;\r\n    left: 0;\r\n}\r\n"
