n                    var colHtml = $this.get(0).outerHTML;\r\n                    newTableHeadHTML.push(colHtml);\r\n                }\r\n            });\r\n\r\n            var tableHeadRowHTML = $(tableHeadRow.find(\"th:not(.adi-column)\").get().reverse()).each(function(){\r\n                newTableHeadHTML.splice(0, 0, $(this).get(0).outerHTML);\r\n            });\r\n            tableHeadRow.html(newTableHeadHTML.join(\"\"));\r\n        }\r\n\r\n        setHeaderEvents();\r\n    }\r\n\r\n    function setHeaderEvents() {\r\n        $(\".order-button.hide-column\").on(_evt_type, function(e){\r\n            var fieldRegID = $(this).attr(\"fieldRegID\");\r\n            var fieldPrefix = $(this).attr(\"fieldPrefix\");\r\n\r\n            $(\"#documents\").removeClass(\"loaded\");\r\n\r\n            hideColumnInReport(fieldPrefix, fieldRegID);\r\n            saveHiddenColumnForReport(queryUID, fieldRegID, null, fieldPrefix);\r\n\r\n            HistoryManager.reloadLastPage();\r\n        });\r\n\r\n        $(\"#documents\").on(\"mousedown\", \".resize-head-col\", function(e){\r\n            var splitter = $(this);\r\n            var th = splitter.closest(\"th\");\r\n            var fieldRegID = th.attr(\"fieldRegID\");\r\n            var fieldPrefix = th.attr(\"fieldPrefix\");\r\n\r\n            var ghost = splitter.clone().appendTo(\"body\")/*insertAfter(splitter)*/.css({\r\n                position: \"absolute\",\r\n                \"z-index\": 99,\r\n                left: splitter.offset().left+splitter.css(\"padding-left\"),\r\n                top: splitter.offset().top,\r\n                \"opacity\":1,\r\n                \"background-color\": \"#7AC394\",\r\n                \"cursor\":\"ew-resize\",\r\n                \"height\": splitter.height(),\r\n                \"width\": \"3px\",\r\n                \"padding\": 0\r\n            });\r\n\r\n            var _mousemove = function(e) {\r\n                var pageX = e[\"pageX\"];\r\n                ghost.css(\"left\", pageX);\r\n                if( !splitter.attr(\"dragging\") ) {\r\n                    splitter.attr(\"startLeft\", pageX);\r\n                }\r\n                splitter.attr(\"dragging\", true);\r\n            };\r\n            var _mouseup = function(e) {\r\n                var pageX = parseInt(e[\"pageX\"],10);\r\n                var startLeft = parseInt(splitter.attr(\"startLeft\"),10);\r\n\r\n                splitter.removeAttr(\"dragging\");\r\n                ghost.remove();\r\n\r\n                var newWidth = Math.max(35, th.get(0).offsetWidth+(pageX-startLeft));\r\n                th.css(\"width\", newWidth).css(\"max-width\", newWidth + DOCUMENT_COL_PADDING).find(\".img-for-width\").css(\"width\", newWidth);\r\n                $(\".documents-table td.\"+fieldPrefix+fieldRegID).css(\"width\", newWidth).css(\"max-width\", newWidth + DOCUMENT_COL_PADDING).find(\".img-for-width\").css(\"width\", newWidth);\r\n\r\n                resizeFieldForReport(queryUID, fieldRegID, newWidth, fieldPrefix);\r\n\r\n                fillWidthWithReport();\r\n\r\n                $(document).unbind(\"mousemove.resizeCol\", _mousemove).unbind(\"mouseup.resizeCol\", _mouseup);\r\n            };\r\n\r\n            $(document).bind(\"mousemove.resizeCol\", _mousemove).bind(\"mouseup.resizeCol\", _mouseup);\r\n        });\r\n\r\n        $(\"#documents\").on(_evt_type, \".more-options\", function() {\r\n            var _this = $(this);\r\n            var th = _this.closest(\"th\");\r\n            var fieldRegID = th.attr(\"fieldRegID\");\r\n            var fieldPrefix = th.attr(\"fieldPrefix\");\r\n\r\n            $(\".more-options.open\").removeClass(\"open\");\r\n            $(\".more-options-container.open\").removeClass(\"open\");\r\n\r\n            var _parent = _this.parent(), _moc = $(\"#moc\"+fieldPrefix+fieldRegID);\r\n            _moc.data(\"__parent\", _parent);\r\n            _moc.detach().appendTo(\"body\").css({\r\n                top:  _this.offset().top+5,\r\n                left: _this.offset().left-_moc.width()+25,\r\n                \"z-index\": 3\r\n            });\r\n            $(document).one(_evt_type,function(){\r\n                _this.removeClass(\"open\");\r\n                _moc.detach().appendTo(_parent);\r\n                $(\".more-options-container.open\").removeClass(\"open\");\r\n            });\r\n\r\n            $(\".order-button.asc-order[fieldregid=\"+fieldRegID+\"][fieldPrefix=\"+fieldPrefix+\"]\").off(_evt_type).on(_evt_type, function() {\r\n                var frid = $(this).attr(\"fieldRegID\");\r\n                var fieldPrefix = $(this).attr(\"fieldPrefix\");\r\n                var fieldFamilyType = $(this).attr(\"famtype\");\r\n                var k = HistoryManager.getLastQuery()[\"key\"];\r\n                var q = HistoryManager.getLastQuery()[\"data\"];\r\n\r\n                HistoryManager.getCurrentPage()[\"docs\"] = null;\r\n                HistoryManager.getCurrentPage()[\"queryKey\"] = null;\r\n                HistoryManager.getCurrentPage()[\"documentsFound\"] = null; //TODO mettere fieldPrefix nella HistoryManager\r\n                HistoryManager.saveQueryToHistory(k,q,\"queryKey=1766499174874&orderBy=\"+frid+\"&orderKind=asc&orderFieldFamilyType=\"+fieldFamilyType);\r\n\r\n                var oldScroll = $(\".documents-table-scroll\").scrollLeft();\r\n\r\n                $.when(\r\n                        saveHistoryAndDisplayPage(k, \"/adiJed/ui/query/change-order-search.do\", //TODO mettere fieldPrefix nella HistoryManager\r\n                                q+\"&queryKey=1766499174874&orderBy=\"+frid+\"&orderKind=asc&orderFieldFamilyType=\"+fieldFamilyType, true, false,\r\n                                HistoryConstants.REPLACE_CURRENT_HISTORY)\r\n                ).then( function(){\r\n                            $(\".documents-table-scroll\").scrollLeft(oldScroll);\r\n                        } );\r\n            });\r\n\r\n            $(\".order-button.desc-order[fieldregid=\"+fieldRegID+\"][fieldPrefix=\"+fieldPrefix+\"]\").off(_evt_type).on(_evt_type,function() {\r\n                var frid = $(this).attr(\"fieldRegID\");\r\n                var fieldPrefix = $(this).attr(\"fieldPrefix\");\r\n                var fieldFamilyType = $(this).attr(\"famtype\");\r\n                var k = HistoryManager.getLastQuery()[\"key\"];\r\n                var q = HistoryManager.getLastQuery()[\"data\"];\r\n\r\n                HistoryManager.getCurrentPage()[\"docs\"] = null; //TODO mettere fieldPrefix nella HistoryManager\r\n                HistoryManager.saveQueryToHistory(k,q,\"queryKey=1766499174874&orderBy=\"+frid+\"&orderKind=desc&orderFieldFamilyType=\"+fieldFamilyType);\r\n\r\n                var oldScroll = $(\".documents-table-scroll\").scrollLeft();\r\n\r\n                $.when(\r\n                        saveHistoryAndDisplayPage(k, \"/adiJed/ui/query/change-order-search.do\", //TODO mettere fieldPrefix nella HistoryManager\r\n                                q+\"&queryKey=1766499174874&orderBy=\"+frid+\"&orderKind=desc&orderFieldFamilyType=\"+fieldFamilyType, true, false,\r\n                                HistoryConstants.REPLACE_CURRENT_HISTORY)\r\n                ).then( function(){\r\n                            $(\".documents-table-scroll\").scrollLeft(oldScroll);\r\n                        } );\r\n            });\r\n\r\n            _this.toggleClass(\"open\");\r\n            _moc.toggleClass(\"open\");\r\n            return false;\r\n        });\r\n    }\r\n\r\n    function loadMoreRows(qKey,mode)\r\n    {\r\n        $(\"#moreRowsMessage\").html(\"<span><img src=\\\"/adiJed/img/wait.gif\\\"/></span>\");\r\n\r\n        setTimeout( function() {\r\n            \r\n            $.ajax({url: \"/adiJed/ui/get-more-docs.do\", // --> more-results.jsp\r\n                data: \"qKey=\"+qKey+\"&pos=\"+queryDocs.length+\"&mode=\"+mode+\"&total=\"+HistoryManager.getCurrentPage()[\"documentsFound\"]+\"&pageUnique=\",\r\n                success: function(html) {\r\n                    // aggiungo i record in coda alla tabella\r\n                    $('.documents-table').last().find(\" > tbody\").append(html);\r\n                    $(\"#moreRowsMessage\").css(\"opacity\",0);\r\n                    $(\"#moreRowsMessage\").html(\"<span>Mostra più risultati...</span>\");    /*Mostra pi&uacute; risultati...*/\r\n//                    setTimeout( function(){ /*fixTableHeader($(\".documents-table\"));*/fixTableFirstColumn($(\".documents-table\").last(),FIXED_COLUMN_NUM,scrollContainer); }, 400 );\r\n                    bindEvents();\r\n                }\r\n            });\r\n        }, 1000);\r\n    }\r\n\r\n    \r\n    \r\n    \r\n        $(\"#moreRowsMessage\").removeAttr(\"hasMoreRowsToDisplay\");\r\n        $(\"#moreRowsMessage\").css(\"opacity\",0);\r\n        $(\"#moreRowsMessage\").css(\"display\", \"none\");\r\n    \r\n    \r\n\r\n    var ir=1;\r\n    var lastSelectedDocFidd = '';\r\n    var reportPlugins = $(\".report-plugin\");\r\n\r\n    function reorderColumns(colsHtml) {\r\n        var userColumnsOrder = getColumnsOrderForReport(queryUID);\r\n        if( !userColumnsOrder ) {\r\n            return colsHtml;\r\n        } else {\r\n            var orderedCols = [];\r\n\r\n            for( var ic=0; ic<userColumnsOrder.length; ic++ ) {\r\n                for( var ic2 = 0; ic2 < colsHtml.length; ic2++ ) {\r\n                    if( colsHtml[ic2].fieldPrefix+colsHtml[ic2].fieldID == userColumnsOrder[ic] ) {\r\n                        orderedCols.push(colsHtml.splice(ic2, 1)[0]);\r\n                        break;\r\n                    }\r\n                }\r\n            }\r\n\r\n            for( var ic2 = 0; ic2 < colsHtml.length; ic2++ ) {\r\n                orderedCols.push(colsHtml[ic2]);\r\n            }\r\n\r\n            return orderedCols;\r\n        }\r\n    }\r\n    function appendRows(block,_queryKey, callback)\r\n    {\r\n        console.time(\"appending rows\");\r\n        var parentDocId='-1';\r\n        \r\n        var headdocid = '';\r\n\r\n        var hiddenFields    = getHiddenFieldsForReport(queryUID), //TODO Modificare idCampi con prefisso\r\n            colsSize        = getColumnsSizeForReport(queryUID);\r\n\r\n        var rowsArray = new Array();\r\n        var iRow = 0;\r\n        var queryKey = _queryKey||\"1766499174874\";\r\n        for(var iblock=0; iblock < block.length; iblock++)\r\n        {\r\n            var rowHtml;\r\n            var dKey = block[iblock];\r\n            var d = AdiutoCacheStore.retrieve(\"dc\"+queryKey,dKey);\r\n            var selectable = true;\r\n\r\n            if( queryDocs.indexOf(dKey) == -1 ) {\r\n                queryDocs.push(dKey);\r\n            }\r\n\r\n            rowHtml = '<tr dKey=\"'+ dKey +'\" docid=\"'+ d.id +'\" parentDocId=\"'+ d.id +'\" headdocid=\"'+ d.headerDocumentID +'\" class=\"rpl document-row parent-row';\r\n\r\n            if(d.del || !d.isEnabled) {\r\n                rowHtml += ' deleted';\r\n            }\r\n            \r\n            if(d.id == lastSelectedDocFidd) {\r\n                rowHtml += ' last-selected';\r\n            }\r\n            \r\n            \r\n            rowHtml += '\"> ';\r\n\r\n            var chk;\r\n            if(!selectable || d.del || !d.isEnabled){\r\n                chk = '<span style=\"width:22px;height:14px;display:inline-block;\">&nbsp;</span>';\r\n            } else {\r\n                chk = '<input type=\"checkbox\" famid=\"'+ d.f +'\" trackingId=\"'+d['trackingId']+'\" trackingFamilyId=\"'+d['trackingFamilyId']+'\" value=\"sel\">';\r\n        \r\n            \r\n            \r\n                chk = '<input type=\"checkbox\" famid=\"'+ d.f +'\" trackingId=\"'+d['trackingId']+'\" trackingFamilyId=\"'+d['trackingFamilyId']+'\" value=\"sel\">';\r\n            \r\n        \r\n            }\r\n            var rowNumber = ir++;\r\n            rowHtml += '<td class=\"row-number\">'+ rowNumber + '' + chk +'</td>';\r\n            var colsHtml = [];\r\n            for(var icol=0; icol<queryFieldsArray.length; icol++) {\r\n                if (queryFieldsArray[icol]){\r\n                \r\n                    var fieldID = queryFieldsArray[icol].id,\r\n                        field   = queryFields[queryFieldsArray[icol].fieldPrefix+fieldID],\r\n                        fieldPrefix = queryFieldsArray[icol].fieldPrefix;\r\n                    var hasBeenHiddenByUser = false,\r\n                        hasCustomSize       = false;\r\n\r\n                    if( queryFieldsArray[icol].id > 0 ) {\r\n                        var isFirstReportRow = rowNumber == 1;\r\n                        if( hiddenFields[fieldPrefix+fieldID] && hiddenFields[fieldPrefix+fieldID] == 'H' ) {\r\n                            hasBeenHiddenByUser = true;\r\n\r\n                            if( isFirstReportRow ) {\r\n                                $(\"th[fieldRegID=\"+fieldID+\"][fieldPrefix=\"+fieldPrefix+\"]\").addClass(\"hidden-by-user\").css(\"display\", \"none\");\r\n                            }\r\n                        }\r\n                        if( colsSize[fieldPrefix+fieldID] ) {\r\n                            if( isFirstReportRow ) {\r\n                                $(\"th[fieldRegID=\"+fieldID+\"][fieldPrefix=\"+fieldPrefix+\"]\").width(colsSize[fieldPrefix+fieldID]);\r\n                                // setto come max-width la larghezza scelta piÃ¹ il padding messo nel css\r\n                                $(\"th[fieldRegID=\"+fieldID+\"][fieldPrefix=\"+fieldPrefix+\"]\").css(\"max-width\", (colsSize[fieldPrefix+fieldID]+DOCUMENT_COL_PADDING)+\"px\");\r\n                            }\r\n                            hasCustomSize = true;\r\n                        }\r\n                    }\r\n\r\n                    if(icol==0) {//famiglia\r\n                        var iconFileName = (d[\"p\"].indexOf(\".\")>-1?\"ext\"+d[\"p\"].substr(d[\"p\"].lastIndexOf(\".\")):d[\"p\"]);\r\n                        rowHtml += '<td class=\"docVC '+ ('t'+field[\"type\"]) +' icons '+ (\"famtype\"+field[\"famtype\"]) +'\">';\r\n                        rowHtml += '<span class=\"icon file-icon\" style=\"background:url(\\'/adiJed/getDocumentIcon?fileName='+iconFileName+'\\') no-repeat center\">&nbsp;</span>';\r\n                        if(!d[\"hvd\"] || d[\"hvd\"]!=true)\r\n                            rowHtml += '<span class=\"icon icon-button historySubRpt\" title=\"Vedi storia documento\" style=\"background:url(\\'/adiJed/img/toolbar/history.png\\') no-repeat center\">&nbsp;</span>';\r\n\r\n                        if(d[\"i\"]>0) {\r\n                            rowHtml += '<span class=\"icon itttip\" itactid=\"'+ d[\"i\"] +'\" style=\"background:url(\\'/adiJed/img/wf-play.png\\') no-repeat center; background-size:22px;\">&nbsp;</span>';\r\n                        } else if(d[\"i\"]<=0 && d[\"fi\"]>0) {\r\n                            rowHtml += '<span class=\"icon\" style=\"background:url(\\'/adiJed/img/wf-light.png\\') no-repeat center; background-size:22px; opacity:.5;\">&nbsp;</span>';\r\n                        } else {\r\n                            rowHtml += '<span class=\"icon\" style=\"background:transparent;\">&nbsp;</span>';\r\n                        }\r\n\r\n                        if(d[\"ha\"]){\r\n                            if(d[\"ap\"]) {\r\n                                rowHtml += '<span class=\"icon icon-button attSubRpt\" title=\"Clicca per vedere gli allegati\" style=\"background:url(\\'/adiJed/img/report/clip.png\\') no-repeat center;\">&nbsp;</span>';\r\n                            } else {\r\n                                rowHtml += '<span class=\"icon attSubRpt\" style=\"background:url(\\'/adiJed/img/report/clip.png\\') no-repeat center;\">&nbsp;</span>';\r\n                            }\r\n                        } else {\r\n                            rowHtml += '<span class=\"icon\" style=\"background:transparent;\">&nbsp;</span>';\r\n                        }\r\n\r\n                        if(d[\"hd\"]){\r\n                            rowHtml += '<span class=\"icon icon-button detSubRpt\">&nbsp;</span>';\r\n                        } else {\r\n                            rowHtml += '<span class=\"icon\" style=\"background:transparent;\">&nbsp;</span>';\r\n                        }\r\n\r\n                        if(d[\"hl\"]){\r\n                            if(d[\"lp\"]) {\r\n                                rowHtml += '<span class=\"icon icon-button lnkSubRpt\" title=\"Clicca per vedere i documenti collegati\" style=\"background:url(\\'/adiJed/img/report/link.png\\') no-repeat center;\">&nbsp;</span>';\r\n                            } else {\r\n                                rowHtml += '<span class=\"icon lnkSubRpt\" style=\"background:url(\\'/adiJed/img/report/link.png\\') no-repeat center;\">&nbsp;</span>';\r\n                            }\r\n                        } else {\r\n                            rowHtml += '<span class=\"icon\" style=\"background:transparent;\">&nbsp;</span>';\r\n                        }\r\n\r\n                        if(d[\"lb\"]<0){\r\n                            rowHtml += '<span class=\"icon\" title=\"Documento in modifica\" style=\"background:url(\\'/adiJed/img/toolbar/lock.png\\') no-repeat left 1px center; background-size:18px;\">&nbsp;</span>';\r\n                        } else if(d[\"lb\"]==0) {\r\n                            rowHtml += '<span class=\"icon\" style=\"background:transparent;\">&nbsp;</span>';\r\n                        } else {\r\n                            if(d[\"lb\"]){\r\n                                if(d[\"vp\"]) {\r\n                                    rowHtml += '<span class=\"icon icon-button revSubRpt\" title=\"Clicca per vedere le versioni\" style=\"background:url(\\'/adiJed/img/toolbar/version.png\\') no-repeat center;\">&nbsp;</span>';\r\n                                } else {\r\n                                    rowHtml += '<span class=\"icon revSubRpt\" style=\"background:url(\\'/adiJed/img/toolbar/version.png\\') no-repeat center;\">&nbsp;</span>';\r\n                                }\r\n                            } else {\r\n                                rowHtml += '<span class=\"icon\" style=\"background:transparent;\">&nbsp;</span>';\r\n                            }\r\n                        }\r\n\r\n                        if((!d[\"cd\"] || d[\"cd\"]!=true) && d[\"nComm\"] && d[\"nComm\"]>0){\r\n                            rowHtml += '<span class=\"icon icon-button commment-info\" style=\"background:url(\\'/adiJed/img/comment.png\\') no-repeat left 1px center; background-size:18px;\" title=\"Visualizza commenti\">&nbsp;</span>';\r\n                        }else{\r\n                            rowHtml += '<span class=\"icon\" style=\"background:transparent;\">&nbsp;</span>';\r\n                        }\r\n\r\n                        if((d[\"la\"] && d[\"la\"]==1) || (d[\"f28\"]==1) || (d[\"f28\"]==2)) {\r\n                            var sStoreStatus = \"\";\r\n                            var sStoreStatusDesc = \"Documento archiviato in sostitutiva.\";\r\n\r\n                            if (d[\"f28\"]!=0){\r\n                                sStoreStatus = d[\"f28\"];\r\n                                sStoreStatusDesc = getStoreStatusDesc(sStoreStatus);\r\n                                rowHtml += '<span class=\"icon\" style=\"background:url(\\'/adiJed/img/toolbar/arch-sost'+sStoreStatus+'.png\\') no-repeat left 1px center; background-size:18px;\" title=\"'+sStoreStatusDesc+'\">&nbsp;</span>';\r\n                            }\r\n                        }else{\r\n                            rowHtml += '<span class=\"icon\" style=\"background:transparent;\">&nbsp;</span>';\r\n                        }\r\n\r\n                        if (d[\"f29\"]!=null && d[\"f29\"]!=0 && d[\"trackingId\"]==0){\r\n                            var iNumInvio = d[\"f29\"];\r\n                            rowHtml += '<span class=\"icon icon-button trackSubRpt\" style=\"background:url(\\'/adiJed/img/toolbar/mail.png\\') no-repeat left 1px center; background-size:18px;\" title=\"Clicca per vedere gli invii.\"><span class=\"bullet-indicator\">'+iNumInvio+'</span>&nbsp;</span>';\r\n\r\n                        }\r\n\r\n\t\t\t\t\t\trowHtml += '<span class=\"icon\" style=\"background:transparent;\">&nbsp;</span><span class=\"icon icon-button other-actions\">&nbsp;</span>';\r\n\r\n                        \r\n\r\n                        rowHtml += '</td>';\r\n\r\n                        if(d[\"fnh\"] && d[\"fnh\"] != \"\") {\r\n                            var sName = (d.v[icol][1]);\r\n    /*                        if (sName.length > 15)\r\n                                sName = sName.substr(0, 15);\r\n    */                        rowHtml += '<td class=\"family docVC '+ ('t'+field[\"type\"]) +'\"><p class=\"document-value clamped clamped-2\"><span class=\"headSpan\">'+ sName +'</span><span class=\"famhdr\">'+ (d[\"fnh\"]) +'</span></p>';\r\n                        }else{\r\n                            rowHtml += '<td class=\"family docVC '+ ('t'+field[\"type\"]) +'\"><p class=\"document-value clamped clamped-2\"><span>'+ (d.v[icol][1]) +'</span></p>';\r\n                        }\r\n\r\n                        rowHtml += '</td>';\r\n                    } else {\r\n                        var colHtml = \"\", colstyle = [];\r\n                        if( hasBeenHiddenByUser ) {\r\n                            colstyle.push(\"display: none\");\r\n                        }\r\n                        if( hasCustomSize ) {\r\n                            colstyle.push(\"width: \"+colsSize[fieldPrefix+queryFieldsArray[icol].id]+\"px\");\r\n                            // setto come max-width la larghezza scelta piÃ¹ il padding messo nel css\r\n                            colstyle.push(\"max-width: \"+(colsSize[fieldPrefix+queryFieldsArray[icol].id]+DOCUMENT_COL_PADDING)+\"px\");\r\n                        }\r\n\r\n                        colHtml += '<td style=\"'+colstyle.join(\";\")+'\" class=\"docVC '+ ('t'+field[\"type\"]) +' '+fieldPrefix+queryFieldsArray[icol].id+' '+(hasBeenHiddenByUser?'hidden-by-user':'')+'\">';\r\n                        var _val = d.v[icol][1]; //TODO modificare v in document-rows.jsp\r\n                        if(!_val || _val == '')\r\n                            _val = '-';\r\n\r\n                        if( typeof _val === 'string' ) {\r\n                            _val = _val.__escapeHtml();\r\n                        }\r\n\r\n                        if(field[\"fill\"] == \"113\"){\r\n                            _val = \"&#9679;&#9679;&#9679;&#9679;&#9679;&#9679;&#9679;&#9679;\";\r\n                        }\r\n\r\n                        if(field[\"fill\"] == \"114\"){\r\n                            _val = \"...\";\r\n                        }\r\n\r\n                        if(field[\"type\"] == \"4\" || field[\"type\"] == \"5\" || field[\"type\"] == \"7\") {\r\n                            colHtml += '<p class=\"document-value clamped clamped-2\"><span>'+ _val +'</span><span class=\"ellipsis\">&#133;</span><span class=\"fill\"></span>';\r\n                        } else {\r\n                            colHtml += '<p class=\"document-value\"><span>'+ _val +'</span>';\r\n                        }\r\n                        colHtml += '</td>';\r\n\r\n                        colsHtml.push({fieldID: queryFieldsArray[icol].id, fieldPrefix: queryFieldsArray[icol].fieldPrefix, html: colHtml});\r\n                    }\r\n                }\r\n                \r\n            }\r\n\r\n            colsHtml = reorderColumns(colsHtml);\r\n            for( var iCol = 0; iCol < colsHtml.length; iCol++ ) {\r\n                rowHtml += colsHtml[iCol].html;\r\n            }\r\n            rowHtml += \"</tr>\";\r\n            rowsArray[iRow++] = rowHtml;\r\n        }\r\n\r\n        var documentsTable = $(\".documents-table\").last();\r\n        var table = documentsTable.find(\"> tbody\").get(0);\r\n        var currentHTML = table.innerHTML+rowsArray.join('');\r\n        try {\r\n            table.innerHTML = currentHTML;\r\n        } catch(e) {\r\n            Logger.error(e);\r\n            documentsTable.find(\"> tbody\").html(currentHTML);\r\n        }\r\n        currentHTML = null;\r\n        console.timeEnd(\"appending rows\");\r\n\r\n        //TODO ripristinare il plugin per la kendo grid\r\n        if(reportPlugins.length) {\r\n            var newRows = $(\"tr.rpl\", documentsTable);\r\n            for(var iNewRows=0; iNewRows<newRows.length; iNewRows++) {\r\n                try {\r\n                    var _rowPlugin = (function($row){\r\n                        reportPlugins.data(\"__adi_plugin\")\r\n                            .getAction()(\r\n                                $row[0],\r\n                                prepareFieldNamesForPlugin(AdiutoCacheStore.retrieve(\"dc\"+queryKey,$row.attr(\"dKey\")))\r\n                            );\r\n                        $row.removeClass(\"rpl\");\r\n                    })($(newRows.get(iNewRows)));\r\n                    setTimeout(_rowPlugin,5);\r\n                } catch(e) {\r\n                    Logger.error(e);\r\n                }\r\n            }\r\n        }\r\n\r\n        if(isTablet()) {\r\n            const tableHeader = documentsTable.closest(\"div#documents\").find(\".header-copy\");\r\n            const tableHeaderIScrollInstance = tableHeader.data(\"iscroll-instance\");\r\n            if(tableHeaderIScrollInstance)\r\n                tableHeaderIScrollInstance.refresh();\r\n        }\r\n        if(callback){\r\n            callback();\r\n        }\r\n    }\r\n    function prepareFieldNamesForPlugin(documentData) {\r\n        var response = $.extend({}, documentData);\r\n        response.v = new Array();\r\n        var newv = documentData.v.slice();\r\n        newv.forEach(function(element, index) {\r\n            var key;\r\n            if(element[0].startsWith(\"F\")) {\r\n                key = element[0].replace(/[^0-9]/g, '');\r\n            }else{\r\n                key = element[0];\r\n            }\r\n            var value = new Array();\r\n            value.push(key);\r\n            value.push(element[1])\r\n            response.v.push(value);\r\n        });\r\n\r\n        return response;\r\n    }\r\n\r\n    $(document).ready(function(){\r\n        setTitleOnDocumentValues();\r\n    });\r\n    \r\n    function getStoreStatusDesc(iStoreStatus){\r\n\r\n                if (iStoreStatus == -1)\r\n                    return \"Non validato\";\r\n\r\n                if (iStoreStatus == -2)\r\n                    return \"Errore durante conservazione presso provider\";\r\n\r\n                if (iStoreStatus == 1)\r\n                    return \"Inviabile a conservatore\";\r\n\r\n                if (iStoreStatus == 2)\r\n                    return \"Inviato a conservatore\";\r\n\r\n                if (iStoreStatus == 3)\r\n                    return \"Confermata la ricezione da conservatore\";\r\n\r\n                if (iStoreStatus == 4)\r\n                    return \"Inviato a SDI\";\r\n\r\n                if (iStoreStatus == 5)\r\n                    return \"Ancora da Trattare (Allegati presenti)\";\r\n\r\n                if (iStoreStatus == 8)\r\n                    return \"Archiviati in sostitutiva in House\";\r\n\r\n                if (iStoreStatus == 9)\r\n                    return \"Archiviati in sostitutiva presso conservatore\";\r\n\r\n                if (iStoreStatus == 10)\r\n                    return \"Pronto per conservazione presso provider\";\r\n\r\n                if (iStoreStatus == 11)\r\n                    return \"Pronto per conservazione in House\";\r\n\r\n                if (iStoreStatus == 12)\r\n                    return \"Inviato a provider con conservazione\";\r\n        \r\n    }\r\n    \r\n//# sourceURL=/adiJed/ui/query/search-result-rows.jsp\r\n</script>\r\n\r\n<script type=\"text/javascript\">\r\n\r\nshowWaitDialog(\"Formattazione risultati...\");\r\n\r\nvar prepareTable = function() {\r\n    setTimeout(function(){\r\n        reorderTableHead(queryUID);\r\n\r\n        setTimeout(function(){\r\n            $(\"#documents\").addClass(\"loaded\");\r\n            $.modal.close();\r\n        },1);\r\n\r\n        console.time(\"fixTableHeader\");\r\n        scrollContainer = fixTableHeader($(\".documents-table\"));\r\n        console.timeEnd(\"fixTableHeader\");\r\n\r\n        console.time(\"fixTableFirstColumn\");\r\n        resetAndFixTableFirstColumn($(\".documents-table\"), FIXED_COLUMN_NUM, scrollContainer);\r\n        console.timeEnd(\"fixTableFirstColumn\");\r\n\r\n        setTimeout(function(){\r\n            console.time(\"bindEvents\");\r\n            bindEvents();\r\n            console.timeEnd(\"bindEvents\");\r\n\r\n            if( $(\"#moreRowsMessage\").attr(\"hasMoreRowsToDisplay\") && $(\"#first-column-copy .document-row\").length == 4)\r\n            {\r\n                $(\"#moreRowsMessage\").removeAttr(\"hasMoreRowsToDisplay\");\r\n                $(\"#moreRowsMessage\").css(\"opacity\",0);\r\n                $(\"#moreRowsMessage\").css(\"display\", \"none\");\r\n\r\n            }\r\n            // executeReportMultiColor();\r\n        },1);\r\n    }, 1);\r\n};\r\n\r\nif(HistoryManager.getCurrentPage()[\"docs\"]) {\r\n    queryDocs = HistoryManager.getCurrentPage()[\"docs\"];\r\n    setTimeout(function(){\r\n        appendRows(queryDocs,HistoryManager.getCurrentPage()[\"queryKey\"]);\r\n        prepareTable();\r\n        setTimeout(fillWidthWithReport, 1000);\r\n    },10);\r\n} else {\r\n    setTimeout(function(){\r\n        appendRows(queryBlock);\r\n        prepareTable();\r\n        setTimeout(fillWidthWithReport, 1000);\r\n    },10);\r\n    HistoryManager.getCurrentPage()[\"queryKey\"]=\"1766499174874\";\r\n    HistoryManager.getCurrentPage()[\"docs\"] = queryDocs;\r\n}\r\n\r\n</script>\r\n\r\n</table>\r\n    </div>\r\n    <div id=\"moreRowsMessage\"><span>Mostra più risultati...</span></div>  \r\n    \r\n        \r\n    \r\n</div>\r\n\r\n<script type=\"text/javascript\">\r\n    var queryUID = \"6CC6EEFB674286F7D1A0E4ADAA840670DAFA7870F77C7D6D73D5924C44CE3BFF\";\r\n    var singleFamilyQuery = true;\r\n    var FIXED_COLUMN_NUM = singleFamilyQuery ? 2 : 3;// con le query su piÃ¹ famiglie tengo bloccata anche la colonna con la famiglia per adesso\r\n    var scrollContainer = null;\r\n\r\n    function getCurrentReportFields() {\r\n\r\n        var reportFields = [];\r\n        var userColumnsOrder = getColumnsOrderForReport(queryUID);\r\n        var hiddenFields = getHiddenFieldsForReport(queryUID);\r\n        var _queryFieldsArray = [].concat(queryFieldsArray);\r\n        if( userColumnsOrder ) {\r\n            for( var i=0; i<userColumnsOrder.length; i++ ) {\r\n                for( var x=0; x<_queryFieldsArray.length; x++ ) {\r\n                    var fieldPrefix = _queryFieldsArray[x].fieldPrefix;\r\n                    if(fieldPrefix+_queryFieldsArray[x].id == userColumnsOrder[i]) {\r\n                        var queryField = queryFields[fieldPrefix+_queryFieldsArray[x].id];\r\n                        var hidden = (hiddenFields[fieldPrefix+_queryFieldsArray[x].id]==null);\r\n                        queryField.hidden = hidden;\r\n                        reportFields.push(queryField);\r\n                        _queryFieldsArray.splice(x, 1);\r\n                        break;\r\n                    }\r\n                }\r\n            }\r\n            for( i=0; i<_queryFieldsArray.length; i++ ) {\r\n                var fieldPrefix = _queryFieldsArray[i].fieldPrefix;\r\n                if(_queryFieldsArray[i].id > 0) {\r\n                    var queryField = queryFields[fieldPrefix+_queryFieldsArray[i].id];\r\n                    var hidden = (hiddenFields[fieldPrefix+_queryFieldsArray[i].id]==null);\r\n                    queryField.hidden = hidden;\r\n\r\n                    reportFields.push(queryField);\r\n                }\r\n            }\r\n        } else {\r\n            for( var i=0; i<_queryFieldsArray.length; i++ ) {\r\n                var fieldPrefix = _queryFieldsArray[i].fieldPrefix;\r\n                if(_queryFieldsArray[i].id > 0) {\r\n                    var queryField = queryFields[fieldPrefix+_queryFieldsArray[i].id];\r\n                    var hidden = (hiddenFields[fieldPrefix+_queryFieldsArray[i].id]==null);\r\n                    queryField.hidden = hidden;\r\n\r\n                    reportFields.push(queryField);\r\n                }\r\n            }\r\n        }\r\n        return reportFields;\r\n    }\r\n\r\n    var busy = false;\r\n\r\n    //Se viene passato l'array di checkbox allCheck, la funzione viene richiamata\r\n    //ricorsivamente per collegare o scollegare tutti i documenti\r\n    function changeDocumentLink(_this, allCheck, isChecked){\r\n        busy = true;\r\n\r\n        var documentID = _this.closest(\"tr\").attr(\"docid\");\r\n        var action;\r\n        var isProgrammaticCall = false;\r\n        var checked = _this.attr(\"checked\");\r\n        if(isChecked != undefined){\r\n            checked = isChecked;\r\n            isProgrammaticCall = true;\r\n        }\r\n\r\n        if(!isProgrammaticCall)\r\n            showWaitDialog();\r\n\r\n        if(checked) {\r\n            action = \"add\";\r\n            _this.addClass(\"linking\");\r\n        } else {\r\n            action = \"remove\";\r\n            _this.addClass(\"unlinking\");\r\n        }\r\n        $.ajax({url: \"/adiJed/ui/link-to-document.do\",\r\n            type: \"POST\",\r\n            data: \"actionId=&from=&action=\"+action+\"&lnkid=\"+documentID+\"&pageUnique=\",\r\n            success: function(result)\r\n            {\r\n                if(result[\"ok\"])\r\n                {\r\n                    var linkRow = $(\"tr.document-row[docid=\"+documentID+\"]\");//_this.parent().parent();\r\n\r\n                    if(action == \"add\")\r\n                    {\r\n                        linkRow.addClass(\"linked\");\r\n\r\n                        dismissMessage();\r\n                        if(!isProgrammaticCall){\r\n                            showInfoMessage(\"Documento collegato correttamente\");\r\n                        }\r\n\r\n                        setTimeout(function(){ _this.addClass(\"linked\"); },50);\r\n                    }\r\n                    else\r\n                    {\r\n                        linkRow.removeClass(\"linked\");\r\n\r\n                        dismissMessage();\r\n                        if(!isProgrammaticCall){\r\n                            showInfoMessage(\"Collegato rimosso\");\r\n                        }\r\n\r\n                        setTimeout(function(){ _this.removeClass(\"linked\"); },50);\r\n                    }\r\n                }\r\n                else if(result[\"error\"])\r\n                {\r\n                    var msg = result[\"message\"]||\"Si è verificato un errore.\"; //Si ï¿½ verificato un errore.\r\n                    showErrorMessage(msg);\r\n                    _this.addClass(\"link-error\");\r\n                }\r\n\r\n                busy = false;\r\n\r\n                if(!isProgrammaticCall)\r\n                    $.modal.close();\r\n\r\n                if(allCheck != undefined && allCheck.length>0){\r\n                    _this.prop(\"checked\", isChecked);\r\n                    var nextCheck = allCheck.shift();\r\n                    changeDocumentLink($(nextCheck), allCheck, isChecked);\r\n                    //setTimeout(function(){changeDocumentLink($(nextCheck), allCheck, isChecked);}, 50);\r\n                }else if(allCheck != undefined && allCheck.length==0){\r\n                    _this.prop(\"checked\", isChecked);\r\n\r\n                    if(action == \"add\")\r\n                        showInfoMessage(\"Documento collegato correttamente\");\r\n                    else\r\n                        showInfoMessage(\"Collegato rimosso\");\r\n\r\n                    $.modal.close();\r\n                }\r\n            }\r\n        });\r\n    }\r\n\r\n    \r\n    \r\n        var backToFilterPage = function() {\r\n            history.back();\r\n        };\r\n\r\n        var customEvents = function() {\r\n\r\n            $(\".documents-table\").off(_evt_type, \"td.row-number\").on(_evt_type, \"td.row-number\", function(event) {\r\n                event.stopPropagation();\r\n                $(this).find(\"> input[type=checkbox]\").trigger(_evt_type);\r\n            });\r\n\r\n            $(\".documents-table\").off(_evt_type, \"td.row-number > input[type=checkbox]\").on(_evt_type, \"td.row-number > input[type=checkbox]\", function(event) {\r\n                event.stopPropagation();\r\n            });\r\n\r\n            $(\".documents-table\").off(\"change\", \"td.row-number > input[type=checkbox]\").on(\"change\", \"td.row-number > input[type=checkbox]\", function(event) {\r\n                event.stopPropagation();\r\n                var currentRow = $(this).parent().parent();\r\n                if($(this).is(\":checked\")){\r\n                    $(\"tr.document-row[docid=\"+currentRow.attr(\"docid\")+\"]\").addClass(\"rowSelected\");\r\n                }else {\r\n                    $(\"tr.document-row[docid=\"+currentRow.attr(\"docid\")+\"]\").removeClass(\"rowSelected\");\r\n                }\r\n                onCheckboxsChange();\r\n            });\r\n        };\r\n\r\n        var _document_row_click = function(event){\r\n            event.stopPropagation();\r\n            var documentID = $(this).closest(\"tr\").attr(\"docid\");\r\n            viewDocInfo(documentID);\r\n        };\r\n    \r\n\r\n</script>\r\n\r\n\r\n<script type=\"text/javascript\">\r\n    var colnr;\r\n    var TrackFamilyId = 0;\r\n    var trackFamilyIds=[];\r\n    var massiveFamilyRight = new Array();\r\n\r\n    function getUniqueID(){\r\n        return new String(new Date().getTime());\r\n    }\r\n\r\n    function noDocumentsFound()\r\n    {\r\n        showInfoMessage(\":( Nessun documento trovato!\");    /*Nessun documento trovato!*/\r\n        backToFilterPage();\r\n    }\r\n\r\n    var moreRowsShown = false;\r\n\r\n    function bindEvents()\r\n    {\r\n        colnr = $(\".documents-table tbody tr:first-child td\").length;\r\n\r\n        var _documents = $('#documents');\r\n        if(_documents[0].scrollWidth > _documents.width())\r\n        {\r\n            $(\"#moreRowsMessage\").css(\"bottom\", \"20px\");\r\n        }\r\n\r\n        var _span_family_click = function(event){\r\n\r\n            event.stopPropagation();\r\n            var documentID = -1;\r\n            if ($(this).hasClass(\"headSpan\")){\r\n                documentID = $(this).closest(\"tr\").attr(\"headdocid\");                \r\n            }else{\r\n                documentID = $(this).closest(\"tr\").attr(\"docid\");\r\n            }\r\n            if(true){\r\n                $(\".last-selected\").removeClass(\"last-selected\");\r\n                $(\"tr.document-row[docid=\"+documentID+\"]\").addClass(\"last-selected\");\r\n            }\r\n            openDoc(documentID,true);\r\n        };\r\n        $(\"td.family > p > span\").off(_evt_type).on(_evt_type, _span_family_click);\r\n\r\n        $(\"td .file-icon\").off(_evt_type).on(_evt_type, function(event){\r\n            event.stopPropagation();\r\n            var documentID = $(this).closest(\"tr\").attr(\"docid\");\r\n\r\n            if(true){\r\n                $(\".last-selected\").removeClass(\"last-selected\");\r\n                $(\"tr.document-row[docid=\"+documentID+\"]\").addClass(\"last-selected\");\r\n            }\r\n            openDoc(documentID,true);\r\n        });\r\n\r\n        $(\".documents-table-scroll\").off(_evt_type, 'tr > td:not(.icons):not(.row-number)').on(_evt_type, 'tr > td:not(.icons):not(.row-number)', _document_row_click);\r\n        $(\".documents-table-scroll\").off(_evt_type, 'tr > td.icons').on(\r\n            _evt_type, 'tr > td.icons',\r\n            function() {\r\n                var documentID = $(this).closest(\"tr\").attr(\"docid\");\r\n                $(\"tr.last-selected\").removeClass(\"last-selected\");\r\n                $(\"tr.document-row[docid=\"+documentID+\"]\").addClass(\"last-selected\");\r\n            }\r\n        );\r\n\r\n        $(\"#back\").unbind(_evt_type).on(_evt_type, function(){\r\n            \r\n            \r\n                \r\n                \r\n                    backToFilterPage();\r\n                \r\n            \r\n        });\r\n        $(\"#config\").unbind(_evt_type).on(_evt_type, function(){\r\n            showReportConfigWindow(true);\r\n        });\r\n\r\n        $(\"#downloadExportXls\").unbind(_evt_type).on(_evt_type, function(){\r\n            exportWithFilters(\"xls\");\r\n        });\r\n        $(\"#downloadExportPdf\").unbind(_evt_type).on(_evt_type, function(){\r\n            exportWithFilters(\"pdf\");\r\n        });\r\n        \r\n        $(\"#downloadExportCsv\").unbind(_evt_type).on(_evt_type, function(){\r\n            //startExportQuery(\"csv\", null, null, null, encodeURIComponent(JSON.stringify(getCurrentReportFields())));\r\n\r\n            exportQueryResult(\"csv\", encodeURIComponent(JSON.stringify(getCurrentReportFields())));\r\n        });\r\n        $(\"#downloadExportZip\").unbind(_evt_type).on(_evt_type, function(){\r\n            //startExportQuery(\"zip\");//Esportazione senza exportmanager\r\n            exportQueryResultDocuments();\r\n        });\r\n        $(\"#downloadExportPrints\").unbind(_evt_type).on(_evt_type, function(e){\r\n\r\n            var params = {\"title\":\"Filtri Stampe\" , \"modal\": true, \"width\": \"450px\", \"height\": \"500px\", \"Minimize\": false, \"Maximize\": false};\r\n            openWindow(\"print-filters-window\", \"/adiJed/ui/includes/print-filters.jsp?id=-1\", params);\r\n            if(e!=null)\r\n                e.preventDefault();\r\n        });\r\n        \r\n        $(\"#showReconciliation\").unbind(_evt_type).on(_evt_type, function(e){\r\n            var params = {\"title\":\"Riconciliazione\" , \"modal\": true, \"width\": \"450px\", \"height\": \"500px\", \"Minimize\": false, \"Maximize\": false};\r\n            openWindow(\"recon-filters-window\", \"/adiJed/ui/includes/recon-filters.jsp?familyId=1134\", params);\r\n            if(e!=null)\r\n                e.preventDefault();\r\n        });\r\n        \r\n        \r\n        $(\"#viewSelected\").unbind(_evt_type).on(_evt_type, function(){\r\n            var docsIds=[], attachIds=[], attachDocsIds=[];\r\n            var items = $(\"td.row-number > input[type=checkbox]:checked\");\r\n            $.each(items, function(i,item){\r\n                var rowTr = $(item).closest(\"tr\");\r\n                var docId = rowTr.attr(\"docid\");\r\n\r\n                if(rowTr.hasClass(\"att-row\")){\r\n                    var attachId = rowTr.attr(\"attid\");\r\n                    attachIds.push(attachId);\r\n                    attachDocsIds.push(docId);\r\n                }else{\r\n                    docsIds.push(docId);\r\n                }\r\n            });\r\n\r\n            //prendo i documenti selezionati\r\n            if(docsIds.length==1 && attachIds.length==0) {\r\n                openDoc(docsIds[0], false);\r\n            }else if(docsIds.length==0 && attachIds.length==1) {\r\n                openAttachment(attachDocsIds[0], attachIds[0]);\r\n            }else if((docsIds.length+attachIds.length)>1){\r\n                saveHistoryAndDisplayPage('/multi-view/?' + getUniqueID(), \"/adiJed/ui/view-doc/multi-view.do\", \"ids=\" + JSON.stringify(docsIds)+\"&attachIds=\" + JSON.stringify(attachIds)+\"&attachDocsIds=\" + JSON.stringify(attachDocsIds), true);\r\n            }\r\n        });\r\n        $(\"#sendSelected\").unbind(_evt_type).on(_evt_type, function(){\r\n            \r\n            var blockTrk = false;\r\n            var famOld = 0;\r\n            for( var i=0; i<trackFamilyIds.length; i++ ) {\r\n                var famTrk = trackFamilyIds[i];\r\n                if (famOld == 0)\r\n                    famOld = famTrk;\r\n                if (famOld != famTrk){\r\n                    blockTrk = true;\r\n                }\r\n            }\r\n\r\n            if (blockTrk){\r\n                showErrorMessage(\"Non è possibile inviare documenti con Famiglie di tracciamento differenti!\"); //Errore nel download dei documenti\r\n            }else{\r\n                var docsIds=[], attachIds=[], attachDocsIds=[], linksIds=[], linksParentIds=[];\r\n                var items = $(\"td.row-number > input[type=checkbox]:checked\");\r\n                $.each(items, function(i,item){\r\n                    var rowTr = $(item).closest(\"tr\");\r\n                    var docId = rowTr.attr(\"docid\");\r\n\r\n                    if(rowTr.hasClass(\"att-row\")){\r\n                        var attachId = rowTr.attr(\"attid\");\r\n                        attachIds.push(attachId);\r\n                        attachDocsIds.push(docId);\r\n                    }else if(rowTr.hasClass(\"link-row\")){\r\n                        var parentDocId = $(rowTr).attr(\"parentDocId\");\r\n                        linksIds.push(docId);\r\n                        linksParentIds.push(parentDocId);\r\n                    }else{\r\n                        docsIds.push(docId);\r\n                    }\r\n                });\r\n\r\n                var data = 'ids='+encodeURIComponent(JSON.stringify(docsIds))+\r\n                            '&multi=true'+\r\n                            '&attachDocsIds='+encodeURIComponent(JSON.stringify(attachDocsIds))+\r\n                            '&attachIds='+encodeURIComponent(JSON.stringify(attachIds))+\r\n                            '&linksParentIds='+encodeURIComponent(JSON.stringify(linksParentIds))+\r\n                            '&linksIds='+encodeURIComponent(JSON.stringify(linksIds))+\r\n                            '&trackingID='+encodeURIComponent(JSON.stringify(trackFamilyIds));\r\n\r\n            openWindow(\"send-message-window\", '/adiJed/ui/messages/send-window.do?'+data,\r\n                        {\"width\": \"750px\", \"height\": \"500px\", \"title\": \"Nuovo messaggio\", \"modal\": true, \"maxHeight\": \"1500px\"});        /*Nuovo messaggio*/\r\n            }\r\n        });\r\n        $(\"#downloadSelected\").unbind(_evt_type).on(_evt_type, function(){\r\n\r\n            var docsIds=[], attachIds=[], attachDocsIds=[], linksIds=[], linksParentIds=[], detailsIds=[], detailsParentIds=[];\r\n            var items = $(\"td.row-number > input[type=checkbox]:checked\");\r\n            $.each(items, function(i,item){\r\n                var rowTr = $(item).closest(\"tr\");\r\n                var isDetailRow = $(item).closest(\".detail-rows\").length>0;\r\n\r\n                var docId = rowTr.attr(\"docid\");\r\n\r\n                if(rowTr.hasClass(\"att-row\")){\r\n                    var attachId = rowTr.attr(\"attid\");\r\n                    attachIds.push(attachId);\r\n                    attachDocsIds.push(docId);\r\n                }else if(rowTr.hasClass(\"link-row\")){\r\n                    var parentDocId = $(rowTr).attr(\"parentDocId\");\r\n                    if(!isDetailRow){\r\n                        linksIds.push(docId);\r\n                        linksParentIds.push(parentDocId);\r\n                    }else{\r\n                        detailsIds.push(docId);\r\n                        detailsParentIds.push(parentDocId);\r\n                    }\r\n                }else{\r\n                    docsIds.push(docId);\r\n                }\r\n            });\r\n\r\n            var url = '/adiJed/ui/query-export.do';\r\n            var data = 'action=downloadMixedFiles'+\r\n                        '&fidds='+JSON.stringify(docsIds)+\r\n                        '&attachsFidds='+JSON.stringify(attachDocsIds)+\r\n                        '&attachs='+JSON.stringify(attachIds)+\r\n                        '&linksFidds='+JSON.stringify(linksParentIds)+\r\n                        '&links='+JSON.stringify(linksIds)+\r\n                        '&detailsFidds='+JSON.stringify(detailsParentIds)+\r\n                        '&details='+JSON.stringify(detailsIds);\r\n\r\n            $.ajax({url: url,\r\n                type: \"POST\", data: data, dataType: 'json',\r\n                success: function(result) {\r\n                    if(result && result[\"ok\"] && result[\"ok\"]==true)\r\n                    {\r\n                        loadRightApp();\r\n                        showInfoMessage(LangManager.get(\"export.in.progress\"));\r\n                    }else{\r\n                        if(result[\"message\"])\r\n                            showErrorMessage(result[\"message\"]);\r\n                        else\r\n                            showErrorMessage(\"Error\");\r\n                    }\r\n                }\r\n            });\r\n\r\n\r\n\r\n\r\n            //startExportQuery(\"zip\", false, \"Download documenti in corso...\", downloadSelected);//Download documenti in corso...\r\n        });\r\n        $(\"#deleteSelected\").unbind(_evt_type).on(_evt_type, function(){\r\n            var docsIds=[], attachIds=[], attachDocsIds=[];\r\n            var items = $(\"td.row-number > input[type=checkbox]:checked\");\r\n            $.each(items, function(i,item){\r\n                var rowTr = $(item).closest(\"tr\");\r\n                var docId = rowTr.attr(\"docid\");\r\n\r\n                if(rowTr.hasClass(\"att-row\")){\r\n                    var attachId = rowTr.attr(\"attid\");\r\n                    attachIds.push(attachId);\r\n                    attachDocsIds.push(docId);\r\n                }else{\r\n                    docsIds.push(docId);\r\n                }\r\n            });\r\n\r\n            DialogManager.showConfirm(\"Sei sicuro di voler eliminare questi documenti?\", // Sei sicuro di voler eliminare questi documenti?\r\n                function() {\r\n                    if(docsIds.length>0 && attachDocsIds.length>0){\r\n                        ADA.deleteDocs( docsIds, function() {\r\n                            ADA.deleteAttachments( attachDocsIds, attachIds, function() {\r\n                                $.modal.close();\r\n                                setTimeout(function(){HistoryManager.reloadLastPage();},1000);\r\n                            } );\r\n\r\n                        } );\r\n                    }else if(docsIds.length>0){\r\n                        ADA.deleteDocs( docsIds, function() {\r\n                            $.modal.close();\r\n                            setTimeout(function(){HistoryManager.reloadLastPage();},1000);\r\n                        } );\r\n                    }else if(attachDocsIds.length>0){\r\n                        ADA.deleteAttachments( attachDocsIds, attachIds, function() {\r\n                            $.modal.close();\r\n                            setTimeout(function(){HistoryManager.reloadLastPage();},1000);\r\n                        } );\r\n                    }\r\n                },\r\n                null,\r\n                \"Cancella documenti\",      //Cancella documenti\r\n                \"Elimina\",           //Elimina\r\n                \"Annulla\"            //Annulla\r\n            );\r\n        });\r\n\r\n\r\n        $(\"#deleteSearch:not(.button-disabled)\").unbind(_evt_type).on(_evt_type, function(){\r\n            DialogManager.showConfirm(\"Cancellare questa ricerca salvata?\",function(){   /*Cancellare questa ricerca salvata?*/\r\n                $.ajax({\r\n                    type: \"POST\",\r\n                    url: \"/adiJed/ui/saved-search.do\",\r\n                    dataType: \"json\",\r\n                    data: \"action=delete&name=\"\r\n                }).done(function(result){\r\n                    if(result[\"ok\"])\r\n                    {\r\n                        showInfoMessage(\"Query cancellata correttamente\");   /*Query cancellata correttamente*/\r\n                        $(\"#deleteSearch\").css(\"opacity\",\".3\").unbind(_evt_type);\r\n                    }\r\n                    else if(result[\"error\"])\r\n                    {\r\n                        var msg = result[\"message\"]||\"Si è verificato un errore.\"; //Si ï¿½ verificato un errore.\r\n                        showErrorMessage(msg);\r\n                    }\r\n                });\r\n            })\r\n        });\r\n\r\n        $(\"#linkAllDocs:not(.button-disabled)\").unbind(_evt_type).on(_evt_type, function(){\r\n            var message = LangManager.get(\"ui.question.link.docs\", '4');\r\n            DialogManager.showConfirm(message,function(){   /*Collegare %s documenti?*/\r\n                $.ajax({\r\n                    type: \"POST\",\r\n                    url: \"/adiJed/ui/link-to-document.do\",\r\n                    dataType: \"json\",\r\n                    data: \"action=linkAllDocs&pageUnique=\"\r\n                }).done(function(result){\r\n                    if(result[\"ok\"])\r\n                    {\r\n                        showInfoMessage(\"Documenti collegati correttamente\");\r\n\r\n                    }\r\n                    else if(result[\"error\"])\r\n                    {\r\n                        var msg = result[\"message\"]||\"Si è verificato un errore.\"; //Si ï¿½ verificato un errore.\r\n                        showErrorMessage(msg);\r\n                    }\r\n                    if(window.parent.$(\"#add-links-container\"))\r\n                        window.parent.$(\"#add-links-container\").data(\"kendoWindow\").close();\r\n\r\n                });\r\n            })\r\n        });\r\n\r\n        $(\"#saveSearch:not(.button-disabled)\").unbind(_evt_type).on(_evt_type, function(){\r\n            DialogManager.inputBox(\"Dai un nome alla ricerca salvata\", function(searchDescription) {  /*Dai un nome alla ricerca salvata*/\r\n                $.ajax({\r\n                    type: \"POST\",\r\n                    url: \"/adiJed/ui/saved-search.do\",\r\n                    dataType: \"json\",\r\n                    data: \"action=save&queryKey=1766499174874&tot=4&des=\"+searchDescription+\"&showTrack=0\"\r\n                }).done(function(result){\r\n                    if(result[\"ok\"])\r\n                    {\r\n                        showInfoMessage(\"Query salvata correttamente\");  /*Query salvata correttamente*/\r\n\r\n                        $(\"#saveSearch\").css(\"opacity\",\".3\").unbind(_evt_type);\r\n                    }\r\n                    else if(result[\"error\"])\r\n                    {\r\n                        var msg = result[\"message\"]||\"Si è verificato un errore.\"; //Si ï¿½ verificato un errore.\r\n                        showErrorMessage(msg);\r\n                    }\r\n                });\r\n            }, DialogManager.closeDialog, \"SALVA LA RICERCA\", \"\");    /*SALVA LA RICERCA*/\r\n        });\r\n\r\n        $('.documents-table-scroll').bind('scroll', function()\r\n        {\r\n            if( $(\"#moreRowsMessage\").attr(\"hasMoreRowsToDisplay\") )\r\n            {\r\n                var curr = $(this).scrollTop() + $(this).innerHeight();\r\n                var targetHeight = $(this)[0].scrollHeight - 150;\r\n                if( curr >= targetHeight )\r\n                {\r\n                    displayMoreRowsButton();\r\n                }\r\n                else\r\n                {\r\n                    $(\"#moreRowsMessage\").css(\"opacity\", 0);\r\n                    moreRowsShown = false;\r\n                }\r\n            }\r\n        });\r\n\r\n        attachLinkSubReportEvents($(\".lnkSubRpt\"),colnr);\r\n        attachTrackSubReportEvents($(\".trackSubRpt\"),colnr);        \r\n        attachDetailsSubReportEvents($(\".detSubRpt\"),colnr);\r\n        attachAttachSubReportEvents($(\".attSubRpt\"),colnr);\r\n        attachRevisionSubReportEvents($(\".revSubRpt\"),colnr);\r\n        attachCommentsEvents($(\".commment-info\"));\r\n        attachOtherActionsEvents($(\".other-actions\"));\r\n        attachIterTooltipEvents();\r\n        attachHistoryEvents();\r\n\r\n\r\n        \r\n        \r\n        \r\n        $(\".selAllDoc\").off(_evt_type).on(_evt_type, function(e){\r\n            e.stopPropagation();\r\n            if($(this).is(\":checked\")){\r\n                var items = $(\"tr.document-row > td.row-number > input[type=checkbox]:not(:checked)\");\r\n                $.each(items, function(i,item){\r\n                    if($(item))\r\n                        $(item).prop(\"checked\", true);\r\n                });\r\n            }\r\n            else {\r\n                var items = $(\"tr.document-row > td.row-number > input[type=checkbox]:checked\");\r\n                $.each(items, function(i,item){\r\n                    $(item).prop(\"checked\", false);\r\n                });\r\n            }\r\n\r\n            onCheckboxsChange();\r\n\r\n\r\n        });\r\n\r\n        \r\n        \r\n\r\n        customEvents();\r\n    }\r\n    \r\n\tfunction exportWithFilters(type) {\r\n\t\t//Verifico se ci sono piï¿½ famiglie\r\n\t\tif (singleFamilyQuery){\r\n\t\t\tvar params = {\"title\":\"Parametri Esportazione\" , \"modal\": true, \"width\": \"850px\", \"height\": \"500px\", \"Minimize\": false, \"Maximize\": true};\r\n\t\t\topenWindow(\"export-filters-window\", \"/adiJed/ui/includes/export-filters.jsp?type=\"+type, params);\r\n\t\t}else{\r\n\t\t\t//Se c'Ã¨ piÃ¹ di una famiglia eseguo l'export standard\r\n\t\t\t//startExportQuery(type, null, null, null, encodeURIComponent(JSON.stringify(getCurrentReportFields())));\r\n            exportQueryResult(type, encodeURIComponent(JSON.stringify(getCurrentReportFields())));\r\n\t\t}\r\n\t}\r\n\r\n    function selectXlsTemplate(iXlsSel){\r\n        var fields = [];\r\n        //console.log(\"selectXlsTemplate\");\r\n\r\n        if (iXlsSel > 1000){\r\n//            startExportQuery(\"tmplxls\", null, null, null, encodeURIComponent(JSON.stringify(getCurrentReportFields())), null, null, iXlsSel);\r\n\r\n            exportQueryResult(\"tmplxls\", encodeURIComponent(JSON.stringify(getCurrentReportFields())), \"result\", encodeURIComponent(JSON.stringify(fields)), iXlsSel);\r\n        }\r\n    }\r\n    \r\n    \r\n\r\n    function saveLastQuery(){\r\n            \r\n        var showTrack=0;\r\n        \r\n            showTrack=parseInt(\"0\");\r\n        \r\n            \r\n        $.ajax({\r\n            type: \"POST\",\r\n            url: \"/adiJed/ui/saved-search.do\",\r\n            dataType: \"json\",\r\n            data: \"action=delete&name=_adlastquery\"\r\n        }).done(function(result){\r\n            $.ajax({\r\n                type: \"POST\",\r\n                url: \"/adiJed/ui/saved-search.do\",\r\n                dataType: \"json\",\r\n                data: \"action=save&queryKey=1766499174874&tot=4&des=_adlastquery&fileName=_adlastquery&showTrack=\"+showTrack\r\n            }).done(function(result){\r\n\r\n            });\r\n        });\r\n    }\r\n\r\n    function displayMoreRowsButton()\r\n    {\r\n        $(\"#moreRowsMessage\").css(\"opacity\", .9);\r\n        moreRowsShown = true;\r\n    }\r\n\r\n    var DOCUMENT_COL_PADDING = 0;\r\n    function fillWidthWithReport() {\r\n        resizeCol($(\"thead tr th\", $(\".header-copy > table\")).last().attr(\"fieldRegID\"), $(\"thead tr th\", $(\".header-copy > table\")).last().attr(\"fieldPrefix\"), 100);\r\n\r\n        if( $(\".documents-table\").last().width() < $(\".documents-table-scroll\").width() ) {\r\n            var _table = $(\".documents-table\").last();\r\n            var missingWidth = $(\".documents-table-scroll\").width() - _table.width();\r\n            var colWidth = $(\"tbody tr td\", _table).last().width();\r\n            var outerWidth = $(\"tbody tr td\", _table).last().outerWidth();\r\n            var newWidth = outerWidth+missingWidth;\r\n            $(\"tbody tr td:not(.hidden-by-user)\", _table).last().css(\"width\", newWidth+\"px\").css(\"max-width\", (newWidth + DOCUMENT_COL_PADDING)+\"px\").find(\".img-for-width\").css(\"width\", newWidth+\"px\")\r\n//        newWidth = colWidth+missingWidth;\r\n            $(\"thead tr th:not(.hidden-by-user)\", $(\".header-copy > table\")).last().css(\"width\", newWidth+\"px\").css(\"max-width\", (newWidth + DOCUMENT_COL_PADDING)+\"px\").find(\".img-for-width\").css(\"width\", newWidth+\"px\")\r\n        }\r\n    }\r\n\r\n    function resizeCol(colFieldRegID, fieldPrefix, def) {\r\n        var colsSize = getColumnsSizeForReport(queryUID);\r\n        var newWidth = colsSize[fieldPrefix+colFieldRegID]||def;\r\n        var th = $(\"th[fieldRegID=\"+colFieldRegID+\"][fieldPrefix=\"+fieldPrefix+\"]\");\r\n        th.css(\"width\", newWidth).css(\"max-width\", newWidth + DOCUMENT_COL_PADDING).find(\".img-for-width\").css(\"width\", newWidth);\r\n        var colIndex = th.closest(\"tr\").children().index(th) + 1;\r\n        $(\".documents-table tbody tr td:not(.hidden-by-user):nth-child(\"+colIndex+\")\").css(\"width\", newWidth).css(\"max-width\", newWidth + DOCUMENT_COL_PADDING).find(\".img-for-width\").css(\"width\", newWidth);\r\n    }\r\n\r\n    function onCheckboxsChange(){\r\n        if($(\"td.row-number > input[type=checkbox]:checked\").length > 0){\r\n            $(\"#azioniMassive\").removeClass(\"hiddenButton\");\r\n\r\n            $(\"#sendSelected\").addClass(\"hiddenButton\");\r\n            $(\"#deleteSelected\").addClass(\"hiddenButton\");\r\n            $(\"#downloadSelected\").addClass(\"hiddenButton\");\r\n\r\n            var famsIds=[];\r\n            var attachDocsIds=[];\r\n            var docsIds=[];\r\n            var docsIdsToCheck=[];\r\n            var allFamsIds=[];\r\n            var docsfamsIdsToCheck=[];\r\n\r\n            var TrackId = 0;\r\n            var trackIds=[];\r\n            //ROSSTE - 20190822\r\n            //Azzero\r\n            trackFamilyIds=[];\r\n\r\n            var items = $(\"td.row-number > input[type=checkbox]:checked\");\r\n            $.each(items, function(i,item){\r\n                var famId = $(item).attr(\"famid\");\r\n                TrackId = $(item).attr(\"trackingId\");\r\n                TrackFamilyId = $(item).attr(\"trackingFamilyId\");\r\n                if(allFamsIds.indexOf(famId)==-1)\r\n                    allFamsIds.push(famId);\r\n\r\n                if (TrackFamilyId)\r\n                    trackFamilyIds.push(TrackFamilyId);\r\n\r\n                if (TrackId != 0)\r\n                    trackIds.push(TrackId);\r\n\r\n                let row = $(item).closest(\"tr\");\r\n                let docId = row.attr(\"docid\");\r\n\r\n                if($(item).closest(\"tr\").hasClass(\"att-row\")){\r\n                    attachDocsIds.push(docId);\r\n                }else{\r\n                    docsIds.push(docId);\r\n                    famsIds.push(famId);\r\n                }\r\n\r\n                let familyRight = massiveFamilyRight[famId];\r\n                if(familyRight == null){\r\n                    if(!$(item).closest(\"tr\").hasClass(\"att-row\")){\r\n                        docsIdsToCheck.push(docId);\r\n                        docsfamsIdsToCheck.push(famId);\r\n                    }\r\n                }\r\n            });\r\n\r\n            if(docsIdsToCheck.length>0){\r\n                if(checkAllAuthByFams(1, 5, docsIdsToCheck)){  //Controllo l'autorizzazione download per tutte le famiglie selezionate\r\n                    for( var i=0; i<docsfamsIdsToCheck.length; i++ ) {\r\n                        let famId = docsfamsIdsToCheck[i];\r\n                        if(famId>1000) {\r\n                            let familyRight = massiveFamilyRight[famId];\r\n                            if(familyRight==null){\r\n                                familyRight = {\r\n                                    docsCanSend : true,\r\n                                    docsCanDownload : true,\r\n                                    docsCanDelete: false\r\n                                };\r\n                            }else{\r\n                                familyRight[\"docsCanSend\"] = true;\r\n                                familyRight[\"docsCanDownload\"] = true;\r\n                            }\r\n                            massiveFamilyRight[famId] = familyRight;\r\n                        }\r\n                    }\r\n                }else{\r\n                    for( var i=0; i<docsfamsIdsToCheck.length; i++ ) {\r\n                        let famId = docsfamsIdsToCheck[i];\r\n                        if(famId>1000) {\r\n                            let familyRight = massiveFamilyRight[famId];\r\n                            if(familyRight==null){\r\n                                familyRight = {\r\n                                    docsCanSend : false,\r\n                                    docsCanDownload : false,\r\n                                    docsCanDelete: false\r\n                                };\r\n                            }else{\r\n                                familyRight[\"docsCanSend\"] = false;\r\n                                familyRight[\"docsCanDownload\"] = false;\r\n                            }\r\n                            massiveFamilyRight[famId] = familyRight;\r\n                        }\r\n                    }\r\n                }\r\n\r\n                if(checkAllAuthByFams(1, 6, docsIdsToCheck)){  //Controllo l'autorizzazione delete per tutte le famiglie selezionate\r\n                    for( var i=0; i<docsfamsIdsToCheck.length; i++ ) {\r\n                        let famId = docsfamsIdsToCheck[i];\r\n                        if(famId>1000) {\r\n                            let familyRight = massiveFamilyRight[famId];\r\n                            if(familyRight==null){\r\n                                familyRight = {\r\n                                    docsCanSend : false,\r\n                                    docsCanDownload : false,\r\n                                    docsCanDelete: true\r\n                                };\r\n                            }else{\r\n                                familyRight[\"docsCanDelete\"] = true;\r\n                            }\r\n                            massiveFamilyRight[famId] = familyRight;\r\n                        }\r\n                    }\r\n                }else{\r\n                    for( var i=0; i<docsfamsIdsToCheck.length; i++ ) {\r\n                        let famId = docsfamsIdsToCheck[i];\r\n                        if(famId>1000) {\r\n                            let familyRight = massiveFamilyRight[famId];\r\n                            if(familyRight==null){\r\n                                familyRight = {\r\n                                    docsCanSend : false,\r\n                                    docsCanDownload : false,\r\n                                    docsCanDelete: false\r\n                                };\r\n                            }else{\r\n                                familyRight[\"docsCanDelete\"] = false;\r\n                            }\r\n                            massiveFamilyRight[famId] = familyRight;\r\n                        }\r\n                    }\r\n                }\r\n\r\n                if(!checkAllDocLocksByDocs(docsIds)){\r\n                    for( var i=0; i<famsIds.length; i++ ) {\r\n                        let famId = famsIds[i];\r\n                        if(famId>1000) {\r\n                            let familyRight = massiveFamilyRight[famId];\r\n                            if(familyRight==null){\r\n                                familyRight = {\r\n                                    docsCanSend : false,\r\n                                    docsCanDownload : false,\r\n                                    docsCanDelete: false\r\n                                };\r\n                            }else{\r\n                                familyRight[\"docsCanDelete\"] = false;\r\n                            }\r\n                            massiveFamilyRight[famId] = familyRight;\r\n                        }\r\n                    }\r\n                }\r\n            }\r\n\r\n            var docsCanSend = true;\r\n            var docsCanDownload = true;\r\n            var docsCanDelete = true;\r\n            var attachCanSend = false;\r\n            var attachCanDownload = false;\r\n            var attachCanDelete = false;\r\n\r\n            if(checkAllAuthByDocs(1, 3, attachDocsIds)){  //Controllo l'autorizzazione aggiungi e vedi allegati per tutti gli allegati selezionati\r\n                attachCanSend = true;\r\n                attachCanDownload = true;\r\n            }\r\n            if(checkAllAuthByDocs(1, 4, attachDocsIds)){  //Controllo l'autorizzazione cancella allegati per tutti gli allegati selezionati\r\n                attachCanDelete = true;\r\n            }\r\n\r\n            for( var i=0; i<allFamsIds.length; i++ ) {\r\n                let famId = allFamsIds[i];\r\n                let familyRight = massiveFamilyRight[famId];\r\n                if(familyRight==null){\r\n                    docsCanSend = false;\r\n                    docsCanDownload = false;\r\n                    docsCanDelete = false;\r\n                }else{\r\n                    docsCanSend = docsCanSend && familyRight.docsCanSend;\r\n                    docsCanDownload = docsCanDownload && familyRight.docsCanDownload;\r\n                    docsCanDelete = docsCanDelete && familyRight.docsCanDelete;\r\n                }\r\n            }\r\n\r\n            if(famsIds.length>0 && attachDocsIds.length>0){\r\n                if(docsCanDelete && attachCanDelete){\r\n                    $(\"#deleteSelected\").removeClass(\"hiddenButton\");\r\n                }\r\n                if(docsCanDownload && attachCanDownload){\r\n                    $(\"#downloadSelected\").removeClass(\"hiddenButton\");\r\n                }\r\n                if(docsCanSend && attachCanSend){\r\n                    $(\"#sendSelected\").removeClass(\"hiddenButton\");\r\n                }\r\n            }\r\n\r\n            if(famsIds.length>0 && attachDocsIds.length==0){\r\n                if(docsCanDelete && trackIds.length == 0){\r\n                    $(\"#deleteSelected\").removeClass(\"hiddenButton\");\r\n                }\r\n                if(docsCanDownload){\r\n                    $(\"#downloadSelected\").removeClass(\"hiddenButton\");\r\n                }\r\n                \r\n                console.log(\"trackIds.length:\"+trackIds.length);\r\n                \r\n                if(docsCanSend && trackIds.length == 0){\r\n                    $(\"#sendSelected\").removeClass(\"hiddenButton\");\r\n                }\r\n            }\r\n\r\n            if(famsIds.length==0 && attachDocsIds.length>0){\r\n                if(attachCanDelete){\r\n                    $(\"#deleteSelected\").removeClass(\"hiddenButton\");\r\n                }\r\n                if(attachCanDownload){\r\n                    $(\"#downloadSelected\").removeClass(\"hiddenButton\");\r\n                }\r\n                if(attachCanSend){\r\n                    $(\"#sendSelected\").removeClass(\"hiddenButton\");\r\n                }\r\n            }\r\n\r\n            if( $(\".revSubRptContainer td.row-number > input[type=checkbox]:checked\").length>0 ) {\r\n                $(\"#deleteSelected\").addClass(\"hiddenButton\");\r\n            }\r\n\r\n            //Scateno l'evento solo se ho selezionato dei documenti e non gli allegati\r\n            if(docsIds && docsIds.length>0 && attachDocsIds.length==0)\r\n                $(window).trigger(\"onRowSelectionChanged\", [JSON.stringify(famsIds), JSON.stringify(docsIds), JSON.stringify(attachDocsIds)]);\r\n            else\r\n                $(\".plugin-multi\").addClass(\"hiddenButton\");\r\n        }else{\r\n            $(\"#azioniMassive\").addClass(\"hiddenButton\");\r\n            $(\"#sendSelected\").addClass(\"hiddenButton\");\r\n            $(\"#deleteSelected\").addClass(\"hiddenButton\");\r\n            $(\"#downloadSelected\").addClass(\"hiddenButton\");\r\n        }\r\n\r\n\t\ttidyUpMenu();\r\n    }\r\n\r\n\tvar menuAzioniMassive = $(\".split-toolbar.azioniMassive\");\r\n\tvar othersMenu = $(\".others-menu-actions\");\r\n\tvar HIDE_BUTTON_TRESHOLD = 100;\r\n\tvar SHOW_BUTTON_TRESHOLD = 20;\r\n\tfunction tidyUpMenu() {\r\n\t\tvar otherButtonsWidth = 0;\r\n\t\tmenuAzioniMassive.parent().find(\"> li:not(.azioniMassive)\").each(function(i, btn){\r\n\t\t\totherButtonsWidth += $(btn).outerWidth();\r\n\t\t});\r\n\r\n\t\tvar idxBreak = 50;\r\n\t\tvar allButtonsWidth = 0;\r\n\t\tmenuAzioniMassive.find(\"li:not(.hiddenButton):not(.never-hidden)\").each(function(i, btn){\r\n\t\t\tallButtonsWidth += $(btn).outerWidth();\r\n\t\t});\r\n\r\n\t\tfunction availableSpace() {\r\n\t\t\treturn menuAzioniMassive.parent().width()-otherButtonsWidth;\r\n\t\t}\r\n\t\tfunction usedSpace() {\r\n\t\t\treturn menuAzioniMassive.width()+HIDE_BUTTON_TRESHOLD;\r\n\t\t}\r\n\t\tfunction nextButtonToShowSpace() {\r\n\t\t\treturn othersMenu.find(\"> ul > li:first\").outerWidth();\r\n\t\t}\r\n\t\tfunction thereAreHiddenButtons() {\r\n\t\t\treturn othersMenu.find(\"> ul > li\").length > 0;\r\n\t\t}\r\n\r\n\t\tif(usedSpace() > availableSpace()) {\r\n\t\t\twhile(usedSpace() > availableSpace() && 0 < idxBreak--) {\r\n\t\t\t\tvar buttonToHide = menuAzioniMassive.find(\"li:not(.hiddenButton):not(.never-hidden):last\");\r\n\t\t\t\tif(!buttonToHide.prop(\"originalParent\"))\r\n\t\t\t\t\tbuttonToHide.prop(\"originalParent\", buttonToHide.parent());\r\n\t\t\t\tothersMenu.find(\"> ul\").prepend(buttonToHide);\r\n//\t\t\t\tothersMenu.removeClass(\"visible\");\r\n\t\t\t}\r\n\t\t} else if(thereAreHiddenButtons()) {\r\n\t\t\twhile(usedSpace()+SHOW_BUTTON_TRESHOLD+nextButtonToShowSpace() < availableSpace() && 0 < idxBreak--) {\r\n\t\t\t\tif(thereAreHiddenButtons() && usedSpace()+SHOW_BUTTON_TRESHOLD+nextButtonToShowSpace() < availableSpace()) {\r\n\t\t\t\t\tvar buttonToShow = othersMenu.find(\"> ul > li:first\");\r\n\t\t\t\t\tbuttonToShow.prop(\"originalParent\").append(buttonToShow);\r\n//\t\t\t\t\tothersMenu.removeClass(\"visible\");\r\n\t\t\t\t} else {\r\n\t\t\t\t\tbreak;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\tif(thereAreHiddenButtons()) {\r\n\t\t\t$(\"#show-more-buttons-container\").removeClass(\"hidden\");\r\n\t\t} else {\r\n\t\t\t$(\"#show-more-buttons-container\").addClass(\"hidden\");\r\n\t\t}\r\n    }\r\n\r\n    $(document).ready(function () {\r\n        $(\"#crumbs\").html('<li><a href=\"#/\">Home</a></li>' +\r\n                '<li><a onclick=\"displayPreviousPage(); return false;\" href=\"javascript:void(0)\">Ricerche</a></li>'+    /*Ricerche*/\r\n                '<li>Risultati ricerca: <span style=\"font-style: italic;\">4 documenti</span></li>');      /*Risultati ricerca*/\r\n\r\n        \r\n        \r\n        $(\"#documents\").addClass(getReportStyle());\r\n        \r\n\r\n        saveLastQuery();\r\n\t\ttidyUpMenu();\r\n\t\t$(window).bind(\"resize\", tidyUpMenu);\r\n\t\t$(\"#show-more-buttons\").off(_evt_type).on(_evt_type,function(){\r\n\t\t\t$(\".others-menu-actions > ul > li select\").off(_evt_type).on(_evt_type,function(e){e.stopPropagation();});\r\n\t\t\t$(\".others-menu-actions > ul > li\").one(_evt_type, function(){$(\".others-menu-actions\").removeClass(\"visible\");});\r\n\t\t\t$(\".others-menu-actions\").toggleClass(\"visible\");\r\n\t\t});\r\n    });\r\n    //# sourceURL=http://172.16.90.4:8080/adiJed/ui/query/result.jsp\r\n</script>\r\n\r\n\r\n\r\n\r\n}\r\n"
