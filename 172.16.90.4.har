   window.document.addEventListener('pageTokensUpdated', onPageTokensUpdated, false);\r\n            function onPageTokensUpdated(e) {\r\n                //console.log(e.detail);\r\n                const newPageTokens = e.detail;\r\n                if (newPageTokens !== undefined) {\r\n                    Object.keys(newPageTokens).forEach(function (key) {\r\n                        if (pageTokenWrapper.pageTokens === null) {\r\n                            pageTokenWrapper.pageTokens = {};\r\n                        }\r\n                        return pageTokenWrapper.pageTokens[key] = newPageTokens[key];\r\n                    });\r\n                }\r\n\r\n                triggerParentPageTokensUpdate(newPageTokens);\r\n            }\r\n\r\n            addEvent(window, 'DOMContentLoaded', function () {\r\n                isLoadedWrapper.isDomContentLoaded = true;\r\n\r\n                if (pageTokenWrapper.pageTokensLoaded) {\r\n                    injectTokens(tokenName, masterTokenValue, pageTokenWrapper.pageTokens);\r\n                }\r\n\r\n                injectToKendoWindow(tokenName, masterTokenValue);\r\n                injectToOpenWin(tokenName, masterTokenValue);\r\n                injectToFetch(tokenName, masterTokenValue);\r\n                injectToJQueryFunctions(tokenName, masterTokenValue);\r\n            });\r\n\r\n            if (true) { // TODO should it be invoked only after the DOMContentLoaded?\r\n                handleDynamicallyCreatedNodes();\r\n            }\r\n\r\n            /* optionally include Ajax support */\r\n            if (true) {\r\n                if (navigator.appName === 'Microsoft Internet Explorer') {\r\n                    hijackExplorer();\r\n                } else {\r\n                    hijackStandard();\r\n                }\r\n\r\n                XMLHttpRequest.prototype.onsend = function (data) {\r\n                    var computePageToken = function(pageTokens, modifiedUri) {\r\n                        let resul