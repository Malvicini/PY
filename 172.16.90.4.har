            "mimeType": "text/css",
            "compression": -1,
            "text": "#bd {\r\n    opacity: 0;\r\n    -webkit-transition: all .3s ease-in-out;\r\n    -moz-transition: all .3s ease-in-out;\r\n    -o-transition: all .3s ease-in-out;\r\n    transition: all .3s ease-in-out;\r\n}\r\n#application-top-bar, .top-bar {\r\n    display: block;\r\n    position: fixed;\r\n    padding-left: 60px;\r\n    background-color: #354042; /* #4D086F viola, #087908 verde, #379413 verde2  */\r\n    height: 36px;\r\n    left: 0;\r\n    right: 0;\r\n    vertical-align: middle;\r\n    color: white;\r\n    z-index: 2;\r\n    -webkit-transition: all .3s ease-in-out;\r\n    -moz-transition: all .3s ease-in-out;\r\n    -o-transition: all .3s ease-in-out;\r\n    transition: all .3s ease-in-out;\r\n}\r\n#bd.tablet #application-top-bar {\r\n    padding-left: 0;\r\n    text-align: center;\r\n    height: 100%;\r\n    width: 70px;\r\n    vertical-align: middle;\r\n    margin-top: auto;\r\n    margin-bottom: auto;\r\n    z-index: 1;\r\n    box-shadow: rgb(10, 10, 10) -4px 4px 17px inset;\r\n}\r\n#bd.tablet #application-top-bar > span, #bd.tablet #application-top-bar > #user-box {\r\n    display: block;\r\n    float: left;\r\n    width: 55px;\r\n    clear: both;\r\n}\r\n#bd.tablet #application-top-bar #user-box > span {\r\n    margin-top: 0;\r\n    padding-top: 23px;\r\n    padding-bottom: 0;\r\n    margin-left: 0;\r\n    width: 44px;\r\n}\r\n#bd.big #application-top-bar {\r\n    padding-left: 60px;\r\n}\r\n#bd.small #application-top-bar {\r\n    height: 25px;\r\n    padding-left: 5px;\r\n    font-size: 80%;\r\n}\r\n#bd.smaller #application-top-bar {\r\n    height: 35px;\r\n    padding-left: 5px;\r\n    bottom: 0;\r\n    z-index: 99;\r\n}\r\n#main-container, #aboutAdiuto {\r\n    overflow: hidden;\r\n    position: absolute;\r\n    top: 70px;\r\n    bottom: 10px;\r\n    left: 10px;\r\n    right: 10px;\r\n/*    box-shadow: 0 0 10px #007fd4 !important;*/\r\n    box-shadow: 0 0 10px rgb(223, 223, 223);\r\n    border: 1px solid rgba(214, 214, 214, 1);\r\n    background-color: #ffffff;\r\n    display: block;\r\n    z-index: 1;\r\n    -webkit-transition: all .3s ease-in-out;\r\n    -moz-transition: all .3s ease-in-out;\r\n    -o-transition: all .3s ease-in-out;\r\n    transition: all .3s ease-in-out;\r\n}\r\n#bd.tablet #main-container {\r\n    left: 71px;\r\n    top: 0;\r\n    height: 100%;\r\n    right: 0;\r\n    box-shadow: none;\r\n    overflow: auto;\r\n    bottom: auto;\r\n    border: none;\r\n}\r\n#bd.def #main-container {\r\n    margin-right: 55px;\r\n}\r\n#bd.def #switchCompanyDiv {\r\n    margin-right: 55px;\r\n}\r\n#bd.big #main-container {\r\n    top: 70px;\r\n    left: 10px;\r\n}\r\n#bd.pinned-right-container:not(.w1024) #main-container {\r\n    left: 0.5%;\r\n    margin-right: 19.5%;\r\n}\r\n#bd.pinned-right-container #aboutAdiuto {\r\n    margin-right: 17.5%;\r\n}\r\n#bd.pinned-right-container #switchCompanyDiv {\r\n    margin-right: 19.5%;\r\n}\r\n#bd.big.pinned-right-container #main-container {\r\n    left: 15px;\r\n}\r\n#bd.big:not(.pinned-right-container) #main-container, #bd.def:not(.pinned-right-container) #main-container {\r\n    margin-right: 55px;\r\n}\r\n#bd.big:not(.pinned-right-container) #switchCompanyDiv, #bd.def:not(.pinned-right-container) #switchCompanyDiv {\r\n    margin-right: 55px;\r\n}\r\n#bd.w1024 #main-container {\r\n    top: 60px;\r\n    bottom: 6px;\r\n    left: 10px;\r\n    right: 0px;\r\n}\r\n#bd.small #main-container {\r\n    top: 25px;\r\n    left: 0;\r\n    right: 44px;\r\n    margin-right: 0;\r\n    bottom: 0;\r\n}\r\n#bd.smaller #main-container {\r\n    top: 0px;\r\n    left: 0;\r\n    right: 20px;\r\n    bottom: 30px;\r\n}\r\n#app-container {\r\n    position: absolute;\r\n    top: 0;\r\n    bottom: 0;\r\n    right: 0;\r\n    left: 0;\r\n    display: inline-block;\r\n    overflow: hidden;\r\n    width: 100%;\r\n}\r\n#application-left-bar {\r\n    position: absolute;\r\n    display: block;\r\n    width: 250px;\r\n    border-right: #ecebeb 1px solid;\r\n    padding-left: 1px;\r\n    top: 0;\r\n    bottom: 0;\r\n    overflow-y: auto;\r\n}\r\n#bd.big #application-left-bar {\r\n    width: 370px;\r\n}\r\n#bd.small #application-left-bar {\r\n    width: 180px;\r\n    padding-left: 0;\r\n}\r\n#bd.smaller #application-left-bar {\r\n    height: auto;\r\n    overflow-y: visible;\r\n}\r\n#bd.smaller #application-left-bar.homepage {\r\n    width: 30px;\r\n    padding-left: 0;\r\n}\r\n#application-left-bar.homepage {\r\n    display: none;\r\n}\r\n#right-app-container {\r\n    position: absolute;\r\n    right: 0;\r\n    top: 0;\r\n    width: 40px;\r\n    background-color: #354042;\r\n}\r\n#bd.small #right-app-container #pin-right-app-container, #bd.w1024 #right-app-container #pin-right-app-container {\r\n    display: none;\r\n}\r\n#right-app-container #pin-right-app-container {\r\n    -webkit-transition: all .3s ease;\r\n    -moz-transition: all .3s ease;\r\n    -o-transition: all .3s ease;\r\n    transition: all .3s ease;\r\n}\r\n#right-app-container:not(.pinned) #pin-right-app-container {\r\n    opacity: 0;\r\n    position: absolute;\r\n    right: 3px;\r\n}\r\n#right-app-container.pinned #pin-right-app-container, #right-app-container:not(.cc):not(.pinned):hover #pin-right-app-container {\r\n    opacity: 1;\r\n}\r\n#right-app-container #pin-right-app-container {\r\n    float: right;\r\n    display: inline-block;\r\n    margin-right: 2px;\r\n    width: 30px;\r\n    height: 30px;\r\n    cursor: pointer;\r\n    background: transparent url('/adiJed/img/toolbar/pin.png') no-repeat center;\r\n    margin-top: -5px;\r\n    z-index: 2;\r\n}\r\n#right-app-container.pinned #pin-right-app-container {\r\n    background-image: url('/adiJed/img/toolbar/unpin.png') !important;\r\n}\r\n#bd.tablet #right-app-container {\r\n    display: none;\r\n}\r\n#bd.tablet #right-app-container {\r\n    top: 0;\r\n    bottom: 0;\r\n    padding-top: 20px;\r\n}\r\n#right-app-container:not(.pinned) #right-app-user-info, #bd.tablet #right-app-container #right-app-user-info {\r\n    display: none;\r\n}\r\n#right-app-user-info {\r\n    padding-left: 7px;\r\n    padding-right: 35px;\r\n    margin-bottom: 20px;\r\n}\r\n#right-app-container {\r\n    bottom: 0;\r\n    padding-right: 4px;\r\n    -webkit-transition: all .25s ease-in-out;\r\n    -moz-transition: all .2s ease;\r\n    -o-transition: all .2s ease;\r\n    transition: all .25s ease-in-out;\r\n    -webkit-transform: translate3d(0, 0, 0);\r\n}\r\n#right-app-container.pinned {\r\n    padding-top: 2px;\r\n}\r\n#bd.big #right-app-container.pinned, #right-app-container:not(.pinned) {\r\n    padding-top: 25px;\r\n    overflow-x: hidden;\r\n}\r\n#bd.small #right-app-container {\r\n    top: 25px;\r\n}\r\n#right-app-container:not(.cc):not(.pinned):hover {\r\n    width: 22%;\r\n    min-width: 250px;\r\n    z-index: 999;\r\n    box-shadow: -3px 1px 10px black;\r\n    -webkit-backface-visibility: hidden;\r\n    -webkit-perspective: 1000;\r\n    opacity: .95;\r\n}\r\n#right-app-container.pinned {\r\n    position: absolute;\r\n    right: 0;\r\n    bottom: 0;\r\n    width: 19%;\r\n\r\n    /*min-width: 220px;*/ /* todo: controllare come fare a fissare la larghezza minima, e far sì che non si sovrapponga il #main-container */\r\n}\r\n#right-app-container {\r\n    top: 36px;\r\n    box-shadow: inset 2px -5px 6px black;\r\n}\r\n#right-app-container * {\r\n    color: #fff;\r\n}\r\n#right-app-content .right-item {\r\n    padding-left: 35px;\r\n    height: 30px;\r\n    vertical-align: middle;\r\n    padding-top: 4px;\r\n    font-weight: bold;\r\n    padding-right: 35px;\r\n    position: relative;\r\n}\r\n#right-app-content .right-item .right-item-bullet {\r\n    font-weight: bold;\r\n    vertical-align: initial;\r\n    position: absolute;\r\n    left: 15px;\r\n    top: -5px;\r\n}\r\n#right-app-content:not(.pinned) .right-item span:first-child {\r\n    visibility: hidden;\r\n}\r\n#right-app-container:not(.cc):not(.pinned):hover #right-app-content .right-item span:first-child, #right-app-container.pinned #right-app-con