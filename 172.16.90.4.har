ner > table thead tr th, .revSubRptContainer > table thead tr th {\r\n        height: 20px !important;\r\n        padding-left: 5px;\r\n        padding-right: 5px;\r\n    }\r\n    .trackSubRptContainer, .attSubRptContainer, .revSubRptContainer {\r\n        border: 3px solid #AFBDBD;\r\n        border-radius: 5px;\r\n        display: inline-block;\r\n        position: relative;\r\n        opacity: 1;\r\n        height: auto;\r\n        width: 100%;\r\n    }\r\n    .trackSubRptContainer > table, .attSubRptContainer > table, .revSubRptContainer > table {\r\n        width: auto !important;\r\n        margin-bottom: 0 !important;\r\n        padding-bottom: 0;\r\n    }\r\n    .trackSubRptContainer > table thead tr th, .attSubRptContainer > table thead tr th, .revSubRptContainer > table thead tr th {\r\n        height: 20px !important;\r\n        padding-left: 5px;\r\n        padding-right: 5px;\r\n    }    \r\n    tr.no-hover > td:hover {\r\n        background-color: white;\r\n        cursor: auto;\r\n    }\r\n    .docVC .icon, .icon-button {\r\n        padding: 8px 2px;\r\n    }\r\n    #documents.compact-view .docVC .icon, #documents.compact-view .icon-button {\r\n        padding: 5px 2px;\r\n    }\r\n    .lnkSubRpt.icon-button {\r\n        background: url('/adiJed/img/report/link_plus.png') no-repeat center !important;\r\n    }\r\n    .lnkSubRpt.icon-button.open {\r\n        background: url('/adiJed/img/report/link_less.png') no-repeat center !important;\r\n    }\r\n    .trackSubRpt.icon-button {\r\n        background: url('/adiJed/img/report/track_plus.png') no-repeat center !important;\r\n    }\r\n    .trackSubRpt.icon-button.open {\r\n        background: url('/adiJed/img/report/track_less.png') no-repeat center !important;\r\n    }\r\n    .detSubRpt.icon-button {\r\n        background: url('/adiJed/img/report/zoom_plus.png') no-repeat center !important;\r\n    }\r\n    .detSubRpt.icon-button.open {\r\n        background: url('/adiJed/img/report/zoom_less.png') no-rep