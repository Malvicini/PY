          "content": {
            "size": 7525,
            "mimeType": "text/javascript",
            "compression": -1,
            "text": "(function(wnd) {\r\n    var IterManager = function() {\r\n        this.saveComment = function(iterID, comment) {\r\n            var result = false;\r\n            $.ajax({\r\n                url: \"/adiJed/ui/save-iter-comment.do\",\r\n                data: \"COMMENT=\"+comment+\"&ITERID=\"+iterID,\r\n                async: false, type: 'POST', success: function(html) { result = true; }\r\n            });\r\n            return result;\r\n        };\r\n\r\n        this.denyAction = function (docID, iterID, roleId, comment, token, signChoosenLabel, workflowUserListREAD, listPK, onSuccessCallback, onErrorCallback) {\r\n            let result = false;\r\n            let postData = \"docId=\" + docID + \"&action-id=-1&roleId=\" + roleId + \"&iter-id=\" + iterID + \"&comment=\" + comment + \"&token=\" + token;\r\n            postData += \"&sign-significato=\" + (signChoosenLabel ? encodeURIComponent(signChoosenLabel) : \"\");\r\n            postData += (workflowUserListREAD >= 1000 ? \"&listPK=\" + listPK : \"\");\r\n\r\n            $.ajax({\r\n                url: \"/adiJed/ui/deny-iter-action.do\",\r\n                data: postData,\r\n                async: !!onSuccessCallback,\r\n                type: 'POST',\r\n                success: function(jsonResult) {\r\n                    if(jsonResult[\"error\"]) {\r\n                        if(onErrorCallback) onErrorCallback();\r\n                        result = false;\r\n                    } else {\r\n                        if(onSuccessCallback) onSuccessCallback();\r\n                        result = true;\r\n                    }\r\n                }\r\n            });\r\n            return result;\r\n        };\r\n\r\n        this.approveAction = function (docID, iterID, roleId, comment, nextActionID, token, signChoosenLabel, workflowUserListREAD, listPK, onSuccessCallback, onErrorCallback) {\r\n            let result = false;\r\n            let postData = \"docId=\" + docID + \"&action-id=\" + nextActionID + \"&roleId=\" + roleId + \"&iter-id=\" + iterID + \"&comment=\" + comment + \"&token=\" + token;\r\n            postData += \"&sign-significato=\" + (signChoosenLabel ? encodeURIComponent(signChoosenLabel) : \"\");\r\n            postData += (workflowUserListREAD >= 1000 ? \"&listPK=\" + listPK : \"\");\r\n\r\n            $.ajax({\r\n                url: \"/adiJed/ui/approve-iter-action.do\",\r\n                data: postData,\r\n                async: !!onSuccessCallback,\r\n                type: 'POST',\r\n                success: function (jsonResult) {\r\n                    if (jsonResult[\"error\"]) {\r\n                        if(onErrorCallback) onErrorCallback();\r\n                        result = false;\r\n                        if (jsonResult[\"message\"]) {\r\n                            showErrorMessage(jsonResult[\"message\"]);\r\n                        }\r\n                    } else {\r\n                        if(onSuccessCallback) onSuccessCallback();\r\n                        result = true;\r\n                    }\r\n                }\r\n            });\r\n            return result;\r\n        };\r\n\r\n        this.checkSign = function(user, password) {\r\n            var result = false;\r\n            var postData = \"sign-user=\"+encodeURIComponent(user)+\"&sign-password=\"+encodeURIComponent(password);\r\n            $.ajax({\r\n                url: \"/adiJed/ui/check-sign-login.do\",\r\n                data: postData,\r\n                async: false, type: 'POST', success: function(loginResult) {\r\n                    result = loginResult;\r\n                }\r\n            });\r\n            return result;\r\n        };\r\n\r\n        this.changeSignPassword = function(user, password, passwordConfirm, oldPassword, passwordExpired) {\r\n            var result = false;\r\n            var postData = \"action=change&sign-user=\"+encodeURIComponent(user)+\"&sign-password=\"+encodeURIComponent(password)+\"&sign-password-confirm=\"+encodeURIComponent(passwordConfirm)+\"&sign-old-password=\"+encodeURIComponent(oldPassword)+\"&passwordExpired=\"+passwordExpired;\r\n            $.ajax({\r\n                url: \"/adiJed/ui/check-sign-login.do\",\r\n                data: postData,\r\n                async: false, type: 'POST', success: function(loginResult) {\r\n                    result = loginResult;\r\n                }\r\n            });\r\n            return result;\r\n        };\r\n\r\n        /**\r\n         * params {callback: function, iterID: int, responsableUserID: int, listPK: int}\r\n         * @param params\r\n         * @returns {boolean}\r\n         */\r\n        this.changeResponsable = function(options) {\r\n            var result = false;\r\n            var postData = \"iid=\"+options[\"iterID\"]+\"&ruid=\"+options[\"responsableUserID\"]+\"&roleID=\"+options[\"roleID\"]+\"&listPK=\"+options[\"listPK\"]+\"&comment=\"+encodeURIComponent(options[\"comment\"]);\r\n            $.ajax({\r\n                url: \"/adiJed/ui/workflow.change-action-responsable.do\",\r\n                data: postData,\r\n                async: false, type: 'POST', success: function(commandResult) {\r\n                    if(options[\"callback\"])\r\n                        options[\"callback\"].call(this,commandResult);\r\n                }\r\n            });\r\n            return result;\r\n        };\r\n\r\n        /**\r\n         * params {callback: function, iterID: int, responsableUserID: int}\r\n         * @param params\r\n         * @returns {boolean}\r\n         */\r\n        this.addResponsable = function(options) {\r\n            var result = false;\r\n            var postData = \"iid=\"+options[\"iterID\"]+\"&ruid=\"+options[\"responsableUserID\"]+\"&roleID=\"+options[\"roleID\"]+\"&listPK=\"+options[\"listPK\"]+\"&comment=\"+encodeURIComponent(options[\"comment\"]);\r\n            $.ajax({\r\n                url: \"/adiJed/ui/workflow.add-action-responsable.do\",\r\n                data: postData,\r\n                async: false, type: 'POST', success: function(commandResult) {\r\n                    if(options[\"callback\"])\r\n                        options[\"callback\"].call(this,commandResult);\r\n                }\r\n            });\r\n            return result;\r\n        };\r\n\r\n        /**\r\n         * params {callback: function, iterID: int, responsableUserID: int}\r\n         * @param params\r\n         * @returns {boolean}\r\n         */\r\n        this.assignResponsable = function(options) {\r\n            var result = false;\r\n            var postData = \"iid=\"+options[\"iterID\"]+\"&ids=\"+options[\"ids\"]+\"&type=\"+options[\"type\"]+\"&action=assign_resp\";\r\n            $.ajax({\r\n                url: \"/adiJed/ui/tutor.manage-action.do\",\r\n                data: postData,\r\n                async: false, type: 'POST', success: function(commandResult) {\r\n                    if(options[\"callback\"])\r\n                        options[\"callback\"].call(this,commandResult);\r\n                }\r\n            });\r\n            return result;\r\n        };\r\n\r\n        /**\r\n         * params {callback: function, iterID: int, responsableUserID: int}\r\n         * @param params\r\n         * @returns {boolean}\r\n         */\r\n        this.endIter = function(options) {\r\n            var result = false;\r\n            var postData = \"iid=\"+options[\"iterID\"]+\"&docId=\"+options[\"docID\"]+\"&endIterId=\"+options[\"endIterId\"]+\"&comment=\"+options[\"comment\"]+\"&action=end_iter\";\r\n            $.ajax({\r\n                url: \"/adiJed/ui/tutor.manage-action.do\",\r\n                data: postData,\r\n                async: false, type: 'POST', success: function(commandResult) {\r\n                    if(options[\"callback\"])\r\n                        options[\"callback\"].call(this,commandResult);\r\n                }\r\n            });\r\n            return result;\r\n        };\r\n\r\n    };\r\n\r\n    wnd.IterManager = new IterManager();\r\n\r\n})(window);\r\n"
