id=\"+fieldRegID+\"][fieldPrefix=\"+fieldPrefix+\"]\").off(_evt_type).on(_evt_type,function() {\r\n                var frid = $(this).attr(\"fieldRegID\");\r\n                var fieldPrefix = $(this).attr(\"fieldPrefix\");\r\n                var fieldFamilyType = $(this).attr(\"famtype\");\r\n                var k = HistoryManager.getLastQuery()[\"key\"];\r\n                var q = HistoryManager.getLastQuery()[\"data\"];\r\n\r\n                HistoryManager.getCurrentPage()[\"docs\"] = null; //TODO mettere fieldPrefix nella HistoryManager\r\n                HistoryManager.saveQueryToHistory(k,q,\"queryKey=1766499180192&orderBy=\"+frid+\"&orderKind=desc&orderFieldFamilyType=\"+fieldFamilyType);\r\n\r\n                var oldScroll = $(\".documents-table-scroll\").scrollLeft();\r\n\r\n                $.when(\r\n                        saveHistoryAndDisplayPage(k, \"/adiJed/ui/query/change-order-search.do\", //TODO mettere fieldPrefix nella HistoryManager\r\n                                q+\"&queryKey=1766499180192&orderBy=\"+frid+\"&orderKind=desc&orderFieldFamilyType=\"+fieldFamilyType, true, false,\r\n                                HistoryConstants.REPLACE_CURRENT_HISTORY)\r\n                ).then( function(){\r\n                            $(\".documents-table-scroll\").scrollLeft(oldScroll);\r\n                        } );\r\n            });\r\n\r\n            _this.toggleClass(\"open\");\r\n            _moc.toggleClass(\"open\");\r\n            return false;\r\n        });\r\n    }\r\n\r\n    function loadMoreRows(qKey,mode)\r\n    {\r\n        $(\"#moreRowsMessage\").html(\"<span><img src=\\\"/adiJed/img/wait.gif\\\"/></span>\");\r\n\r\n        setTimeout( function() {\r\n            \r\n            $.ajax({url: \"/adiJed/ui/get-more-docs.do\", // --> more-results.jsp\r\n                data: \"qKey=\"+qKey+\"&pos=\"+queryDocs.length+\"&mode=\"+mode+\"&total=\"+HistoryManager.getCurrentPage()[\"documentsFound\"]+\"&pageUnique=\",\r\n                succes