rstNews = $(\".news-channel\").first();\r\n                    firstNews.fadeIn( \"slow\", function() {\r\n                        firstNews.addClass(\"current-news\");\r\n                    });\r\n                });\r\n            }\r\n        }else{\r\n            var firstNews = $(\".news-channel\").first();\r\n\r\n            firstNews.fadeIn( \"slow\", function() {\r\n                firstNews.addClass(\"current-news\");\r\n            });\r\n        }\r\n\r\n        var refreshFunction = function(){ changeNewsTimeoutID = setTimeout(changeNews, 5000);};\r\n\r\n        refreshFunction.call();\r\n    }\r\n\r\n    function openNews(channelId, title){\r\n        openWindow(\"news-preview\",\"/adiJed/ui/channels.channels.do?action=getChannelDesc&id=\"+channelId, {\"width\": \"700px\", \"height\": \"80%\", \"modal\": true, \"title\": title});\r\n    }\r\n\r\n//# sourceURL=http://172.16.90.4:8080/adiJed/ui/home/main.jsp\r\n</script>\r\n\r\n<script type=\"text/javascript\">AdiPlugin.prototype.getCurrentDocumentInfo = function(){return null;};</script>\r\n<script type=\"text/javascript\">AdiPlugin.prototype.getDocumentInfo = function(fidd){return null;};</script>\r\n\r\n"
