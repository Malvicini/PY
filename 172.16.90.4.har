            "mimeType": "text/css",
            "compression": -1,
            "text": ".can-drop-here {\r\n    opacity: .6;\r\n    transition: all .3s;\r\n}\r\n.dropping-here {\r\n    opacity: 1;\r\n    border: 1px solid #cdffb9;\r\n    transition: all .3s;\r\n}\r\n.dropping-here:before {\r\n    position: absolute;\r\n    content: ' ';\r\n    float: left;\r\n    width: 100%;\r\n    height: 100%;\r\n    left: 0;\r\n    z-index: 99;\r\n    opacity: .9;\r\n    background-image: url('/adiJed/img/193.png');\r\n    background-position: center center;\r\n    background-repeat: no-repeat;\r\n}\r\n.dropping-here > div, .folder > div {\r\n    background-color: #ffffff;\r\n    height: 60px !important;\r\n    width: 60px !important;\r\n    font-size: 40%;\r\n    margin-left: 12px;\r\n    margin-top: 15px;\r\n    float: left;\r\n    border: 1px solid #d3d3d3;\r\n    transition: all .3s;\r\n}\r\n.folder {\r\n    border-top: 1px solid #d3d3d3;\r\n    transition: all .3s;\r\n    left: 0px; top: 0px; display: block;\r\n}\r\n.folder.folder-expanded {\r\n    width: 600px;\r\n    height: 400px;\r\n    padding: 20px 10px;\r\n    overflow: auto !important;\r\n}\r\n.folder > .folder-title {\r\n    position: absolute;\r\n    opacity: .8;\r\n    z-index: 100;\r\n    background-color: rgb(240, 76, 76);\r\n    top: 0px;\r\n    border-bottom: 1px solid lightgray;\r\n    padding: 5px;\r\n    right: 0;\r\n    left: -1px;\r\n    color: white;\r\n    font-weight: bold;\r\n    font-size: 80%;\r\n    text-align: center;\r\n    border-radius: 13px;\r\n    top: 3px;\r\n    width: 85%;\r\n    margin: auto;\r\n}\r\n.folder.folder-expanded > .folder-title {\r\n    font-size: 100%;\r\n}\r\n.folder div.pinned-doc-family {\r\n    padding: 3px;\r\n}\r\n.dropping-here div.pinned-doc-inner, .folder div.pinned-doc-inner {\r\n    background-size: 18px !important;\r\n    background-color: #fff;\r\n    background-position: center !important;\r\n    background-repeat: no-repeat no-repeat !important;\r\n}\r\n.folder.folder-expanded div.pinned-doc-inner {\r\n    width: 160px !important;\r\n    height: 160px !important;\r\n    background-position: right 5px top 3px !important;\r\n    font-size: 100%;\r\n}\r\n.dropping-here > div {\r\n    opacity: .5;\r\n}\r\n.pinned-doc > div {\r\n    overflow: hidden;\r\n    width: 100%;\r\n    height: 100%;\r\n    transition: all .3s;\r\n}\r\ndiv.pinned-doc-inner {\r\n    transition: all .3s;\r\n    background-color: white;\r\n}\r\n.moving {\r\n    cursor: url('/adiJed/img/moving.png'), auto;\r\n}\r\n.dragging-outside:hover {\r\n    cursor: move;\r\n    background-color: green !important;\r\n}\r\n.folder.folder-expanded.overflow-visible {\r\n    overflow: visible !important;\r\n}\r\n.pinned-doc > .pinned-doc-inner > .pinned-doc-workflow {\r\n    position: absolute;\r\n    bottom: 28px;\r\n    background-color: rgba(251, 247, 247, 1);\r\n    left: 56px;\r\n    right: -60px;\r\n    box-shadow: 0px 1px 2px -1px gray;\r\n    border-top: #f5f5f5 1px solid;\r\n    border-bottom: #f5f5f5 1px solid;\r\n    padding-left: 35px;\r\n    padding-right: 3px;\r\n    -webkit-transform: rotate(-45deg) translate3d( 0, 0, 0);\r\n    -moz-transform: rotate(-45deg) translate3d( 0, 0, 0);\r\n    -ms-transform: rotate(-45deg) translate3d( 0, 0, 0);\r\n    -o-transform: rotate(-45deg) translate3d( 0, 0, 0);\r\n    transform: rotate(-45deg) translate3d( 0, 0, 0);\r\n}\r\n#bd.small .pinned-doc > .pinned-doc-inner > .pinned-doc-workflow {\r\n    -webkit-transform: none;\r\n    -moz-transform: none;\r\n    -ms-transform: none;\r\n    -o-transform: none;\r\n    transform: none;\r\n    padding-left: 3px;\r\n    padding-right: 3px;\r\n    bottom: 0;\r\n    left: 0;\r\n    right: 0;\r\n}\r\n.folder.pinned-doc > .pinned-doc-inner > .pinned-doc-workflow {\r\n    opacity: .2;\r\n}\r\n.folder-expanded.pinned-doc > .pinned-doc-inner > .pinned-doc-workflow {\r\n    opacity: 1;\r\n}\r\n.pinned-doc-workflow > span {\r\n    display: table-cell;\r\n    background: url(/adiJed/img/wf.png) left center no-repeat;\r\n    height: 22px;\r\n    color: whitesmoke;\r\n    font-size: 80%;\r\n    padding-left: 27px;\r\n    vertical-align: middle;\r\n}\r\ndiv#pinned-documents {\r\n    display: inline-block;\r\n    clear: both;\r\n    padding-top: 20px;\r\n    padding-left: 20px;\r\n    max-width: 50%;\r\n    overflow-y: hidden;\r\n    top: 0;\r\n    box-sizing: border-box;\r\n    bottom: 0;\r\n    /*position: absolute;*/\r\n}\r\ndiv#pinned-documents:hover {\r\n    overflow-y: auto;\r\n}\r\n.in-evidenza {\r\n    display: inline;\r\n    font-weight: bold;\r\n    float:left;\r\n    clear: both;\r\n    position: absolute;\r\n    padding:2px;\r\n    top: 10px;\r\n    left: 30px;\r\n    border-bottom: 1px solid gray;\r\n    letter-spacing: 1px;\r\n}\r\n.hiddenElement{\r\n    display: none;\r\n}\r\n#empty-home{\r\n    position: absolute;\r\n    bottom: 20px;\r\n    right: 20px;\r\n    /*padding-top: 20px;*/\r\n    width: 250px;\r\n}"
