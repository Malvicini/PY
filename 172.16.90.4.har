          "content": {
            "size": 212552,
            "mimeType": "text/javascript",
            "compression": -1,
            "text": "/**\r\n * Polyfill per Math.trunc che non è presente in IE\r\n * @type {Function|*}\r\n */\r\nMath.trunc = Math.trunc || function(x) {\r\n    return x < 0 ? Math.ceil(x) : Math.floor(x);\r\n}\r\nMath._fracts = function(x,n) {\r\n    var _x = x-Math.trunc(x);\r\n    for(var i=0;i<n;i++) {\r\n        _x *= 10;\r\n    }\r\n    return Math.trunc(_x);\r\n}\r\n/**\r\n * Polyfill per console.time e console.timeEnd se non presenti\r\n */\r\nif(typeof console === 'undefined' || typeof console.time === 'undefined') {\r\n    if(typeof console === 'undefined') {\r\n        window.console = {};\r\n\r\n        window.console.log = function(msg) {\r\n            Logger.log(msg);\r\n        }\r\n    }\r\n    window.tracerTimes = {};\r\n    console.time = function(n){\r\n        if(!window.tracerTimes[n]) {\r\n            window.tracerTimes[n] = new Date().getTime();\r\n        }\r\n    }\r\n    console.timeEnd = function(n){\r\n        var tend   = new Date().getTime(),\r\n            tstart = window.tracerTimes[n];\r\n\r\n        delete window.tracerTimes[n];\r\n\r\n        if(!tstart) {\r\n            return void(0);\r\n        }\r\n        var elapsed = (tend-tstart)/1000;\r\n        Logger.log(n+\": \"+Math.trunc(elapsed)+\".\"+(Math._fracts(elapsed,3))+\"s\");\r\n    }\r\n}\r\nif(!String.prototype.trim) {\r\n  String.prototype.trim = function() {\r\n    return this.replace(/^[\\s\\uFEFF\\xA0]+|[\\s\\uFEFF\\xA0]+$/g, '');\r\n  };\r\n}\r\nif(!Array.prototype.includes) {\r\n  Array.prototype.includes = function(el) {\r\n    return this.indexOf(el) !== -1;\r\n  };\r\n}\r\nvar adiutoTopWin = self;\r\n\r\nvar CustomEvents = {\r\n    SAVE_DOCUMENT_INFO_EVT: \"saveDocumentInfoEvent\",\r\n    CLOSE_DOCUMENT_INFO_EVT: \"closeDocumentInfoEvent\"\r\n};\r\nvar HistoryConstants = {\r\n    SAVE_PAGE_IN_HISTORY: 1,\r\n    LOAD_AND_FORGET: 2,\r\n    REPLACE_CURRENT_HISTORY: 3\r\n};\r\nvar ErrorBehaviour = {\r\n    GO_BACK: 1,\r\n    CLOSE_WINDOW: 2,\r\n    RELOAD_LAST_PAGE: 3,\r\n    DISABLE_BUTTON: 4,\r\n    DO_NOTHING: 5,\r\n    IGNORE: 99\r\n};\r\n// Prevent auto-execution of scripts when no explicit dataType was provided (See gh-2432)\r\n$.ajaxPrefilter( function( s ) {\r\n    if ( s.crossDomain ) {\r\n        s.contents.script = false;\r\n    }\r\n} );\r\n// aggiungere i codici di errore gestiti, nelle servlet\r\n$.ajaxSetup({\r\n    errorBehaviour: ErrorBehaviour.GO_BACK, // azione di default per errori\r\n    statusCode: {\r\n        409: function(data) {\r\n            var commandErrorCode = parseInt(data.getResponseHeader(\"CommandResponseErrorCode\"));\r\n            if( !isNaN(commandErrorCode) ) {\r\n                switch( commandErrorCode ) {\r\n                    case 1001: \r\n                        documentLockedError.call(this, data);\r\n                        break;\r\n                    case 1002: \r\n                        iterLockedError.call(this, data);\r\n                        break;\r\n                    case 1004: \r\n                        showErrorMessage(LangManager.get(\"ui.js.document.locked\")); //\"Documento bloccato.\"\r\n                        manageError(this.errorBehaviour);\r\n                        break;\r\n                    case 1005: \r\n                        documentCheckinCheckoutError.call(this, data);\r\n                        manageError(this.errorBehaviour);\r\n                        break;\r\n                    case 1006:\r\n                        concurrentWFUser.call(this, data);\r\n                        manageError(this.errorBehaviour);\r\n                        break;\r\n                    case 1007:\r\n                        this.errorBehaviour=ErrorBehaviour.DISABLE_BUTTON;\r\n                        \r\n                        adminLockedError.call(this, data);\r\n\r\n                        this.success.call(this, JSON.parse(data.responseText));\r\n                        $(\".toolbar-button\").not('.menuvoice').addClass(\"do-not-touch\");\r\n                        $(\".user.add-user\").addClass(\"do-not-touch\");\r\n                        //Blocco le azioni sugli utenti\r\n                        $(\".action.lock-unlock\").addClass(\"do-not-touch\");\r\n                        $(\".action.reset\").addClass(\"do-not-touch\");\r\n                        $(\".action.sign-password-reset\").addClass(\"do-not-touch\");\r\n                        $(\".action.sign-password-unlock\").addClass(\"do-not-touch\");\r\n                        $(\".action.sign-password-lock\").addClass(\"do-not-touch\");\r\n                        \r\n                        $(\"#application-top-bar .toolbar-button\").removeClass(\"do-not-touch\");\r\n                        \r\n                        $(\"#back\").removeClass(\"do-not-touch\");\r\n                        $(\".do-not-touch\").unbind(\"click\");\r\n\r\n//                        manageError(ErrorBehaviour.DISABLE_BUTTON);\r\n                        break;\r\n                    case 1008:\r\n                        this.errorBehaviour=ErrorBehaviour.DO_NOTHING;\r\n                        var wfManag = LangManager.get(\"general.actions.WORKFLOW_MANAGEMENT\");\r\n                        var message = LangManager.get(\"ui.auth.missing\", wfManag);\r\n                        showErrorMessage(message);\r\n                        manageError(this.errorBehaviour);\r\n\r\n                        break;\r\n                    case 1100:\r\n                        overwriteConflict.call(this, data);\r\n                        break;\r\n                    case 1101:\r\n                        overwriteError.call(this, data);\r\n                        break;\r\n                    case 1102:\r\n                        duplicateWarning.call(this, data);\r\n                        break;\r\n                    case 1103:\r\n                        noDuplicateWarning.call(this, data);\r\n                        break;\r\n                    //TODO MANCA 1104\r\n                    case 1105:\r\n                        this.errorBehaviour=ErrorBehaviour.DO_NOTHING;\r\n                        var message = LangManager.get(\"generic.msg.ricaricare\");\r\n                        showErrorMessage(message);\r\n                        manageError(this.errorBehaviour);\r\n\r\n                        break;\r\n                    case 1200:\r\n                        Logger.info(data.responseText);\r\n                        actionDeletedWarning.call(this, data);\r\n                        break;\r\n                    case 1300:\r\n                        userInvalidError.call(this, data);\r\n                        break;\r\n                    case 1301:\r\n                        roleInvalidError.call(this, data);\r\n                        break;\r\n                    case 1302:\r\n                        userInvalidWarning.call(this, data);\r\n                        manageError.call(this, ErrorBehaviour.IGNORE, data);\r\n                        break;\r\n                    case 1303:\r\n                        roleInvalidWarning.call(this, data);\r\n                        manageError.call(this, ErrorBehaviour.IGNORE, data);\r\n                        break;\r\n                    default:\r\n                        Logger.error(data.responseText);\r\n                        let errorMessageKey = \"ui.generic.error.message\";\r\n                        try {\r\n                            let callResponseText = data[\"responseText\"] || data.getResponseHeader('commandResponse');\r\n                            if(callResponseText && JSON.parse(callResponseText).errorMessageKey) {\r\n                                errorMessageKey = JSON.parse(callResponseText).errorMessageKey;\r\n                            }\r\n                        } catch(e) {\r\n                            //ignore\r\n                        }\r\n\r\n                        showErrorMessage(LangManager.get(errorMessageKey));\r\n                }\r\n            }\r\n        },\r\n        500: function(data) {\r\n            Logger.error(\"xhr error call to: \" + this.originalArguments + \" - server response: \" + data.responseText);\r\n        },\r\n        404: function(data) {\r\n            Logger.error(\"xhr error call to: \" + this.originalArguments + \" - server response: \" + data.responseText);\r\n        }\r\n    },\r\n    errorDealer: {\r\n        overwriteConflictDone: function(){},\r\n        overwriteErrorDone: function(){}\r\n    }\r\n});\r\nwindow.onerror = function(err1, err2, line, col, error) {\r\n    var msg = err1;\r\n    if(err2 && err2.message) {\r\n        msg = err2.message;\r\n    }\r\n    var url;\r\n    if(HistoryManager.getCurrentPage()) {\r\n        url = HistoryManager.getCurrentPage().url;\r\n    }\r\n    var extra = !col ? '' : '\\n'+'column: ' + col;\r\n    extra += !error ? '' : '\\n'+'error: ' + error;\r\n    if(err2 && err2.error) {\r\n        extra = '\\n'+err2.error;\r\n    }\r\n    try {\r\n        if(HistoryManager && HistoryManager.getCurrentPage())\r\n            extra += '\\n'+'currentpage: '+HistoryManager.getCurrentPage().url+'?'+HistoryManager.getCurrentPage().data;\r\n    } catch(e) {\r\n    }\r\n    Logger.error(\"Error: \" + msg + \"\\nurl: \" + url + \"\\nline: \" + line + extra);\r\n};\r\n$.fn.scale = function(x) {\r\n    if(!$(this).filter(':visible').length && x!=1)return $(this);\r\n    if(!$(this).parent().hasClass('scaleContainer')){\r\n        $(this).wrap($('<div class=\"scaleContainer\">').css('position','relative'));\r\n        $(this).data({\r\n            'originalWidth':$(this).width(),\r\n            'originalHeight':$(this).height()});\r\n    }\r\n    $(this).css({\r\n        'transform': 'scale('+x+')',\r\n        '-ms-transform': 'scale('+x+')',\r\n        '-moz-transform': 'scale('+x+')',\r\n        '-webkit-transform': 'scale('+x+')',\r\n        'transform-origin': 'right bottom',\r\n        '-ms-transform-origin': 'right bottom',\r\n        '-moz-transform-origin': 'right bottom',\r\n        '-webkit-transform-origin': 'right bottom',\r\n        'position': 'absolute',\r\n        'bottom': '0',\r\n        'right': '0'\r\n    });\r\n    if(x==1) {\r\n        $(this).unwrap().css('position','static');\r\n    } else {\r\n        $(this).parent()\r\n            .width($(this).data('originalWidth')*x)\r\n            .height($(this).data('originalHeight')*x);\r\n    }\r\n    return $(this);\r\n};\r\n\r\n/**\r\n * Estende le chiamate ajax di jquery per permettere la gestione errori in base allo status code della request.\r\n * Vedi sopra $.ajaxSetup\r\n *\r\n * addedData: consente di aggiungere dei parametri alla chiamata ajax originale\r\n *   es.   $.ajax.call(_this,{\"addedData\":\"ow=overwrite\"}).done(_this.overwriteConflictDone);\r\n */\r\n(function($){\r\n    var jqAjax = $.ajax;\r\n    $.ajax = function() {\r\n        var _args = Array.prototype.slice.call(arguments);\r\n        var addedData = null;\r\n        if(this.originalArguments) {\r\n            if ( typeof _args[0] === \"object\" ) {\r\n                addedData = (_args[0]).addedData;\r\n            }\r\n            _args = JSON.parse(this.originalArguments);\r\n        }\r\n        var errorBehaviour = _args[0], _ajax_options, _url;\r\n\r\n        if ( typeof errorBehaviour === \"object\" ) {\r\n            _ajax_options = errorBehaviour;\r\n            errorBehaviour = null;\r\n\r\n            if( typeof _ajax_options.data === \"object\" ) {\r\n                if( jQuery.isArray( _ajax_options.data ) ) {\r\n                    for(var idata=0; idata < _ajax_options.data.length; idata++) {\r\n                        var el = _ajax_options.data[idata];\r\n                        if(el.name && el.name == \"errorBehaviour\") {\r\n                            errorBehaviour = el.value;\r\n                        }\r\n                    }\r\n                } else {\r\n                    if(_ajax_options.data && _ajax_options.data.name && _ajax_options.data.name == \"errorBehaviour\")\r\n                        errorBehaviour = _ajax_options.data.value;\r\n                }\r\n            } else if(getParameterByName(\"errorBehaviour\", _ajax_options.data) != \"\") {\r\n                errorBehaviour = parseInt(getParameterByName(\"errorBehaviour\", _ajax_options.data), 10);\r\n            } else {\r\n                errorBehaviour = _ajax_options.errorBehaviour;\r\n            }\r\n\r\n        } else if( !isNaN(errorBehaviour) ) {\r\n            _args.slice(); // lo rimuovo prima di passarlo al vero metodo $.ajax()\r\n\r\n            _ajax_options = _args[0];\r\n\r\n            if ( typeof _ajax_options === \"object\" ) {\r\n                _ajax_options = jQuery.ajaxSetup( {}, _args[0] );\r\n            } else {\r\n                _url = _ajax_options;\r\n                _ajax_options = jQuery.ajaxSetup( {}, _args[1]||{} );\r\n            }\r\n        }\r\n\r\n        if(_ajax_options) {\r\n            if(_ajax_options.dataType == \"script\") {\r\n                _ajax_options.cache = true;\r\n            }\r\n            if(errorBehaviour) {\r\n                _ajax_options.errorBehaviour = errorBehaviour;\r\n            }\r\n            if(!_ajax_options.originalArguments) {\r\n                try { _ajax_options.originalArguments = JSON.stringify(Array.prototype.slice.call(arguments)); } catch(e) {;}\r\n            }\r\n        }\r\n        if(_ajax_options && _ajax_options.data && addedData) {\r\n            _ajax_options.data = addedData+\"&\"+_ajax_options.data;\r\n        }\r\n        return jqAjax.call(this,_url,_ajax_options);\r\n    };\r\n}(jQuery));\r\n\r\n(function($){\r\n    var jqLoad = $.fn.load;\r\n    $.fn.load = function() {\r\n        var _args = Array.prototype.slice.call(arguments);\r\n        // controllo se ho chiamato la funzione load con il parametro per gestire gli errori di adijed\r\n        if(!isNaN(_args[0])) {\r\n            var errorBehaviour = _args.shift();\r\n            var _url = _args.shift();\r\n            var _params = _args.shift();\r\n\r\n            if ( _params && !jQuery.isFunction( _params ) ) {\r\n                // se sono stati passati parametri\r\n                if ( jQuery.isArray( _params ) || ( _params.jquery && !jQuery.isPlainObject( _params ) ) ) {\r\n                    _params.unshift({name: \"errorBehaviour\", value: errorBehaviour});\r\n                } else if(jQuery.isPlainObject( _params )) {\r\n                    jQuery.extend({}, _params, {\"errorBehaviour\": errorBehaviour});\r\n                } else {\r\n                    _params = \"errorBehaviour=\"+errorBehaviour+\"&\"+_params;\r\n                }\r\n            } else {\r\n                // non sono stati passati parametri\r\n                var _callback = _params;\r\n                var _new_params = new Array();\r\n\r\n                if(_callback)\r\n                    _args.unshift(_callback);\r\n                _new_params.unshift({name: \"errorBehaviour\", value: errorBehaviour});\r\n\r\n                _params = _new_params;\r\n            }\r\n            _args.unshift(_params);\r\n            _args.unshift(_url);\r\n        }\r\n        return jqLoad.apply(this,_args);\r\n    };\r\n}(jQuery));\r\n\r\n(function($){\r\n    var jqGetScript = $.fn.getScript;\r\n    $.fn.getScript = function(url, callback) {\r\n        return jQuery.get( url, {cache: true}, callback, \"script\" );\r\n    };\r\n}(jQuery));\r\n/**\r\n * ------------------------------------- fine overloading chiamate ajax\r\n */\r\nif($.expr && $.expr.createPseudo) {\r\n    $.expr[\":\"]._containsIgnoreCase = $.expr.createPseudo(function(arg) {\r\n        return function( elem ) {\r\n            return $(elem).text().toUpperCase().indexOf(arg.toUpperCase()) >= 0;\r\n        };\r\n    });\r\n    $.expr[\":\"]._notContainsIgnoreCase = $.expr.createPseudo(function(arg) {\r\n        return function( elem ) {\r\n            return $(elem).text().toUpperCase().indexOf(arg.toUpperCase()) < 0;\r\n        };\r\n    });\r\n    $.expr[\":\"]._equals = $.expr.createPseudo(function(arg) {\r\n        return function( elem ) {\r\n            return $(elem).text() == arg;\r\n        };\r\n    });\r\n}\r\n/**\r\n * ------------------------------------- fine aggiunta pseudo a jquery\r\n */\r\njQuery.fn.justText = function() {\r\n    return $(this).clone().children().remove().end().text();\r\n};\r\njQuery.fn.priorityOn = function (type, selector, data, fn) {\r\n    this.each(function () {\r\n        var $this = $(this);\r\n        var types = type.split(\" \");\r\n\r\n        for (var t in types) {\r\n            $this.on(types[t], selector, data, fn);\r\n            var currentBindings = $._data(this, 'events')[types[t]];\r\n            if ($.isArray(currentBindings)) {\r\n                currentBindings.unshift(currentBindings.pop());\r\n            }\r\n        }\r\n    });\r\n    return this;\r\n};\r\njQuery.fn.preBind = function(type, data, fn) {\r\n    this.bind(type, data, fn);\r\n\r\n    var currentBindings = jQuery._data(this.get(0), 'events')[type];\r\n    var currentBindingsLastIndex = currentBindings.length - 1;\r\n    var newBindings = [];\r\n    newBindings.push(currentBindings[currentBindingsLastIndex]);\r\n\r\n    $.each(currentBindings, function (index) {\r\n        if (index < currentBindingsLastIndex)\r\n            newBindings.push(this);\r\n    });\r\n\r\n    jQuery._data(this.get(0), 'events')[type] = newBindings;\r\n    return this;\r\n};\r\n/**\r\n * Controllo se async è supportato dal browser\r\n * https://stackoverflow.com/questions/43502448/how-to-detect-async-function-support-without-eval/46127368#46127368\r\n */\r\n$(document).ready(function() {\r\n    new Promise(function (resolve, reject) {\r\n        var script = document.createElement('script');\r\n        document.body.appendChild(script);\r\n        script.onload = resolve.bind(null, true);\r\n        script.onerror = reject;\r\n        script.async = true;\r\n        script.src = '/adiJed/js/async-detection.js';\r\n    })\r\n        .then(function () {\r\n            // console.log(window.isAsyncAvailable);\r\n        })\r\n        .catch(/* generic script loading error */);\r\n});\r\n/**\r\n * ---------------------------------- fine controllo async\r\n */\r\n/**\r\n * Aggiunge l'evento click all'elemento passando prima per la richiesta di conferma dell'history manager se impostata\r\n * \r\n * @param {type} fn il click handler da associare all'evento click\r\n * @return {undefined}\r\n */\r\njQuery.fn.confirmedClick = function(fn) {\r\n    var f = function(i, _this) {\r\n        var _onClickHandler = fn.bind(_this);\r\n        $(_this).click(function(){\r\n            $.when(HistoryManager.needConfirmBeforeProceed()).then(_onClickHandler);\r\n        });\r\n    };\r\n\r\n    if(this.length && this.map) {\r\n        this.map(f);\r\n    } else {\r\n        f(this);\r\n    }\r\n};\r\n//ROSSTE - 20180822\r\n/**\r\n * jQuery.fn.sortElements\r\n * --------------\r\n * @author James Padolsey (http://james.padolsey.com)\r\n * @version 0.11\r\n * @updated 18-MAR-2010\r\n * --------------\r\n * @param Function comparator:\r\n *   Exactly the same behaviour as [1,2,3].sort(comparator)\r\n *   \r\n * @param Function getSortable\r\n *   A function that should return the element that is\r\n *   to be sorted. The comparator will run on the\r\n *   current collection, but you may want the actual\r\n *   resulting sort to occur on a parent or another\r\n *   associated element.\r\n *   \r\n *   E.g. $('td').sortElements(comparator, function(){\r\n *      return this.parentNode; \r\n *   })\r\n *   \r\n *   The <td>'s parent (<tr>) will be sorted instead\r\n *   of the <td> itself.\r\n */\r\njQuery.fn.sortElements = (function(){\r\n    \r\n    var sort = [].sort;\r\n    \r\n    return function(comparator, getSortable) {\r\n        \r\n        getSortable = getSortable || function(){return this;};\r\n        \r\n        var placements = this.map(function(){\r\n         