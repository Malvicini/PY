            "compression": -124,
            "text": "\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n<style type=\"text/css\">\r\n    #search-toolbar ul li#result-total {\r\n        position: absolute;\r\n        display: inline-block;\r\n        top: 10px;\r\n        padding-left: 5px;\r\n        padding-right: 5px;\r\n    }\r\n    #back:before {\r\n        background: url(\"/adiJed/img/toolbar/back.png\") no-repeat center;\r\n    }\r\n    #config:before {\r\n        background: url(\"/adiJed/img/toolbar/gear.png\") no-repeat center;\r\n    }\r\n    #linkDocuments:before {\r\n        background: url(\"/adiJed/img/toolbar/link_white.png\") no-repeat center;\r\n    }\r\n    #search-toolbar .split-toolbar {\r\n        float: left;\r\n    }\r\n    #search-toolbar .split-toolbar.azioniMassive {\r\n        float: right;\r\n        margin-right: 10px;\r\n    }\r\n    #downloadExportXls:before {\r\n        background: url(\"/adiJed/res/img/reportIcons/xls.png\") no-repeat center;\r\n    }\r\n    #showReconciliation:before {\r\n        background: url(\"/adiJed/res/img/reportIcons/recon.png\") no-repeat center;\r\n    }\r\n    #downloadExportCsv:before {\r\n        background: url(\"/adiJed/res/img/reportIcons/csv.png\") no-repeat center;\r\n    }\r\n    #downloadExportZip:before {\r\n        background: url(\"/adiJed/res/img/reportIcons/zip.png\") no-repeat center;\r\n    }\r\n    #downloadExportPdf:before {\r\n        background: url(\"/adiJed/res/img/reportIcons/pdf.png\") no-repeat center;\r\n    }\r\n    #downloadExportPrints:before {\r\n        background: url(\"/adiJed/res/img/reportIcons/xls.png\") no-repeat center;\r\n    }\r\n    #viewSelected:before {\r\n        background: url(\"/adiJed/img/toolbar/open.png\") no-repeat center;\r\n    }\r\n    #sendSelected:before {\r\n        background: url(\"/adiJed/img/toolbar/send_mail.png\") no-repeat center;\r\n    }\r\n    #downloadSelected:before {\r\n        background: url(\"/adiJed/img/toolbar/download.png\") no-repeat center;\r\n    }\r\n    #deleteSelected:before {\r\n        background: url(\"/adiJed/img/toolbar/delete.png\") no-repeat center;\r\n    }\r\n    #saveSearch:before {\r\n        background: url(\"/adiJed/img/toolbar/diskette.png\") no-repeat center;\r\n    }\r\n    #deleteSearch:before {\r\n        background: url(\"/adiJed/img/toolbar/delete.png\") no-repeat center;\r\n    }\r\n    #linkAllDocs:before {\r\n        background: url(\"/adiJed/img/toolbar/link.png\") no-repeat center;\r\n    }\r\n    #saveSearch.button-disabled {\r\n        opacity: .3;\r\n    }\r\n    #application-left-bar {\r\n        padding-top: 5px;\r\n        display: none;\r\n    }\r\n    #application-left-bar h4 {\r\n        font-size: 100%;\r\n    }\r\n    #application-left-bar h4 {\r\n        margin: 1px;\r\n    }\r\n    #documents {\r\n        display: block;\r\n        position: absolute;\r\n        top: 41px;\r\n        bottom: 0;\r\n        left: 0;\r\n        right: 0;\r\n        overflow: hidden;\r\n    }\r\n    #documents table {\r\n        position: relative;\r\n        /*width: 100%;*/\r\n        border-collapse: collapse;\r\n    }\r\n    #first-column-copy table {\r\n        width: 100%;\r\n    }\r\n    #documents > table {\r\n        margin-bottom: 100px;\r\n    }\r\n    #documents table thead {\r\n        background-color: #f8f8f8;\r\n        left: 0;\r\n    }\r\n    body#bd.smaller thead {\r\n        display: none;\r\n    }\r\n    #documents table thead tr th {\r\n        background-color: #f8f8f8;\r\n        border-bottom: #d3d3d3 1px solid;\r\n        border-right: 1px solid #ECECEC;\r\n        font-weight: bold;\r\n        min-width: 60px;\r\n        height: 30px;\r\n        max-height: 20px;\r\n        overflow-x: hidden;\r\n        overflow-y: hidden;\r\n        text-align: left;\r\n        padding: 2px 10px;\r\n        text-overflow: ellipsis;\r\n        position: relative;\r\n        white-space: nowrap;\r\n    }\r\n    #documents table thead tr th, .document-row td {\r\n        box-sizing: border-box;\r\n    }\r\n    #documents table tbody {\r\n    }\r\n    #documents table tbody tr td {\r\n        border-bottom: 1px solid #f5f5f5;\r\n        padding: 4px 10px;\r\n        border-left: 1px solid #d5d5d5;\r\n        overflow: hidden;\r\n    }\r\n    #documents.compact-view table tbody tr td {\r\n        padding: 0px 10px;\r\n    }\r\n    #documents table tbody tr td.family, #documents table thead tr th.head-th-1 {\r\n        border-left: 0;\r\n        /*overflow-style: panner;*/\r\n        box-sizing: initial;\r\n        overflow-x: hidden;\r\n        font-weight: bold;\r\n        min-width: 120px;\r\n        /*max-width: 180px;*/\r\n        position: relative;\r\n    }\r\n    #bd.smaller #documents table tbody tr td {\r\n        border: 0;\r\n    }\r\n    body#bd.smaller #documents table tbody tr td {\r\n        display: block;\r\n    }\r\n    body#bd.smaller #documents table tbody tr:nth-of-type(odd) td {\r\n        background-color: #f5f5f5;\r\n    }\r\n    body#bd.smaller #documents table tbody tr:nth-of-type(even) td {\r\n        background-color: #fff;\r\n    }\r\n    #documents table tbody tr td.icons .img-for-width, #documents table tbody tr td.icons, #documents table thead tr th.row-icons, #documents table thead tr th.row-icons .img-for-width {\r\n        max-width: 240px !important;/*TODO modificare in common.js per leggere e gestire questa proprietï¿½*/\r\n    }\r\n    #documents table tbody tr td.icons {\r\n        white-space: nowrap;\r\n        padding-left: 0;\r\n        padding-right: 0;\r\n    }\r\n    body#bd.smaller #documents table tbody tr td.family {\r\n        max-width: none;\r\n    }\r\n    td.family span.document-value {\r\n        padding-left: 3px;\r\n        text-decoration: underline;\r\n    }\r\n    #documents table tbody tr:hover {\r\n        cursor: pointer;\r\n    }\r\n    #documents table tbody tr.linked, #documents table tbody tr.rowSelected{\r\n        background-color: transparent !importan