0 4px 15px -5px black;\r\n    white-space: nowrap;\r\n}\r\n#bd.tablet #themeChooser {\r\n    margin-top: 0;\r\n}\r\n.theme-preview {\r\n    display: inline-block;\r\n    width: 56px;\r\n    height: 52px;\r\n    line-height: 52px;\r\n    margin-left: 20px;\r\n    margin-top: 20px;\r\n    position: relative;\r\n    font-weight: bold;\r\n    cursor: pointer;\r\n    overflow: hidden;\r\n    text-overflow: ellipsis;\r\n    text-align: center;\r\n    vertical-align: middle;\r\n    font-size: 110%;\r\n    white-space: nowrap;\r\n    border-radius: 50%;\r\n    opacity: .8;\r\n}\r\n.theme-preview:last-child {\r\n    margin-right: 20px;\r\n}\r\n.theme-preview-default {\r\n    border: 1px groove rgba(221, 221, 221, 0.80);\r\n}\r\n.theme-preview:hover {\r\n    opacity: 1;\r\n}\r\n#application-top-bar .toolbar-button.infoAdiuto {\r\n    background: url('/adiJed/img/toolbar/info_w_18.png') transparent no-repeat center;\r\n    background-size: 18px;\r\n    padding: 0;\r\n    height: 20px;\r\n    width: 20px;\r\n    display: inline-block;\r\n    margin: 0;\r\n    top: -2px;\r\n}\r\n#application-top-bar .toolbar-button.logout-action-button {\r\n    padding: 0;\r\n    padding-left: 30px;\r\n    padding-right: 5px;\r\n    margin: 0;\r\n    height: 20px;\r\n    display: inline-block;\r\n    line-height: 20px;\r\n    top: -2px;\r\n    background-position-y: -1px;\r\n}\r\nhtml.k-ie9 #infoAdiuto, html.k-ie9 #aboutAdiuto {\r\n    display: none;\r\n}\r\n#aboutAdiuto {\r\n    top: 70px;\r\n    bottom: 15px;\r\n    left: 15px;\r\n    right: 60px;\r\n}\r\n.logoAbout {\r\n    height:53px;\r\n    float: right;\r\n    margin-top: 18px;\r\n}\r\n.pinned-doc-col{\r\n    font-weight: bold;\r\n}\r\n.uppercase{\r\n    text-transform: uppercase;\r\n}\r\n.folderLocked > .folder-title{\r\n    background-color: #0000ff !important;\r\n}\r\n.fieldLabel{\r\n    padding:2px;\r\n    white-space: nowrap;\r\n}\r\n.fieldValue{\r\n    padding:2px;\r\n    white-space: nowrap;\r\n}\r\n#channelNotifiesContainer{\r\n    min-height: 50px;\r\n    max-width: 400px;\r\n    background-color: transparent;\r\n    position: absolute;\r\n    /*overflow-x: hidden;*/\r\n}\r\n#channelNotifiesBody{\r\n    padding: 2px;\r\n    min-height: 30px;\r\n    max-width: 400px;\r\n    max-height: 350px;\r\n    overflow-y: auto;\r\n    overflow-x: hidden;\r\n    background-color: rgba(0,0,0,0.8);\r\n    border-top-right-radius: 5px;\r\n    border-bottom-left-radius: 5px;\r\n    border-bottom-right-radius: 5px;\r\n    border-top-left-radius: 5px;\r\n    color: #ffffff;\r\n}\r\n#channelNotifiesTriangle{\r\n    height: 0px;\r\n    width: 0px;\r\n    line-height: 0px;\r\n    margin-left: 5px;\r\n    border-bottom: 6px solid rgba(0,0,0,0.8);\r\n    border-left: 8px solid transparent;\r\n    border-right: 8px solid transparent;\r\n}\r\n.channelNotify{\r\n    padding: 2px;\r\n    min-height: 30px;\r\n    width: 99%;\r\n    overflow-x: hidden;\r\n    box-sizing: border-box;\r\n    border: 1px solid transparent;\r\n    cursor: pointer;\r\n    padding: 5px;\r\n    margin: 3px;\r\n}\r\n.channelNotify:hover{\r\n    border: 1px solid white;\r\n}\r\n#news-channels{\r\n    position: absolute;\r\n    bottom: 30px;\r\n    left: 10px;\r\n    height: 50px;\r\n    right: 350px;\r\n    font-weight: bold;\r\n}\r\n.news-channel{\r\n    position: relative;\r\n    padding: 8px;\r\n    left: 0px;\r\n    right: 0px;\r\n    height: 100%;\r\n    box-shadow: 0px 0px 9px 0px rgba(31, 35, 31, 0.6);\r\n}\r\n.news-channel:hover{\r\n    cursor: pointer;\r\n}\r\n#news-preview{\r\n    overflow: auto !important;\r\n}\r\n.in-evidenza {\r\n\tfloat: none !important;\r\n}\r\n"
