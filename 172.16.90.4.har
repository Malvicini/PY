            "mimeType": "text/javascript",
            "compression": -1,
            "text": "var _evt_type = isTablet() ? \"tap\" : \"click\";\r\n\r\nfunction attachAttachSubReportEvents(atts, colnr)\r\n{\r\n    SubReportDiv.attachToIcon( atts, \"att\", function(subReportDiv, documentID) {\r\n        var dfd = new $.Deferred();\r\n\r\n        subReportDiv.load(\"/adiJed/ui/get-document-attachments.do\",\"id=\"+documentID+\"&type=list&style=full\", function(){\r\n            dfd.resolve();\r\n        });\r\n\r\n        return dfd;\r\n    });\r\n}\r\n\r\nfunction attachRevisionSubReportEvents(atts, colnr)\r\n{\r\n    SubReportDiv.attachToIcon( atts, \"rev\", function(subReportDiv, documentID) {\r\n        var dfd = new $.Deferred();\r\n\r\n        subReportDiv.load(\"/adiJed/ui/get-document-revisions.do\", \"id=\" + documentID + \"&type=list\", function () {\r\n            //Collego gli eventi\r\n            $(\"#selAllRevDoc\" + documentID).unbind(\"click\").click(function () {\r\n                if ($(this).is(\":checked\")) {\r\n                    subReportDiv.find(\"td.row-number > input[type=checkbox]:not(:checked)\").click();\r\n                } else {\r\n                    subReportDiv.find(\"td.row-number > input[type=checkbox]:checked\").click();\r\n                }\r\n            });\r\n\r\n            dfd.resolve();\r\n        });\r\n\r\n        return dfd;\r\n    });\r\n}\r\n\r\nfunction attachCommentsEvents(atts)\r\n{\r\n    var _comment_click = function(evt) {\r\n        evt.preventDefault();\r\n        if($(this).hasClass(\"icon-button\") && !$(this).closest(\"tr\").hasClass(\"deleted\")) {\r\n            var documentID = $(this).closest(\"tr\").attr(\"docid\");\r\n            showDocumentComments(documentID, 'Query documenti', -1, function(){});\r\n        }\r\n    };\r\n\r\n    atts.unbind(_evt_type).on(_evt_type, _comment_click);\r\n}\r\n\r\nfunction attachOtherActionsEvents(atts)\r\n{\r\n    var _other_actions_click = function(evt) {\r\n        evt.preventDefault();\r\n        if($(this).hasClass(\"icon-button\") && !$(this).closest(\"tr\").hasClass(\"deleted\")) {\r\n            var documentID = $(this).closest(\"tr\").attr(\"docid\");\r\n\t\t\tif($(\".report-others-menu-container.id\"+documentID).length === 0) {\r\n\t\t\t\tvar c = $(\"<div>\").appendTo($(this))\r\n\t\t\t\t\t\t.addClass(\"report-others-menu-container\")\r\n\t\t\t\t\t\t.addClass(\"id\"+documentID)\r\n\t\t\t\t\t\t.html(\"<div style=\\\"position: absolute;right: 38px;top: 6px;\\\"><img src=\\\"/adiJed/img/progress.gif\\\" /><div>\")\r\n\t\t\t\t\t\t.load(\"/adiJed/includes/document-menu-bar.do?currentPage=report&id=\"+documentID, function(){\r\n\t\t\t\t\t\t\tsetTimeout(function(){$(\".vertical-toolbar-\"+documentID).addClass(\"loaded\");}, 50);\r\n\t\t\t\t\t\t});\r\n\t\t\t\t\r\n\t\t\t\t$(document).bind(_up_evt_type+'.othersmenu'+documentID, {documentID: documentID}, function(e) {\r\n\t\t\t\t\tvar container = $(\".report-others-menu-container.id\"+e.data.documentID);\r\n\t\t\t\t\t// if the target of the click isn't the container nor a descendant of the container\r\n\t\t\t\t\tif (!container.is(e.target) && container.has(e.target).length === 0) {\r\n\t\t\t\t\t\t$(\".tooltip\").remove();\r\n\t\t\t\t\t\tcontainer.find(\".vertical-toolbar-\"+e.data.documentID).removeClass(\"loaded\");\r\n\t\t\t\t\t\tsetTimeout(function(){container.remove();}, 350);\r\n\t\t\t\t\t\t$(document).unbind(_up_evt_type+'.othersmenu'+e.data.documentID);\r\n\t\t\t\t\t}\r\n\t\t\t\t});\r\n\t\t\t}\r\n        }\r\n    };\r\n\r\n    atts.unbind(_evt_type).on(_evt_type, _other_actions_click);\r\n}\r\n\r\nfunction attachTrackSubReportEvents(lnks)\r\n{\r\n    SubReportDiv.attachToIcon( lnks, \"lnk\", function(subReportDiv, documentID) {\r\n        var dfd = new $.Deferred();\r\n\r\n        subReportDiv.load(\"/adiJed/ui/view-document-tracks.do\",\"id=\"+documentID+\"&type=track\", function(){\r\n            //Collego gli eventi\r\n            $(\"#selAllLinkDoc\"+documentID).unbind(\"click\").click(function(e){\r\n                if($(this).is(\":checked\")){\r\n                    subReportDiv.find(\"td.row-number > input[type=checkbox]:not(:checked)\").click();\r\n                }\r\n                else {\r\n                    subReportDiv.find(\"td.row-number > input[type=checkbox]:checked\").click();\r\n                }\r\n            });\r\n\r\n            attachIterTooltipEvents(subReportDiv);\r\n            attachHistoryEvents(subReportDiv);\r\n\r\n            dfd.resolve();\r\n        });\r\n\r\n        return dfd;\r\n    });\r\n}\r\n\r\nfunction attachLinkSubReportEvents(lnks)\r\n{\r\n    SubReportDiv.attachToIcon( lnks, \"lnk\", function(subReportDiv, documentID) {\r\n        var dfd = new $.Deferred();\r\n\r\n        subReportDiv.load(\"/adiJed/ui/get-document-links.do\",\"id=\"+documentID+\"&type=list\", function(){\r\n            //Collego gli eventi\r\n            $(\"#selAllLinkDoc\"+documentID).unbind(\"click\").click(function(e){\r\n                if($(this).is(\":checked\")){\r\n                    subReportDiv.find(\"td.row-number > input[type=checkbox]:not(:checked)\").click();\r\n                }\r\n                else {\r\n                    subReportDiv.find(\"td.row-number > input[type=checkbox]:checked\").click();\r\n                }\r\n            });\r\n\r\n            attachIterTooltipEvents(subReportDiv);\r\n            attachHistoryEvents(subReportDiv);\r\n            let hasHorizontalScrollbar= subReportDiv.outerWidth(true)>subReportDiv[0].clientWidth;\r\n\r\n            if(hasHorizontalScrollbar==true){\r\n                let theadEl = subReportDiv.find(\".documents-links-table thead\");\r\n                let documentsContainer = subReportDiv.closest(\".documents-table-scroll\");\r\n                let tableScrollOffset = $(documentsContainer[0]).offset();\r\n                let subReportDivOffset = subReportDiv.offset();\r\n                let leftSpace = (subReportDivOffset.left+20) - tableScrollOffset.left;\r\n\r\n                if(theadEl && (theadEl.width()+1)<=(documentsContainer.width()-50)){\r\n                    $(subReportDiv[0].parentElement).css(\"max-width\", theadEl.width()+1);\r\n                }else{\r\n                    $(subReportDiv[0].parentElement).css(\"max-width\", documentsContainer.width()-leftSpace);\r\n                }\r\n\r\n            }\r\n\r\n            dfd.resolve();\r\n        });\r\n\r\n        return dfd;\r\n    });\r\n}\r\n\r\nfunction attachHistoryEvents(container){\r\n    var _container = container || $('.documents-table-scroll');\r\n    _container.off('click.showHistory','.historySubRpt').on('click.showHistory','.historySubRpt',function(event){\r\n        event.preventDefault();\r\n        event.stopPropagation();\r\n        var _icon = $(this);\r\n        var docid = _icon.closest(\"tr\").attr(\"docid\");\r\n        if(!_icon.closest(\"tr\").hasClass(\"deleted\")) {\r\n            showWorkflowHistory(docid);\r\n        }\r\n    });\r\n}\r\n\r\nfunction attachIterTooltipEvents(container)\r\n{\r\n    var _container = container || $('.documents-table-scroll');\r\n    _container.off('click.showWfStatus','.itttip').on('click.showWfStatus','.itttip',function(event){\r\n        event.preventDefault();\r\n        event.stopPropagation();\r\n        if(!$(this).closest(\"tr\").hasClass(\"deleted\")) {\r\n            var _icon = $(this);\r\n            var iid = _icon.attr(\"itactid\");\r\n            var docid = _icon.closest(\"tr\").attr(\"docid\");\r\n\r\n            $.removeData(_icon, \"iterInfoAjax\");\r\n            var toRemove = $(\".iterActionInfoTooltip\");\r\n            setTimeout(function(){ try {toRemove.remove();} catch(e){} }, 150);\r\n\r\n            var _span = $(\"<span>\")\r\n                .addClass(\"iterActionInfoTooltipContainer\")\r\n                .mouseleave(function() {\r\n                    _icon.removeAttr(\"__hover_disabled\");\r\n\r\n                    if( $.data(_icon, \"iterInfoAjax\") ) {\r\n                        $.data(_icon, \"iterInfoAjax\").cancel();\r\n                    }\r\n                    $(this).fadeOut();\r\n                })\r\n                .on(_evt_type, function(){$(this).remove();})\r\n                .css({left: _icon.position().left + 30, top: Math.max(_icon.position().top - 40, _icon.closest(\"div\").scrollTop())})\r\n                .appendTo(_icon.closest(\"div\"));\r\n\r\n            $.data(_icon, \"iterInfoAjax\", $.ajax({\r\n                url: \"/adiJed/ui/get-iter-info.do\",\r\n                data: \"iid=\"+iid+\"&docid=\"+docid,\r\n                success: function(result) {\r\n                    $.removeData(_icon, \"iterInfoAjax\");\r\n                    var toRemove = $(\".iterActionInfoTooltip\");\r\n                    setTimeout(function(){ try {toRemove.remove();} catch(e){} }, 150);\r\n\r\n                    var workflowStatus = result[\"t\"];\r\n                    var desc;\r\n                    if(workflowStatus == \"A\") {\r\n                        desc = LangManager.get(\"ui.get.iter.info.command.current.action\", result[\"d\"], result[\"r\"]);\r\n                    } else if(workflowStatus == \"U\") {\r\n                        desc = LangManager.get(\"ui.get.iter.info.command.current.action.updating\", result[\"d\"]);\r\n                    } else if(workflowStatus == \"E\") {\r\n                        desc = LangManager.get(\"ui.get.iter.info.workflow.ended\");\r\n                    }\r\n\r\n                    _span.html(\r\n                            '<div class=\"iterActionInfoTooltip\">' +\r\n                                '<span class=\"workflow-tooltip-body\">'+desc+'</span>' +\r\n                                '</div>'\r\n                        ).fadeIn();\r\n                }\r\n            }));\r\n        }\r\n    });\r\n}\r\n\r\nfunction attachDetailsSubReportEvents(lnks, colnr)\r\n{\r\n    SubReportDiv.attachToIcon( lnks, \"det\", function(subReportDiv, documentID) {\r\n        var dfd = new $.Deferred();\r\n\r\n        subReportDiv.load(\"/adiJed/ui/get-document-details-list.do\", \"id=\" + documentID, function () {\r\n            //Collego gli eventi\r\n/*            $(\"#selAllLinkDoc\" + documentID).unbind(\"click\").click(function () {\r\n                if ($(this).is(\":checked\")) {\r\n                    subReportDiv.find(\"td.row-number > input[type=checkbox]:not(:checked)\").click();\r\n                }\r\n                else {\r\n                    subReportDiv.find(\"td.row-number > input[type=checkbox]:checked\").click();\r\n                }\r\n            });*/\r\n\r\n            dfd.resolve();\r\n        });\r\n/*        subReportDiv.load(\"/adiJed/ui/get-document-details.do\", \"id=\" + documentID + \"&type=list\", function () {\r\n            //Collego gli eventi\r\n            $(\"#selAllLinkDoc\" + documentID).unbind(\"click\").click(function () {\r\n                if ($(this).is(\":checked\")) {\r\n                    subReportDiv.find(\"td.row-number > input[type=checkbox]:not(:checked)\").click();\r\n                }\r\n                else {\r\n                    subReportDiv.find(\"td.row-number > input[type=checkbox]:checked\").click();\r\n                }\r\n            });\r\n\r\n            dfd.resolve();\r\n        });*/\r\n\r\n        return dfd;\r\n    });\r\n}\r\n\r\nfunction setTitleOnDocumentValues()\r\n{\r\n    $(\"#documents\").on('mouseover', \".document-value\", function() {\r\n        var _this = $(this);\r\n        if(_this.attr(\"title\") === undefined || _this.attr(\"title\") == \"\") {\r\n            _this.attr(\"title\", _this.text());\r\n        }\r\n        _this.unbind('mouseover');\r\n    });\r\n}\r\n\r\nvar subReportUnique = window.subReportUnique = window.subReportUnique||1;\r\n\r\nvar SubReportDiv = window.SubReportDiv || (function SubReportDiv(_icon, _type, _documentID, _clickEvent) {\r\n    var that = this;\r\n\r\n    var subReport   = null,\r\n        obj         = _icon,\r\n        type        = _type,\r\n        documentID  = _documentID,\r\n        clickEvent  = _clickEvent;\r\n\r\n    var visible     = false;\r\n\r\n    /**\r\n     * Crea un contenitore per un sottoreport del tipo specificato.\r\n     *\r\n     * TODO aggiungere la creazione degli eventi e il caricamento del report\r\n     *\r\n     * @param obj\r\n     * @param divId\r\n     * @param divClass\r\n     * @param documentID\r\n     * @param lbl\r\n     * @returns {*|jQuery}\r\n     */\r\n    function createSubReportDiv(){\r\n        return (\r\n            $('<div style=\"padding:0;z-index:10;left:60px;margin: 0 0 100px;position:absolute;background-color:white;\" id=\"'+type+'SubRptRow'+documentID+'parent\">' +\r\n                '<div class=\"'+type+'SubRptContainer SubRptContainer\" style=\"box-shadow: 1px 1px 5px 5px rgba(154, 154, 154, 0.45);\" id=\"'+type+'SubRptRow'+documentID+'\">' +\r\n                    '<span style=\"padding: 20px; line-height: 20px;\"><img src=\"/adiJed/img/progress.gif\"/> '+LangManager.get(\"ui.js.loading.in.progress\")+'</span>' +\r\n                '</div>'+\r\n                '</div>')\r\n                .css({\r\n                    \"z-index\": 99,\r\n                    position: \"absolute\",\r\n                    top: $(obj).position().top + 40,\r\n                    left: 40,\r\n                    \"max-width\": $(obj).closest(\"tr\").attr(\"parentdocid\")!=$(obj).closest(\"tr\").attr(\"docid\") ? $(obj).closest(\"div.SubRptContainer\").width() : $(obj).closest(\".documents-table-scroll\").width()\r\n                }).appendTo($(obj).closest(\"tr\").attr(\"parentdocid\")!=$(obj).closest(\"tr\").attr(\"docid\") ? $(obj).closest(\"span#linked-document-list\") : $(obj).closest(\"table\"))\r\n        ).find(\"> div\").last();\r\n    }\r\n\r\n    function refreshIScrollInstance(){\r\n        if (isTablet()) {\r\n            $(\".header-copy\").data(\"iscroll-instance\").refresh();\r\n        }\r\n    }\r\n\r\n    function hideSubReport(){\r\n        that.subReport.parent().transition({opacity: 0, scale: 1.6}, function() {\r\n            this.remove();\r\n            refreshIScrollInstance();\r\n        });\r\n    }\r\n\r\n    function isVisible() {\r\n        return that.visible;\r\n    }\r\n\r\n    function hideDifferentReportForTheSameRow($tr) {\r\n        if(SubReportDiv.openReportForDocument && SubReportDiv.openReportForDocument[$tr.attr(\"subReportUnique\")]) {\r\n            if( SubReportDiv.openReportForDocument[$tr.attr(\"subReportUnique\")].type != _type ) {\r\n                SubReportDiv.openReportForDocument[$tr.attr(\"subReportUnique\")].reportObject.hide();\r\n            }\r\n        }\r\n    }\r\n\r\n    function display() {\r\n        var $tr = $(obj).closest(\"tr\");\r\n        if( !$tr.attr(\"subReportUnique\") ) {\r\n            $tr.attr(\"subReportUnique\", (subReportUnique));\r\n            subReportUnique = subReportUnique+1;\r\n        }\r\n        hideDifferentReportForTheSameRow.call(that, $tr);\r\n\r\n        that.subReport = createSubReportDiv.apply(that);\r\n        that.subReport.click(function(e){e.stopPropagation();});\r\n\r\n        clickEvent(that.subReport, documentID).then(refreshIScrollInstance);\r\n\r\n        $(obj).addClass('open');\r\n        that.visible = true;\r\n\r\n        SubReportDiv.setOpenReportForDocument(documentID, _type, that, $tr);\r\n    }\r\n\r\n    function hide() {\r\n        hideSubReport();\r\n\r\n        $(obj).removeClass('open');\r\n        that.visible = false;\r\n    }\r\n\r\n    obj.unbind(_evt_type).on(_evt_type, function(e) {\r\n        e.preventDefault();\r\n        if( !isVisible() ) {\r\n            display();\r\n        } else {\r\n            hide();\r\n        }\r\n    });\r\n\r\n    $.extend(that, {\r\n        isVisible: isVisible,\r\n        display: display,\r\n        hide: hide\r\n    });\r\n\r\n    return that;\r\n});\r\n\r\nSubReportDiv.setOpenReportForDocument = function(id, type, subr, $tr) {\r\n    if(!SubReportDiv.openReportForDocument) {\r\n        SubReportDiv.openReportForDocument = {};\r\n    }\r\n\r\n    SubReportDiv.openReportForDocument[$tr.attr(\"subReportUnique\")] = {\r\n        type: type, reportObject: subr, tr: $tr\r\n    };\r\n};\r\n\r\nSubReportDiv.attachToIcon = function(iconObj, type, callback) {\r\n    if( !iconObj )\r\n        return;\r\n\r\n    $(iconObj).each(function(i, el){\r\n        if( $(\"#\"+type+\"SubRptRow\"+$(el).attr(\"docid\")).length ) {\r\n            $(el).css(\"opacity\", \".5\").attr(\"title\", LangManager.get(\"report.already.shown.links\")).removeClass(\"icon-button\");\r\n        }\r\n    });\r\n\r\n    $(iconObj).unbind(_evt_type).one(_evt_type, function(evt) {\r\n        evt.preventDefault();\r\n\r\n        if( $(this).hasClass(\"icon-button\") && !$(this).closest(\"tr\").hasClass(\"deleted\") ) {\r\n            var $this = $(this);\r\n            var docID = $this.closest(\"tr\").attr(\"docid\");\r\n            var subRptRowExist = false;\r\n            // se ho già aperto lo stesso report non lo rifaccio aprire all'infinito, es. collegati\r\n            //Verifico se la finestra di subreport è già presente\r\n            if( $(\"#\"+type+\"SubRptRow\"+docID).length != 0 ) {\r\n                subRptRowExist = true;\r\n            }\r\n            var subr  = new SubReportDiv($this, type, docID, callback);\r\n            if (subRptRowExist){\r\n                $(\"#\"+type+\"SubRptRow\"+docID+\"parent\").transition({opacity: 0, scale: 1.6}, function() {\r\n                    this.remove();\r\n                    $this.removeClass('open');\r\n                });\r\n            }else{\r\n                subr.display();\r\n            }\r\n        }\r\n    });\r\n};\r\n\r\nvar reportSettings = migrateReportColumnsSettings(AdiutoUserSettings.load(\"reportColumnsSettings\", {}));\r\n\r\n/**\r\n * Migra le impostazioni delle query, da versioni precedenti alla 6.7.1\r\n * @param reportSettings\r\n */\r\nfunction migrateReportColumnsSettings(reportSettings) {\r\n    if(reportSettings !== null) {\r\n        if(!reportSettings[\"updatedFieldsPrefix\"]) {\r\n            console.debug(\"Migrazione configurazione report utente da versione precedente\");\r\n            var reportSettingsCopy = $.extend({}, reportSettings);\r\n            for (let queryHashKey in reportSettingsCopy) {\r\n                var queryReportConfig = reportSettingsCopy[queryHashKey];\r\n                prefixFieldsIdInObject(queryReportConfig[\"hiddenFields\"]);\r\n                prefixFieldsIdInObject(queryReportConfig[\"colOrder\"]);\r\n                prefixFieldsIdInObject(queryReportConfig[\"colSize\"]);\r\n            }\r\n\r\n            reportSettingsCopy[\"updatedFieldsPrefix\"] = true;\r\n\r\n            reportSettings = reportSettingsCopy;\r\n        }\r\n    }\r\n\r\n    return reportSettings;\r\n}\r\nfunction prefixFieldsIdInObject(configObject) {\r\n    if(configObject) {\r\n        for (let fieldIdKey in configObject) {\r\n            if (fieldIdShouldBeConverted(fieldIdKey, configObject)) {\r\n                if($.isArray(configObject)) {\r\n                    configObject[fieldIdKey] = \"F\" + configObject[fieldIdKey];\r\n                } else {\r\n                    configObject[\"F\" + fieldIdKey] = configObject[fieldIdKey];\r\n                    delete configObject[fieldIdKey];\r\n                }\r\n            }\r\n        }\r\n    }\r\n}\r\nfunction fieldIdShouldBeConverted(fieldIdKey, configObject) {\r\n    // come chiave può esserci 11 oppure \"11\", entrambe vanno considerate come id campo\r\n    // se è un intero, ma negativo sono le colonne tipo \"descrizione attività\" ecc.\r\n    const fieldId = $.isArray(configObject) ? configObject[fieldIdKey] : fieldIdKey;\r\n    return ((Number.isInteger(fieldId) && fieldId > 0) || (!Number.isInteger(fieldId) && !isNaN(parseInt(fieldId)) && parseInt(fieldId) > 0))\r\n        && !configObject.hasOwnProperty(\"F\" + fieldId)\r\n        && !configObject.hasOwnProperty(\"DF\" + fieldId);\r\n}\r\nfunction saveHiddenColumnForReport(queryUID, fieldRegID, visible, _fieldPrefix) {\r\n    const fieldPrefix = _fieldPrefix ? _fieldPrefix : \"\";\r\n    var querySettings = reportSettings[queryUID] || {};\r\n    var hiddenFields = querySettings[\"hiddenFields\"] || {};\r\n\r\n    if( !visible ) {\r\n        //setto lo stato del campo fieldRegID a 'H' (nascosto) per il report corrente\r\n        hiddenFields[fieldPrefix+fieldRegID] = \"H\";\r\n    } else {\r\n        delete hiddenFields[fieldPrefix+fieldRegID];\r\n    }\r\n\r\n    querySettings[\"hiddenFields\"] = hiddenFields;\r\n    reportSettings[queryUID] = querySettings;\r\n\r\n    AdiutoUserSettings.save(\"reportColumnsSettings\", reportSettings);\r\n}\r\nfunction saveReportStyle(style) {\r\n    var generalReportSettings = reportSettings[\"generalSettings\"] || {};\r\n    generalReportSettings[\"reportViewStyle\"] = style;\r\n    reportSettings[\"generalSettings\"] = generalReportSettings;\r\n\r\n    AdiutoUserSettings.save(\"reportColumnsSettings\", reportSettings);\r\n}\r\nfunction getReportStyle() {\r\n    var generalReportSettings = reportSettings[\"generalSettings\"] || {};\r\n    return generalReportSettings[\"reportViewStyle\"] || \"\";\r\n}\r\nfunction hideColumnInReport(_fieldPrefix, fieldRegID) {\r\n    var fieldPrefix = _fieldPrefix || \"\";\r\n    $(\".documents-table td.\"+fieldPrefix+fieldRegID).css(\"display\", \"none\");\r\n    $(\"th[fieldRegID=\"+fieldRegID+\"][fieldPrefix=\"+fieldPrefix+\"]\").css(\"display\", \"none\");\r\n}\r\nfunction showColumnInReport(_fieldPrefix, fieldRegID) {\r\n    var fieldPrefix = _fieldPrefix || \"\";\r\n    $(\".documents-table td.\"+fieldPrefix+fieldRegID).css(\"display\", \"table-cell\");\r\n    $(\"th[fieldRegID=\"+fieldRegID+\"][fieldPrefix=\"+fieldPrefix+\"]\").css(\"display\", \"table-cell\");\r\n}\r\n\r\nfunction resizeFieldForReport(queryUID, fieldRegID, newSize, _fieldPrefix) {\r\n    const fieldPrefix = _fieldPrefix ? _fieldPrefix : \"\";\r\n    var querySettings = reportSettings[queryUID] || {};\r\n    var colSize = querySettings[\"colSize\"] || {};\r\n\r\n    //setto lo stato del campo fieldRegID a 'H' (nascosto) per il report corrente\r\n    colSize[fieldPrefix+fieldRegID] = newSize;\r\n    querySettings[\"colSize\"] = colSize;\r\n    reportSettings[queryUID] = querySettings;\r\n\r\n    AdiutoUserSettings.save(\"reportColumnsSettings\", reportSettings);\r\n}\r\n\r\nfunction getHiddenFieldsForReport(queryUID) {\r\n    var querySettings = reportSettings[queryUID] || {};\r\n    return querySettings[\"hiddenFields\"] || {};\r\n}\r\n\r\nfunction getColumnsSizeForReport(queryUID) {\r\n    var querySettings = reportSettings[queryUID] || {};\r\n    return querySettings[\"colSize\"] || {};\r\n}\r\n\r\nfunction getColumnsOrderForReport(queryUID) {\r\n    var querySettings = reportSettings[queryUID] || {};\r\n    return querySettings[\"colOrder\"] || null;\r\n}\r\n\r\nfunction saveFieldsOrderToConfig(queryUID, fieldsOrder) {\r\n    var querySettings = reportSettings[queryUID] || {};\r\n    querySettings[\"colOrder\"] = fieldsOrder;\r\n\r\n    reportSettings[queryUID] = querySettings;\r\n\r\n    AdiutoUserSettings.save(\"reportColumnsSettings\", reportSettings);\r\n}\r\nfunction showReportConfigWindow(canReorder) {\r\n    var canReorderParam = canReorder || false;\r\n    openWindow(\r\n        'report-config',\r\n        '/adiJed/ui/query/report-config.jsp?queryUID='+queryUID+'&canReorder='+canReorderParam,\r\n        {\"width\": \"400px\", \"height\": \"75%\", \"title\": \"\", \"modal\": true, \"resizable\": false, \"Maximize\": false},\r\n        function() {\r\n            HistoryManager.reloadLastPage();\r\n        }\r\n    );\r\n}\r\n//# sourceURL=/adiJed/js/ui/report-common.js"
