or: #e8e8e8 !important;\r\n\t}\r\n</style>\r\n\r\n<script type=\"text/javascript\" src=\"/adiJed/js/ui/report-common.js\"/>\r\n\r\n<script type=\"text/javascript\">\r\n    createCustomEvent(\"onRowSelectionChanged\");\r\n</script>\r\n\r\n\r\n\r\n\r\n        \r\n            <div id=\"plugin1766499175824_2\" class=\"plugin report-plugin\" style=\"display:none;\"></div>\r\n        \r\n        \r\n        \r\n            <link rel=\"stylesheet\" href=\"/adiJed/workfolder/SystemFiles/1001/Plugins/Report-Colors/report-colors2.css\"/>\r\n        \r\n    \r\n\r\n\r\n\r\n<script type=\"text/javascript\">AdiPlugin.prototype.getCurrentDocumentInfo = function(){return ADA.getDocumentInfo();};</script>\r\n<script type=\"text/javascript\">AdiPlugin.prototype.getDocumentInfo = function(fidd){return ADA.getDocumentInfo(fidd);};</script>\r\n\r\n    \r\n<script type=\"text/javascript\">\r\n    $(\"#plugin1766499175824_2\").data(\"__adi_plugin\", (function() {\r\n        /**\n * Viene richiamata da Adiuto per inizializzare il plugin\n * N.B. viene chiamata tutte le volte che il plugin viene mostrato a video\n *\n * @returns Ritorna un'istanza di AdiPlugin\n */\nfunction init()\n{\n    var myPlugin = AdiPlugin.getNew();\n\n\tmyPlugin.setAction(function(tr,doc){\n\tif(doc.f == 1134) \n\t\t{\n            for(var i=0; i<doc.v.length; i++) {\n                if(doc.v[i][0]==1109) {\n                    if(doc.v[i][1] == \"OBSOLETO\") {\n                        $(tr).find(\"td.F1109\").addClass(\"rosso\");\n                    } \n                    break;\n                }\n            }\n        }\n\t\t\n\tif(doc.f == 1136) {\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t//famiglia da considerare\n            for(var i=0; i<doc.v.length; i++) {\t\t\t\t\t\t\t\t\t\t\t\t\t\n                if(doc.v[i][0]==1158) {\t\t\t\t\t\t\t\t\t\t\t\t\t\t//campo da analizzare\n                    if(doc.v[i][1] == \"CONSEGNATA CON IMPOSSIBILITA` DI RECAPITO\") {\t\t//campo da colorare\n                        $(tr).find(\"td.F1158\").addClass(\"verde\");\n                    } \n                    if(doc.v[i][1] == \"EMESSA\") {\n                        $(tr).find(\"td.F1158\").addClass(\"giallo\");\t\t\t\t\t\t\t//campo da colorare\n                    } \t\t\t\t\t\n                    if(doc.v[i][1] == \"SCARTATA\") {\n                        $(tr).find(\"td.F1158\").addClass(\"rosso\");\t\t\t\t\t\t\t//campo da colorare\n                    } \t\t\t\t\t\n                    if(doc.v[i][1] == \"CONSEGNATA\") {\n                        $(tr).find(\"td.F1158\").addClass(\"verde\");\t\t\t\t\t\t\t//campo da colorare\n                    } \n                    break;\n                }\n\t\t\t\n            }\n        }\n\t\t\n\tif(doc.f == 1005) {\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t//famiglia da considerare\n            for(var i=0; i<doc.v.length; i++) {\t\t\t\t\t\t\t\t\t\t\t\t\t\n                if(doc.v[i][0]==1175) {\t\t\t\t\t\t\t\t\t\t\t\t\t\t//campo da analizzare\n                    if(doc.v[i][1] == \"SI\") {\t\t//campo da colorare\n\t\t\t\t\t\tfor(var j=0; j<doc.v.length; j++) {\n\t\t\t\t\t\t\tif(doc.v[j][0]==1171) {\t\t\t\t\t\t\t\t\t\t\t\t\t\t//campo da analizzare\n\t\t\t\t\t\t\t\tif(doc.v[j][1].indexOf(\"2020\") > 0 ) {\n\t\t\t\t\t\t\t\t\t$(tr).find(\"td.F1171\").addClass(\"salmone\");\n\t\t\t\t\t\t\t\t\t\t\t\t                    }}    \n} } \t\t\t\t\t\n                    break;\n                }\n\t\t\t\n            }\n        }\t\n\t\t\n\t});\n\n\treturn myPlugin;\n}\n\r\n        return init($(\"#plugin1766499175824_2\"));\r\n    })());\r\n    //# sourceURL=http://172.16.90.4:8080/adiJed/Plugins/Report-Colors/plugin.js\r\n</script>\r\n\r\n\r\n\r\n\r\n<div id=\"application-left-bar\">\r\n\r\n</div>\r\n<div id=\"content\">\r\n    \r\n    \r\n        \r\n        \r\n            \r\n        \r\n    \r\n    <div id=\"search-toolbar\" class=\"ad-toolbar fit-to-screen\">\r\n        <ul>\r\n            <li class=\"split-toolbar small\">\r\n                <ul>                