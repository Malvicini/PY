          "content": {
            "size": 14365,
            "mimeType": "text/javascript",
            "compression": -1,
            "text": "// richiede jquery e common.js\r\n(function(wnd) {\r\n    var AdiutoDatabaseAccess = function() {\r\n        var commandCall = function(command, params, async) {\r\n            var defaults = {\r\n                type: \"POST\",\r\n                data: {},\r\n                dataType: \"json\",\r\n                async: arguments.length === 3 ? async : true,\r\n                doneCallback: function(result) {},\r\n                errorCallback: function(result) {\r\n                    var msg = result[\"message\"]||LangManager.get(\"ui.js.error.generic\");\r\n                    showErrorMessage(msg);\r\n                }\r\n            };\r\n\r\n            var opts = $.extend({}, defaults, params);\r\n            opts[\"url\"] = \"/adiJed/ui/\"+command+\".do\";\r\n            var res = null;\r\n            $.ajax(opts).done(function(result){\r\n                if(result[\"ok\"]) {\r\n                    opts.doneCallback.call(this, result);\r\n                    res = result;\r\n                } else if(result[\"error\"]) {\r\n                    opts.errorCallback.call(this, result);\r\n                }\r\n            });\r\n            return res;\r\n        };\r\n        this.storeUserSettings = function(val)\r\n        {\r\n            // per ora salva solo per l'utente corrente\r\n            commandCall.call( this, \"save-settings\", { data: {\"action\": \"store\", \"val\": JSON.stringify(val)} } );\r\n        };\r\n        this.loadUserSettings = function(callback)\r\n        {\r\n            // per ora salva solo per l'utente corrente\r\n            commandCall.call( this, \"save-settings\", { data: {\"action\": \"load\"}, doneCallback: callback } );\r\n        };\r\n        this.saveSettings = function(attr,val)\r\n        {\r\n            // per ora salva solo per l'utente corrente\r\n            commandCall.call( this, \"save-settings\", { data: {\"attr\": attr, \"val\": JSON.stringify(val), \"target\": \"cu\"} } );\r\n        };\r\n        this.deleteSettings = function(attr, async)\r\n        {\r\n            // per ora salva solo per l'utente corrente\r\n            commandCall.call( this, \"save-settings\", { data: {\"attr\": attr, \"target\": \"cu\", \"action\": \"del\"} }, async );\r\n        };\r\n        this.loadSettings = function(attr, callback, target)\r\n        {\r\n            return commandCall.call( this, \"load-settings\", { async: false, doneCallback: callback, data: {\"attr\": attr, \"target\": target||\"us\"} }, false );\r\n        };\r\n        this.assignTasso = function(pk, kind, id, val, action)\r\n        {\r\n            commandCall.call( this, \"save-settings\", {data:{\"attr\":\"assigned-vq\", action:action||\"del+add\", \"val\":pk, \"target\":kind, \"id\":id}}, false );\r\n        };\r\n        this.getTassoAssignement = function(pk, kind, id)\r\n        {\r\n            return commandCall.call( this, \"load-settings\", { async: false, data: {\"pk\": pk, \"kind\": kind, \"id\": id} }, false );\r\n        };\r\n        this.tassoInHomepage = function(pk, kind, to, action)\r\n        {\r\n            commandCall.call( this, \"save-settings\", { data: {\"attr\": \"pinned-vq\", \"val\": pk, \"action\": action||\"del+add\", \"target\": kind, \"id\": to} } );\r\n        };\r\n        this.pinDoc = function(id, pin, icon)\r\n        {\r\n            commandCall.call( this, \"pin-doc\", {\r\n                    data: {\"id\": id, \"pin\": pin},\r\n                    doneCallback: function(result){\r\n                        if(result[\"ok\"]) {\r\n                            if(pin) {\r\n                                icon.addClass(\"pinned\");\r\n                                icon.attr(\"pinned\", \"true\");\r\n                            } else {\r\n                                icon.removeClass(\"pinned\");\r\n                                icon.attr(\"pinned\", \"false\");\r\n                            }\r\n                        }\r\n                    }\r\n                }\r\n            );\r\n        };\r\n        this.createFolder = function(name, callback)\r\n        {\r\n            $.ajax({\r\n                type: \"POST\",\r\n                url: \"/adiJed/ui/folders-action.do\",\r\n                dataType: 'json',\r\n                data: \"action=\"+1+\"&name=\"+name\r\n            }).done(function(result){\r\n                if(result[\"ok\"]) {\r\n                    console.log(\"created folder with id:\"+result[\"folderID\"])\r\n                    callback.call(this, result[\"folderID\"]);\r\n                } else if (result[\"error\"]) {\r\n                    var msg = result[\"message\"]||LangManager.get(\"ui.js.error.generic\");\r\n                    showErrorMessage(msg);\r\n                }\r\n            });\r\n        };\r\n        this.addToFolder = function(idFolder,idDocument)\r\n        {\r\n            $.ajax({\r\n                type: \"POST\",\r\n                url: \"/adiJed/ui/folders-action.do\",\r\n                dataType: \"json\",\r\n                data: \"action=\"+3+\"&idf=\"+idFolder+\"&idd=\"+idDocument\r\n            }).done(function(result){\r\n                if(result[\"ok\"]) {\r\n                    /* ok */\r\n                } else if (result[\"error\"]) {\r\n                    var msg = result[\"message\"]||LangManager.get(\"ui.js.error.generic\");\r\n                    showErrorMessage(msg);\r\n                }\r\n            });\r\n        };\r\n        this.deleteDocMulti = function(id,okCallback,errorCallback)\r\n        {\r\n            $.ajax({\r\n                type: \"POST\",\r\n                url: \"/adiJed/ui/delete-doc.do\",\r\n                dataType: 'json',\r\n                data: \"ids=\"+id\r\n            }).done(function(result){\r\n                if(result[\"ok\"]) {\r\n                    var documentsId = id.split(\",\");\r\n                    for(var y=0; y<documentsId.length; y++) {\r\n                        var id = documentsId[y];\r\n                        var d = AdiutoCacheStore.retrieve(\"*\",\"d\"+id);\r\n                        if(d && d.length) {\r\n                            for(var i=0; i<d.length; i++) {\r\n                                d[i].del = true;\r\n                            }\r\n                        } else if(d) {\r\n                            d.del = true;\r\n                        }\r\n                    }\r\n                    showMessage(LangManager.get(\"ui.js.delete.doc.successful\"), \"alert\", \"topCenter\", 1000, false); //\"Documento cancellato correttamente\"\r\n                    if(okCallback) okCallback();\r\n                } else if (result[\"error\"]) {\r\n                    var msg = result[\"message\"]||LangManager.get(\"ui.js.error.generic\"); //\"Si � verificato un errore.\"\r\n                    showErrorMessage(msg);\r\n                    if(errorCallback) errorCallback();\r\n                }\r\n            });\r\n        };\r\n\r\n        /**\r\n         *\r\n         * @param {int} id\r\n         * @param {string} errorMessage\r\n         * @constructor\r\n         */\r\n        function DeleteDocErrorData(id, errorMessage) {\r\n            this.id = id;\r\n            this.errorMessage = errorMessage;\r\n        }\r\n        DeleteDocErrorData.prototype.getId = function () {\r\n            return this.id;\r\n        };\r\n        DeleteDocErrorData.prototype.getErrorMessage = function () {\r\n            return this.id;\r\n        };\r\n\r\n        /**\r\n         *\r\n         * @param {int} id\r\n         * @param {Function} ok - Callback richiamata al termine dell'esecuzione, se il documento è stato correttamente eliminato\r\n         * @param {Function} errorCallback - Callback richiamata in caso di errore. Viene passato un oggetto di tipo {@see DeleteDocErrorData}\r\n         * @returns void\r\n         */\r\n        this.deleteDoc = function(id,ok,errorCallback)\r\n        {\r\n            $.ajax({\r\n                type: \"POST\",\r\n                url: \"/adiJed/ui/delete-doc.do\",\r\n                dataType: 'json',\r\n                data: \"id=\"+id\r\n            }).done(function(result){\r\n                if(result[\"ok\"]) {\r\n                    setDocumentDeletedStatusInCache(id);\r\n                    showMessage(LangManager.get(\"ui.js.delete.doc.successful\"), \"alert\", \"topCenter\", 1000, false); //\"Documento cancellato correttamente\"\r\n                    if(ok) ok();\r\n                } else if (result[\"error\"]) {\r\n                    var msg = result[\"message\"]||LangManager.get(\"ui.js.error.generic\");\r\n\r\n                    if(errorCallback) {\r\n                        errorCallback(new DeleteDocErrorData(id, msg));\r\n                    } else {\r\n                        showErrorMessage(msg);\r\n                    }\r\n                }\r\n            });\r\n        };\r\n\r\n        this.deleteDocs = function(ids,ok)\r\n        {\r\n            var msg = \"\";\r\n            $.each(ids, function (i,docId) {\r\n                $.ajax({\r\n                    type: \"POST\",\r\n                    url: \"/adiJed/ui/delete-doc.do\",\r\n                    dataType: 'json',\r\n                    data: \"id=\"+docId,\r\n                    async: false,\r\n                    errorBehaviour: ErrorBehaviour.DO_NOTHING\r\n                }).done(function(result){\r\n                    if (result[\"error\"]) {\r\n                        if(msg==\"\"){\r\n                            msg = result[\"message\"]||LangManager.get(\"ui.js.error.generic\");\r\n                        }else{\r\n                            msg += \"<BR>\"+result[\"message\"]||LangManager.get(\"ui.js.error.generic\");\r\n                        }\r\n                    } else {\r\n                        debugger;\r\n                        setDocumentDeletedStatusInCache(docId);\r\n                    }\r\n                });\r\n            });\r\n\r\n            if(msg!=\"\")\r\n                showErrorMessage(msg);\r\n\r\n            if(ok){\r\n                ok();\r\n            }\r\n        };\r\n        this.deleteAttachment = function(documentID,attachmentID,ok)\r\n        {\r\n            $.ajax({\r\n                type: \"POST\",\r\n                url: \"/adiJed/ui/delete-att.do\",\r\n                dataType: 'json',\r\n                data: \"id=\"+documentID+\"&attid=\"+attachmentID\r\n            }).done(function(result){\r\n                if(result[\"ok\"]) {\r\n                    showMessage(LangManager.get(\"ui.js.delete.attach.successful\"), \"alert\", \"topCenter\", 1000, false); //\"Allegato cancellato correttamente\"\r\n                    if(ok) ok();\r\n                } else if (result[\"error\"]) {\r\n                    var msg = result[\"message\"]||LangManager.get(\"ui.js.error.generic\");\r\n                    showErrorMessage(msg);\r\n                }\r\n            });\r\n        };\r\n        this.deleteAttachments = function(documentIDs,attachmentIDs,ok)\r\n        {\r\n            var msg = \"\";\r\n            $.each(documentIDs, function (i,docId) {\r\n                $.ajax({\r\n                    type: \"POST\",\r\n                    url: \"/adiJed/ui/delete-att.do\",\r\n                    dataType: 'json',\r\n                    data: \"id=\"+docId+\"&attid=\"+attachmentIDs[i],\r\n                    async: false\r\n                }).done(function(result){\r\n                    if (result[\"error\"]) {\r\n                        if(msg==\"\"){\r\n                            msg = result[\"message\"]||LangManager.get(\"ui.js.error.generic\");\r\n                        }else{\r\n                            msg += \"<BR>\"+result[\"message\"]||LangManager.get(\"ui.js.error.generic\");\r\n                        }\r\n                    }\r\n                });\r\n            });\r\n\r\n            if(msg!=\"\")\r\n                showErrorMessage(msg);\r\n\r\n            if(ok){\r\n                ok();\r\n            }\r\n        };\r\n        this.addDocumentComment = function(_params, ok, ko)\r\n        {\r\n            //documentID, comment, knd, where, actionID\r\n            $.ajax({\r\n                type: \"POST\",\r\n                url: \"/adiJed/ui/comments.add-comment.do\",\r\n                dataType: \"json\",\r\n                data: \"id=\"+_params['documentID']+\"&\" +\r\n                      \"comment=\"+_params['comment']+\"&\"+\r\n                      \"where=\"+(_params['where']||\"\")+\"&\"+\r\n                      \"actionID=\"+(_params['actionID']||\"-1\")+\"&\"+\r\n                      \"knd=\"+(_params['knd']||\"\")\r\n            }).done(function(result){\r\n                if(result[\"ok\"]) {\r\n                    if(ok) {\r\n                        ok.call(this, _params['documentID'], _params['comment']);\r\n                    }\r\n                } else if (result[\"error\"]) {\r\n                    var msg = result[\"message\"]||LangManager.get(\"ui.js.error.generic\");\r\n                    showErrorMessage(msg);\r\n                    if(ko) {\r\n                        ko.call(this, _params['documentID'], _params['comment']);\r\n                    }\r\n                }\r\n            });\r\n        };\r\n        this.setLastCommentRead = function(documentID, commentID, ok)\r\n        {\r\n            $.ajax({\r\n                type: \"POST\",\r\n                url: \"/adiJed/ui/comments.set-last-comment-read.do\",\r\n                dataType: 'json',\r\n                data: \"id=\"+documentID+\"&commentID=\"+commentID\r\n            }).done(function(result){\r\n                if(result[\"ok\"]) {\r\n                    if(ok) ok.call(this, documentID, commentID);\r\n                } else if (result[\"error\"]) {\r\n                    var msg = result[\"message\"]||LangManager.get(\"ui.js.error.generic\");\r\n                    showErrorMessage(msg);\r\n                }\r\n            });\r\n        };\r\n        this.getDocumentInfo = function(documentID,doneCallback,dataKey)\r\n        {\r\n            var info = null;\r\n            $.ajax({\r\n                type: \"POST\",\r\n                url: \"/adiJed/ui/get-document-info.do\",\r\n                dataType: 'json',\r\n                data: \"id=\"+documentID,\r\n                async: doneCallback ? true : false\r\n            }).done(function(result){\r\n                if(result[\"ok\"]) {\r\n                    info = result[(dataKey||\"data\")];\r\n                    if(doneCallback) {\r\n                        doneCallback.call(this,info);\r\n                    }\r\n                } else if (result[\"error\"]) {\r\n                    var msg = result[\"message\"]||LangManager.get(\"ui.js.error.generic\");\r\n                    showErrorMessage(msg);\r\n                }\r\n            });\r\n\r\n            return info;\r\n        };\r\n\r\n        this.deleteLastVersion = function(id,ok)\r\n        {\r\n            $.ajax({\r\n                type: \"POST\",\r\n                url: \"/adiJed/ui/utils.do\",\r\n                dataType: 'json',\r\n                data: \"action=removeLastVersion&\"+\"id=\"+id\r\n            }).done(function(result){\r\n                setDocumentDeletedStatusInCache(id);\r\n                if(ok) ok();\r\n            });\r\n        };\r\n    };\r\n\r\n    wnd.ADA = new AdiutoDatabaseAccess();\r\n\r\n})(window);\r\n"
