nager.get(\"ui.js.document.modified.hour\")+\" \"+lockInfo.time_lock,//\"Documento in modifica da\r\n                        function(){\r\n                            if (getUrl) {\r\n                                urlDoc.resolve(_url);\r\n                            } else {\r\n                                if(closeCallBack){\r\n                                    _openWin(_url,'view-doc',LangManager.get(\"ui.js.view.document\"), closeCallBack);\r\n                                }else{\r\n                                    _openWin(_url,'view-doc',LangManager.get(\"ui.js.view.document\"));\r\n                                }\r\n\r\n                                $.modal.close();\r\n                            }\r\n                        },//'Visualizza documento'\r\n                    function(){\r\n                        if (getUrl) {\r\n                            urlDoc.reject(\"\");\r\n                        } else {\r\n                            $.modal.close();\r\n                        }\r\n                    }, LangManager.get(\"ui.js.document.modified\"), \"Ok\", LangManager.get(\"ui.generic.buttons.cancel\"));\r\n            }else{\r\n                if( getUrl ) {\r\n                    urlDoc.resolve(_url);\r\n                } else {\r\n                    if(closeCallBack){\r\n                        _openWin(_url,'view-doc',LangManager.get(\"ui.js.view.document\"), closeCallBack);\r\n                    }else{\r\n                        _openWin(_url,'view-doc',LangManager.get(\"ui.js.view.document\"));/*Visualizza documento*/\r\n                    }\r\n                }\r\n            }\r\n        }\r\n    });\r\n    return urlDoc;\r\n}\r\n\r\n\r\nfunction openDoc(id, checkEnable, linkedParentFamilyID, getUrl, closeCallBack, \r\n                imgManage, signType, panelID, actionID\r\n)\r\n{\r\n    var _url = \"/adiJed/ui/view-doc.do?\";\r\n    var _params = [];\r\n    _params.push(\"id=\"+id);\r\n//    _params.push(\"checkEnable=\"+(checkEnable? checkEnable : true));\r\n    if (checkEnable == null)\r\n        _params.push(\"checkEnable=\"+true);\r\n    else\r\n        _params.push(\"checkEnable=\"+checkEnable);\r\n    _params.push(\"linkedParentFamilyID=\"+(linkedParentFamilyID && linkedParentFamilyID>=1000? linkedParentFamilyID : -1));\r\n//    _params.push(\"signMode=\"+(signMode && signMode==true? true : false));\r\n    _params.push(\"signType=\"+signType);\r\n    _params.push(\"imgManage=\"+imgManage);\r\n    _params.push(\"panelID=\"+panelID);\r\n    _params.push(\"actionID=\"+actionID);\r\n    _url += _params.join(\"&\");\r\n\r\n\r\n    var postData = \"action=lockInfo&id=\"+id;\r\n    var urlDoc = new jQuery.Deferred();\r\n    \r\n    $.ajax({\r\n        url: \"/adiJed/ui/utils.do\",\r\n        dataType: 'json',\r\n        data: postData,\r\n        async: false, type: 'POST', success: function(result) {\r\n            var lockInfo = result[\"lockInfo\"];\r\n            if(lockInfo && lockInfo.locked == 1){\r\n                DialogManager.showConfirm(LangManager.get(\"ui.js.document.modified.by\")+\" \"+lockInfo.username+\" \"+LangManager.get(\"ui.js.doc.modify.by.2\")+\" \"+formatDataFromDB(lockInfo.date_lock)+\" \"+LangManager.get(\"ui.js.document.modified.hour\")+\" \"+lockInfo.time_lock,//\"Documento in modifica da\r\n                        function(){\r\n                            if (getUrl) {\r\n                                urlDoc.resolve(_url);\r\n                            } else {\r\n                                if(closeCallBack){\r\n                                    _openWin(_url,'view-doc',LangManager.get(\"ui.js.view.document\"), closeCallBack);\r\n                                }else{\r\n                                    _openWin(_url,'view-doc',LangManager.get(\"ui.js.view.document\"));\r\n                                }\r\n\r\n                                $.modal.close();\r\n                            }\r\n                        },//'Visualizza documento'\r\n                    function(){\r\n                        if (getUrl) {\r\n                            urlDoc.reject(\"\");\r\n                        } else {\r\n                            $.modal.close();\r\n                        }\r\n                    }, LangManager.get(\"ui.js.document.modified\"), \"Ok\", LangManager.get(\"ui.generic.buttons.cancel\"));\r\n            }else{\r\n                if( getUrl ) {\r\n                    urlDoc.resolve(_url);\r\n                } else {\r\n                    if(closeCallBack){\r\n                        _openWin(_url,'view-doc',LangManager.get(\"ui.js.view.document\"), closeCallBack);\r\n                    }else{\r\n                        _openWin(_url,'view-doc',LangManager.get(\"ui.js.view.document\"));/*Visualizza documento*/\r\n                    }\r\n                }\r\n            }\r\n        }\r\n    });\r\n    return urlDoc;\r\n}\r\n\r\n/**\r\n * Carica l'iframe con il contenuto specificato, e fa il dispatch dell'evento InjectableNodeChanged\r\n * @param iframeName il valore dell'attributo \"name\" dell'iframe che si vuole caricare\r\n * @param iframeSrc il contenuto dell'iframe\r\n */\r\nfunction loadIFrame(iframeName, iframeSrc) {\r\n    changeWindowLocation(iframeName, iframeSrc);\r\n}\r\n\r\nfunction changeWindowLocation(wndName, newLocation) {\r\n    const form = document.createElement(\"form\");\r\n    form.action = newLocation;\r\n    form.method = \"POST\";\r\n    form.target = wndName;\r\n    form.style.display = 'none';\r\n    document.body.appendChild(form);\r\n\r\n    const injectableNodeChangedEvent = new CustomEvent('InjectableNodeChanged', {detail: form});\r\n    window.dispatchEvent(injectableNodeChangedEvent);\r\n\r\n    form.submit();\r\n    document.body.removeChild(form);\r\n}\r\n\r\nfunction _openWin(url, name, title, closeCallBack)\r\n{    \r\n    var windowUrl = location.protocol+'//'+location.hostname+(location.port ? ':'+location.port: '')+url;\r\n    // per internet explorer facciamo il submit del form, perchè con window.open non setta il referer\r\n    // che viene utilizzato dai filtri\r\n    if( detectIE() ){\r\n        sForm = '<form action=\"'+windowUrl+'\" method=\"post\" target=\"_blank\">';\r\n        sForm += '</form>';\r\n        var frm = $(sForm).appendTo('body');\r\n        setTimeout(function(){frm.submit()}, 0);\r\n        setTimeout(function(){\r\n            frm.remove();\r\n        }, 500);\r\n    } else {\r\n        var w = window.open(windowUrl, title);\r\n\r\n        if(title) {\r\n            var f = function(win) {\r\n                if(win && win.document && win.document.readyState == 'complete') {\r\n                    win.document.title = title;\r\n                } else {\r\n                    setTimeout(function(){f(win);}, 500);\r\n                }\r\n            };\r\n            f(w);\r\n        }\r\n        if(closeCallBack) {\r\n            var f = function(win) {\r\n                if(win && win.document && win.document.readyState == 'complete') {\r\n                    win.onclose = closeCallBack;\r\n                } else {\r\n                    setTimeout(function(){f(win);}, 500);\r\n                }\r\n            };\r\n            f(w);\r\n        }\r\n    }\r\n}\r\n\r\nfunction detectIE() {\r\n    var ua = window.navigator.userAgent;\r\n\r\n    var msie = ua.indexOf('MSIE ');\r\n    if (msie > 0) {\r\n        // IE 10 or older => return version number\r\n        return parseInt(ua.substring(msie + 5, ua.indexOf('.', msie)), 10);\r\n    }\r\n\r\n    var trident = ua.indexOf('Trident/');\r\n    if (trident > 0) {\r\n        // IE 11 => return version number\r\n        var rv = ua.indexOf('rv:');\r\n        return parseInt(ua.substring(rv + 3, ua.indexOf('.', rv)), 10);\r\n    }\r\n\r\n    var edge = ua.indexOf('Edge/');\r\n    if (edge > 0) {\r\n        // Edge (IE 12+) => return version number\r\n        return parseInt(ua.substring(edge + 5, ua.indexOf('.', edge)), 10);\r\n    }\r\n\r\n    // other browser\r\n    return false;\r\n}\r\n\r\nfunction openAttachment(documentID, attachmentID)\r\n{\r\n    var url = '/adiJed/ui/view-attachment.do?id='+documentID+'&attid='+attachmentID;\r\n    _openWin(url,'view-att',LangManager.get(\"ui.js.view.attachment\"));//'Visualizza allegato'\r\n}\r\n\r\nfunction showWorkflowHistory(id, callback)\r\n{\r\n    showWaitDialog();\r\n    openWindow(\"wf-history-wnd\", \"/adiJed/ui/view-workflow-history.do?documentID=\"+id,\r\n        {\"title\": LangManager.get(\"ui.js.view.history\"), \"modal\": true, \"Maximize\": false, \"Minimize\": false, \"fullscreen\": true}, callback);//\"Storia documento\"\r\n    $(\"#wf-history-wnd\").data(\"kendoWindow\").maximize();\r\n}\r\n\r\nfunction showEmailHistory(id, callback)\r\n{\r\n    openWindow(\"mail-history-wnd\", \"/adiJed/ui/view-email-history.do?documentID=\"+id,\r\n        {\"title\": LangManager.get(\"ui.js.view.mail.history\"), \"modal\": true, \"Maximize\": false, \"Minimize\": false, \"fullscreen\": false}, callback);//\"Storia documento\"\r\n}\r\n\r\nfunction chooseWhatInherit(id, preselectedDocs, kind, callback, famid)\r\n{\r\n    openWindow(\"inherit-wnd\", \"/adiJed/ui/choose-what-inherit.do?documentID=\"+id+\"&\"+\"preselectedDocs=\"+encodeURIComponent(preselectedDocs)+\"&\"+\"kind=\"+kind+\"&\"+\"famid=\"+famid,\r\n        {\"title\":LangManager.get(\"ui.js.eredita\") , \"modal\": true, \"width\": \"80%\", \"height\": \"80%\"}, callback);\r\n}\r\n\r\nfunction showDocumentComments(id, where, actionID, callback)\r\n{\r\n    openWindow(\"document-comments\",\r\n        \"/adiJed/ui/comments.document-comments.do?documentID=\"+id+\"&where=\"+where+\"&actionID=\"+actionID,\r\n        {\"width\": \"600px\", \"height\": \"80%\", \"title\": LangManager.get(\"ui.js.view.comments\"), \"modal\": true},    //\"Commenti\"\r\n        callback\r\n    );\r\n}\r\n\r\nfunction showChannels(id, channelTitle, channelType, callback)\r\n{\r\n    if($(\".toolbar-button-selected\")) $(\".toolbar-button-selected\").removeClass(\"toolbar-button-selected\");\r\n    $(\"#channel\").addClass(\"toolbar-button-selected\");\r\n\r\n    if(!HistoryManager.loadPage())\r\n        saveHistoryAndDisplayPage(null, \"/adiJed/ui/channels.channels-page.do\", \"id=\"+id+\"&channelTitle=\"+channelTitle+\"&channelType=\"+channelType, true);\r\n}\r\n\r\n/**\r\n * Apre la maschera di modifica info\r\n * Se passo il parametro famid allora vuol dire che sto facendo un cambia famiglia\r\n * @param id L'id del documento da modificare\r\n * @param famid La famiglia destinazione (passata in caso di \"cambia famiglia\")\r\n * @param ctx Il contesto nel quale sto facendo il modifica info (questo cambia il funzionamento del modifica info\r\n *            es. ICompanyUtil.FROM_WORKFLOW non controlla i campi obbligatori, perchè questo controllo è già eseguito a livello di attività wf)\r\n * @param listPK id della lista attività dove devo ritornare dopo la modifica degli indici\r\n>>>>>>> .theirs * @param lastRecord boolean mi dice se ho cliccato sul tasto ULTIMO\r\n */\r\nfunction modifyDocumentInfo(id, famid, ctx, listPK, lastRecord)\r\n{\r\n    var dfd = new $.Deferred();\r\n\r\n    var params = {\"id\": id, \"famid\": famid, \"ctx\": ctx, \"listPK\": listPK, \"lastRecord\": lastRecord};\r\n    var paperOnGlassEnabled = false;\r\n    $.ajax({\r\n        url: \"/adiJed/ui/modify-document-is-paper-on-glass-enabled.do\",\r\n        data: params,\r\n        dataType: 'json',\r\n        async: false, type: 'POST', success: function(result) {\r\n            paperOnGlassEnabled = result[\"paperOnGlassEnabled\"];\r\n        },\r\n        errorBehaviour: ErrorBehaviour.RELOAD_LAST_PAGE\r\n    });\r\n\r\n    if(!paperOnGlassEnabled) {\r\n        $(\"div.fields-table\").load(\r\n            ErrorBehaviour.RELOAD_LAST_PAGE,\r\n            \"/adiJed/ui/edit-doc-info.do\",\r\n            params,\r\n            function () {\r\n                dfd.resolve();\r\n            }\r\n        );\r\n    } else {\r\n        var fieldsTableDiv = $(\"div.fields-table\").empty();\r\n\r\n        ($(\"<iframe>\")\r\n            .addClass(\"always-visible\")\r\n            .attr(\"id\",\"phantomFrame\")\r\n            .attr(\"src\", \"/adiJed/ui/edit-doc-info.do?\"+$.param(params))\r\n            .appendTo(fieldsTableDiv)\r\n        )[0].addEventListener(\"load\", function() {\r\n            dfd.resolve();\r\n        });\r\n    }\r\n    return dfd;\r\n}\r\n\r\n// todo [simone]: creare dinamicamente il container per la finestra se questo non c'è\r\nfunction showLinkedDocuments(id)\r\n{\r\n    $(\"#document-links-container\").load(\"/adiJed/ui/get-document-links.do\",\"id=\"+id,function(){\r\n            $(\"#document-links-container\").modal({\r\n                    focus: false,\r\n                    overlayClose: true,\r\n                    opacity:65,\r\n                    autoResize:true,\r\n                    autoPosition: true,\r\n                    position: [isMobile() || targetWidth <= 501 ? null : '15%', null],\r\n                    maxHeight: isMobile() || targetWidth <= 501 ? null : '65%',\r\n                    overlayCss: {backgroundColor:\"#F8F8F8\"}\r\n                }\r\n            );\r\n        }\r\n    );\r\n}\r\n\r\nfunction addLinkedDocuments(mode, pageUnique, callerId, docId, from, actionId, callback){\r\n    var previewHidden = false;\r\n    var _bd = $(\"body\");\r\n    var _wnd = $(\"<div/>\")\r\n            .attr(\"id\", \"add-links-container\")\r\n            .css(\"position\", \"relative\")\r\n            .css(\"width\", \"100%\")\r\n            .css(\"padding\", \"0\")\r\n            .addClass(\"adi-modal-dialog-container\");\r\n\r\n\r\n    if (!_wnd.data(\"kendoWindow\")) {\r\n        _wnd.kendoWindow({\r\n            width: _bd.hasClass(\"tablet\") ? \"100%\" : \"80%\",\r\n            height: _bd.hasClass(\"tablet\") ? \"100%\" : \"550px\",\r\n            title: LangManager.get(\"ui.js.link.documents\"), //\"Collega documenti\"\r\n            content: \"/adiJed/ui/linked-documents/query.jsp?mode=\"+(mode?mode:\"links\")+\"&docId=\"+docId+\"&pageUnique=\"+pageUnique+\"&from=\"+from+\"&actionId=\"+actionId,\r\n            modal: true,\r\n            iframe: true,\r\n            actions: [\r\n                \"Minimize\",\r\n                \"Maximize\",\r\n                \"Close\"\r\n            ],\r\n            open: function() {\r\n                // nascondo la preview perchè altrimenti va a coprire la nuova finestra aperta\r\n                var documentPreview = $(\"#document-preview\");\r\n                if (detectIE()){\r\n                    if(!documentPreview.hasClass(\"preview-closed\")) {\r\n                        if( $(\"#document-preview-iframe\").length ) {\r\n                            $(\"#document-preview-iframe\").css(\"visibility\",\"hidden\");\r\n                            previewHidden = true;\r\n                        }\r\n                    }\r\n                }\r\n                if(isTablet()) {\r\n                    _wnd.data(\"kendoWindow\").maximize();\r\n                } else {\r\n                    _wnd.data(\"kendoWindow\").center();\r\n                }\r\n            },\r\n            close: function() {\r\n                // riabilito la preview se era stata nascosta durante l'apertura\r\n                if( previewHidden ) {\r\n                    $(\"#document-preview-iframe\").css(\"visibility\",\"visible\");\r\n                    previewHidden = false;\r\n                }\r\n\r\n                _wnd.fadeOut(200, function(){\r\n                    $.ajax({url: \"/adiJed/ui/link-to-document.do\",\r\n                        type: \"POST\",\r\n                        data: \"action=\"+(mode?mode:\"num\")+\"&pageUnique=\"+pageUnique+\"&docId=\"+docId+\"&from=\"+from+\"&actionId=\"+actionId+\"&clear=true\",\r\n                        success: function(result)\r\n                        {\r\n                            HistoryManager.removePage();\r\n                            if(from!='Inserimento' && from!='Workflow' && !callback){\r\n                                HistoryManager.reloadLastPage();\r\n                            }else{\r\n                                if(callback){\r\n                                    callback();\r\n                                }\r\n                            }\r\n                            updateCachedDocInfo(docId);\r\n                        }\r\n                    });\r\n                    _wnd.data(\"kendoWindow\").destroy();\r\n                });\r\n            }\r\n        });\r\n    }\r\n\r\n    _wnd.data(\"kendoWindow\").open();\r\n}\r\n\r\nfunction addLinkedDocumentsToChannel(pageUnique, linkCallBack){ //TODO DA MODIFICARE\r\n    var previewHidden = false;\r\n    var _bd = $(\"body\");\r\n    var _wnd = $(\"<div/>\")\r\n            .attr(\"id\", \"add-links-container\")\r\n            .css(\"position\", \"relative\")\r\n            .css(\"width\", \"100%\")\r\n            .css(\"padding\", \"0\")\r\n            .addClass(\"adi-modal-dialog-container\");\r\n\r\n    if (!_wnd.data(\"kendoWindow\")) {\r\n        _wnd.kendoWindow({\r\n            width: _bd.hasClass(\"tablet\") ? \"100%\" : \"80%\",\r\n            height: _bd.hasClass(\"tablet\") ? \"100%\" : \"550px\",\r\n            title: LangManager.get(\"ui.js.link.documents\"), //\"Collega documenti\"\r\n            content: \"/adiJed/ui/linked-documents/query.jsp?mode=channel&pageUnique=\"+pageUnique,\r\n            modal: true,\r\n            iframe: true,\r\n            actions: [\r\n                \"Minimize\",\r\n                \"Maximize\",\r\n                \"Close\"\r\n            ],\r\n            open: function() {\r\n                // nascondo la preview perchè altrimenti va a coprire la nuova finestra aperta\r\n                if (detectIE()){\r\n                    var documentPreview = $(\"#document-preview\");\r\n                    if(!documentPreview.hasClass(\"preview-closed\")) {\r\n                        if( $(\"#document-preview-iframe\").length ) {\r\n                            $(\"#document-preview-iframe\").css(\"visibility\",\"hidden\");\r\n                            previewHidden = true;\r\n                        }\r\n                    }\r\n                }\r\n                if(isTablet()) {\r\n                    _wnd.data(\"kendoWindow\").maximize();\r\n                } else {\r\n                    _wnd.data(\"kendoWindow\").center();\r\n                }\r\n            },\r\n            close: function() {\r\n                // riabilito la preview se era stata nascosta durante l'apertura\r\n                if( previewHidden ) {\r\n                    $(\"#document-preview-iframe\").css(\"visibility\",\"visible\");\r\n                    previewHidden = false;\r\n                }\r\n\r\n                _wnd.fadeOut(200, function(){\r\n                    $.ajax({url: \"/adiJed/ui/channels.channels.do\",\r\n                        type: \"POST\",\r\n                        dataType: 'json',\r\n                        data: \"action=getNumLink&pageUnique=\"+pageUnique,\r\n                        success: function(result)\r\n                        {\r\n                            if(result && result.num){\r\n                                if($(\"#linkContainer span\").length == 0){\r\n                                    $(\"<span>\").addClass(\"channel-bullet-indicator\").text(result.num).appendTo($(\"#linkContainer\"));\r\n                                }else{\r\n                                    $($(\"#linkContainer span\")[0]).text(result.num);\r\n                                }\r\n                            }\r\n                            if(linkCallBack)\r\n                                linkCallBack();\r\n                        }\r\n                    });\r\n                    _wnd.data(\"kendoWindow\").destroy();\r\n                });\r\n            }\r\n        });\r\n    }\r\n\r\n    _wnd.data(\"kendoWindow\").open();\r\n}\r\n\r\nfunction showAttachments(id, where, actionID, listID, insertLater, familyId, callback, pageUnique)\r\n{\r\n    showAttachments(id, where, actionID, listID, insertLater, familyId, callback, pageUnique, \"\");\r\n}\r\n\r\nfunction showAttachments(id, where, actionID, listID, insertLater, familyId, callback, pageUnique, action, executed)\r\n{\r\n    if(!where || where == \"\")\r\n    {\r\n        Logger.error(\"Chiamata a metodo showAttachments, Parametro 'where' mancante! [\"+document.location+\"]\");\r\n        showErrorMessage(LangManager.get(\"ui.js.error.generic\")); //\"Si è verificato un errore imprevisto. Ricaricare la pagina e riprovare....\"\r\n    }\r\n    else\r\n    {\r\n        //var _url = \"/adiJed/ui/get-document-attachments.do?\";\r\n        var _url = \"/adiJed/ui/attachments/_view-attachments.jsp?\";\r\n        var _params = [];\r\n        _params.push(\"id=\"+id);\r\n        _params.push(\"where=\"+where);\r\n        _params.push(\"actionID=\"+actionID);\r\n        _params.push(\"listID=\"+(listID?listID:-1));\r\n        _params.push(\"insertLater=\"+(insertLater?insertLater:false));\r\n        _params.push(\"familyId=\"+(familyId?familyId:\"\"));\r\n        _params.push(\"pageUnique=\"+pageUnique);\r\n        _params.push(\"action=\"+action);\r\n        _params.push(\"executed=\"+executed);\r\n        \r\n        _url += _params.join(\"&\");\r\n\r\n        openWindow(\r\n            \"document-attachments-container\",\r\n            _url,\r\n            {\"iframe\": true, \"width\": \"800px\", \"height\": \"80%\", \"title\": LangManager.get(\"ui.js.attachments\"), \"modal\": true},\r\n            callback,\r\n            true\r\n        );//\"Allegati\"\r\n    }\r\n}\r\n\r\nfunction showNewVersionDialog(id, where, actionID, ext, listPK)\r\n{\r\n    if(!where || where == \"\")\r\n    {\r\n        Logger.error(\"Chiamata a metodo showNewVersionDialog, Parametro 'where' mancante! [\"+document.location+\"]\");\r\n        showErrorMessage(LangManager.get(\"ui.js.error.generic\"));//\"Si è verificato un errore imprevisto. Ricaricare la pagina e riprovare....\"\r\n    }\r\n    else\r\n    {\r\n        var _url = \"/adiJed/ui/versions/new.jsp?\";\r\n\r\n        var _params = [];\r\n        _params.push(\"id=\"+id);\r\n        _params.push(\"where=\"+where);\r\n        _params.push(\"actionID=\"+actionID);\r\n        _params.push(\"ext=\"+ext);\r\n        _params.push(\"listPK=\"+listPK);\r\n        _url += _params.join(\"&\");\r\n\r\n        openWindow(\"new-doc-container\", _url, {\"width\": \"700px\", \"height\": \"550px\", \"title\": LangManager.get(\"ui.js.new.version\"), \"modal\": true});//\"Nuova versione\"\r\n    }\r\n}\r\n\r\nfunction showReplaceDocumentDialog(id, where, actionID, listPK)\r\n{\r\n    if(!where || where == \"\")\r\n    {\r\n        Logger.error(\"Chiamata a metodo showReplaceDocumentDialog, Parametro 'where' mancante! [\"+document.location+\"]\");\r\n        showErrorMessage(LangManager.get(\"ui.js.error.generic\"));//\"Si è verificato un errore imprevisto. Ricaricare la pagina e riprovare....\"\r\n    }\r\n    else\r\n    {\r\n        var _url = \"/adiJed/ui/includes/replaceDocument.jsp?\";\r\n\r\n        var _params = [];\r\n        _params.push(\"id=\"+id);\r\n        _params.push(\"where=\"+where);\r\n        _params.push(\"actionID=\"+actionID);\r\n        _params.push(\"listPK=\"+listPK);\r\n        _url += _params.join(\"&\");\r\n\r\n        openWindow(\"document-replace-container\", _url, {\"width\": \"700px\", \"height\": \"550px\", \"title\": LangManager.get(\"ui.js.replace.doc\"), \"modal\": true}, function(){lockDocument(id,'unlock');});//\"Sostituisci Documento\"\r\n    }\r\n}\r\n\r\nfunction lockDocument(documentId, action){\r\n    var status = false;\r\n\r\n    var postData = \"action=\"+action+\r\n                    \"&id=\"+documentId;\r\n\r\n    $.ajax({\r\n        url: \"/adiJed/ui/lock-document.do\",\r\n        dataType: 'json',\r\n        data: postData,\r\n        async: false, type: 'POST', success: function(result) {\r\n            status = result[\"ok\"];\r\n\r\n        },\r\n        errorBehaviour: ErrorBehaviour.RELOAD_LAST_PAGE\r\n    });\r\n    return status;\r\n}\r\n\r\nfunction getAttachInfo(documentId){\r\n    var info = {count:0}; //TODO Aggiungere info\r\n\r\n    var postData = \"action=getAttachsInfo\"+\r\n                    \"&id=\"+documentId;\r\n\r\n    $.ajax({\r\n        url: \"/adiJed/ui/utils.do\",\r\n        dataType: 'json',\r\n        data: postData,\r\n        async: false, type: 'POST', success: function(result) {\r\n            info.count = result[\"count\"];\r\n\r\n        }\r\n    });\r\n    return info;\r\n}\r\n\r\nfunction loadHome()\r\n{\r\n    if($(\".toolbar-button-selected\")) $(\".toolbar-button-selected\").removeClass(\"toolbar-button-selected\");\r\n    $(\"#home\").addClass(\"toolbar-button-selected\");\r\n    saveHistoryAndDisplayPage(null, \"/adiJed/ui/home.do?main=true\", \"\", true);\r\n//    $.ajax({url: \"/adiJed/ui/home.do?main=true\",\r\n//        success: function(html) {\r\n//            $(\"#app-container\").html(html);\r\n//        }\r\n//    });\r\n}\r\n\r\nfunction wdef(a,b)\r\n{\r\n    return typeof a !== 'undefined' ? a : b;\r\n}\r\n\r\n/**\r\n * Passare i parametri come oggetto javascript {chiave:valore,...}\r\n *\r\n * Per utlizzare la callback è necessario che openNewWin sia true, altrimenti viene ignorata la callback e ad inserimento concluso\r\n * viene fatto un back\r\n *\r\n * @param {Object} p\r\n */\r\nfunction loadNewDocument(p)\r\n{\r\n    var params = {\r\n        /*l'url della pagina di inserimento*/\r\n        pageUrl         : wdef(p.pageUrl , \"/adiJed/ui/new-document.do\"),\r\n        /*deve aprire una nuova finestra o nella pagina principale?*/\r\n        openNewWin      : wdef(p.openNewWin , true),\r\n        replaceHistory  : wdef(p.replaceHistory , false),\r\n        familyID        : wdef(p.familyID , -1),\r\n        familyLocked    : wdef(p.familyLocked , true),\r\n        /*il documento dal quale ereditare gli indici*/\r\n        documentID      : wdef(p.documentID , -1),\r\n        /*l'id della testata*/\r\n        headDocumentID  : wdef(p.headDocumentID , -1),\r\n        /*il tipo di documento (family|phantom)*/\r\n        familyKind      : wdef(p.familyKind , \"family\"),\r\n        /*l'id azione wf, per i documenti inseriti dal wf*/\r\n        actionID        : wdef(p.actionID , -1),\r\n        /*id pannello per attesa documenti (checkpoint)*/\r\n        panelID         : wdef(p.panelID , -1),\r\n        /*id pannello di inserimento da utilizzare custom */\r\n        requestedPanelID: wdef(p.requestedPanelID , -1),\r\n        /*id lista attività wf, per attesa documenti (checkpoint)*/\r\n        wfListID        : wdef(p.wfListID , -1),\r\n        /*per dire se deve attendere il wf del documento inserito*/\r\n        waitWF          : wdef(p.waitWF , false),\r\n        /*se è un dettaglio*/\r\n        isDetail        : wdef(p.isDetail , false),\r\n        /*specifica se collegare il documento inserito con quello dal quale è originato*/\r\n        linkToParent    : wdef(p.linkToParent, false),\r\n        /*la funzione da chiamare a documento inserito (gli viene passato una stringa json con dentro {fidd:123}),\r\n          se non viene passato niente, allora ricarica l'ultima pagina*/\r\n        callback        : wdef(p.callback , null),\r\n        /*la funzione da chiamare se viene annullato l'inserimento*/\r\n        callbackCancel  : wdef(p.callbackCancel , null),\r\n        /* Funzione di callback da chiamare in inserimento senza chiusura del documento*/\r\n        callBackInsert  : wdef(p.callBackInsert , null),\r\n        /*la chiave univoca generata dalla pagina di inserimento*/\r\n        pageUnique      : wdef(p.pageUnique , \"\"),\r\n        /*il titolo della finestra*/\r\n        winTitle        : wdef(p.winTitle , LangManager.get(\"ui.js.insert.doc\")), //\"Inserisci documento\"\r\n        /*chiave: valore per valorizzare gli indici del documento da inserire [{fifr:\"1001\", value:\"xxx\", label:\"asd qwe\"}]*/\r\n        values          : wdef(p.values , {}),\r\n        iframe          : wdef(p.iframe, false),\r\n        uploadedFiles   : wdef(p.uploadedFiles,\"\"),\r\n        detailToInsertId   : wdef(p.detailToInsertId,-1)\r\n    };\r\n\r\n    if(!params.openNewWin) {\r\n        if($(\".toolbar-button-selected\")) $(\".toolbar-button-selected\").removeClass(\"toolbar-button-selected\");\r\n        $(\"#new\").addClass(\"toolbar-button-selected\");\r\n\r\n        var _params = [];\r\n        _params.push(\"id=\"+params.documentID);\r\n        _params.push(\"famid=\"+params.familyID);\r\n        _params.push(\"familyLocked=\"+params.familyLocked);\r\n        _params.push(\"famknd=\"+params.familyKind);\r\n        _params.push(\"actid=\"+params.actionID);\r\n        _params.push(\"panid=\"+params.panelID);\r\n        _params.push(\"reqpanid=\"+params.requestedPanelID);\r\n        _params.push(\"wflid=\"+params.wfListID);\r\n        _params.push(\"waitwf=\"+params.waitWF);\r\n        _params.push(\"detail=\"+params.isDetail);\r\n        _params.push(\"linkToParent=\"+params.linkToParent);\r\n        _params.push(\"headDocumentID=\"+params.headDocumentID);\r\n        _params.push(\"uploadedFiles=\"+params.uploadedFiles);\r\n        _params.push(\"detailToInsertId=\"+params.detailToInsertId);\r\n\r\n        if(params.replaceHistory)\r\n        {\r\n            saveHistoryAndDisplayPage('/new/?'+getUniqueID(), params.pageUrl, _params.join(\"&\"), true, false, HistoryConstants.REPLACE_CURRENT_HISTORY);\r\n        }\r\n        else if(!HistoryManager.loadPage())\r\n        {\r\n            saveHistoryAndDisplayPage(null, params.pageUrl, _params.join(\"&\"), true);\r\n        }\r\n    } else {\r\n        var newDocWnd = $(\"<div/>\")\r\n            .attr(\"id\", \"new-document-container\")\r\n            .css(\"position\", \"relative\")\r\n            .css(\"width\", \"100%\")\r\n            .css(\"padding\", \"0\")\r\n            .addClass(\"adi-modal-dialog-container\");\r\n\r\n        if (!newDocWnd.data(\"kendoWindow\")) {\r\n            var _url = params.pageUrl+\"?\";\r\n\r\n            var _params = [];\r\n            _params.push(\"id=\"+params.documentID);\r\n            _params.push(\"famid=\"+params.familyID);\r\n            _params.push(\"famknd=\"+params.familyKind);\r\n            _params.push(\"actid=\"+params.actionID);\r\n            _params.push(\"panid=\"+params.panelID);\r\n            _params.push(\"reqpanid=\"+params.requestedPanelID);\r\n            _params.push(\"wflid=\"+params.wfListID);\r\n            _params.push(\"waitwf=\"+params.waitWF);\r\n            _params.push(\"detail=\"+params.isDetail);\r\n            _params.push(\"pageUnique=\"+params.pageUnique);\r\n            _params.push(\"headDocumentID=\"+params.headDocumentID);\r\n            _params.push(\"linkToParent=\"+params.linkToParent);\r\n            _params.push(\"uploadedFiles=\"+params.uploadedFiles);\r\n            _params.push(\"detailToInsertId=\"+params.detailToInsertId);\r\n            _url += _params.join(\"&\");\r\n\r\n            var _bd = $(\"body\");\r\n\r\n            newDocWnd.kendoWindow({\r\n                width: _bd.hasClass(\"tablet\") ? \"100%\" : \"80%\",\r\n                height: _bd.hasClass(\"tablet\") ? \"100%\" : \"550px\",\r\n                title: params.winTitle,\r\n                content: _url,\r\n                modal: true,\r\n                iframe: params.iframe,\r\n                actions: [\r\n                    \"Minimize\",\r\n                    \"Maximize\",\r\n                    \"Close\"\r\n                ],\r\n                open: function() {\r\n                    newDocWnd.data(\"fieldsLoaded\", function(form) {\r\n                        if(params.values)\r\n                        {\r\n                            $.each(params.values, function(i,overrideValue) {\r\n                                $(\":input[name=fld\"+overrideValue[\"fifr\"]+\"]\", form).val(overrideValue[\"value\"]);\r\n                                $(\"#f\"+overrideValue[\"fifr\"], form).text(overrideValue[\"value\"]);\r\n                                if(overrideValue[\"label\"])\r\n                                {\r\n                                    $(\":input[name=lbl-fld\"+overrideValue[\"fifr\"]+\"]\", form).val(overrideValue[\"label\"]);\r\n                                }\r\n                            });\r\n                        }\r\n                    });\r\n                },\r\n                close: function() {\r\n                    HistoryManager.cancelConfirmBeforeProceed();\r\n                    \r\n                    newDocWnd.fadeOut(200, function(){\r\n                        if((params.callback && newDocWnd.attr(\"dirty\")) || params.callbackCancel)\r\n                        {\r\n                            if(params.callback && newDocWnd.attr(\"dirty\"))\r\n                            {\r\n                                params.callback.call(this, newDocWnd.attr(\"_arguments\"));\r\n                            }\r\n                            else if(params.callbackCancel)\r\n                            {\r\n                                params.callbackCancel.call(this);\r\n                            }\r\n                        }\r\n                        else if( newDocWnd.attr(\"dirty\") )\r\n                        {\r\n                            HistoryManager.reloadLastPage();\r\n                        }\r\n                        newDocWnd.data(\"kendoWindow\").destroy();\r\n                    });\r\n                },\r\n                refresh : function(){ //Richiamo di callback da fare in caso di inserimento senza chiusura della pagina\r\n                    if (newDocWnd.attr(\"_arguments\") !== undefined) {\r\n                        if (params.callBackInsert) {\r\n                            params.callBackInsert.call(this, newDocWnd.attr(\"_arguments\"));\r\n                        }\r\n                    }\r\n                }\r\n            });\r\n        }\r\n\r\n        newDocWnd.data(\"kendoWindow\").open().maximize();\r\n    }\r\n}\r\n\r\nfunction openSendMessage(to, subj, id)\r\n{\r\n    var params = [];\r\n\r\n    if(to)   params.push(\"to=\"+to);\r\n    if(subj) params.push(\"subj=\"+encodeURIComponent(subj));\r\n\r\n    params.push(\"ids=\" + encodeURIComponent(\"[\") + (id ? id : \"\") + encodeURIComponent(\"]\"));\r\n\r\n    return openWindow(\r\n        \"send-message-window\",\r\n        \"/adiJed/ui/messages/send-window.do?\"+params.join(\"&\"),\r\n        {\"width\": \"750px\", \"height\": \"500px\", \"title\": LangManager.get(\"ui.js.new.message\"), \"modal\": true}\r\n    );\r\n}\r\n\r\nfunction loadTracking(prm)\r\n{\r\n    if($(\".toolbar-button-selected\")) $(\".toolbar-button-selected\").removeClass(\"toolbar-button-selected\");\r\n    $(\"#tracking\").addClass(\"toolbar-button-selected\");\r\n\r\n    var _pageLoadedFromHistory = HistoryManager.loadPage();\r\n    if(prm != null || !_pageLoadedFromHistory) {\r\n        return saveHistoryAndDisplayPage(null, \"/adiJed/ui/query.filters.do?tracking=true\", prm, true, false, void(0));\r\n    } else if(_pageLoadedFromHistory) {\r\n        return _pageLoadedFromHistory;\r\n    } else {\r\n        return null;\r\n    }\r\n}\r\n\r\n\r\nfunction loadQuery(prm)\r\n{\r\n    if($(\".toolbar-button-selected\")) $(\".toolbar-button-selected\").removeClass(\"toolbar-button-selected\");\r\n    $(\"#query\").addClass(\"toolbar-button-selected\");\r\n\r\n    var _pageLoadedFromHistory = HistoryManager.loadPage();\r\n    if(prm != null || !_pageLoadedFromHistory) {\r\n        return saveHistoryAndDisplayPage(null, \"/adiJed/ui/query.filters.do\", prm, true, false, void(0));\r\n    } else if(_pageLoadedFromHistory) {\r\n        return _pageLoadedFromHistory;\r\n    } else {\r\n        return null;\r\n    }\r\n}\r\n\r\nfunction loadWorkflow(prm)\r\n{\r\n    if($(\".toolbar-button-selected\")) $(\".toolbar-button-selected\").removeClass(\"toolbar-button-selected\");\r\n    $(\"#workflow\").addClass(\"toolbar-button-selected\");\r\n\r\n    if(!HistoryManager.loadPage())\r\n        saveHistoryAndDisplayPage(null, \"/adiJed/ui/get-workflow.do\", prm, true);\r\n}\r\n\r\nfunction loadTutor(prm)\r\n{\r\n    if($(\".toolbar-button-selected\")) $(\".toolbar-button-selected\").removeClass(\"toolbar-button-selected\");\r\n    $(\"#tutor\").addClass(\"toolbar-button-selected\");\r\n\r\n    if(!HistoryManager.loadPage())\r\n        saveHistoryAndDisplayPage(null, \"/adiJed/ui/tutor-list.do\", prm, true);\r\n}\r\n\r\nfunction loadMessages(prm)\r\n{\r\n    if($(\".toolbar-button-selected\")) $(\".toolbar-button-selected\").removeClass(\"toolbar-button-selected\");\r\n    $(\"#messages\").addClass(\"toolbar-button-selected\");\r\n\r\n    if(!HistoryManager.loadPage())\r\n        saveHistoryAndDisplayPage(null, \"/adiJed/ui/messages.do\", prm, true);\r\n}\r\n\r\nfunction viewIter(id, actionType, docId, historyBehaviour, url, listPK)\r\n{\r\n    HistoryManager.navigateTo('/activity/?', url||\"/adiJed/ui/view-workflow-action.do\", getHistoryDocumentKeyParam(\"docid\", docId)+\"&id=\"+id+\"&type=\"+actionType+(listPK && listPK>=1000 ? \"&listPK=\"+listPK : \"\"), void(0), historyBehaviour);\r\n\r\n}\r\n\r\nfunction viewIterInSequence(ids, actionsType, docsIds, historyBehaviour, url)           //TODO lockErrorCallback\r\n{\r\n    //Gli passo anche il parametro id contenente la prima azione altrimenti il command va in errore per l'ExtendedDocument\r\n    HistoryManager.navigateTo('/activity/?', url||\"/adiJed/ui/view-workflow-action.do\", \"id=\"+ids[0]+(docsIds && docsIds[0]? \"&docid=\"+docsIds[0] : \"\")+\"&type=\"+actionsType[0]+\"&ids=\"+JSON.stringify(ids)+\"&actionstypes=\"+JSON.stringify(actionsType)+\"&sequence=true\", void(0), historyBehaviour);\r\n}\r\n\r\nfunction viewIterForTutor(id, endIterId, historyBehaviour, url)\r\n{\r\n    HistoryManager.navigateTo('/tutor/?', url||\"/adiJed/ui/tutor-view-action.do\", \"id=\"+id+\"&endIterId=\"+endIterId, void(0), historyBehaviour);\r\n}\r\nfunction viewExecutedIter(id, actionType, docId, historyBehaviour)\r\n{\r\n    viewIter(id, actionType, docId, historyBehaviour, \"/adiJed/ui/workflow.view-executed-action.do\", null);\r\n}\r\n\r\nfunction loadTraining(prm)\r\n{\r\n    if($(\".toolbar-button-selected\")) $(\".toolbar-button-selected\").removeClass(\"toolbar-button-selected\");\r\n    $(\"#training\").addClass(\"toolbar-button-selected\");\r\n\r\n    if(!HistoryManager.loadPage())\r\n        saveHistoryAndDisplayPage(null, \"/adiJed/ui/training.training-page.do\", prm, true);\r\n}\r\n\r\nfunction getParameterByName(name,queryString)\r\n{\r\n  name = name.replace(/[\\[]/, \"\\\\\\[\").replace(/[\\]]/, \"\\\\\\]\");\r\n  var regexS = \"[\\\\?&]\" + name + \"=([^&#]*)\";\r\n  var regex = new RegExp(regexS);\r\n  var results = regex.exec(queryString||window.location.search);\r\n  if(results == null)\r\n    return \"\";\r\n  else\r\n    return decodeURIComponent(results[1].replace(/\\+/g, \" \"));\r\n}\r\n\r\nvar elementIDUnique = 0;\r\n/* crea un header fisso per la tabella passata come argomento */\r\nfunction fixTableHeader(tableToFix, clazz)\r\n{\r\n    if(!tableToFix) // make it safe to overcall this\r\n        return;\r\n\r\n    var rowForWidth;\r\n    var scrollDiv = null, headerFixed = null;\r\n\r\n    var headerFixedID = tableToFix.attr(\"headerFixedID\");\r\n    var existsCopy    = headerFixedID ? ( $(\"#\"+headerFixedID).length > 0 ) : false;\r\n    if(!existsCopy)\r\n    {\r\n        headerFixedID = \"header-copy\"+(elementIDUnique++);\r\n\r\n        // creo la tabella con l'header fisso\r\n        (headerFixed = $(\"<div>\")).attr(\"id\", headerFixedID)\r\n            .css({\r\n                left: 0,\r\n                \"margin-left\": 0,\r\n                position: \"absolute\",\r\n                overflow: \"visible\"\r\n            })\r\n            .addClass(\"header-copy\")\r\n            .insertBefore(tableToFix)\r\n            .append($(\"<table>\").css(\"width\",\"100%\"));\r\n\r\n        (scrollDiv = $(\"<div>\")).attr(\"class\",\"documents-table-scroll\")\r\n            .css({\r\n                position: \"absolute\",\r\n                \"overflow-x\": \"auto\",\r\n                \"overflow-y\": \"visible\",\r\n                left: 0,\r\n                right: 0,\r\n                top: 0,\r\n                bottom: 0,\r\n                \"padding-bottom\": \"80px\"\r\n            })\r\n            .insertBefore(tableToFix);\r\n\r\n        // creo il div scrollabile\r\n        tableToFix.appendTo(scrollDiv).addClass(clazz);\r\n\r\n        tableToFix.attr(\"headerFixedID\", headerFixedID);\r\n\r\n        rowForWidth = $(\"thead tr th\", tableToFix);\r\n    }\r\n    else\r\n    {\r\n        rowForWidth = $(\"thead tr th\", $(\"#\"+headerFixedID));\r\n    }\r\n\r\n    var col = 0;\r\n    var jqCells = tableToFix.find(\"> tbody\").find(\"> tr:first\").find(\"> td\");\r\n    //todo [simone]: cambiare questo ciclo\r\n    rowForWidth.each(function() {\r\n        var __this = $(this);\r\n        var _cell = $(jqCells.get(col++));\r\n        var _w = parseInt(_cell.get(0).style.width, 10);\r\n        var _maxw = parseInt(_cell.css(\"max-width\"), 10);\r\n        if(isNaN(_w))\r\n            _w = _cell.css(\"width\");\r\n        if(isNaN(_maxw))\r\n            _maxw = 9999999;\r\n\r\n        _w = Math.min( parseInt(_w, 10), _maxw );\r\n\r\n        $(\"img.img-for-width\", _cell).remove();\r\n        $(\"img.img-for-width\", __this).remove();\r\n\r\n        __this.css(\"width\",_w);\r\n        _cell.css(\"width\",_w);\r\n\r\n        var imgHTML = \"<img class=\\\"img-for-width\\\" style=\\\"height:1px;width:\"+_w+\"px;display:block;\\\" src=\\\"data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7\\\">\";\r\n        _cell.append(imgHTML);\r\n        __this.append(imgHTML);\r\n    });\r\n\r\n    if(headerFixed) {\r\n        var headerFixedTable = headerFixed.find(\"> table\");\r\n        if(!existsCopy)\r\n        {\r\n            headerFixedTable.append($(\"thead\", tableToFix));\r\n            if( !$(\"#bd.tablet\").length ) {\r\n                scrollDiv.bind(\"scroll.tableHeaderFixScroll\", function() {\r\n                    var currentState = {\"x\":$(this).scrollLeft(), \"y\":$(this).scrollTop()};\r\n\r\n                    headerFixed.css(\"left\", -currentState.x);\r\n                    var idxState = -1;\r\n                    var viewState = HistoryManager.getCurrentPage()[\"viewState\"];\r\n\r\n                    if(!viewState) {\r\n                        viewState = HistoryManager.getCurrentPage()[\"viewState\"] = {};\r\n                    }\r\n                    viewState[\"query-result-docs\"] = currentState;\r\n                });\r\n            }\r\n\r\n            scrollDiv.css(\"top\", headerFixedTable.css(\"height\"));\r\n\r\n            var viewState = HistoryManager.getCurrentPage()[\"viewState\"];\r\n            if(viewState && viewState.hasOwnProperty(\"query-result-docs\")) {\r\n                $(\".documents-table-scroll\").scrollTop(viewState[\"query-result-docs\"].y).scrollLeft(viewState[\"query-result-docs\"].x);\r\n            }\r\n\r\n            if( isTablet() ) {\r\n                var table_iscroll = new IScroll(\".documents-table-scroll\", {\r\n                    scrollX : true, \"tap\": false\r\n                });\r\n                table_iscroll.on('scrollEnd', function () {\r\n                    var _l = this.x;\r\n                    headerFixed.css(\"left\", _l);\r\n                });\r\n                if(typeof displayMoreRowsButton !== 'undefined')\r\n                    table_iscroll.on('scrollEnd', displayMoreRowsButton);\r\n                headerFixed.data(\"iscroll-instance\",table_iscroll);\r\n            }\r\n        }\r\n        else\r\n        {\r\n            if( isTablet() ) {\r\n                headerFixed.data(\"iscroll-instance\").refresh();\r\n            }\r\n        }\r\n    }\r\n    return scrollDiv;\r\n}\r\n\r\nfunction fixTableHeaderWidth(tableToFix)\r\n{\r\n    var col = 0;\r\n    $(\"tr:first td\", tableToFix).each(function() {\r\n        var _cell = $($(\"#header-copy table tr th\").get(col++));\r\n        $(\".img-for-width\", _cell).remove();\r\n        $(\"<img>\").css(\"height\",0)\r\n            .css(\"width\",$(this).outerWidth())\r\n            .addClass(\"img-for-width\")\r\n            .css(\"display\",\"block\")\r\n            .attr(\"src\",\"data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7\")\r\n            .appendTo(_cell);\r\n    });\r\n\r\n    $(\"#header-copy\").css(\"width\",$(\".documents-table-scroll\").innerWidth());\r\n    $(\"#header-copy > table\").css(\"width\", tableToFix.css(\"width\"));\r\n}\r\n\r\nvar table_iscroll_before;\r\nfunction resetAndFixTableFirstColumn(tableToFix, num, scrollContainer) {\r\n    table_iscroll_before = void 0;\r\n    fixTableFirstColumn(tableToFix, num, scrollContainer);\r\n}\r\n/* crea un header fisso per la tabella passata come argomento */\r\nfunction fixTableFirstColumn(tableToFix, num, scrollContainer)\r\n{\r\n    var scrollDiv = null, tableWithFixedColumns = null;\r\n    var existsCopy = (tableWithFixedColumns = $(\"#first-column-copy\")).length > 0;\r\n\r\n    console.time(\"Creating first-column-copy\");\r\n    if(!existsCopy) {\r\n        // creo la tabella con l'header fisso\r\n        (tableWithFixedColumns=$(\"<div>\"))\r\n            .attr(\"id\", \"first-column-copy\")\r\n            .css({\r\n                left: 0,\r\n                \"margin-left\": 0,\r\n                position: \"absolute\",\r\n                overflow: \"visible\",\r\n                \"z-index\": 2,\r\n                \"background-color\": \"#fff\",\r\n                \"border-right\": \"1px solid #C7C7C7\"\r\n            })\r\n            .insertBefore(tableToFix)\r\n            .append(\r\n                $(\"<table>\")\r\n                    .addClass(\"documents-table\")\r\n                    .css({\r\n                        \"border-spacing\": 0,\r\n                        \"border-collapse\": \"collapse\"\r\n                    })\r\n                    .append(\"<tbody>\")\r\n            );\r\n\r\n        var _klass = tableToFix.attr(\"id\")+\"-table-scroll\";\r\n        var d = $(\"<div>\").attr(\"class\",_klass)\r\n            .css({\r\n                position: \"absolute\",\r\n                left: 0,\r\n                top: 0,\r\n                width: \"100%\",\r\n                \"z-index\": 1,\r\n                \"padding-bottom\": \"200px\"\r\n            })\r\n            .insertBefore(tableToFix);\r\n\r\n        if( scrollContainer ) {\r\n            d.css(\"overflow\", \"visible\");\r\n        } else {\r\n            d.css({\r\n                overflow: \"auto\",\r\n                right: 0,\r\n                bottom: 0\r\n            });\r\n        }\r\n\r\n        // creo un div fisso con le 3 colonne che poi verranno fissate anche nel table body\r\n        var headerFixedID = tableToFix.attr(\"headerFixedID\");\r\n        if( headerFixedID ) {\r\n            var headerFixed = $(\"#\"+headerFixedID);\r\n            var tb = $(\"<table>\").append($(\"<thead>\").append(\"<tr>\"));\r\n            var headerFixedCols = headerFixed.find(\"th\"), headerFixedColsHTML = \"\";\r\n            if( !headerFixedCols.length ) {\r\n                // non c'è nessuna colonna da gestire, elimino i nodi creati ed esco\r\n                try{\r\n                    tableWithFixedColumns.remove();\r\n                    d.remove();\r\n                }catch(e){}\r\n\r\n                return;\r\n            }\r\n            for(var iHeadCol = 0; iHeadCol < num; iHeadCol++) {\r\n                headerFixedColsHTML += headerFixedCols.get(iHeadCol).outerHTML;\r\n                headerFixedCols.get(iHeadCol).style.visibility = 'hidden';\r\n            }\r\n            try {\r\n                tb.find(\"> thead > tr\").get(0).innerHTML = headerFixedColsHTML;\r\n            } catch(e) {}\r\n\r\n            var cssStyle = {\r\n                \"border-left\": \"3px solid #E4E4E4\",\r\n                \"z-index\": 2\r\n            };\r\n            if( !$(\"#bd.tablet\")[0] ) {\r\n                cssStyle[\"position\"] = \"absolute\";\r\n                cssStyle[\"left\"] = \"-2px\"; //2px sono per i bordi\r\n                cssStyle[\"top\"] = \"0px\";\r\n            }\r\n            headerFixed.append(\r\n                $(\"<div>\").addClass(\"fixed-columns-thead-container\").css(cssStyle).append(tb)\r\n            );\r\n        }\r\n\r\n        // creo il div scrollabile\r\n        tableToFix.appendTo(d);\r\n    }\r\n    console.timeEnd(\"Creating first-column-copy\");\r\n\r\n    console.time(\"Migrating cells to first-column-copy's table\");\r\n\r\n    var _fixedTableLeft = 0;\r\n    var fixedTableBody = $(\"table tbody\", tableWithFixedColumns);\r\n\r\n    var itr = 0, alreadyCopied = 0;\r\n    if( existsCopy ) {\r\n        alreadyCopied = tableToFix.data(\"fixTableFirstColumn\");\r\n    }\r\n\r\n    var fixedTableRows = [];\r\n    $(\"tr\", tableToFix||$(\"#first-column-copy .documents-table\")).each(function() {\r\n        // salto le righe già copiate, perchè questo metodo mi viene richiamato più volte\r\n        if( itr >= alreadyCopied ) {\r\n            var __this = $(this);\r\n            var __tr   = null;\r\n            var _h = 0;\r\n\r\n            for(var col=0; col<(num||1); col++) {\r\n                //todo [simone]: cambiare questo ciclo\r\n                var _cell  = __this.find(\"> td\")[col];\r\n                var $_cell = $(_cell);\r\n\r\n                if(itr == 0) {\r\n                    _fixedTableLeft += $_cell.outerWidth();\r\n                }\r\n\r\n                // le celle sono tutte alte uguali, quindi lo calcolo solo una volta\r\n                if(!_h) {\r\n                    _h = $_cell.height();\r\n                    // all'ultima cella della riga originale setto l'altezza così spostando la cella con la famiglia,\r\n                    // non rischio che cambi l'altezza della cella\r\n                    setTimeout(function() {\r\n                        var _allTableCells = __this.find(\"> td\");\r\n                        for(var iCell = 0; iCell<_allTableCells.length; iCell++) {\r\n                            var _c = _allTableCells[iCell];\r\n                            _c.style.height = _h;\r\n                            _c.style.maxHeight = _h;\r\n                        }\r\n                    }, 25);\r\n                }\r\n\r\n                if( col == 0 ) {\r\n                    __tr = $(\"<tr>\").addClass(\"document-row\").appendTo(fixedTableBody);\r\n                    __tr.data( __this.data() );\r\n                    $.each(__this.prop(\"attributes\"), function() {\r\n                        __tr.attr(this.name, this.value);\r\n                    });\r\n                    fixedTableRows.push({\r\n                        row: __tr,\r\n                        movedCellsHtml: [],\r\n                        cellsToRemove: []\r\n                    });\r\n                }\r\n                _cell.style.height = _h;\r\n                fixedTableRows[fixedTableRows.length-1].movedCellsHtml.push( _cell.outerHTML );\r\n                fixedTableRows[fixedTableRows.length-1].cellsToRemove.push( $_cell );\r\n            }\r\n        }\r\n        itr++;\r\n    });\r\n\r\n    if( _fixedTableLeft )\r\n        tableWithFixedColumns.css(\"width\", _fixedTableLeft);\r\n\r\n    // nascondo le colonne originali della tabella, e sostituisco gli input per evitare di confonderli con quelli clonati\r\n    // li sostituisco con un'immagine per mantenere le dimensioni originali degli elementi\r\n    for(var iR = 0; iR<fixedTableRows.length; iR++) {\r\n        var _html = fixedTableRows[iR].movedCellsHtml.join(\"\");\r\n        fixedTableRows[iR].row[0].innerHTML = _html;\r\n        for(var iC = 0; iC<fixedTableRows[iR].cellsToRemove.length; iC++) {\r\n            var _c = fixedTableRows[iR].cellsToRemove[iC].get(0);\r\n            fixedTableRows[iR].cellsToRemove[iC].find(\"input\").each(function(){\r\n                var $input = $(this);\r\n                var h = parseInt($input.height(), 10)+'px';\r\n                var w = parseInt($input.width(), 10)+'px';\r\n                var margin = $input.css(\"margin\");\r\n                $input.replaceWith('<img class=\"img-for-height\" style=\"display:inline-block;margin:'+margin+';width:'+w+';height:'+h+';\" src=\"data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7\">');\r\n            });\r\n            _c.style.visibility = 'hidden';\r\n        }\r\n    }\r\n\r\n    tableToFix.data(\"fixTableFirstColumn\", itr);\r\n    console.timeEnd(\"Migrating cells to first-column-copy's table\");\r\n\r\n    console.time(\"Attaching first-column-copy's events\");\r\n    var headerFixedID = tableToFix.attr(\"headerFixedID\"),\r\n            headerFixed   = $(\"#\"+headerFixedID).find(\"> div\");\r\n    if( !$(\"#bd.tablet\")[0] ) {\r\n        ( scrollContainer || d ).unbind(\"scroll.firstColumnFixedScroll\").bind(\"scroll.firstColumnFixedScroll\", function() {\r\n            var currentState = {\"x\":$(this).scrollLeft(), \"y\":$(this).scrollTop()};\r\n\r\n            if( scrollContainer ) {\r\n                tableWithFixedColumns.css(\"left\", currentState.x);\r\n                headerFixed.css(\"left\", currentState.x-2); //2px sono per i bordi\r\n                if( currentState.x > 0 ) {\r\n                    tableWithFixedColumns.get(0).style.boxShadow = 'rgb(204, 204, 204) 4px -3px 6px -2px';\r\n                    headerFixed.get(0).style.boxShadow = 'rgb(204, 204, 204) 4px 1px 6px -2px';\r\n                } else {\r\n                    tableWithFixedColumns.get(0).style.boxShadow = 'none';\r\n                    headerFixed.get(0).style.boxShadow = 'none';\r\n                }\r\n            }\r\n        });\r\n    }else{\r\n        var table_iscroll = table_iscroll_before;\r\n        if(typeof table_iscroll === \"undefined\") {\r\n            table_iscroll = new IScroll(\".documents-table-scroll\", {\r\n                scrollX: true, scrollY: true,\r\n                \"tap\": false, scrollbars: true, hideScrollbar: false\r\n            });\r\n        }\r\n\r\n        table_iscroll.refresh();\r\n        table_iscroll.off('scrollEnd');\r\n        table_iscroll.on('scrollEnd', function () {\r\n            if(typeof displayMoreRowsButton !== 'undefined')\r\n                displayMoreRowsButton();\r\n        });\r\n\r\n        headerFixed.data(\"iscroll-instance\",table_iscroll);\r\n        table_iscroll_before = table_iscroll;\r\n        return table_iscroll_before;\r\n    }\r\n\r\n    console.timeEnd(\"Attaching first-column-copy's events\");\r\n}\r\n\r\nfunction fixTableHeaderHeight(tableToFix)\r\n{\r\n    var col = 0;\r\n    $(\"tr td:first\", tableToFix).each(function() {\r\n        var _cell = $($(\"#first-column-copy table tr td:first-child\").get(col++));\r\n        _cell.css(\"max-height\",$(this).outerHeight());\r\n\r\n        $(\"<img>\").css(\"width\",0)\r\n            .css(\"height\",$(this).outerHeight())\r\n            .css(\"display\",\"block\")\r\n            .attr(\"src\",\"data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7\")\r\n            .appendTo(_cell);\r\n    });\r\n\r\n    $(\"#first-column-copy\").css(\"height\",$(\".documents-table-scroll\").innerHeight());\r\n    $(\"#first-column-copy > table\").css(\"height\", tableToFix.css(\"height\"));\r\n}\r\n\r\n/**\r\n * Esegue una funzione senza in un blocco try-catch\r\n * @param func La funzione da eseguire\r\n * @param [optional] onerror Il metodo da richiamare se viene generata un'eccezione in func\r\n */\r\nfunction tryCatch(func, onerror)\r\n{\r\n    try { func.call(); } catch(e) { if(onerror) onerror.call(this, e); }\r\n}\r\nvar customEventParams = { detail: { message: \"\", time: new Date() }, bubbles: true, cancelable: true };\r\nvar showTipsEvent, hideTipsEvent, changePageEvent;\r\ntryCatch(function(){showTipsEvent = new CustomEvent(\"showTips\", customEventParams);});\r\ntryCatch(function(){hideTipsEvent = new CustomEvent(\"hideTips\", customEventParams);});\r\ntryCatch(function(){changePageEvent = new CustomEvent(\"changePage\", customEventParams);});\r\n\r\nfunction showDocumentPreview(id, fileName, urlOverride)\r\n{\r\n    var documentPreviewBar = $(\"#document-preview\");\r\n    if(documentPreviewBar.hasClass(\"preview-closed\"))\r\n    {\r\n        AdiutoUserSettings.save(\"view-document-sequence\", true);\r\n        documentPreviewBar.removeClass(\"preview-closed\").addClass(\"preview-opened\");\r\n        $(\"#view-document-button\").removeClass(\"preview-closed\").addClass(\"preview-opened\");\r\n        $(\"#view-document\").html(LangManager.get(\"ui.js.close.preview\")+\" \"+fileName);//\"Chiudi anteprima\r\n        $(\"#document-info-container\").css(\"overflow\",\"hidden\");\r\n\r\n        if( !$(\"#document-preview-iframe\").length )\r\n        {\r\n            // aggiungendo dinamicamente l'iframe con direttamente il src che punta al documento si risolve il baco\r\n            // di ie che lasciava la pagina bianca quando si andava indietro di una pagina\r\n            $(\"<iframe>\").attr(\"name\", \"document-preview-iframe\").attr(\"id\",\"document-preview-iframe\").appendTo(documentPreviewBar);\r\n            loadIFrame(\"document-preview-iframe\", (urlOverride||\"/adiJed/ui/view-doc.do\")+\"?id=\"+id);\r\n        }\r\n    }\r\n    else\r\n    {\r\n        AdiutoUserSettings.save(\"view-document-sequence\", false);\r\n        documentPreviewBar.addClass(\"preview-closed\").removeClass(\"preview-opened\");\r\n        $(\"#view-document-button\").addClass(\"preview-closed\").removeClass(\"preview-opened\");\r\n        $(\"#view-document\").html(LangManager.get(\"ui.js.open.preview\")+\" \"+fileName);//\"Anteprima\r\n        $(\"#document-info-container\").css(\"overflow\",\"auto\");\r\n    }\r\n}\r\n\r\nvar __DEBUG_STYLE = '';\r\nvar currentWidth = 0, targetWidth = 0;\r\nvar allCustomClasses = [\"def\",\"big\",\"small\",\"smaller\",\"tablet\",\"w500\",\"w800\",\"w1024\",\"w1400\"];\r\nfunction applyDeviceStyle(style, defaultStyle)\r\n{\r\n    style = style||\"\";\r\n\r\n    $(allCustomClasses).each(function(i,el){ $(\"#bd\").removeClass(el) });\r\n\r\n    if(/iPhone|iPod/i.test(navigator.userAgent) || (window[\"isSmartphone\"] && isSmartphone())/*(isMobile() && targetWidth <= 767)*/)\r\n    {\r\n        if( defaultStyle === \"true\" ) {\r\n            $(\"#bd\").addClass(\"small\").addClass(\"smaller\");\r\n        } else {\r\n            documentLocation(\"/adiJed/ui/touch.home.do\");\r\n        }\r\n    }\r\n    else if((window[\"isTablet\"] && isTablet()) || style == \"tablet\"/*(isTouchDevice() && targetWidth > 767 && targetWidth < 1281)*/)\r\n    {\r\n        $(\"#bd\").addClass(\"tablet\");\r\n        /*if (defaultStyle === \"true\") {\r\n            $(\"#bd\").addClass(\"tablet\");\r\n        } else {\r\n            document.location = \"/adiJed/ui/touch.home.do\";\r\n        }*/\r\n    }\r\n    else if(targetWidth <= 500)\r\n    {\r\n        if (defaultStyle === \"true\") {\r\n            $(\"#bd\").addClass(\"small\").addClass(\"smaller\").addClass(\"w500\");\r\n        } else {\r\n            documentLocation(\"/adiJed/ui/touch.home.do\");\r\n        }\r\n    }\r\n    else if(targetWidth <= 800)\r\n    {\r\n        $(\"#right-app-container\").removeClass(\"pinned\");\r\n        $(\"#bd\").removeClass(\"pinned-right-container\");\r\n        $(\"#bd\").addClass(\"small\").addClass(\"w800\");\r\n    }\r\n    else if(targetWidth <= 1024)\r\n    {\r\n        $(\"#right-app-container\").removeClass(\"pinned\");\r\n\t\t$(\"#bd\").removeClass(\"pinned-right-container\");\r\n        $(\"#bd\").addClass(\"def\").addClass(\"w1024\");\r\n    }\r\n    else if(targetWidth > 1401)\r\n    {\r\n        $(\"#bd\").addClass(\"big\").addClass(\"w1400\");//.addClass(\"pinned-right-container\");\r\n//        $(\"#right-app-container\").addClass(\"pinned\");\r\n    }\r\n    else\r\n    {\r\n        $(\"#bd\").addClass(\"def\");\r\n    }\r\n}\r\n\r\n// todo [simone]: aggiungere come discriminante anche la dimensione verticale (x smartphone)\r\nfunction fitToScreen(userID, defaultStyle)\r\n{\r\n    if(!__DEBUG_STYLE)\r\n    {\r\n        targetWidth = windowWidth();\r\n        if( targetWidth > currentWidth )\r\n        {\r\n            applyDeviceStyle(void(0), defaultStyle);\r\n            currentWidth = targetWidth;\r\n        }\r\n\r\n        if(userID)\r\n            AdiutoUserSettings.restoreUserSettings(userID);\r\n    }\r\n    else\r\n    {\r\n        if(userID)\r\n            AdiutoUserSettings.restoreUserSettings(userID);\r\n\r\n        $(allCustomClasses).each(function(i,el){ $(\"#bd\").removeClass(el) });\r\n\r\n        $(\"#bd\").addClass(__DEBUG_STYLE);\r\n    }\r\n}\r\n\r\nfunction windowWidth()\r\n{\r\n    return document.getElementById(\"bd\").offsetWidth;\r\n}\r\n\r\nfunction getFileSizeReadable(fileSizeInBytes)\r\n{\r\n    var i = -1;\r\n    var byteUnits = [' kB', ' MB', ' GB', ' TB', 'PB', 'EB', 'ZB', 'YB'];\r\n    do {\r\n        fileSizeInBytes = fileSizeInBytes / 1024;\r\n        i++;\r\n    } while (fileSizeInBytes > 1024);\r\n\r\n    return Math.max(fileSizeInBytes, 0.1).toFixed(1) + byteUnits[i];\r\n}\r\nfunction attachEventToIFrameLoaded(iframe, evtFunc) {\r\n    iframe.onreadystatechange = function(){\r\n        if (iframe.readyState == \"complete\"){\r\n            evtFunc.call();\r\n        }\r\n    };\r\n}\r\n\r\nvar previewHidden = false;\r\n/**\r\n * Apre una nuova kendoWindow all'interno di un iframe\r\n * Viene automaticamente incluso tutto il javascript come se la pagina fosse caricata senza iframe (la pagina richiesta verrà\r\n * inclusa all'interno di includes/action-with-iframe.jsp\r\n *\r\n * Per passare argomenti alla funzione di callback alla chiusura della window vedi es. sotto\r\n * $(\"#XXXXX.k-window-content\").attr(\"dirty\", XXXX).attr(\"_arguments\", PARAMETRI_COME_STRINGA).data(\"kendoWindow\").close();\r\n *\r\n * params {\"width\": \"50%\", \"height\": \"50%\", \"title\": \"\", \"modal\": true, \"resizable\": false, \"Maximize\": false}\r\n *\r\n * @param id\r\n * @param url passare solo il percorso a partire da web\\ui (es. messages\\send.jsp)\r\n * @param params\r\n * @param callback\r\n * @returns {*|jQuery}\r\n */\r\nfunction openWindowInsideIFrame(id, url, params, callback) {\r\n\tparams[\"iframe\"] = \"true\";\r\n\t\r\n\tif(url.indexOf(\"?\") > 0) {\r\n\t\turl = url.replace(\"?\", \"&\");\r\n\t}\r\n\turl = \"includejsp=\"+url;\r\n\t\r\n\tvar _wnd = openWindow(id, \"/adiJed/ui/includes/action-with-iframe.jsp?\"+url, params, callback, true);\r\n\t_wnd.css(\"padding\", \"0\");\r\n\treturn _wnd;\r\n}\r\n\r\n/**\r\n * Apre una nuova kendoWindow\r\n *\r\n * Per passare argomenti alla funzione di callback alla chiusura della window vedi es. sotto\r\n * $(\"#XXXXX.k-window-content\").attr(\"dirty\", XXXX).attr(\"_arguments\", PARAMETRI_COME_STRINGA).data(\"kendoWindow\").close();\r\n *\r\n * params {\"width\": \"50%\", \"height\": \"50%\", \"title\": \"\", \"modal\": true, \"resizable\": false, \"Maximize\": false}\r\n *\r\n * @param id\r\n * @param url\r\n * @param params\r\n * @param callback\r\n * @returns {*|jQuery}\r\n */\r\nfunction openWindow(id, url, params, callback, doNotHideThis)\r\n{\r\n    var _wnd = $(\"<div>\").attr(\"id\",id).addClass(\"adi-modal-dialog-container\").appendTo(document.body);\r\n//    var previewHidden = false;\r\n    var actions = [];\r\n    var fullscreen = false;\r\n\r\n    if(params[\"Minimize\"]==undefined || (params[\"Minimize\"] && params[\"Minimize\"]==true)){\r\n        actions.push(\"Minimize\");\r\n    }\r\n\r\n    if(params[\"Maximize\"]==undefined || (params[\"Maximize\"] && params[\"Maximize\"]==true)){\r\n        actions.push(\"Maximize\");\r\n    }\r\n\r\n    if(params[\"fullscreen\"] && params[\"fullscreen\"]==true){\r\n        fullscreen = true\r\n    }\r\n    actions.push(\"Close\");\r\n\r\n    // il plugin browsedirectory, usa all'interno percorsi relativi, per farli funzionare devo aprire il contenuto all'interno dell'iframe\r\n\t// altrimenti vengono considerati relativi a /adiJed\r\n\t// messo anche qui per sistemare i plugin già installati nella cartella 1001 (?)\r\n\tif(url.indexOf(\"/BrowseDirectory\") != -1) {\r\n\t\tparams[\"iframe\"] = \"true\";\r\n\t}\r\n\r\n    if (!_wnd.data(\"kendoWindow\")) {\r\n        _wnd.kendoWindow({\r\n            width: params[\"width\"] || \"50%\",\r\n            height: params[\"height\"] || \"50%\",\r\n            maxHeight: params[\"maxHeight\"] || undefined,\r\n            title: params[\"title\"] || \"\",\r\n            iframe: params[\"iframe\"] || \"\",\r\n            content: url,\r\n            modal: (params[\"modal\"]!=undefined ? params[\"modal\"] : true),\r\n            resizable: (params[\"resizable\"]!=undefined ? params[\"resizable\"] : true),\r\n            actions: actions,\r\n            open: function() {\r\n                // nascondo la preview perchè altrimenti va a coprire la nuova finestra aperta\r\n                var documentPreview = $(\"#document-preview\");\r\n                var newdocumentPreview = $(\"#new-document-preview\");\r\n                //ROSSTE - 20180112\r\n                if (detectIE() && !previewHidden){\r\n                    if(!documentPreview.hasClass(\"preview-closed\")) {\r\n                        if( $(\"#document-preview-iframe\").length ) {\r\n                            //Controllo se sto usando il visualizzatore integrato\r\n                            if (((typeof $(\"#document-preview-iframe\")[0].contentDocument === \"unknown\"))||($(\"#document-preview-iframe\")[0].contentDocument.title != \"PDF Viewer\")){\r\n                                $(\"#document-preview-iframe\").css(\"visibility\",\"hidden\");\r\n                                previewHidden = true;\r\n                                \r\n                                _wnd.data(\"previewHiddenInWindow\", true);\r\n                            }\r\n                        }\r\n                    }\r\n                    \r\n                    if( $(\"#new-document-preview iframe\").length ) {\r\n                        //Controllo se sto usando il visualizzatore integrato\r\n                        if (((typeof $(\"#new-document-preview iframe\")[0].contentDocument === \"unknown\"))||($(\"#new-document-preview iframe\")[0].contentDocument.title != \"PDF Viewer\")){\r\n                            $(\"#new-document-preview iframe:not(.always-visible)\").css(\"visibility\",\"hidden\");\r\n                            previewHidden = true;\r\n                            \r\n                            _wnd.data(\"previewHiddenInWindow\", true);\r\n                        }\r\n                    }\r\n                }\r\n\r\n\t\t\t\tvar hiddenExcludedSelector = \"iframe:not(.always-visible):not(#document-preview-iframe):not(#new-document-preview iframe):not(#list-data-container iframe)\";\r\n\t\t\t\tif( doNotHideThis )\r\n\t\t\t\t\thiddenExcludedSelector += \":not(#\"+id+\" iframe)\";\r\n\t\t\t\t\r\n                $(hiddenExcludedSelector).each(function() {\r\n                    $(this).css(\"visibility\",\"hidden\");\r\n                });\r\n\r\n                jQuery('.k-overlay').unbind('click').one('click', function() {\r\n                    _wnd.data(\"kendoWindow\").close();\r\n                });\r\n                if($(\"body\").hasClass(\"tablet\")) {\r\n                    _wnd.data(\"kendoWindow\").maximize();\r\n                } else {\r\n                    _wnd.data(\"kendoWindow\").center();\r\n                }\r\n            },\r\n            close: function() {\r\n                // riabilito la preview se era stata nascosta durante l'apertura\r\n                if( previewHidden && _wnd.data(\"previewHiddenInWindow\") ) {\r\n                    $(\"#document-preview-iframe\").css(\"visibility\",\"visible\");\r\n                    previewHidden = false;\r\n                }\r\n\r\n                $(\"iframe:not(.always-visible)\").each(function() {\r\n                    $(this).css(\"visibility\",\"visible\");\r\n                });\r\n\r\n                _wnd.fadeOut(100, function(){\r\n                    var isDirty = _wnd.attr(\"dirty\");\r\n                    _wnd.data(\"kendoWindow\").destroy();\r\n                    if(callback)\r\n                    {\r\n                        callback.call(this,_wnd.attr(\"_arguments\"));\r\n                    }\r\n                    else if(isDirty == \"true\")\r\n                    {\r\n                        HistoryManager.reloadLastPage();\r\n                    }\r\n                });\r\n            }\r\n        });\r\n\r\n        if(fullscreen && fullscreen == true){\r\n            _wnd.data(\"kendoWindow\").maximize();\r\n        }\r\n    }\r\n\r\n    if($(\"body\").hasClass(\"tablet\")) {\r\n        _wnd.data(\"kendoWindow\").open();\r\n    } else {\r\n        _wnd.data(\"kendoWindow\").open();\r\n    }\r\n\r\n    return _wnd;\r\n}\r\n\r\nvar AdiutoUserSettings = parent.AdiutoUserSettings || {\r\n    userSettings: null,\r\n\r\n    save: function(attr,val,storeOnDatabase)\r\n    {\r\n        var $this = this;\r\n        \r\n        if( !storeOnDatabase && $this.userSettings === null ) {\r\n            //settings have not been initialized yet\r\n            return;\r\n        }\r\n        \r\n        var saveSettingsToServer = function() {\r\n            ADA.storeUserSettings($this.userSettings);\r\n        };\r\n\r\n        if(storeOnDatabase) {\r\n           ADA.saveSettings(attr,val);\r\n        } else {\r\n            $this.userSettings[attr] = val;\r\n            saveSettingsToServer();\r\n\r\n            if(localStorage && localStorage.getItem && $this.userSettings != null) {\r\n                try {\r\n                    Logger.debug(\"Storing \"+attr+\"=\"+val+\" in user settings: \"+JSON.stringify($this.userSettings));\r\n                    localStorage.setItem('adiuto.user.'+$this.userSettings[\"fius\"]+'.local.settings', JSON.stringify($this.userSettings));\r\n                    Logger.debug(\"New settings: \"+JSON.stringify($this.userSettings));\r\n                } catch(e) {\r\n                    Logger.error(e);\r\n                }\r\n            }\r\n        }\r\n    },\r\n\r\n    deleteSettings: function(attr, storeOnDatabase, async)\r\n    {\r\n        if(storeOnDatabase) {\r\n           ADA.deleteSettings(attr, arguments.length == 3 ? async : true);\r\n        } else if(localStorage && localStorage.getItem && this.userSettings != null) {\r\n            //TODO implementare\r\n        }\r\n    },\r\n\r\n    load: function(attr,def,loadFromDatabase)\r\n    {\r\n        var returnVal = def;\r\n\r\n        if(loadFromDatabase) {\r\n            returnVal = ADA.loadSettings(attr)['val'];\r\n\r\n        } else {\r\n            if(this.userSettings != null && this.userSettings[attr]) {\r\n                returnVal = this.userSettings[attr];\r\n            }\r\n        }\r\n        return returnVal;\r\n    },\r\n\r\n    restoreUserSettings: function(userID)\r\n    {\r\n        var dfd = new $.Deferred();\r\n        var $this = this;\r\n        if(this.userSettings == null)\r\n        {\r\n            ADA.loadUserSettings(function(result) {\r\n                if( result && result.data ) {\r\n                    $this.userSettings = result.data;\r\n                    dfd.resolve();\r\n                } else if( localStorage && localStorage.getItem ) {\r\n                    try {\r\n                        var records = localStorage.getItem(\"adiuto.user.\"+userID+\".local.settings\");\r\n\r\n                        if(records) {\r\n                            Logger.debug(\"Restoring user settings: \"+records);\r\n                            $this.userSettings = JSON.parse(records);\r\n                            $this.userSettings = $this.userSettings[0]||$this.userSettings;\r\n                            if(!$this.userSettings[\"fius\"]) {\r\n                                $this.userSettings[\"fius\"] = userID;\r\n                            }\r\n                        } else {\r\n                            $this.userSettings = {\"fius\": userID};\r\n                            Logger.debug(\"Creating new settings for user: \"+JSON.stringify($this.userSettings));\r\n                        }\r\n\r\n                        dfd.resolve();\r\n\r\n                    } catch(e) {\r\n                        Logger.error(e);\r\n                        dfd.reject();\r\n                    }\r\n                }\r\n            });\r\n        }\r\n        else\r\n        {\r\n            dfd.resolve();\r\n        }\r\n        return dfd;\r\n    }\r\n};\r\n\r\nvar DivSplitter = {\r\n    splitterUniqueID: 0,\r\n\r\n    setPositions: function(A,B,pos)\r\n    {\r\n        Logger.debug('DivSplitter.setPosition('+pos+')');\r\n        var splitter = null;\r\n\r\n        B.css(\"left\",pos-10);\r\n        A.css(\"width\",pos-11);\r\n\r\n        if( A.attr(\"__splitter_instance\") )\r\n        {\r\n            splitter = $(\"#\"+A.attr(\"__splitter_instance\"));\r\n            splitter.css(\"left\",pos-12);\r\n        }\r\n    },\r\n    hideLeft: function(A,B)\r\n    {\r\n        if(A.attr(\"hiddenLeft\") != \"true\")\r\n        {\r\n            A.attr(\"hiddenLeft\", \"true\");\r\n            B.attr(\"leftBefore\", B.css(\"left\"));\r\n            A.attr(\"widthBefore\", A.css(\"width\"));\r\n            B.css(\"left\",0);\r\n            A.css(\"width\",0);\r\n\r\n            if( A.attr(\"__splitter_instance\") )\r\n            {\r\n                splitter = $(\"#\"+A.attr(\"__splitter_instance\"));\r\n                splitter.attr(\"_display\",splitter.css(\"display\"));\r\n                splitter.css(\"display\",\"none\");\r\n            }\r\n        }\r\n    },\r\n    restore: function(A,B)\r\n    {\r\n        if(A.attr(\"hiddenLeft\") == \"true\")\r\n        {\r\n            A.removeAttr(\"hiddenLeft\");\r\n            B.css(\"left\",B.attr(\"leftBefore\"));\r\n            A.css(\"width\",A.attr(\"widthBefore\"));\r\n\r\n            B.removeAttr(\"leftBefore\");\r\n            A.removeAttr(\"widthBefore\");\r\n\r\n            if( A.attr(\"__splitter_instance\") )\r\n            {\r\n                splitter = $(\"#\"+A.attr(\"__splitter_instance\"));\r\n                Logger.debug('splitter[left]=\"'+B.attr(\"leftBefore\")+'\"');\r\n                splitter.css(\"left\",parseInt(B.attr(\"leftBefore\"))-12);\r\n                splitter.css(\"display\",splitter.attr(\"_display\"));\r\n                setTimeout(function(){splitter.removeAttr(\"_display\");}, 350);\r\n            }\r\n        }\r\n    },\r\n    /**\r\n     * aggiunge divisore tra i due div affiancati verticalmente\r\n     * il container di A e B deve avere position relative, o absolute\r\n     * @param A div di sx\r\n     * @param B div di dx\r\n     * @param moveCallback\r\n     */\r\n    split: function(A, B, moveCallback)\r\n    {\r\n        var splitter = null;\r\n        if( A.attr(\"__splitter_instance\") )\r\n        {\r\n            splitter = $(\"#\"+A.attr(\"__splitter_instance\"));\r\n        }\r\n        if( splitter == null )\r\n        {\r\n            Logger.debug('DivSplitter.split[left]=\"'+A.width()+'\"');\r\n            splitter = $(\"<div></div>\").attr({\r\n                \"id\": \"_splt_uid_\"+(++this.splitterUniqueID),\r\n                \"class\": \"splitter\"\r\n            }).css({\r\n               /* todo: rendere dinamico il posizionamento della barra che permette di ridimensionare i 2 div */\r\n                \"position\": \"absolute\",\r\n                \"visibility\": \"hidden\",\r\n                \"top\": 0,\r\n                \"bottom\": 0,\r\n                \"width\": \"6px\",\r\n                \"left\": A.width()-1,\r\n                \"background-color\": \"#add8e6\",\r\n                \"cursor\": \"ew-resize\",\r\n                \"opacity\": .1,\r\n                \"z-index\": 99\r\n            }).hover(\r\n                function(){ if(!splitter.attr(\"dragging\")) $(this).css(\"opacity\", 1); },\r\n                function(){ if(!splitter.attr(\"dragging\")) $(this).css(\"opacity\",.1); }\r\n            ).insertAfter(A);\r\n\r\n            splitter.mousedown(function(e){\r\n                var ghost = splitter.clone().insertAfter(splitter).css({\"opacity\":.6, \"cursor\":\"ew-resize\"});\r\n\r\n                var _mousemove = function(e) {\r\n                    ghost.css(\"left\",Math.max(200,Math.min(A.parent().width()/2, e[\"pageX\"]))-12);\r\n                    splitter.attr(\"dragging\", true);\r\n                };\r\n                var _mouseup = function(e) {\r\n                    splitter.removeAttr(\"dragging\");\r\n                    ghost.remove();\r\n                    var _x = Math.max(200,Math.min(A.parent().width()/2, e[\"pageX\"]));\r\n                    DivSplitter.setPositions(A,B,_x);\r\n                    $(document).unbind(\"mousemove\", _mousemove).unbind(\"mouseup\", _mouseup);\r\n\r\n                    if(moveCallback)\r\n                    {\r\n                        moveCallback.call(this, e,_x);\r\n                    }\r\n                };\r\n\r\n                $(document).mousemove(_mousemove).mouseup(_mouseup);\r\n            });\r\n\r\n            A.attr(\"__splitter_instance\",splitter.attr(\"id\"));\r\n            A.css(\"transition\", \"width .35s ease\");\r\n            B.css(\"transition\", \"left .35s ease\");\r\n            setTimeout(function(){splitter.css(\"visibility\", \"visible\");},350);\r\n        }\r\n\r\n        return splitter;\r\n    }\r\n};\r\n\r\nfunction checkEmailAddress(email) {\r\n    var Email_reg_exp=/^([a-zA-Z0-9_.-])+@([a-zA-Z0-9_.-])+\\.([a-zA-Z])+([a-zA-Z])+/;\r\n    var re = new RegExp(Email_reg_exp);\r\n    if (!email || (email == \"\") || (email == \"undefined\") || !email.match(re)) {\r\n        return false;\r\n    }\r\n    return true;\r\n}\r\n\r\n\r\nfunction themeSetup()\r\n{\r\n    if(loadedThemes == null)\r\n    {\r\n        loadedThemes = [];\r\n        loadThemes();\r\n        initFont();\r\n        $(\"#themeChooser\").on('click', function(ev){ev.stopPropagation();});\r\n    }\r\n\r\n    $(\".change-theme\").one('click',function(ev){\r\n        ev.stopPropagation();\r\n\r\n        var container = $(\"#themeChooser\");\r\n        if(!container.hasClass(\"opened\"))\r\n        {\r\n            container.addClass(\"opened\");\r\n\r\n            container.animate({height: \"100px\"}, 300, function(){\r\n                $(\".change-theme\").one('click', function(ev) { ev.stopPropagation(); hideThemesBar(); });\r\n                $(document).one('click', function() { if($(\"#themeChooser\").hasClass(\"opened\")) { $(\".change-theme\").off('click'); hideThemesBar(); } } );\r\n            });\r\n        }\r\n    });\r\n}\r\n\r\nfunction initFont(){\r\n    var savedFont = AdiutoUserSettings.load(\"font\", false);\r\n    if(savedFont)\r\n    {\r\n        chosenFont = savedFont;\r\n        $(\"#fontChooser\").val(chosenFont);\r\n        loadFont(chosenFont);\r\n    }\r\n}\r\n\r\nfunction loadFont(font)\r\n{\r\n    var _fontRule = findCssRule('*, .__fontStyle');\r\n    removeCSSRule(null, _fontRule.ruleID);\r\n    addCSSRule(null, '*, .__fontStyle','font-family: \\''+font+'\\' !important;');\r\n}\r\n\r\nfunction saveFont(){\r\n    chosenFont = $(\"#fontChooser\").val();\r\n    AdiutoUserSettings.save(\"font\",chosenFont);\r\n    loadFont(chosenFont);\r\n}\r\n\r\nvar loadedThemes = null, chosenTheme = \"\", chosenFont = \"\";\r\nvar loadedThemesCss = [];\r\n\r\nfunction loadThemes()\r\n{\r\n    $.ajax({\r\n        type: \"GET\",\r\n        url: \"/adiJed/ui/get-themes.do\",\r\n        dataType: 'json'\r\n    }).done(function(result){\r\n        var themes = result[\"allThemes\"];\r\n        var container = $(\"#themeChooser\");\r\n\r\n        for(var it=0; it < themes.length; it++)\r\n        {\r\n            var theme = themes[it];\r\n            var themePreview = theme[\"preview\"];\r\n            loadedThemes[themePreview[\"prefix\"]] = theme;\r\n\r\n            $(\"<div>\")\r\n                .text(themePreview[\"name\"])\r\n                .css({color: themePreview[\"color\"], backgroundColor: themePreview[\"bg-color\"], boxShadow: \"5px 4px 6px -3px \"+themePreview[\"bg-color\"]})\r\n                .addClass(\"theme-preview\")\r\n                .addClass(\"theme-preview-\"+themePreview[\"prefix\"])\r\n                .addClass(\"theme-preview-\"+(themePreview[\"style\"]||\"\"))\r\n                .attr(\"theme\",themePreview[\"prefix\"])\r\n                .hover(previewTheme, unloadPreview)\r\n                .click(function(){\r\n                    $(this).attr(\"chosen\", true);\r\n                    var bd = $(\"body#bd\");\r\n                    if(chosenTheme != \"\")\r\n                        bd.removeClass(\"theme-\"+chosenTheme);\r\n                    chosenTheme = $(this).attr(\"theme\");\r\n                    AdiutoUserSettings.save(\"theme\",chosenTheme);\r\n\r\n                    bd.addClass(\"theme-\"+chosenTheme);\r\n                    if(chosenTheme != \"default\")\r\n                    {\r\n                        var themeStyle = \"\";\r\n                        try {\r\n                            themeStyle = loadedThemes[savedTheme][\"preview\"][\"style\"];\r\n                        } catch(e) {\r\n                            // ignore this\r\n                        }\r\n                        switch(themeStyle)\r\n                        {\r\n                            case \"tablet\":\r\n                                applyDeviceStyle(\"tablet\");\r\n                                break;\r\n                            default:\r\n                                applyDeviceStyle();\r\n                        }\r\n                    }\r\n                    $(\".change-theme\").off(\"click\");\r\n                    hideThemesBar();\r\n                })\r\n                .appendTo(container);\r\n        }\r\n\r\n        var savedTheme = AdiutoUserSettings.load(\"theme\", false);\r\n        if(savedTheme)\r\n        {\r\n            chosenTheme = savedTheme;\r\n            var theme = loadedThemes[savedTheme];\r\n            if(theme) {\r\n                loadCSS(\"/adiJed/css/themes/\"+theme[\"filename\"]);\r\n                loadedThemesCss[savedTheme] = true;\r\n            }\r\n            $(\"#bd\").addClass(\"theme-\"+savedTheme);\r\n        }\r\n    });\r\n}\r\nfunction hideThemesBar()\r\n{\r\n    var container = $(\"#themeChooser\");\r\n    container.animate({height: \"0\"}, 100, function(){\r\n        $(\"#themeChooser\").removeClass(\"opened\");\r\n        themeSetup();\r\n    });\r\n}\r\n\r\nfunction unloadPreview()\r\n{\r\n    if(!$(this).attr(\"chosen\"))\r\n    {\r\n        var th = $(this).attr(\"theme\");\r\n        var theme = loadedThemes[th];\r\n        var bd = $(\"body#bd\");\r\n        if(theme[\"preview\"][\"prefix\"] != \"\") {\r\n            bd.removeClass(\"theme-\"+theme[\"preview\"][\"prefix\"]);\r\n            Logger.debug(\"[unloadPreview] remove class: \"+\"theme-\"+theme[\"preview\"][\"prefix\"]);\r\n        }\r\n        if(chosenTheme != \"\")\r\n            bd.addClass(\"theme-\"+chosenTheme);\r\n    }\r\n}\r\nfunction previewTheme()\r\n{\r\n    var th = $(this).attr(\"theme\");\r\n    var theme = loadedThemes[th];\r\n    if(!loadedThemesCss[th]) {\r\n        loadCSS(\"/adiJed/css/themes/\"+theme[\"filename\"]);\r\n        loadedThemesCss[th] = true;\r\n    }\r\n    var bd = $(\"body#bd\");\r\n    var allClassNames = (\"\"+(bd.attr(\"class\"))).split(' ');\r\n    for(var ic=0; ic<allClassNames.length; ic++)\r\n    {\r\n        var klassName = allClassNames[ic];\r\n        if(klassName.indexOf(\"theme-\") != -1)\r\n        {\r\n            bd.removeClass(klassName.trim());\r\n            Logger.debug(\"[previewTheme] remove class: \"+klassName.trim());\r\n        }\r\n    }\r\n    bd.addClass(\"theme-\"+theme[\"preview\"][\"prefix\"]);\r\n}\r\n\r\nfunction loadCSS(href) {\r\n    var cssLink = $(\"<link rel='stylesheet' type='text/css' href='\"+href+\"'>\");\r\n    $(\"head\").append(cssLink);\r\n}\r\n\r\nvar utilRegexps = {\r\n    email: /^(?:[\\w\\!\\#\\$\\%\\&\\'\\*\\+\\-\\/\\=\\?\\^\\`\\{\\|\\}\\~]+\\.)*[\\w\\!\\#\\$\\%\\&\\'\\*\\+\\-\\/\\=\\?\\^\\`\\{\\|\\}\\~]+@(?:(?:(?:[a-zA-Z0-9](?:[a-zA-Z0-9\\-](?!\\.)){0,61}[a-zA-Z0-9]?\\.)+[a-zA-Z0-9](?:[a-zA-Z0-9\\-](?!$)){0,61}[a-zA-Z0-9]?)|(?:\\[(?:(?:[01]?\\d{1,2}|2[0-4]\\d|25[0-5])\\.){3}(?:[01]?\\d{1,2}|2[0-4]\\d|25[0-5])\\]))$/,\r\n    url: /^(?:(?:ht|f)tp(?:s?):\\/\\/|~\\/|\\/)?(?:\\w+:\\w+@)?((?:(?:[-\\w\\d{1-3}]+\\.)+(?:com|org|net|gov|mil|biz|info|mobi|name|aero|jobs|edu|co\\.uk|ac\\.uk|it|fr|cn|tw|hk|jp|de|tv|museum|asia|local|travel))|((\\b25[0-5]\\b|\\b[2][0-4][0-9]\\b|\\b[0-1]?[0-9]?[0-9]\\b)(\\.(\\b25[0-5]\\b|\\b[2][0-4][0-9]\\b|\\b[0-1]?[0-9]?[0-9]\\b)){3}))(?::[\\d]{1,5})?(?:(?:(?:\\/(?:[-\\w~!$+|.,=]|%[a-f\\d]{2})+)+|\\/)+|\\?|#)?(?:(?:\\?(?:[-\\w~!$+|.,*:]|%[a-f\\d{2}])+=?(?:[-\\w~!$+|.,*:=]|%[a-f\\d]{2})*)(?:&(?:[-\\w~!$+|.,*:]|%[a-f\\d{2}])+=?(?:[-\\w~!$+|.,*:=]|%[a-f\\d]{2})*)*)*(?:#(?:[-\\w~!$ |\\/.,*:;=]|%[a-f\\d]{2})*)?$/i,\r\n    urlprotocol: /^(?:(?:ht|f)tp(?:s?):\\/\\/|~\\/|\\/)/i,\r\n    cc: /^(?:4[0-9]{12}(?:[0-9]{3})?|5[1-5][0-9]{14}|6(?:011|5[0-9][0-9])[0-9]{12}|3[47][0-9]{13}|3(?:0[0-5]|[68][0-9])[0-9]{11}|(?:2131|1800|35\\d{3})\\d{11})$/,\r\n    urlsafe: /^[^&$+,\\/:=?@ <>\\[\\]\\{\\}\\\\^~%#]+$/\r\n}\r\n\r\nfunction checkEmail(str)\r\n{\r\n    return str.search(utilRegexps.email) != -1;\r\n}\r\n\r\nfunction parseForLinks(str)\r\n{\r\n    var urls = [], _str = str;\r\n    // scommentare qui sotto per cercare il link all'interno di una stringa qualsiasi,\r\n    // altrimenti adesso lo crea solo se il link è tutto il campo indice\r\n//    $.each(str.split(\" \"), function(idx,_str)\r\n//    {\r\n        while(_str.search(utilRegexps.url) != -1)\r\n        {\r\n            var res = _str.match(utilRegexps.url);\r\n            var reparsedUrl = res[0];\r\n            if(reparsedUrl.search(utilRegexps.urlprotocol) != 0)\r\n            {\r\n                reparsedUrl = \"http://\"+reparsedUrl;\r\n            }\r\n            var currentMatch = res.length?{url: reparsedUrl, originalUrl: res[0], txt: res[1]}:null;\r\n\r\n            if(currentMatch != null)\r\n            {\r\n                urls.push(currentMatch);\r\n                _str = _str.replace(currentMatch.originalUrl,\"\");\r\n            }\r\n        }\r\n//    });\r\n    return urls;\r\n}\r\n\r\nvar ricerca = function(containerToSkroll, inputTextSearch, howMany, objectToTest){\r\n\r\n    this.skroll = containerToSkroll;\r\n    this.foundText = 0;\r\n    this._searchResult = [];\r\n    this.searchText = function (tag,_txt)\r\n    {\r\n        if(_txt != '' && tag.tagName && tag.tagName == \"IFRAME\" && tag.contentWindow.document.body.innerText.toLowerCase().indexOf(_txt.toLowerCase()) != -1)\r\n        {\r\n            var re = new RegExp('('+_txt.replace('/','\\\\/')+')','i');\r\n            if(!tag._oh)\r\n            {\r\n                tag._oh = tag.innerHTML;\r\n            }\r\n            tag._highlighted = 'si';\r\n            var colorHighlight = '#a2f4fc';\r\n            if(this.foundText == 0) colorHighlight = '#ffff00';\r\n            tag.innerHTML = tag.innerText.replace(re, '<B class=\"labelV\" style=\"background-color:'+colorHighlight+';\">$1</B>');\r\n            this.foundText++;\r\n            if(!this._searchResult[_txt]) this._searchResult[_txt] = new Array();\r\n            var _res = this._searchResult[_txt];\r\n            _res.push(tag);\r\n        }\r\n        else if(_txt != '' && tag.innerText && tag.innerText.toLowerCase().indexOf(_txt.toLowerCase()) != -1)\r\n        {\r\n            var re = new RegExp('('+_txt.replace('/','\\\\/')+')','i');\r\n            if(!tag._oh)\r\n            {\r\n                tag._oh = tag.innerHTML;\r\n            }\r\n            tag._highlighted = 'si';\r\n            var colorHighlight = '#a2f4fc';\r\n            if(this.foundText == 0) colorHighlight = '#ffff00';\r\n            tag.innerHTML = tag.innerText.replace(re, '<B class=\"labelV\" style=\"background-color:'+colorHighlight+';\">$1</B>');\r\n            this.foundText++;\r\n            if(!this._searchResult[_txt]) this._searchResult[_txt] = new Array();\r\n            var _res = this._searchResult[_txt];\r\n            _res.push(tag);\r\n        }\r\n        else if(tag && tag._highlighted && tag._highlighted == 'si')\r\n        {\r\n            tag.innerHTML = tag._oh;\r\n            tag._highlighted = 'no';\r\n        }\r\n    }\r\n\r\n    this._lastSearch = '';\r\n    this._lastIdx = 0;\r\n    this.idt = -1;\r\n    this.doSearchText = function (txt)\r\n    {\r\n        if(this.idt != -1) clearTimeout(this.idt);\r\n        var superThis = this;\r\n        this.idt = setTimeout(function (){superThis.doFind.call(superThis,txt.replace('\\'','`'))},220);\r\n    }\r\n    this.doFind = function (txt)\r\n    {\r\n        this.foundText = 0;\r\n        if(txt != '' && txt == this._lastSearch)\r\n        {\r\n            if(txt != this._lastSearch)\r\n            {\r\n                this._lastIdx = -1;\r\n            }\r\n            var _res = this._searchResult[txt];\r\n            if( _res )\r\n            {\r\n                _res[this._lastIdx].innerHTML = _res[this._lastIdx].innerHTML.replace('#ffff00','#a2f4fc'); //Giallo - Azzurro\r\n                var _showIdx = this._lastIdx < _res.length - 1 ? this._lastIdx + 1 : 0;\r\n                this.skroll.animate({scrollTop: this.getOffSetTop($(_res[_showIdx])) }, 500);\r\n                _res[_showIdx].innerHTML = _res[_showIdx].innerHTML.replace('#a2f4fc','#ffff00');\r\n                this._lastIdx = _showIdx;\r\n            }\r\n            else\r\n            {\r\n                inputTextSearch.css(\"background-color\", txt != '' ? '#FF6666' : 'white'); //Rosso\r\n            }\r\n        }\r\n        else\r\n        {\r\n            this._searchResult = [];\r\n            this._lastIdx = 0;\r\n            var ret = new Array();\r\n            ret = this.query(this.searchText,txt);\r\n            this._lastSearch = txt;\r\n            inputTextSearch.css(\"background-color\", txt != '' ? this.foundText>0 ? 'white' : '#FF6666' : 'white');\r\n            if(this.foundText>0)\r\n            {\r\n                var _res = this._searchResult[txt];\r\n                this.skroll.animate({scrollTop: this.getOffSetTop($(_res[0])) }, 500);\r\n                howMany.html(LangManager.get(\"generic.match.found\", this.foundText));\r\n            }\r\n            else if(txt == '' || this.foundText == 0){\r\n                this.skroll.animate({scrollTop: 0 }, 500);\r\n                howMany.html('');\r\n            }\r\n        }\r\n    }\r\n\r\n    this.getOffSetTop = function(obj){\r\n        if( obj.prop && obj.prop(\"tagName\") == \"IFRAME\" ) {\r\n            return obj[0].offsetParent.offsetTop;\r\n        }\r\n        var offset = obj.position().top;\r\n        return offset;\r\n    }\r\n\r\n    this.query = function (iqueryCallback,txt,stopOnFirst){\r\n        var ret = null;\r\n        //Adding this item to the result if must be selected ...\r\n        ret = new Array();\r\n        var elements;\r\n\r\n        elements = objectToTest;\r\n        for (var i = 0; i < elements.length; i++) {\r\n            var obj = elements[i];\r\n            if (iqueryCallback.call(this, obj,txt) == true)\r\n            {\r\n                ret.push(obj);\r\n                if(stopOnFirst)\r\n                    return ret;\r\n            }\r\n        }\r\n        return ret;\r\n    }\r\n}\r\n\r\nvar ricercaTitoli = function(containerToSkroll, inputTextSearch, howMany, _objectToTest, funcSelect, funcDeSelect){\r\n\r\n    this.objectToTest = _objectToTest;\r\n    this.skroll = containerToSkroll;\r\n    this.foundText = 0;\r\n    this._searchResult = [];\r\n    this.setObjectToTest = function (_objectToTest)\r\n    {\r\n        this.objectToTest = _objectToTest;\r\n    }\r\n    this.setContainerToSkroll = function (containerToSkroll)\r\n    {\r\n        this.skroll = containerToSkroll;\r\n    }\r\n    this.searchText = function (tag,_txt)\r\n    {\r\n        if(_txt != '' &&\r\n            ((tag.innerText && tag.innerText.toLowerCase().indexOf(_txt.toLowerCase()) != -1) ||\r\n                         (tag.title && tag.title.toLowerCase().indexOf(_txt.toLowerCase()) != -1)))\r\n        {\r\n            var colorHighlight = '#a2f4fc';                   //azzurro\r\n            tag._highlighted = 'si';\r\n            tag._oColor = $(tag).css(\"background-color\");\r\n            if(this.foundText == 0) {\r\n                colorHighlight = '#ffff00';\r\n            }\r\n\r\n            if(funcSelect){\r\n                funcSelect(tag,colorHighlight);\r\n            }else{\r\n                var itemId = $(tag).attr('itemId');\r\n                $('#listItem'+itemId).css(\"background-color\", colorHighlight); //TODO generalizzare\r\n            }\r\n\r\n            this.foundText++;\r\n            if(!this._searchResult[_txt]) this._searchResult[_txt] = new Array();\r\n            var _res = this._searchResult[_txt];\r\n            _res.push(tag);\r\n        }\r\n        else {\r\n            tag._highlighted = 'no';\r\n\r\n            if(funcDeSelect){\r\n                funcDeSelect(tag, tag._oColor);\r\n            }else{\r\n                var itemId = $(tag).attr('itemId'); //TODO generalizzare\r\n                $('#listItem'+itemId).css(\"background-color\", tag._oColor);\r\n            }\r\n\r\n        }\r\n\r\n    }\r\n\r\n    this._lastSearch = '';\r\n    this._lastIdx = 0;\r\n    this.idt = -1;\r\n    this.doSearchText = function (txt)\r\n    {\r\n        if(this.idt != -1) clearTimeout(this.idt);\r\n        var superThis = this;\r\n        this.idt = setTimeout(function (){superThis.doFind.call(superThis,txt.replace('\\'','`'))},220);\r\n    }\r\n    this.doFind = function (txt)\r\n    {\r\n        this.foundText = 0;\r\n        if(txt != '' && txt == this._lastSearch)\r\n        {\r\n            if(txt != this._lastSearch)\r\n            {\r\n                this._lastIdx = -1;\r\n            }\r\n            var _res = this._searchResult[txt];\r\n            if( _res )\r\n            {\r\n                var tag_lastIdx = _res[this._lastIdx];\r\n\r\n                if(funcSelect){\r\n                    funcSelect(tag_lastIdx,'#a2f4fc');\r\n                }else{\r\n                    var itemId = $(tag_lastIdx).attr('itemId'); //TODO generalizzare\r\n                    $('#listItem'+itemId).css(\"background-color\", '#a2f4fc');    //TODO generalizzare\r\n                }\r\n\r\n                var _showIdx = this._lastIdx < _res.length - 1 ? this._lastIdx + 1 : 0;\r\n                var tag_showIdx = _res[_showIdx];\r\n                this.skroll.animate({scrollTop: _res[_showIdx].offsetTop  }, 500);\r\n\r\n                if(funcSelect){\r\n                    funcSelect(tag_showIdx,'#ffff00');\r\n                }else{\r\n                    var itemId = $(tag_showIdx).attr('itemId'); //TODO generalizzare\r\n                    $('#listItem'+itemId).css(\"background-color\", '#ffff00');  //Giallo  //TODO generalizzare\r\n                }\r\n\r\n                this._lastIdx = _showIdx;\r\n            }\r\n            else\r\n            {\r\n                inputTextSearch.css(\"background-color\", txt != '' ? '#FF6666' : 'white'); //Rosso\r\n            }\r\n        }\r\n        else\r\n        {\r\n            this._searchResult = [];\r\n            this._lastIdx = 0;\r\n            var ret = new Array();\r\n            ret = this.query(this.searchText,txt);\r\n            this._lastSearch = txt;\r\n            inputTextSearch.css(\"background-color\", txt != '' ? this.foundText>0 ? 'white' : '#FF6666' : 'white');\r\n            if(this.foundText>0)\r\n            {\r\n                var _res = this._searchResult[txt];\r\n                this.skroll.animate({scrollTop: _res[0].offsetTop  }, 500);\r\n                if(howMany)\r\n                    howMany.html(LangManager.get(\"generic.match.found\", this.foundText));\r\n            }\r\n            else if(txt == '' || this.foundText == 0){\r\n                this.skroll.animate({scrollTop: 0 }, 500);\r\n                if(howMany)\r\n                    howMany.html('');\r\n            }\r\n        }\r\n    }\r\n\r\n    this.getOffSetTop = function(obj){\r\n        var offset = obj.position().top;\r\n        if(obj.parent()[0] !== this.skroll[0]){\r\n\r\n            offset += this.getOffSetTop(obj.parent());\r\n        }\r\n\r\n        return offset;\r\n    }\r\n\r\n    this.query = function (iqueryCallback,txt,stopOnFirst){\r\n        var ret = null;\r\n        //Adding this item to the result if must be selected ...\r\n        ret = new Array();\r\n        var elements;\r\n\r\n        elements = this.objectToTest;\r\n        for (var i = 0; i < elements.length; i++) {\r\n            var obj = elements[i];\r\n            if (iqueryCallback.call(this, obj,txt) == true)\r\n            {\r\n                ret.push(obj);\r\n                if(stopOnFirst)\r\n                    return ret;\r\n            }\r\n        }\r\n        return ret;\r\n    }\r\n}\r\nvar idExport = 0;\r\nfunction startExportQuery(type, checkIfExist, name, callBackFunction, reportFields, action, filter, iIdExport)\r\n{\r\n    var _start = function(type) {\r\n        var msg = \"\";\r\n        if(name)\r\n            msg = name;\r\n        else\r\n            msg = type == 'zip'? LangManager.get(\"ui.js.export.start\") : LangManager.get(\"ui.js.report.start\"); //\"Creazione esportazione file in corso...\"  \"Creazione report in corso...\"\r\n        var currentExport = idExport++;\r\n\r\n        var divExport = $(\"<div>\").addClass(\"download-query-info\").addClass(\"export-\"+type).attr(\"currentExportNum\",currentExport).css(\"display\",\"none\").append(\r\n                $(\"<div>\").text(msg).append(\r\n                    $(\"<span>\").addClass(\"cancel-export\").text(LangManager.get(\"ui.generic.buttons.cancel\")).click(function() {\r\n                            stopExport(currentExport, (callBackFunction? true: false));\r\n                    })\r\n                )\r\n            ).insertAfter($(\"#right-app-content\")).fadeIn(150, function() {\r\n                if(!callBackFunction){\r\n                    if(type=='zip'){\r\n                        downloadZipExport(type, currentExport, reportFields);\r\n                    }else{\r\n                        downloadQuery(type, currentExport, reportFields, action, filter, iIdExport);\r\n                    }\r\n                }else{\r\n                    callBackFunction(type, currentExport);\r\n                }\r\n\r\n            });\r\n\r\n        if(type=='zip')\r\n            divExport.addClass(\"download-query-zip-info\");\r\n    };\r\n    var _this = this;\r\n    if(checkIfExist && $(\".download-query-info\").length)\r\n    {\r\n        DialogManager.showAlert(LangManager.get(\"ui.js.export.in.progress\"));//\"C'è un'altra esportazione in corso, attendere...\"\r\n    }\r\n    else\r\n    {\r\n        _start.apply(_this, arguments);\r\n    }\r\n}\r\nfunction startAdminExport(type, nodeId, checkIfExist, name, callBackFunction)\r\n{\r\n    if(callBackFunction){\r\n        var _start = function(type, nodeId) {\r\n            var msg = \"\";\r\n            if(name)\r\n                msg = name;\r\n            else\r\n                msg = LangManager.get(\"ui.js.report.start\");//\"Creazione report in corso...\"\r\n            var currentExport = idExport++;\r\n\r\n            var divExport = $(\"<li>\").addClass(\"download-query-info\").addClass(\"admin-download-query-info\").attr(\"currentExportNum\",currentExport).css(\"display\",\"none\").append(\r\n                    $(\"<div>\").text(msg).append(\r\n                        $(\"<span>\").addClass(\"cancel-export\").text(LangManager.get(\"ui.generic.buttons.cancel\")).click(function() {\r\n                            stopExport(currentExport, true);\r\n                        })\r\n                    )\r\n                ).appendTo(\".nav-bar-buttons\").fadeIn(150, function() {\r\n                    if(callBackFunction){\r\n                        callBackFunction(type, nodeId, currentExport);\r\n                    }\r\n\r\n                });\r\n        };\r\n        var _this = this;\r\n        if(checkIfExist && $(\".download-query-info\").length)\r\n        {\r\n            DialogManager.showAlert(LangManager.get(\"ui.js.export.in.progress\"));//\"C'è un'altra esportazione in corso, attendere...\"\r\n        }\r\n        else\r\n        {\r\n            _start.apply(_this, arguments);\r\n        }\r\n    }\r\n}\r\nfunction downloadZipExport(type, expNum, reportFields)\r\n{\r\n    var url = '/adiJed/ui/query-export.do';\r\n    var data = 'action=makeZip&reportFields='+reportFields;\r\n\r\n    $.ajax({url: url,\r\n        type: \"POST\",\r\n        data: data,\r\n        dataType: 'json',\r\n        success: function(result) {\r\n            var exportIsReady = false;\r\n            if(result && result[\"STATUS\"])\r\n            {\r\n                var status = result[\"STATUS\"];\r\n                if(status != '-1' && status != '1' && status != ''){\r\n                    exportIsReady = true;\r\n                    downloadExportFile( status, expNum );\r\n                }\r\n            }\r\n            if(!exportIsReady)\r\n            {\r\n                setTimeout(function() {downloadZipExport(type, expNum);}, 500);\r\n            }\r\n        }\r\n    });\r\n}\r\n\r\nfunction downloadQuery(type, expNum, reportFields, action, filter, iIdExport)\r\n{\r\n    var url = '/adiJed/ui/query-export.do';\r\n    var data = 'action='+(action||'makeFile')+'&fileType='+(type||'csv')+'&reportFields='+reportFields;\r\n    if (filter != \"\")\r\n        data = data +'&'+filter;\r\n    if (iIdExport != null)\r\n        data = data + '&idexport='+iIdExport;\r\n\r\n    $.ajax({url: url,\r\n        type: \"POST\",\r\n        data: data,\r\n        dataType: 'json',\r\n        success: function(result) {\r\n            var exportIsReady = false;\r\n            if(result && result[\"STATUS\"])\r\n            {\r\n                var status = result[\"STATUS\"];\r\n                if(status != '-1' && status != '1' && status != ''){\r\n                    exportIsReady = true;\r\n                    downloadExportFile( status, expNum);\r\n                }\r\n            }\r\n            if(!exportIsReady)\r\n            {\r\n                setTimeout(function() {downloadQuery(type, expNum, reportFields, action);}, 500);\r\n            }\r\n        }\r\n    });\r\n}\r\nfunction downloadExportFile( path, expNum )\r\n{\r\n    if(path && path != '' && path != '-1' && path != '1' && path != '0'){\r\n        var url = '/adiJed/ui/query-export.do?action=getFile&filePath='+encodeURIComponent(path);\r\n        downloadThis( url );\r\n        $(\".download-query-info[currentExportNum=\"+expNum+\"]\").fadeOut(300, function(){\r\n            $(this).remove();\r\n        });\r\n    }\r\n}\r\nfunction downloadExportFile2(path, taskId)\r\n{\r\n    if(path && path != '' && path != '-1' && path != '1' && path != '0'){\r\n        var url = '/adiJed/ui/query-export.do?action=getFile&filePath='+encodeURIComponent(path)+\"&deleteFile=false\"+\"&taskId=\"+taskId;\r\n        return downloadThis( url );\r\n    }\r\n}\r\n\r\n\r\nfunction stopExport(expNum, hideOnly)\r\n{\r\n    if(hideOnly){\r\n        $(\".download-query-info[currentExportNum=\"+expNum+\"]\").fadeOut(300, function(){\r\n            $(this).remove();\r\n        });\r\n    }else{\r\n        var url = '/adiJed/ui/query-export.do';\r\n        var data = 'action=stopExport';\r\n\r\n        $.ajax({url: url,\r\n            type: \"POST\",\r\n            data: data,\r\n            dataType: 'json',\r\n            success: function(result) {\r\n                $(\".download-query-info[currentExportNum=\"+expNum+\"]\").fadeOut(300, function(){\r\n                    $(this).remove();\r\n                });\r\n            }\r\n        });\r\n    }\r\n}\r\n\r\n/* ritorna la window richiesta controllando se la pagina corrente è aperta in un iframe o meno */\r\nfunction getContainerWindow(wndId, foremostWindow)\r\n{\r\n    var wnd;\r\n    const windowSelector = wndId.indexOf(\".k-window-content\") === -1 ? wndId+\".k-window-content\" : wndId;\r\n    try {\r\n        if(adiutoTopWin.parent)\r\n            wnd = adiutoTopWin.parent.$(windowSelector);\r\n\r\n        if(!wnd || !wnd.length)\r\n            wnd = $(windowSelector);\r\n\r\n    } catch(e) {//cross-domain sec. ex\r\n        wnd = $(windowSelector);\r\n    }\r\n\r\n    return (wnd.length) ? foremostWindow ? wnd.last() : wnd : null;\r\n}\r\n\r\nfunction formatDataFromTimeStamp(date){\r\n    var value = \"\";\r\n    try{\r\n        value = date.replace(/(\\d{4})(\\d{2})(\\d{2}).*/,'$3/$2/$1');\r\n    } catch(e) {}\r\n\r\n\treturn value;\r\n}\r\n\r\nfunction formatDataTimeFromTimeStamp(date){\r\n    var value = date.replace(/(\\d{4})(\\d{2})(\\d{2})(\\d{2})(\\d{2})(\\d{2})/,'$3/$2/$1 $4:$5:$6');\r\n    return value;\r\n}\r\n\r\nfunction formatDataFromDB(date){\r\n    if( !date ) {\r\n        return \"\";\r\n    }\r\n\tvar value = date.replace(/(\\d{4})(\\d{2})(\\d{2})/,'$3/$2/$1');\r\n\treturn value;\r\n}\r\n\r\nfunction formatDataToDB(date){\r\n    var value = date.replace(/(\\d{2}).(\\d{2}).(\\d{4})/,'$3$2$1');\r\n    return value;\r\n}\r\n\r\nfunction formatDecimalFromDB(val) {\r\n    if( typeof val === 'number' ) {\r\n//        return val.format(2);\r\n\r\n        var loc =(new Intl.NumberFormat()).resolvedOptions().locale;\r\n        const formatter = new Intl.NumberFormat(loc, {\r\n            minimumFractionDigits: 2,\r\n            maximumFractionDigits: 2,\r\n        });\r\n\r\n        return formatter.format(val);\r\n    }\r\n    return val;\r\n}\r\nNumber.prototype.format = function (n, x) {\r\n    var re = '\\\\d(?=(\\\\d{' + (x || 3) + '})+' + (n > 0 ? '\\\\.' : '$') + ')';\r\n    return this.toFixed(Math.max(0, ~~n)).replace(new RegExp(re, 'g'), '$&,');\r\n};\r\n\r\nfunction createCustomEvent(name,params) {\r\n    try {\r\n        if(! window[name])\r\n            window[name] = new CustomEvent(name,params||customEventParams);\r\n    } catch(e) {\r\n        window[name] = document.createEvent(\"CustomEvent\");\r\n        window[name].initCustomEvent(name, false, false, params||{});\r\n    }\r\n}\r\n\r\n/**\r\n * Crea un tooltip stile quelli dentro ad un'attività wf per indicare che va fatto il modifica info\r\n *\r\n * @param el L'elemento al quale attaccare il tooltip\r\n * @param tooltipText Il testo del tooltip in html\r\n * @param classToAdd Opzionale, una classe\r\n * @param [optional] bubbleTipOptions\r\n * @param [optional] displayNow Se mostrare subito il tooltip appena creato\r\n * @return object Un'oggetto con i metodi hideTip e showTip\r\n */\r\nfunction createTooltip(/*object*/el, /*string*/tooltipText, /*string*/classToAdd, /*object*/bubbleTipOptions, /*boolean*/displayNow) {\r\n    var params = bubbleTipOptions||{};\r\n    var defaults = {\r\n        deltaDirection: 'down', animationDuration: 100, offsetTop: -5, delayHide: 0, offsetLeft: 0,\r\n        bindShow: \"showTips\", bindHide: \"hideTips\"\r\n    };\r\n    var opts = $.extend({}, defaults, params);\r\n\r\n    if( !el.hasClass(\"ad-has-tips\") ) {\r\n        var newTip = $(\"<div>\").addClass(classToAdd||false).css(\"display\",\"none\").append(\r\n            $(\"<pre>\").addClass(\"tip\").html(tooltipText)\r\n        ).appendTo(el);\r\n\r\n        el.addClass(\"ad-has-tips\").bubbletip(newTip, opts);\r\n\r\n        $(document).click(function(){ el.trigger(\"hideTips\"); $(document).unbind('click',this); });\r\n\r\n        $(\"#bd\").bind(\"changePage\", function() {el.trigger(\"hideTips\");});\r\n    }\r\n    if(displayNow) {\r\n        setTimeout(function(){el.trigger(\"showTips\");}, 250);\r\n    }\r\n    return {\r\n        hideTip: function() {\r\n            el.trigger(\"hideTips\");\r\n        },\r\n        showTip: function() {\r\n            el.trigger(\"showTips\");\r\n        }\r\n    };\r\n}\r\n\r\nvar AdiutoCacheStore = (function(w){\r\n    var cacheStore, keyCacheLinks;\r\n    if(!w[\"AdiutoCacheStore\"]){\r\n        w[\"AdiutoCacheStore\"]={};\r\n    }\r\n\r\n    cacheStore = w[\"AdiutoCacheStore\"];\r\n    keyCacheLinks = {};\r\n\r\n    $(w).unload(function() {\r\n        if(w[\"AdiutoCacheStore\"])\r\n            delete w[\"AdiutoCacheStore\"];\r\n    });\r\n\r\n    return {\r\n        retrieve: function(cache,k){\r\n            var values = [], caches = [];\r\n\r\n            if(cache !== \"*\") {\r\n                caches.push(cache);\r\n            } else if(keyCacheLinks.hasOwnProperty(k)) {\r\n                Array.prototype.push.apply(caches, keyCacheLinks[k]);\r\n            }\r\n            for(var i=0; i<caches.length; i++) {\r\n                var _cache = caches[i];\r\n                if(cacheStore.hasOwnProperty(_cache)) {\r\n                    var c = cacheStore[_cache];\r\n                    values.push(c[k]);\r\n                }\r\n            }\r\n\r\n            if(values.length == 1 && cache !== \"*\") {\r\n                return values[0];\r\n            } else if(values.length > 0) {\r\n                return values;\r\n            } else {\r\n                return null;\r\n            }\r\n        },\r\n        store: function(cache,k,o){\r\n            if(!cacheStore.hasOwnProperty(cache)) {\r\n                cacheStore[cache] = {};\r\n            }\r\n            if(!keyCacheLinks.hasOwnProperty(k)) {\r\n                keyCacheLinks[k] = [];\r\n            }\r\n            if(keyCacheLinks[k].indexOf(cache) === -1) {\r\n                keyCacheLinks[k].push(cache);\r\n            }\r\n            var c = cacheStore[cache];\r\n            if(!c.hasOwnProperty(k)) {\r\n                c[k] = o;\r\n            }\r\n        },\r\n        remove: function(cache,k){\r\n            if( cacheStore.hasOwnProperty(cache) ) {\r\n                if( typeof k !== 'undefined' ) {\r\n                    var c = cacheStore[cache];\r\n                    if( c.hasOwnProperty(k) ) {\r\n                        delete c[k];\r\n                        if(keyCacheLinks.hasOwnProperty(k) && keyCacheLinks[k].indexOf(cache) !== -1) {\r\n                            keyCacheLinks.splice(keyCacheLinks[k].indexOf(cache),1);\r\n                        }\r\n                    }\r\n                } else {\r\n                    delete cacheStore[cache];\r\n                }\r\n            }\r\n        },\r\n        replaceKey: function(cache,oldKey,newKey){\r\n            if(oldKey !== newKey) {\r\n                var caches = [];\r\n                if(cache !== \"*\") {\r\n                    caches.push(cache);\r\n                } else if(keyCacheLinks.hasOwnProperty(oldKey)) {\r\n                    Array.prototype.push.apply(caches, keyCacheLinks[oldKey]);\r\n                }\r\n                for(var i=0; i<caches.length; i++) {\r\n                    cache = caches[i];\r\n                    if(cacheStore.hasOwnProperty(cache) && oldKey !== newKey) {\r\n                        var c = cacheStore[cache];\r\n                        Object.defineProperty(c, newKey,\r\n                            Object.getOwnPropertyDescriptor(c, oldKey));\r\n                        delete c[oldKey];\r\n                    }\r\n                }\r\n                if(keyCacheLinks.hasOwnProperty(oldKey)) {\r\n                    Object.defineProperty(keyCacheLinks, newKey,\r\n                        Object.getOwnPropertyDescriptor(keyCacheLinks, oldKey));\r\n                    delete keyCacheLinks[oldKey];\r\n                }\r\n            }\r\n        }\r\n    };\r\n})(self);\r\n\r\nfunction setDocumentDeletedStatusInCache(id){\r\n    var d = AdiutoCacheStore.retrieve(\"*\",\"d\"+id);\r\n    if(d && d.length) {\r\n        for(var i=0; i<d.length; i++) {\r\n            d[i].del = true;\r\n        }\r\n    } else if(d) {\r\n        d.del = true;\r\n    }\r\n}\r\n\r\nfunction updateCachedDocInfo(fidd) {\r\n    var updateCachedDocInfoDeferred = new $.Deferred();\r\n\r\n    var __updateCachedDocValues = function(cachedDoc,extendedDocument){\r\n        for(var i=0; i<cachedDoc.v.length; i++){\r\n            cachedDoc.nComm = extendedDocument.numberOfComments;\r\n            cachedDoc.la = extendedDocument.legalArchived;\r\n            cachedDoc.ha = extendedDocument.attachmentsNum>0;\r\n            cachedDoc.hl = extendedDocument.linksNum>0;\r\n            cachedDoc.hd = extendedDocument.canHaveDetails;\r\n            cachedDoc.lb = extendedDocument.lockedBy;\r\n            cachedDoc.f28 = extendedDocument.values['F28'];\r\n            cachedDoc.f29 = extendedDocument.values['F29'];\r\n            var key = cachedDoc.v[i][0];\r\n            if (key.startsWith('DF')){\r\n                key = key.substring(1);\r\n            }\r\n            if(extendedDocument.values.hasOwnProperty(key)){\r\n                var newVal = extendedDocument.values[key];\r\n                switch(extendedDocument.types[key]) {\r\n                    case 3:\r\n                        newVal = formatDataFromDB(newVal);\r\n                        break;\r\n                    case 2:\r\n                        newVal = formatDecimalFromDB(newVal);\r\n                        break;\r\n                }\r\n                cachedDoc.v[i][1] = newVal;\r\n            }\r\n        }\r\n    };\r\n\r\n    try {\r\n        ADA.getDocumentInfo(fidd, function(ed){\r\n            var d = AdiutoCacheStore.retrieve(\"*\",\"d\"+fidd);\r\n            if(d && d.length) {\r\n                for(var i=0; i<d.length; i++) {\r\n                    __updateCachedDocValues(d[i], ed);\r\n                }\r\n            } else if(d) {\r\n                __updateCachedDocValues(d, ed);\r\n            }\r\n\r\n            updateCachedDocInfoDeferred.resolve();\r\n        });\r\n    }catch(e){\r\n        Logger.error(e);\r\n        updateCachedDocInfoDeferred.reject(e);\r\n    }\r\n\r\n    return updateCachedDocInfoDeferred;\r\n}\r\n\r\n\r\nfunction updateCachedDocInfoKey(fidd, key) {    \r\n    var __updateCachedDocValues = function(cachedDoc,extendedDocument){\r\n        for(var i=0; i<cachedDoc.v.length; i++){\r\n            cachedDoc.id = fidd;\r\n            cachedDoc.nComm = extendedDocument.numberOfComments;\r\n            cachedDoc.la = extendedDocument.legalArchived;\r\n            cachedDoc.ha = extendedDocument.attachmentsNum>0;\r\n            cachedDoc.hl = extendedDocument.linksNum>0;\r\n            cachedDoc.hd = extendedDocument.canHaveDetails;\r\n            cachedDoc.lb = extendedDocument.lockedBy;\r\n            cachedDoc.f28 = extendedDocument.values['F28'];\r\n            cachedDoc.f29 = extendedDocument.values['F29'];\r\n\r\n            if(extendedDocument.values.hasOwnProperty('F'+cachedDoc.v[i][0])){\r\n                var newVal = extendedDocument.values['F'+cachedDoc.v[i][0]];\r\n                switch(extendedDocument.types['F' + cachedDoc.v[i][0]]) {\r\n                    case 3:\r\n                        newVal = formatDataFromDB(newVal);\r\n                        break;\r\n                    case 2:\r\n                        newVal = formatDecimalFromDB(newVal);\r\n                        break;\r\n                }\r\n                cachedDoc.v[i][1] = newVal;\r\n            }\r\n        }\r\n    };\r\n    try {\r\n        ADA.getDocumentInfo(fidd, function(ed){\r\n            var d = AdiutoCacheStore.retrieve(\"*\",\"d\"+key);\r\n            if(d && d.length) {\r\n                for(var i=0; i<d.length; i++) {\r\n                    __updateCachedDocValues(d[i], ed);\r\n                }\r\n            } else if(d) {\r\n                __updateCachedDocValues(d, ed);\r\n            }\r\n        });\r\n    }catch(e){\r\n        Logger.error(e);\r\n    }\r\n}\r\n\r\nfunction insertFiddInClientCache(cacheKey, newFidd, headDocumentID, detailFamilyId) {\r\n    ADA.getDocumentInfo(newFidd, function(extendedDocument) {\r\n        var cacheDocVect = [];\r\n\r\n        for(var keyTmp in extendedDocument.values) {\r\n            var newVal = extendedDocument.values[keyTmp];\r\n            switch(extendedDocument.types[keyTmp]) {\r\n                case 3:\r\n                    newVal = formatDataFromDB(newVal);\r\n                    break;\r\n                case 2:\r\n                    newVal = formatDecimalFromDB(newVal);\r\n                    break;\r\n            }\r\n            if (newVal == null)\r\n                newVal = \"\";\r\n            var obj = [];\r\n            obj[0] = 'D'+keyTmp;\r\n            obj[1] = newVal;\r\n\r\n            cacheDocVect.push(obj);\r\n        }\r\n\r\n        AdiutoCacheStore.store(cacheKey, \"d\" + newFidd, {\r\n            fnh: extendedDocument.familyName,\r\n            la: extendedDocument.legalArchived,\r\n            nComm: extendedDocument.numberOfComments,\r\n            pha: extendedDocument.phantom,\r\n            del: false, id: newFidd,\r\n            f: extendedDocument.familyID,\r\n            i: 0, fi: 0,\r\n            lb: extendedDocument.lockedBy,\r\n            ha: extendedDocument.attachmentsNum>0,\r\n            hl: extendedDocument.linksNum>0,\r\n            hd: extendedDocument.canHaveDetails,\r\n            p: extendedDocument.completePathName,\r\n            f28: extendedDocument.values['F28'],\r\n            f29: extendedDocument.values['F29'],\r\n            trackingId: 0,\r\n            trackingFamilyId: 0,\r\n            headerDocumentID: headDocumentID,\r\n            isEnabled: true,\r\n            lnk: '',\r\n            tmplnk: '',\r\n            v: cacheDocVect,\r\n            userFields: []\r\n        });\r\n    });\r\n//    updateCachedDocInfo(newFidd);\r\n/*\r\n     for(var docIdKey in historyDocumentIDStore) {\r\n        if(historyDocumentIDStore[docIdKey].id && historyDocumentIDStore[docIdKey].id == oldFidd) {\r\n            historyDocumentIDStore[docIdKey].id = newFidd;\r\n        }\r\n    }\r\n    var d = AdiutoCacheStore.retrieve(\"*\",\"d\"+newFidd);\r\n    if(d && d.length) {\r\n        for(var i=0; i<d.length; i++) {\r\n            d[i].id = newFidd;\r\n        }\r\n    } else if(d) {\r\n        d.id = newFidd;\r\n    }\r\n*/\r\n    for(var historyPageKey in HistoryManager.__PAGES) {\r\n        var historyPage = HistoryManager.__PAGES[historyPageKey];\r\n        if(historyPage) {\r\n            if(historyPage[\"docs\"]) {\r\n                if (historyPage['queryKey'+detailFamilyId] && historyPage['queryKey'+detailFamilyId].startsWith('dett')){\r\n//                historyPage[\"docs\"].push(\"d\"+newFidd);\r\n                    historyPage[\"docs\"] = [\"d\"+newFidd].concat(historyPage[\"docs\"]);\r\n                }\r\n            }\r\n        }\r\n    }\r\n}\r\n\r\nfunction replaceFiddInClientCache(oldFidd,newFidd) {\r\n    var replaceFiddInClientCacheDeferred;\r\n\r\n    AdiutoCacheStore.replaceKey(\"*\",\"d\"+oldFidd,\"d\"+newFidd);\r\n\r\n    replaceFiddInClientCacheDeferred = updateCachedDocInfo(newFidd);\r\n\r\n    for(var docIdKey in historyDocumentIDStore) {\r\n        if(historyDocumentIDStore[docIdKey].id && historyDocumentIDStore[docIdKey].id == oldFidd) {\r\n            historyDocumentIDStore[docIdKey].id = newFidd;\r\n        }\r\n    }\r\n    var d = AdiutoCacheStore.retrieve(\"*\",\"d\"+newFidd);\r\n    if(d && d.length) {\r\n        for(var i=0; i<d.length; i++) {\r\n            d[i].id = newFidd;\r\n        }\r\n    } else if(d) {\r\n        d.id = newFidd;\r\n    }\r\n    for(var historyPageKey in HistoryManager.__PAGES) {\r\n        var historyPage = HistoryManager.__PAGES[historyPageKey];\r\n        if(historyPage && historyPage[\"docs\"]) {\r\n            var replaceFiddInHistoryPage = function(historyPageDocumentsCacheObject) {\r\n                if((idxOldFidd=historyPageDocumentsCacheObject.indexOf(\"d\"+oldFidd)) !== -1) {\r\n                    historyPageDocumentsCacheObject[idxOldFidd] = \"d\"+newFidd;\r\n                }\r\n            }\r\n\r\n            var historyPageDocuments = historyPage[\"docs\"];\r\n            var idxOldFidd = -1;\r\n            if(typeof historyPageDocuments.indexOf !== 'undefined') {\r\n                replaceFiddInHistoryPage(historyPageDocuments);\r\n            } else {\r\n                for(var historyDocsObjectProperty in historyPageDocuments) {\r\n                    if(typeof historyPageDocuments[historyDocsObjectProperty].indexOf !== 'undefined') {\r\n                        replaceFiddInHistoryPage(historyPageDocuments[historyDocsObjectProperty]);\r\n                    }\r\n                }\r\n            }\r\n        }\r\n    }\r\n\r\n    return replaceFiddInClientCacheDeferred;\r\n}\r\n\r\nfunction showPrewCommentInfo(docId){\r\n\r\n    var baseUrl = \"/adiJed/ui/workflow.get-prew-comment.do\";\r\n    var postData = \"docid=\"+docId;\r\n\r\n    $.ajax({url: baseUrl,\r\n    type: \"POST\",\r\n    data: postData,\r\n    dataType: 'json',\r\n    async: true,\r\n    success: function(result) {\r\n        if(result && result[\"info\"])\r\n        {\r\n            var message = '';\r\n            var prewCommentInfoTemplate = kendo.template($(\"#prewCommentInfoTemplate\").html());\r\n            message = prewCommentInfoTemplate(result[\"info\"]);\r\n\r\n            DialogManager.showAlert(message,null,LangManager.get(\"ui.js.commenti.ricevuti\"));\r\n        }\r\n    }\r\n    });\r\n\r\n}\r\n\r\nfunction changeCompany(companyId){\r\n    //TODO Sloggare l'utente\r\n    //Scollegare subito l'utente senza aspettare il pindar\r\n    //login automatico con utente e password salvati (visto che sono solo LDAP) e quindi homePage\r\n\r\n//    AdiutoUserSettings.save(\"view-document-sequence\", false);\r\n    showWaitDialog();\r\n    documentLocation('/adiJed/ui/switch-company.do?CO='+companyId);\r\n}\r\n\r\nfunction existValueInArray(value, values){\r\n    var exist = false;\r\n    for (var i = 0; i < values.length; i++) {\r\n        var obj = values[i];\r\n        if(value==obj){\r\n            exist = true;\r\n            break;\r\n        }\r\n    }\r\n    return exist;\r\n}\r\n\r\n\r\nfunction hexToR(h) {return parseInt((cutHex(h)).substring(0,2),16)}\r\nfunction hexToG(h) {return parseInt((cutHex(h)).substring(2,4),16)}\r\nfunction hexToB(h) {return parseInt((cutHex(h)).substring(4,6),16)}\r\nfunction cutHex(h) {return (h.charAt(0)==\"#\") ? h.substring(1,7):h}\r\nfunction cutRGB(h) {\r\n    if(h.toLowerCase().indexOf(\"rgb\")>=0){\r\n        var index1 = h.indexOf(\"(\");\r\n        var index2 = h.indexOf(\")\");\r\n        return h.substring(index1+1,index2);\r\n    }else{\r\n        return h;\r\n    }\r\n}\r\n\r\nfunction convertHexToRGB(hex){\r\n    var RGB = \"\";\r\n    if(hex && hex!=''){\r\n        var R = hexToR(hex);\r\n        var G = hexToG(hex);\r\n        var B = hexToB(hex);\r\n        RGB = R+\",\"+G+\",\"+B;\r\n    }\r\n    return RGB;\r\n}\r\n//Cambio il colore del carattere in base allo sfondo\r\nfunction getTextColor(backgroundColor){\r\n    var textColor = \"white\";\r\n    if(backgroundColor){\r\n        var colorNumbers = backgroundColor.split(',');\r\n        for (var i = 0; i < colorNumbers.length; i++) {\r\n            var number = parseInt(colorNumbers[i]);\r\n            if(number>150)\r\n                textColor = \"black\";\r\n        }\r\n    }\r\n    return textColor;\r\n}\r\n\r\nvar datePattern = new RegExp(\"[0-3][0-9]/(0|1)[0-9]/[1-9][0-9]{3}\");\r\nvar oraPattern = new RegExp(\"(?:[01]\\\\d|2[0-3]):(?:[0-5]\\\\d):(?:[0-5]\\\\d)\");\r\n\r\nString.prototype.__escapeHtml = function() {\r\n    var _new = this.replace(/[&<>\"'\\/]/g, function (s) {\r\n        return entityMap[s];\r\n    });\r\n    return _new;\r\n};\r\n\r\nvar entityMap = {\r\n    \"&\": \"&amp;\",\r\n    \"<\": \"&lt;\",\r\n    \">\": \"&gt;\",\r\n    '\"': '&quot;',\r\n    \"'\": '&#39;',\r\n    \"/\": '&#x2F;'\r\n};\r\n\r\nfunction compareDateGreaterOfDate(date1, date2){\r\n    var isGreater = false;\r\n    if((date1 && date2) && date1.getTime() > date2.getTime()){\r\n        isGreater = true;\r\n    }\r\n    return isGreater;\r\n}\r\n\r\nfunction getValueNotNull(a,b)\r\n{\r\n    return (a == undefined || a == null || a.trim().length==0) ? b : a;\r\n}\r\n\r\nfunction removeExport(taskId){\r\n    var url = '/adiJed/ui/query-export.do';\r\n    var data = 'action=removeExport&taskId='+taskId;\r\n\r\n    const removeExportDeferred = new $.Deferred();\r\n    $.ajax({url: url,\r\n        type: \"POST\",\r\n        data: data,\r\n        dataType: 'json',\r\n        success: function(result) {\r\n            removeExportDeferred.resolve(result);\r\n        },\r\n        error: function() {\r\n            removeExportDeferred.resolve(result);\r\n        },\r\n    });\r\n\r\n    return removeExportDeferred;\r\n}\r\nfunction removeAllExport(callback){\r\n    var url = '/adiJed/ui/query-export.do';\r\n    var data = 'action=removeAllExport';\r\n\r\n    $.ajax({url: url,\r\n        type: \"POST\",\r\n        data: data,\r\n        dataType: 'json',\r\n        success: function(result) {\r\n            if(callback){\r\n                callback();\r\n            }\r\n        }\r\n    });\r\n}\r\n\r\nvar loadRightAppTimeoutID = -1;\r\nfunction loadRightApp(loadView){\r\n\r\n    if(loadRightAppTimeoutID != -1)\r\n        clearTimeout(loadRightAppTimeoutID);\r\n\r\n    $.ajax({url: \"/adiJed/ui/system/right-app-content.do\", data: \"view=\"+(loadView||\"false\"),\r\n        success: function(html) {\r\n            var refreshFunction = function(){ loadRightAppTimeoutID = setTimeout(loadRightApp, 15000);};\r\n            $(\"#right-app-content\").html(html);\r\n            $(\".worflow-right-app\").hover(\r\n                function(){ if(loadRightAppTimeoutID != -1) clearTimeout(loadRightAppTimeoutID); },\r\n                refreshFunction\r\n            );\r\n            refreshFunction.call();\r\n        }\r\n    });\r\n}\r\nfunction viewExportsOLD(){\r\n\r\n    //var _url = \"/adiJed/ui/training/trainingView/utils/windowSchedulesInfo.jsp\"+\"?\";\r\n    var _url = \"/adiJed/ui/query-export.do\"+\"?\";\r\n\r\n    var _params = [];\r\n    _params.push(\"action=viewExports\");\r\n    _url += _params.join(\"&\");\r\n\r\n    openWindow(\"windowExportsInfo\", _url,\r\n        {\"title\": LangManager.get(\"ui.esportazioni\"), \"modal\": true, \"width\": \"400px\", \"height\": \"500px\"});\r\n}\r\nfunction viewExports(){\r\n\r\n    var _url = \"/adiJed/ui/home/windowExportsInfo.jsp\"+\"?\";\r\n    //var _url = \"/adiJed/ui/query-export.do\"+\"?\";\r\n\r\n/*    var _params = [];\r\n    _params.push(\"action=viewExports\");\r\n    _url += _params.join(\"&\");*/\r\n\r\n    openWindow(\"windowExportsInfo\", _url,\r\n        {\"title\": LangManager.get(\"ui.esportazioni\"), \"modal\": true, \"width\": \"400px\", \"height\": \"500px\"});\r\n}\r\n\r\nfunction exportDocumentPage(type, documentId, panelId, listPK)\r\n{\r\n    var url = '/adiJed/ui/query-export.do';\r\n    var postData =  \"action=exportDocPage\"+\r\n        \"&docId=\"+documentId+\r\n        \"&panelId=\"+panelId+\r\n        \"&titoloExp=\"+encodeUR