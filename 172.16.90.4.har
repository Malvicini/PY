          "content": {
            "size": 6166,
            "mimeType": "text/html",
            "compression": -1,
            "text": "\r\n\r\n\r\n\r\n\r\n\r\n\r\n<div id=\"right-saved-search\" class=\"right-item\">\r\n    <span style=\"display: none;\">Carica query salvate</span>           \r\n</div>\r\n<div class=\"exports-right-app\" >\r\n    <div class=\"right-item exports-icon\">\r\n        <span style=\"font-size: 140%;\">Esportazioni</span>         \r\n        \r\n            <span class=\"bullet-indicator right-item-bullet\">5</span>\r\n        \r\n    </div>\r\n    \r\n</div>\r\n<div class=\"worflow-right-app\">\r\n    <div class=\"right-item workflow-icon\">\r\n        <span style=\"font-size: 140%;\">ATTIVITÀ</span>         \r\n        \r\n            <span class=\"bullet-indicator right-item-bullet\">1</span>\r\n        \r\n    </div>\r\n    \r\n        \r\n            \r\n            \r\n            <div class=\"right-sub-item workflow \" iterid=\"66454\" actiontype=\"StandardAction\">\r\n                <span style=\"white-space: nowrap; overflow-x: hidden; text-overflow: ellipsis;\">\r\n                \r\n                    \r\n                        02. Richiesta Modifica Ufficio Tecnico Meccanico  - Valutazione Richiesta di Modifica\r\n                    \r\n                    \r\n                \r\n                    <br/>\r\n                </span>\r\n                <span style=\"display: block; overflow-x: hidden;\">\r\n                    <span style=\"display: block;\">Assegnata dal 19/12/2025 alle 16:03</span>    \r\n                    \r\n                    \r\n                        <span class=\"fieldLabel\">Creation date: </span>\r\n                        \r\n                            \r\n                            \r\n                            <span class=\"fieldValue\" title=\"19/12/2025\">19/12/2025</span><br>\r\n                        \r\n\r\n\r\n\r\n                    \r\n                        <span class=\"fieldLabel\">Ragione sociale: </span>\r\n                        \r\n                            \r\n                            \r\n                            <span class=\"fieldValue\" title=\"-\">-</span><br>\r\n                        \r\n\r\n\r\n\r\n                    \r\n                </span>\r\n            </div>\r\n        \r\n    \r\n</div>\r\n\r\n\r\n<div class=\"messages-right-app\">\r\n    <div class=\"right-item messages-icon\">\r\n        <span style=\"font-size: 140%;\">Messaggi</span>         \r\n        \r\n    </div>\r\n    \r\n</div>\r\n\r\n<div style=\"position: absolute; left: 6px; bottom: 20px;z-index: 1;opacity: .85;padding-top:25px;\">\r\n        \r\n    \r\n        <div class=\"right-item change-password\">\r\n            <span style=\"display: none;\">Cambia la tua password</span>        \r\n        </div>\r\n        \r\n    \r\n    \r\n    <div class=\"right-item change-theme\">\r\n        <span style=\"display: none;\">Temi</span>     \r\n    </div>\r\n</div>\r\n<script type=\"text/javascript\">\r\n    $(document).ready(function () {\r\n        $(\".digital-sign-user\").click(function(){\r\n            var params = {\"title\":\"Dati personali\" , \"modal\": true, \"width\": \"650px\", \"height\": \"630px\", \"Minimize\": false, \"Maximize\": false};\r\n\r\n            openWindow(\"digital-sign-user-window\", \"/adiJed/ui/includes/digital-sign-user.jsp\", params);\r\n        });\r\n\r\n\r\n\r\n\r\n        $(\".gestione-IMAP\").click(function(){\r\n            var params = {\"title\":\"Gestione IMAP\\/POP\" , \"modal\": true, \"width\": \"900px\", \"height\": \"500px\", \"Minimize\": false, \"Maximize\": true, \"fullscreen\": true};\r\n\r\n            openWindow(\"export-filters-window\", \"/adiJed/ui/includes/gestione-imap.jsp\", params);\r\n        });\r\n\r\n\r\n        $(\".change-password\").click(function(){\r\n            $(\"#change-password-dialog > H2\").html(\"Cambia la tua password\");            /*Cambia la tua password*/\r\n            $(\"#pwd-chg-old-pwd \").attr(\"placeholder\", \"Digita la tua password\");           /*Digita la tua password*/\r\n            $(\"#passwordType\").val('0');\r\n            $(\"#change-password-dialog-container\").modal({\r\n                overlayClose:true,\r\n                opacity:65,\r\n                overlayCss: {backgroundColor:\"#fff\"}\r\n            });\r\n        });\r\n\r\n        $(\".change-sign-password\").click(function(){\r\n            if(false){\r\n                showMessage(\"Utente di firma non impostato!\"); //Utente di firma non impostato!\r\n            }else{\r\n                $(\"#change-password-dialog > H2\").html(\"Cambia la tua password di firma\");   /*Cambia la tua password di Firma*/\r\n                $(\"#pwd-chg-old-pwd \").attr(\"placeholder\", \"Digita la tua password di Firma\");  /*Digita la tua password di Firma*/\r\n                $(\"#passwordType\").val('1');\r\n                $(\"#change-password-dialog-container\").modal({\r\n                    overlayClose:true,\r\n                    opacity:65,\r\n                    overlayCss: {backgroundColor:\"#fff\"}\r\n                });\r\n            }\r\n        });\r\n\r\n        $(\"#right-saved-search\").click(function(){\r\n            openWindow(\"saved-search\", \"/adiJed/ui/saved-search.do?action=load-all\", {width: '950px', height: '70%'},function(){});\r\n        });\r\n        var fWorkflow = function(){\r\n            location.hash = '/wf/?'+getUniqueID();\r\n            loadWorkflow();\r\n        };\r\n//        $(\".workflow-icon\").click(fWorkflow);\r\n        $(\".more-workflows\").click(fWorkflow);\r\n\r\n        $(\".workflow:not(.sign-action)\").click(function(){\r\n            var iterID = $(this).attr(\"iterid\");\r\n            var actionType = $(this).attr(\"actiontype\");\r\n            viewIter(iterID, actionType);\r\n        });\r\n\r\n        $(\".workflow.sign-action\").click(function(){\r\n            showMessage(\"Azione Firma Gestibile Esternamente\");\r\n        });\r\n        $(\".messages\").click(function(){\r\n            var msgid = $(this).attr(\"messageid\");\r\n            HistoryManager.navigateTo('/msg/?', \"/adiJed/ui/view-message.do\", \"type=inbox&msgid=\"+msgid, void(0), HistoryConstants.SAVE_PAGE_IN_HISTORY);\r\n        });\r\n\r\n        $(\".exports-icon\").click(function(){\r\n            viewExports();\r\n        });\r\n\r\n        themeSetup();\r\n\r\n        if($(\"#bd.tablet\")[0]) {\r\n        \r\n            \r\n                $(\"#workflow-num-bullet\")\r\n                        .css(\"display\",\"inline-block\")\r\n                        .html(\"<span>1</span>\");\r\n            \r\n            \r\n        \r\n        }\r\n    });\r\n\r\n    //# sourceURL=http://172.16.90.4:8080/adiJed/ui/home/right-app-content-view.jsp\r\n</script>\r\n"
          },
