important;\r\n    }\r\n    #documents {\r\n        opacity: 0;\r\n        transition: opacity .35s linear;\r\n    }\r\n    #documents.loaded {\r\n        opacity: 1;\r\n    }\r\n\t.other-actions {\r\n\t\twidth: 24px !important;\r\n\t\theight: 24px !important;\r\n\t\tpadding: 0px !important;\r\n\t\tmargin-right: 10px;\r\n\t\tposition: absolute;\r\n\t\tright: -11px;\r\n\t\theight: 44px !important;\r\n\t\tmargin-top: -4px;\r\n\t\ttransition: background-color .3s;\r\n\t}\r\n\t#documents.compact-view .other-actions {\r\n\t\theight: 24px !important;\r\n\t\tmargin-top: 0px;\r\n\t}\r\n\t.other-actions:hover {\r\n\t\tbackground-color: #d3d3d321 !important;\r\n\t}\r\n\t.other-actions > div {\r\n\t\tposition: absolute;\r\n\t\ttop: 0px;\r\n\t\tright: -37px;\r\n\t\tmargin-bottom: 100px;\r\n\t}\r\n\t.other-actions > div > div#vertical-toolbar {\r\n\t\tposition: relative;\r\n\t\toverflow: hidden;\r\n\t\tborder: 2px solid #dadada;\r\n\t\tbox-shadow: -1px 2px 3px 0px lightgrey;\r\n\t\topacity: .05;\r\n\t\tleft: -20px;\r\n-webkit-transition: left 500ms cubic-bezier(0.680, 0, 0.265, 1), opacity .5s; /* older webkit */\r\n-webkit-transition: left 500ms cubic-bezier(0.680, -0.550, 0.265, 1.550), opacity .5s;\r\n   -moz-transition: left 500ms cubic-bezier(0.680, -0.550, 0.265, 1.550), opacity .5s;\r\n     -o-transition: left 500ms cubic-bezier(0.680, -0.550, 0.265, 1.550), opacity .5s;\r\n        transition: left 500ms cubic-bezier(0.680, -0.550, 0.265, 1.550), opacity .5s;\r\n\t}\r\n\t.other-actions > div > div#vertical-toolbar.loaded {\r\n\t\topacity: 1;\r\n\t\tleft: 0;\r\n\t}\r\n\t.other-actions:hover:before {\r\n\t\topacity: 1;\r\n\t\tcursor: pointer;\r\n\t}\r\n\t.other-actions:before {\r\n\t\tcontent: '';\r\n\t\tdisplay: inline-block;\r\n\t\tbackground: url('/adiJed/img/toolbar/grab-v.png') no-repeat center;\r\n\t\tbackground-size: 18px;\r\n\t\twidth: 100%;\r\n\t\theight: 100%;\r\n\t\topacity: .3;\r\n\t\ttransition: opacity .3s;\r\n\t}\r\n\r\n\t#downloadExpTemplXlsCmb {\r\n\t\tmax-w