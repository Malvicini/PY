            "compression": -1,
            "text": "(function(wnd) {\r\n    var HistoryManager;\r\n\r\n    var ProceedConfirmBehaviour = {\r\n        ONE_TIME: 1, ALWAYS: 2\r\n    };\r\n\r\n    HistoryManager = function()\r\n    {\r\n        var that = this;\r\n\r\n        this.__PAGES = {};\r\n        this.__QUERIES = {};\r\n        this.__DATA = {};\r\n        this.lastQueryKey = undefined;\r\n        this.ACTION_PREW=0;\r\n        this.ACTION_RELOAD=1;\r\n        this.ACTION_REMOVE_PAGE=2;\r\n\r\n        this.proceedConfirmDfd = null;\r\n        this.proceedConfirmFunction = null;\r\n        this.proceedConfirmBehaviour = null;\r\n\r\n        /**\r\n         * Prima di caricare una nuova pagina con navigateTo oppure saveHistoryAndDisplayPage, \r\n         * viene invocata la funzione fnConfirm e in base al risultato di questa decide se procedere con \r\n         * il caricamento oppure interromperlo\r\n         * \r\n         * @param {type} fnConfirm funzione di conferma, pu� tornare una deferred e allora \r\n         * @param {type} persistentConfirm se passato a false allora fnConfirm viene chiamato e poi annullata la richiesta\r\n         * @return {undefined}\r\n         */\r\n        this.confirmBeforeProceed = function(fnConfirm, confirmText, persistentConfirm) {\r\n            that.proceedConfirmFunction  = fnConfirm;\r\n            that.proceedConfirmBehaviour = arguments.length === 1 || persistentConfirm ? ProceedConfirmBehaviour.ALWAYS : ProceedConfirmBehaviour.ONE_TIME;\r\n            window.onbeforeunload = function(e) {\r\n                e = e || window.event;\r\n                if(e) {\r\n                    e.returnValue = confirmText;\r\n                }\r\n                return confirmText;\r\n            };\r\n        };\r\n        \r\n        var __clearConfirmBeforeProceed = function () {\r\n            that.proceedConfirmDfd = null;\r\n            that.proceedConfirmFunction = null;\r\n            window.onbeforeunload = void(0);\r\n        };\r\n        \r\n        var __confirmBeforeProceed = function() {\r\n            // se la funzione di conferma c'� ed � gi� una deferred va bene cos�\r\n            if( this.proceedConfirmFunction && this.proceedConfirmFunction.promise && this.proceedConfirmFunction.resolve ) {\r\n                this.proceedConfirmDfd = this.proceedConfirmFunction;\r\n            } else {\r\n                // altrimenti ne creo una\r\n                this.proceedConfirmDfd = new jQuery.Deferred();\r\n                \r\n                // se non c'� nessuna funzione di conferma la risolvo subito\r\n                if( this.proceedConfirmFunction === null ) {\r\n                    this.proceedConfirmDfd.resolve();\r\n                } else {\r\n                    // altrimenti prendo il risultato di proceedConfirmFunction, se � a sua volta una deferred faccio combaciare \r\n                    // il risultato di quella con il mio then -> resolve, fail -> reject\r\n                    // se invece il risultato di proceedConfirmFunction non � una deferred true -> resolve, false -> reject\r\n                    setTimeout(function(){\r\n                        var result = that.proceedConfirmFunction.call();\r\n                        if( result ) {\r\n                            if( result.promise && result.resolve ) {\r\n                                result.then(function(){\r\n                                    that.proceedConfirmDfd.resolve();\r\n                                }).fail(function(){\r\n                                    that.proceedConfirmDfd.reject();\r\n                                });\r\n                            } else {\r\n                                that.proceedConfirmDfd.resolve();\r\n                            }\r\n                        } else {\r\n                            that.proceedConfirmDfd.reject();\r\n                        }\r\n                    }, 50);\r\n                    \r\n                    this.proceedConfirmDfd.always(function(){\r\n                        // al termine della conferma, se ProceedConfirmBehaviour.ONE_TIME lo rimuovo e non lo faccio pi�\r\n                        if (that.proceedConfirmBehaviour === ProceedConfirmBehaviour.ONE_TIME) {\r\n                            __clearConfirmBeforeProceed.apply(that);\r\n                        }\r\n                    }).then(function(){\r\n                        __clearConfirmBeforeProceed.apply(that);\r\n                    });\r\n                }\r\n            }\r\n            \r\n            return this.proceedConfirmDfd;\r\n        };\r\n        \r\n        this.needConfirmBeforeProceed = __confirmBeforeProceed.bind(that);\r\n        \r\n        /**\r\n         * Annulla la richiesta di conferma prima di caricare una nuova pagina\r\n         * @return {undefined}\r\n         */\r\n        this.cancelConfirmBeforeProceed = function(){\r\n            __clearConfirmBeforeProceed();\r\n        };\r\n        \r\n        this.getPageTimestamp = function(key)\r\n        {\r\n            var _key = key||that.getCurrentKey();\r\n            var _page = that.__PAGES[_key];\r\n            return _page[\"page_ts\"];\r\n        };\r\n        this.removePage = function(key)\r\n        {\r\n            if(that.getCurrentPage().beforeChange && !that.getCurrentPage().beforeChange(that.ACTION_REMOVE_PAGE))\r\n                return;\r\n\r\n            var _key = key||that.getCurrentKey();\r\n            if(typeof that.__PAGES !== \"undefined\")\r\n            {\r\n                that.__PAGES[_key] = null;\r\n            }\r\n        };\r\n        /**\r\n         * Salva nella history la pagina e alimenta l'hash nell'url del browser. la pagina deve poi essere caricata effettivamente da Sammy\r\n         *\r\n         * Ritorna la promise che verr� risolta al caricamento della pagina\r\n         *\r\n         * @param hash La parte di url che identifica la chiamta x Sammy, fino al ? compreso, altrimenti viene aggiunto alla fine\r\n         * @param url\r\n         * @param data\r\n         * @param [optional] key Se voglio passo la chiave x la history, altrimenti viene usato il valore ritornato da getUniqueID()\r\n         * @param [optional] historyBehaviour Cosa fare con la history vedi HistoryConstants in common.js\r\n         */\r\n        this.navigateTo = function(hash, url, data, key, historyBehaviour, savePageHtml, containerSelector) {\r\n            var _args = arguments;\r\n            var _dfd = new jQuery.Deferred();\r\n            $.when(this.needConfirmBeforeProceed()).then(\r\n                    function() {\r\n                        var navToDeferred = that.__navigateTo.apply(that, _args);\r\n                        if( ! navToDeferred ) {\r\n                            _dfd.resolve();\r\n                        } else {\r\n                            navToDeferred.then(_dfd.resolve);\r\n                        }\r\n                    }\r\n            );\r\n            return _dfd;\r\n        };\r\n        \r\n        this.__navigateTo = function(hash, url, data, key, historyBehaviour, savePageHtml, containerSelector)\r\n        {\r\n            var _key = key||getUniqueID();\r\n            var sammyLoadedDfd = false;\r\n            if(historyBehaviour === HistoryConstants.REPLACE_CURRENT_HISTORY) {\r\n                _key = that.getCurrentKey();\r\n            } else {\r\n                sammyLoadedDfd = new jQuery.Deferred();\r\n            }\r\n            \r\n            if(url)\r\n                that.savePage(url, data, _key, null, sammyLoadedDfd, savePageHtml, containerSelector);\r\n            \r\n            if(hash.indexOf(\"?\") === -1)\r\n                hash = hash+\"?\";\r\n            \r\n            if(historyBehaviour !== HistoryConstants.REPLACE_CURRENT_HISTORY) {\r\n                if( self.saveHistoryLocked ) {\r\n                    return false;\r\n                }\r\n                app.setLocation(\"#\"+hash+_key);\r\n                self.saveHistoryLocked = true;\r\n                var idTimeout = setTimeout(function(){\r\n                    self.saveHistoryLocked = false;\r\n                }, 5000);\r\n                sammyLoadedDfd.then(function(){\r\n                    self.saveHistoryLocked = false;\r\n                    clearTimeout(idTimeout);\r\n                });\r\n                return sammyLoadedDfd;\r\n            } else {\r\n                return that.loadPage();\r\n            }\r\n        };\r\n        this.savePage = function(url, data, key, pageData, dfd, savePageHtml, containerSelector)\r\n        {\r\n            var _key = key||that.getCurrentKey();\r\n            // todo: creare l'oggetto HistoryPage\r\n            if(_key) {\r\n                that.__PAGES[_key] = {\"url\":url, \"data\":data, \"key\":_key, \"pageData\":pageData, \"page_ts\":new Date(), \"dfd\":dfd, \"beforeChange\":null, \"savePageHtml\":savePageHtml,\"containerSelector\":containerSelector };\r\n            }\r\n        };\r\n        this.getCurrentPage = function()\r\n        {\r\n            var _key = that.getCurrentKey();\r\n            if( !_key ) {\r\n                return {};\r\n            }\r\n            if(!that.__PAGES[_key])\r\n            {\r\n                that.__PAGES[_key] = {};\r\n            }\r\n            return that.__PAGES[_key];\r\n        };\r\n        \r\n        this.loadPageWithKey = function(key, params) {\r\n            var _args = arguments;\r\n            var _dfd = new jQuery.Deferred();\r\n            $.when(this.needConfirmBeforeProceed()).then(\r\n                function(){\r\n                    that.__loadPageWithKey.apply(that, _args);\r\n                }\r\n            );\r\n            return _dfd;\r\n        };\r\n        \r\n        this.__loadPageWithKey = function(key, params)\r\n        {\r\n            var page = that.__PAGES[key];\r\n            if(page != null && typeof page != \"undefined\") {\r\n                if(params)\r\n                    page[\"data\"] = params+\"&\"+page[\"data\"];\r\n                \r\n                var dfd;\r\n                // todo: spostare le due funzioni di common.js in due metodi astratti\r\n                if(page.pageData) {\r\n                    dfd = displayHtml(page.pageData);\r\n                } else {\r\n                    dfd = saveHistoryAndDisplayPage(null, page[\"url\"], page[\"data\"], false, page[\"savePageHTML\"], void(0), null, page[\"containerSelector\"]);\r\n                }\r\n                // Se alla pagina � stata associata una Deferred allora la faccio risolvere\r\n                // quando verr� risolta dfd (al termine del caricamento della pagina)\r\n                if(page[\"dfd\"]) {\r\n                    var ___dfd = page[\"dfd\"];\r\n                    $.when(dfd).then(function(){___dfd.resolve();});\r\n                }\r\n                return dfd;\r\n            } else {\r\n                return false;\r\n            }\r\n        };\r\n        this.savePageHTML = function(html,key)\r\n        {\r\n            var _key = key;\r\n            if(arguments.length == 1)\r\n            {\r\n                _key = that.getCurrentKey();\r\n            }\r\n            that.__PAGES[_key].pageData = html;\r\n        };\r\n        this.loadPageHTMLWithKey = function(key)\r\n        {\r\n            return that.__PAGES[key];\r\n        };\r\n        this.getCurrentKey = function(hash)\r\n        {\r\n            hash = hash||location.hash;\r\n            var keyStart = hash.indexOf(\"?\");\r\n            if(keyStart == -1)\r\n            {\r\n                return null;\r\n            }\r\n            else\r\n            {\r\n                return hash.substring(keyStart+1);\r\n            }\r\n        };\r\n        this.loadPage = function()\r\n        {\r\n            var key = that.getCurrentKey();\r\n            if( key == null ) {\r\n                return null;\r\n            }\r\n            var page = that.__PAGES[key];\r\n            if( page == null || typeof page === \"undefined\" ) {\r\n                return false;\r\n            }\r\n            return that.loadPageWithKey(key);\r\n        };\r\n        this.loadPageHTML = function()\r\n        {\r\n            var key = that.getCurrentKey();\r\n            if(key == null)\r\n            {\r\n                return null;\r\n            }\r\n            return that.loadPageHTMLWithKey(key);\r\n        };\r\n        this.saveQueryToHistory = function(key,data,orderby,state)\r\n        {\r\n            var historyQueryObject = { \"key\": key, \"data\": data, \"orderby\": orderby, \"state\": state };\r\n            that.__QUERIES[key] = historyQueryObject;\r\n            that.lastQueryKey = key;\r\n            return historyQueryObject;\r\n        };\r\n        this.getLastQuery = function()\r\n        {\r\n            return that.__QUERIES[that.lastQueryKey];\r\n        };\r\n        this.getQuery = function(key)\r\n        {\r\n            return that.__QUERIES[key.substr(1)];\r\n        };\r\n        \r\n        this.reloadLastPage = function(params) {\r\n            var _args = arguments;\r\n            this.needConfirmBeforeProceed().then(function(){\r\n                that.__reloadLastPage.apply(that, _args);\r\n            });\r\n        };\r\n        \r\n        this.__reloadLastPage = function(params)\r\n        {\r\n            if(that.getCurrentPage().beforeChange && !that.getCurrentPage().beforeChange(that.ACTION_RELOAD))\r\n                return;\r\n\r\n            var key = that.getCurrentKey();\r\n            if(key == null)\r\n            {\r\n                return null;\r\n            }\r\n            return that.loadPageWithKey(key, params);\r\n        };\r\n        \r\n        this.displayPreviousPage = function (params) {\r\n            var _args = arguments;\r\n            this.needConfirmBeforeProceed().then(function(){\r\n                that.__displayPreviousPage.apply(that, _args);\r\n            });\r\n        };\r\n        \r\n        this.__displayPreviou