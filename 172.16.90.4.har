                              break;\r\n//                                                            } else {\r\n//                                                                newQueryParams.push(queryParamToken);\r\n//                                                            }\r\n//                                                        }\r\n//                                                    } else {\r\n//                                                        newQueryParams.push(queryParamToken);\r\n//                                                    }\r\n//                                                }\r\n\r\n                                                HistoryManager.saveQueryToHistory(k,queryParams,undefined);\r\n                                                var treeScrollTop = $(\".visual-query-tree\")[0].scrollTop;\r\n                                                var queryPage = HistoryManager.getCurrentPage();\r\n                                                queryPage[\"queryFilters\"] = {\r\n                                                    \"mode\": \"VisualQuery\",\r\n                                                    \"tree\": $(\".visual-query-tree\").detach(),\r\n                                                    \"treeScrollTop\": treeScrollTop,\r\n                                                    \"treeSearchTerm\": $(\"#vq-search-term\").val(),\r\n                                                    \"q\": params[\"q\"]\r\n                                                };\r\n                                                HistoryManager.navigateTo('/results/?', \"/adiJed/ui/query/find.do\", queryParams, queryResultsPageID);\r\n                                            }\r\n                                        } else {\r\n                                            _this.addClass(\"opened\");\r\n                                            __objRef.unHideFolder(_this);\r\n                                        }\r\n                                    } else {\r\n                                        _this.removeClass(\"opened\");\r\n                                        __objRef.hideFolder(_this);\r\n                                    }\r\n                                })\r\n                            ).append($(\"<span>\").text(\"(\"+queryField[\"label\"]+\")\").addClass(\"vq-tree-line-label\"))\r\n                            .appendTo(container)\r\n                        ;\r\n                    });\r\n                }\r\n                else\r\n                {\r\n                    $(\"span.vq-nodoc\", container).remove();\r\n                    $(\"<span>\")\r\n                        .addClass(\"vq-nodoc\")\r\n                        .text(LangManager.get(\"ui.js.vq.no.doc\"))\r\n                        .appendTo(container)\r\n                    ;\r\n                }\r\n\r\n                if( parentContainer && !parentContainer.hasClass(\"visual-query-tree\")) {\r\n                    var maxHeight = parentContainer.prop(\"scrollHeight\")-10;\r\n                    parentContainer.animate(\r\n                        {height: maxHeight}, 150, \"easeOutSine\", function () { parentContainer.css({\"height\":\"auto\", \"overflow-y\":\"visible\"}); }\r\n                    );\r\n                }\r\n\r\n                dfd.resolve();\r\n            });\r\n\r\n            return dfd;\r\n        };\r\n\r\n        this.hideFolder = function(folder) {\r\n            folder.css(\"overflow-y\", \"hidden\").animate({height: folder.attr(\"origHeight\")}, 150, \"easeOutSine\", function(){});\r\n            folder.find(\"> span.vq-folder\").css(\"display\",\"none\");\r\n        };\r\n\r\n        this.unHideFolder = function(folder) {\r\n            folder.find(\"> span.vq-folder\").css(\"display\",\"block\");\r\n            folder.animate({ height: folder.prop(\"scrollHeight\")-10}, 150, \"easeOutSine\",\r\n                function(){ folder.css({\"height\":\"auto\", \"overflow-y\":\"visible\"}); }\r\n            );\r\n        };\r\n    };\r\n\r\n    wnd.VisualQuery = new VisualQuery();\r\n\r\n})(window);\r\n"
