important;\r\n    }\r\n    #documents {\r\n        opacity: 0;\r\n        transition: opacity .35s linear;\r\n    }\r\n    #documents.loaded {\r\n        opacity: 1;\r\n    }\r\n\t.other-actions {\r\n\t\twidth: 24px !important;\r\n\t\theight: 24px !important;\r\n\t\tpadding: 0px !important;\r\n\t\tmargin-right: 10px;\r\n\t\tposition: absolute;\r\n\t\tright: -11px;\r\n\t\theight: 44px !important;\r\n\t\tmargin-top: -4px;\r\n\t\ttransition: background-color .3s;\r\n\t}\r\n\t#documents.compact-view .other-actions {\r\n\t\theight: 24px !important;\r\n\t\tmargin-top: 0px;\r\n\t}\r\n\t.other-actions:hover {\r\n\t\tbackground-color: #d3d3d321 !important;\r\n\t}\r\n\t.other-actions > div {\r\n\t\tposition: absolute;\r\n\t\ttop: 0px;\r\n\t\tright: -37px;\r\n\t\tmargin-bottom: 100px;\r\n\t}\r\n\t.other-actions > div > div#vertical-toolbar {\r\n\t\tposition: relative;\r\n\t\toverflow: hidden;\r\n\t\tborder: 2px solid #dadada;\r\n\t\tbox-shadow: -1px 2px 3px 0px lightgrey;\r\n\t\topacity: .05;\r\n\t\tleft: -20px;\r\n-webkit-transition: left 500ms cubic-bezier(0.680, 0, 0.265, 1), opacity .5s; /* older webkit */\r\n-webkit-transition: left 500ms cubic-bezier(0.680, -0.550, 0.265, 1.550), opacity .5s;\r\n   -moz-transition: left 500ms cubic-bezier(0.680, -0.550, 0.265, 1.550), opacity .5s;\r\n     -o-transition: left 500ms cubic-bezier(0.680, -0.550, 0.265, 1.550), opacity .5s;\r\n        transition: left 500ms cubic-bezier(0.680, -0.550, 0.265, 1.550), opacity .5s;\r\n\t}\r\n\t.other-actions > div > div#vertical-toolbar.loaded {\r\n\t\topacity: 1;\r\n\t\tleft: 0;\r\n\t}\r\n\t.other-actions:hover:before {\r\n\t\topacity: 1;\r\n\t\tcursor: pointer;\r\n\t}\r\n\t.other-actions:before {\r\n\t\tcontent: '';\r\n\t\tdisplay: inline-block;\r\n\t\tbackground: url('/adiJed/img/toolbar/grab-v.png') no-repeat center;\r\n\t\tbackground-size: 18px;\r\n\t\twidth: 100%;\r\n\t\theight: 100%;\r\n\t\topacity: .3;\r\n\t\ttransition: opacity .3s;\r\n\t}\r\n\r\n\t#downloadExpTemplXlsCmb {\r\n\t\tmax-width: 200px;\r\n\t}\r\n\r\n\t@media (max-width: 1350px) {\r\n\t\t.ad-toolbar.fit-to-screen .toolbar-button.small {\r\n\t\t\twidth: auto;\r\n\t\t}\r\n\t\t#downloadExpTemplXlsCmb {\r\n\t\t\tmax-width: 165px;\r\n\t\t}\r\n\t\t#bd.w1024 #downloadExpTemplXlsCmb {\r\n\t\t\tmax-width: 125px;\r\n\t\t}\r\n\t}\r\n\t@media (min-width: 1281px) and (max-width: 1600px) {\r\n\t\t#bd.pinned-right-container .ad-toolbar.fit-to-screen .toolbar-button.small {\r\n\t\t\twidth: auto;\r\n\t\t}\r\n\t\t#bd.pinned-right-container #downloadExpTemplXlsCmb {\r\n\t\t\tmax-width: 165px;\r\n\t\t}\r\n\t}\r\n\t.others-menu-actions > ul {\r\n\t\tposition: relative !important;\r\n\t\ttop: 0 !important;\r\n\t\twidth: 100% !important;\r\n\t\theight: 100% !important;\r\n\t\tmargin: 0 !important;\r\n\t\tpadding: 0 !important;\r\n\t}\r\n\t.others-menu-actions {\r\n\t\tposition: absolute;\r\n\t\tright: 10px;\r\n\t\tmin-width: 150px;\r\n\t\tmargin-top: 30px;\r\n\t\tz-index: -1;\r\n\t\topacity: 0;\r\n\t\tvisibility: hidden;\r\n\t\ttransition: opacity .5s ease-in-out;\r\n\t\tbackground-color: #EFEFEF;\r\n\t}\r\n\t.others-menu-actions.visible {\r\n\t\tvisibility: visible;\r\n\t\tz-index: 999;\r\n\t\topacity: 1;\r\n\t\tbox-shadow: 0px 4px 8px 1px #b5b5b5;\r\n\t\tpadding: 0;\r\n\t}\r\n\t#bd div.ad-toolbar .others-menu-actions.visible > ul > li {\r\n\t\tdisplay: block !important;\r\n\t\tmargin: 0 !important;\r\n\t\tmax-width: 100% !important;\r\n\t\twidth: auto;\r\n\t}\r\n\t#show-more-buttons {\r\n\t\tbackground-position-y: center;\r\n\t\tbackground-position-x: center;\r\n\t\tbackground-repeat: no-repeat;\r\n\t\tbackground-image: url(/adiJed/img/toolbar/more.png);\r\n\t\tbackground-size: 24px;\r\n\t\twidth: 0px !important;\r\n\t\tpadding-left: 20px !important;\r\n\t\tpadding-right: 20px !important;\r\n\t\ttransition: background-color 1s ease-in;\r\n\t}\r\n\t#show-more-buttons-container.hidden {\r\n\t\tdisplay: none !important;\r\n\t}\r\n\t#show-more-buttons-container.hidden #show-more-buttons {\r\n\t\tbackground-color: #e8e8e8 !important;\r\n\t}\r\n</style>\r\n\r\n<script type=\"text/javascript\" src=\"/adiJed/js/ui/report-common.js\"/>\r\n\r\n<script type=\"text/javascript\">\r\n    createCustomEvent(\"onRowSelectionChanged\");\r\n</script>\r\n\r\n\r\n\r\n\r\n        \r\n            <div id=\"plugin1766499181152_2\" class=\"plugin report-plugin\" style=\"display:none;\"></div>\r\n        \r\n        \r\n        \r\n            <link rel=\"stylesheet\" href=\"/adiJed/workfolder/SystemFiles/1001/Plugins/Report-Colors/report-colors2.css\"/>\r\n        \r\n    \r\n\r\n\r\n\r\n<script type=\"text/javascript\">AdiPlugin.prototype.getCurrentDocumentInfo = function(){return ADA.getDocumentInfo();};</script>\r\n<script type=\"text/javascript\">AdiPlugin.prototype.getDocumentInfo = function(fidd){return ADA.getDocumentInfo(fidd);};</script>\r\n\r\n    \r\n<script type=\"text/javascript\">\r\n    $(\"#plugin1766499181152_2\").data(\"__adi_plugin\", (function() {\r\n        /**\n * Viene richiamata da Adiuto per inizializzare il plugin\n * N.B. viene chiamata tutte le volte che il plugin viene mostrato a video\n *\n * @returns Ritorna un'istanza di AdiPlugin\n */\nfunction init()\n{\n    var myPlugin = AdiPlugin.getNew();\n\n\tmyPlugin.setAction(function(tr,doc){\n\tif(doc.f == 1134) \n\t\t{\n            for(var i=0; i<doc.v.length; i++) {\n                if(doc.v[i][0]==1109) {\n                    if(doc.v[i][1] == \"OBSOLETO\") {\n                        $(tr).find(\"td.F1109\").addClass(\"rosso\");\n                    } \n                    break;\n                }\n            }\n        }\n\t\t\n\tif(doc.f == 1136) {\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t//famiglia da considerare\n            for(var i=0; i<doc.v.length; i++) {\t\t\t\t\t\t\t\t\t\t\t\t\t\n                if(doc.v[i][0]==1158) {\t\t\t\t\t\t\t\t\t\t\t\t\t\t//campo da analizzare\n                    if(doc.v[i][1] == \"CONSEGNATA CON IMPOSSIBILITA` DI RECAPITO\") {\t\t//campo da colorare\n                        $(tr).find(\"td.F1158\").addClass(\"verde\");\n                    } \n                    if(doc.v[i][1] == \"EMESSA\") {\n                        $(tr).find(\"td.F1158\").addClass(\"giallo\");\t\t\t\t\t\t\t//campo da colorare\n                    } \t\t\t\t\t\n                    if(doc.v[i][1] == \"SCARTATA\") {\n                        $(tr).find(\"td.F1158\").addClass(\"rosso\");\t\t\t\t\t\t\t//campo da colorare\n                    } \t\t\t\t\t\n                    if(doc.v[i][1] == \"CONSEGNATA\") {\n                        $(tr).find(\"td.F1158\").addClass(\"verde\");\t\t\t\t\t\t\t//campo da colorare\n                    } \n                    break;\n                }\n\t\t\t\n            }\n        }\n\t\t\n\tif(doc.f == 1005) {\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t//famiglia da considerare\n            for(var i=0; i<doc.v.length; i++) {\t\t\t\t\t\t\t\t\t\t\t\t\t\n                if(doc.v[i][0]==1175) {\t\t\t\t\t\t\t\t\t\t\t\t\t\t//campo da analizzare\n                    if(doc.v[i][1] == \"SI\") {\t\t//campo da colorare\n\t\t\t\t\t\tfor(var j=0; j<doc.v.length; j++) {\n\t\t\t\t\t\t\tif(doc.v[j][0]==1171) {\t\t\t\t\t\t\t\t\t\t\t\t\t\t//campo da analizzare\n\t\t\t\t\t\t\t\tif(doc.v[j][1].indexOf(\"2020\") > 0 ) {\n\t\t\t\t\t\t\t\t\t$(tr).find(\"td.F1171\").addClass(\"salmone\");\n\t\t\t\t\t\t\t\t\t\t\t\t                    }}    \n} } \t\t\t\t\t\n                    break;\n                }\n\t\t\t\n            }\n        }\t\n\t\t\n\t});\n\n\treturn myPlugin;\n}\n\r\n        return init($(\"#plugin1766499181152_2\"));\r\n    })());\r\n    //# sourceURL=http://172.16.90.4:8080/adiJed/Plugins/Report-Colors/plugin.js\r\n</script>\r\n\r\n\r\n\r\n\r\n<div id=\"application-left-bar\">\r\n\r\n</div>\r\n<div id=\"content\">\r\n    \r\n    \r\n        \r\n        \r\n            \r\n        \r\n    \r\n    <div id=\"search-toolbar\" class=\"ad-toolbar fit-to-screen\">\r\n        <ul>\r\n            <li class=\"split-toolbar small\">\r\n                <ul>                