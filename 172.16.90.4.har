            "text": "<!DOCTYPE html>\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n<html>\r\n    <head>\r\n        <title>Adiuto - We Value Your Knowledge</title>\r\n\r\n        \r\n\r\n        <meta name=\"viewport\" content=\"initial-scale=1, maximum-scale=1, width=device-width, user-scalable=false\" />\r\n        <meta name=\"format-detection\" content=\"telephone=no\">\r\n        <meta name=\"apple-mobile-web-app-capable\" content=\"yes\">\r\n        <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\" />\r\n\r\n        <link rel=\"icon\" type=\"image/png\" href=\"/adiJed/img/logo/fav_ico_adiuto.ico\"/>\r\n        <link rel=\"SHORTCUT ICON\" href=\"/adiJed/img/logo/fav_ico_adiuto.ico\"/>\r\n        <link rel=\"apple-touch-icon\" href=\"/adiJed/img/logo/fav_ico_adiuto.ico\"/>\r\n        <link rel=\"apple-touch-startup-image\" href=\"/adiJed/img/logo/fav_ico_adiuto.ico\"/>\r\n\r\n        \r\n\r\n\r\n<script src=\"/adiJed/csrfguard\"></script>\r\n\r\n<script type=\"text/javascript\" src=\"/adiJed/js/kendo/jquery.min.js?ver=6.7.2.20250507.P6\"></script>\r\n        <script type=\"text/javascript\" src=\"/adiJed/js/jquery-ui-1.8.23.custom.min.js?ver=6.7.2.20250507.P6\"></script>\r\n\r\n        <script src=\"/adiJed/js/jQuery.bubbletip-1.0.6.js\" type=\"text/javascript\"></script>\r\n        <!--[if !IE]><!-->\r\n        <link href=\"/adiJed/css/bubbletip.css\" rel=\"stylesheet\" type=\"text/css\" />\r\n        <![endif]-->\r\n        <!--[if IE]>\r\n        <link href=\"/adiJed/css/bubbletip-IE.css\" rel=\"stylesheet\" type=\"text/css\" />\r\n        <![endif]-->\r\n        \r\n        <script type=\"text/javascript\" src=\"/adiJed/js/ui/lang.jsp?ver=6.7.2.20250507.P6.it\"></script>\r\n        <script type=\"text/javascript\" src=\"/adiJed/js/jquery.ui.touch-punch.js?ver=6.7.2.20250507.P6\"></script>\r\n        <script type=\"text/javascript\" src=\"/adiJed/js/jquery.hammer.js?ver=6.7.2.20250507.P6\"></script>\r\n        <script type=\"tex