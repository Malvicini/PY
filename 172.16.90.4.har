;\r\n        border-radius: 5px;\r\n        background-color: #f2f2f2;\r\n        border: 1px solid #d3d3d3;\r\n\r\n        transition: opacity .3s ease;\r\n    }\r\n    #moreRowsMessage:hover, #moreRowsMessage:hover * {\r\n        opacity: .8 !important;\r\n    }\r\n    #bd.tablet #moreRowsMessage {\r\n        left: 90px;\r\n    }\r\n    td.row-number {\r\n        white-space: nowrap;\r\n        color: #808080;\r\n    }\r\n    .row-number {\r\n        width: 50px !important;\r\n        min-width: 10px !important;\r\n        padding-left: 5px !important;\r\n        padding-right: 5px !important;\r\n        text-align: right;\r\n        font-weight: bold;\r\n        background-color: #f9f9f9;\r\n        border-right: 1px inset #eeeeee;\r\n    }\r\n    #documents .fixed-columns-thead-container table thead tr th:last-of-type {\r\n        border-right-color: #C7C7C7 !important;\r\n    }\r\n    #documents table thead tr th.row-number, #documents table thead tr th.row-icons {\r\n        padding-left: 0;\r\n        padding-right: 0;\r\n    }\r\n    #documents .fixed-columns-thead-container table thead tr th {\r\n        background-color: rgba(230, 230, 230, 0.5);\r\n    }\r\n    #bd.tablet #documents .fixed-columns-thead-container {\r\n        position: fixed;\r\n        top: 41px;\r\n        left: 71px;\r\n    }\r\n    tr.last-selected td.row-number, td.row-number {\r\n        background-color: #f9f9f9 !important;\r\n    }\r\n    .lnkSubRptContainer, .attSubRptContainer, .revSubRptContainer {\r\n        border: 3px solid #AFBDBD;\r\n        border-radius: 5px;\r\n        display: inline-block;\r\n        position: relative;\r\n        opacity: 1;\r\n        height: auto;\r\n        width: 100%;\r\n    }\r\n    .lnkSubRptContainer > table, .attSubRptContainer > table, .revSubRptContainer > table {\r\n        width: auto !important;\r\n        margin-bottom: 0 !important;\r\n        padding-bottom: 0;\r\n    }\r\n    .lnkSubRptContainer > table thead tr th, .attSubRptContai