            "mimeType": "text/javascript",
            "compression": -1,
            "text": "var __ADIJED_DEBUG = false;\r\n\r\nfunction checkIsDebug()\r\n{\r\n    Logger.setup($(\"#debug-messages\"),$(\"#log-filter\"));\r\n\r\n    __ADIJED_DEBUG = getParameterByName('debug') == 'on';\r\n    __DEBUG_STYLE = getParameterByName('style');\r\n\r\n    if(__ADIJED_DEBUG) {\r\n        enableDebugWin();\r\n    }\r\n}\r\n\r\nLogger = self.Logger||{};\r\n/**\r\n * @const\r\n */\r\nLogger.DEBUG_WIN_UNSET = null;\r\n/**\r\n * @const\r\n */\r\nLogger.DEBUG_WIN_HIDDEN = 'hidden';\r\n/**\r\n * @const\r\n */\r\nLogger.DEBUG_WIN_VISIBLE = 'visible';\r\n\r\n\r\nvar debugWinState = Logger.DEBUG_WIN_UNSET;\r\nfunction hideDebugWin()\r\n{\r\n    debugWinState = Logger.DEBUG_WIN_HIDDEN;\r\n    $(\"#debug-info-box\").css({\"display\":\"none\"});\r\n}\r\nfunction addCSSRule(sheet, selector, rules, index)\r\n{\r\n    sheet = sheet||getCssSheet();\r\n    if(sheet.insertRule) {\r\n        sheet.insertRule(selector + \"{\" + rules + \"}\", index);\r\n    }\r\n    else {\r\n        sheet.addRule(selector, rules, index);\r\n    }\r\n}\r\nfunction removeCSSRule(sheet, ruleid)\r\n{\r\n    sheet = sheet||getCssSheet();\r\n    if ($.browser.msie  && parseInt($.browser.version, 10) < 9) {\r\n        sheet.removeRule (ruleid);\r\n    }\r\n    else {        // Internet Explorer before version 9\r\n        sheet.deleteRule (ruleid);\r\n    }\r\n}\r\nfunction getCssSheet()\r\n{\r\n    var mysheet;\r\n    for(var ist=0; ist<document.styleSheets.length; ist++)\r\n    {\r\n        var _href = document.styleSheets[ist].href;\r\n        if( _href && ( _href.indexOf(\"common.css\") != -1 || _href.indexOf(\"all.css\") != -1 )) {\r\n            mysheet = document.styleSheets[ist];\r\n            break;\r\n        }\r\n    }\r\n    return mysheet;\r\n}\r\nfunction findCssRule(selector)\r\n{\r\n    var targetrule = null;\r\n    var mysheet = getCssSheet();\r\n    var myrules = mysheet.cssRules? mysheet.cssRules: mysheet.rules;\r\n    for (var i=0; i<myrules.length; i++)\r\n    {\r\n        if(myrules[i].selectorText == selector)\r\n        {\r\n            targetrule = i;\r\n            break;\r\n        }\r\n    }\r\n    return {rule: myrules[targetrule], ruleID: targetrule};\r\n}\r\nfunction showHideDebugInfo()\r\n{\r\n    $(document).unbind(\"contextmenu\");\r\n\r\n    var mysheet = getCssSheet();\r\n    var myRule = findCssRule(\".__d\");\r\n\r\n    if(myRule.rule.style.display == \"none\" || myRule.rule.style.display == \"none !important\")\r\n    {\r\n        removeCSSRule(mysheet, myRule.ruleID);\r\n        var rules = [\r\n            \"background-color: white;\",\r\n            \"color: black;\",\r\n            \"border: 2px solid red;\",\r\n            \"box-shadow: 0px 0px 4px 1px lightgray;\",\r\n            \"padding: 2px;\",\r\n            \"z-index: 999;\",\r\n            \"font-size: 11px;\",\r\n            \"font-family: 'Courier New', Courier, monospace;\",\r\n            \"font-weight: bold;\",\r\n            \"max-height: 60px;\",\r\n            \"max-width: 500px;\",\r\n            \"overflow-y: auto;\",\r\n            \"overflow-x: hidden;\",\r\n            \"position: absolute;\"\r\n        ];\r\n        addCSSRule(mysheet, \".__d\", rules.join(\" \"));\r\n    }\r\n    else\r\n    {\r\n        removeCSSRule(mysheet, myRule.ruleID);\r\n        var rules = [ \"display: none !important;\" ];\r\n        addCSSRule(mysheet, \".__d\", rules.join(\" \"));\r\n    }\r\n}\r\nfunction enableDebugWin()\r\n{\r\n    self._log = _log = Logger.log;\r\n    $(\"#debug-info-box\").css({\"display\":\"block\"});\r\n    if(debugWinState == Logger.DEBUG_WIN_UNSET)\r\n    {\r\n        $(\"#debug-info-box\").draggable({handle:\"#debug-title\"});\r\n\r\n        $(\"#debug-title\").dblclick(function(e) {\r\n            if(!$(\"#debug-info-box\").data(\"docked\") || $(\"#debug-info-box\").data(\"docked\") == false) {\r\n                $(\"#debug-info-box\").data(\"floatPosition\", $(\"#debug-info-box\").position());\r\n\r\n                $(\"#debug-info-box\")\r\n                    .css(\"height\",\"100px\")\r\n                    .css(\"width\",\"auto\")\r\n                    .css(\"top\",\"auto\")\r\n                    .css(\"bottom\",0)\r\n                    .css(\"left\",0)\r\n                    .css(\"right\",0);\r\n\r\n                $(\"#main-container\").data(\"oldBottom\",$(\"#main-container\").css(\"bottom\"));\r\n                $(\"#main-container\").css(\"bottom\", \"140px\");\r\n\r\n                $(\"#debug-info-box\").data(\"docked\",true);\r\n\r\n            } else {\r\n\r\n                var pos = $(\"#debug-info-box\").data(\"floatPosition\");\r\n\r\n                $(\"#debug-info-box\")\r\n                    .css(\"height\",\"180px\")\r\n                    .css(\"width\",\"500px\")\r\n                    .css(\"bottom\",\"auto\")\r\n                    .css(\"right\",\"auto\")\r\n                    .css(\"left\",pos.left)\r\n                    .css(\"top\",pos.top);\r\n\r\n                $(\"#main-container\").css(\"bottom\", $(\"#main-container\").data(\"oldBottom\"));\r\n\r\n                $(\"#debug-info-box\").data(\"docked\", false);\r\n            }\r\n        });\r\n    }\r\n    debugWinState = Logger.DEBUG_WIN_VISIBLE;\r\n}\r\n"
