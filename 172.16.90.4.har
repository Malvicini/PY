            "size": 19034,
            "mimeType": "text/javascript",
            "compression": -1,
            "text": "(function(wnd) {\r\n    var ListManager, ListRecord, ListValue;\r\n\r\n    ListManager = function() {\r\n        this.FROM_MODIFY = 'FROM_MODIFY';\r\n        this.FROM_NOTIFY = 'FROM_NOTIFY';\r\n        this.FROM_NEW = 'FROM_NEW';\r\n        this.FROM_QUERY = 'FROM_QUERY';\r\n        this.FROM_VISUAL_QUERY = 'FROM_VISUAL_QUERY';\r\n        this.FROM_TUTOR = 'FROM_TUTOR';\r\n        this.FROM_WF_DELEGA = 'FROM_WF_DELEGA';\r\n        this.FROM_WF_COINVOLGI = 'FROM_WF_COINVOLGI';\r\n        this.FROM_USER_LIST = 'FROM_USER_LIST';\r\n        this.FROM_CHANNEL = 'FROM_CHANNEL';\r\n        this.FROM_TODO = 'FROM_TODO';\r\n        this.FROM_ADMIN_WEB = 'FROM_ADMIN_WEB';\r\n        this.FROM_ADMIN_ROLE = 'FROM_ADMIN_ROLE';\r\n        this.FROM_VIEW_SIGN = 'FROM_VIEW_SIGN';\r\n\r\n        this._fillFormCallback = null;\r\n        this._onCancel = null;\r\n        this._listFieldID = null;\r\n        this._listID = null;\r\n        this._familyType = null;\r\n        this._userSelected = null;\r\n        this._rolesSelected = null;\r\n        this._sectorSelected = null;\r\n        this._multivalueSelected = null;\r\n        this._family = null;\r\n        this._readOnly = null;\r\n        this._docId = null;\r\n        this._fillType = null;\r\n\r\n        this.setFamilyType = function(familyType) {\r\n            this._familyType = familyType;\r\n        };\r\n        this.getFamilyType = function() {\r\n            return this._familyType;\r\n        };\r\n\r\n        this.setFamilyId = function(family) {\r\n            this._family = family;\r\n        };\r\n        this.getFamilyId = function() {\r\n            return this._family;\r\n        };\r\n\r\n        this.setReadOnly = function(readOnly) {\r\n            this._readOnly = readOnly;\r\n        };\r\n        this.getReadOnly = function() {\r\n            return this._readOnly;\r\n        };\r\n\r\n        this.setDocumentId = function(docId) {\r\n            this._docId = docId;\r\n        };\r\n        this.getDocumentId = function() {\r\n            return this._docId;\r\n        };\r\n\r\n        this.setFillType = function(fillType) {\r\n            this._fillType = fillType;\r\n        };\r\n        this.getFillType = function() {\r\n            return this._fillType;\r\n        };\r\n\r\n        this.displayList = function(listID, fieldID, fillFormCallback, filter, fillType, hideSelectAll, presetLockedFiltersID, presetLockedFiltersValues) {\r\n            var _filter = filter||\"\";\r\n            var advancedList = (fillType == \"9\");\r\n            var fam = this._family;\r\n            var readOnly = this._readOnly;\r\n\r\n\t\t\tvar lockedFiltersID = presetLockedFiltersID||[];\r\n\t\t\tvar lockedFiltersValues = presetLockedFiltersValues||[];\r\n\t\t\t$(\"input[list-id='\"+listID+\"'\").each(function(i, e) {\r\n\t\t\t\tif(e.className.toLowerCase().indexOf(\"readonly\") !== -1) {\r\n\t\t\t\t\tif(!lockedFiltersID.includes($(e).attr(\"fldid\"))) {\r\n\t\t\t\t\t\tlockedFiltersID.push($(e).attr(\"fldid\"));\r\n\t\t\t\t\t\tlockedFiltersValues.push($(e).val());\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t});\r\n\r\n            var params = {\r\n\t\t\t\t\"id\": listID, \"fldid\": fieldID, \"fillType\": fillType,\r\n\t\t\t\t\"q\": encodeURIComponent(_filter), \"familyId\": fam,\r\n\t\t\t\t\"readOnly\": readOnly, \"lockedFiltersID\": lockedFiltersID,\r\n\t\t\t\t\"lockedFiltersValues\": lockedFiltersValues,\r\n\t\t\t\t\"hideSelectAll\": hideSelectAll ? true : false\r\n\t\t\t};\r\n\r\n\t\t\tvar windowParams = {width: \"40%\", height: \"73%\", iframe: true};\r\n\r\n\t\t\tif(advancedList || isTablet()) {\r\n                windowParams.fullscreen = true;\r\n            }\r\n\r\n            var w = openWindow(\"list-data-container\", \"/adiJed/ui/get-list-data.do?\"+jQuery.param( params, jQuery.ajaxSettings.traditional ), windowParams);\r\n\r\n            this._listID = listID;\r\n            this._fillFormCallback = fillFormCallback;\r\n            this._listFieldID