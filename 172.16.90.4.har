          "cookies": [],
          "content": {
            "size": 6835,
            "mimeType": "text/javascript",
            "compression": -1,
            "text": "/* \r\n * Copyright JM Consulting srl\r\n */\r\n\r\nfunction DialogManagerImpl() {};\r\nDialogManagerImpl.prototype = {\r\n    /**\r\n     * Controlla se � gi� incluso il css common.css che � richiesto per lo stile delle alert\r\n     * @returns {boolean}\r\n     */\r\n    checkDialogMarkup: function (fn, args) {\r\n        var that = this;\r\n        if (!$(\"#confim-dialog-message\").length || !$(\"#confim-dialog\").length)\r\n        {\r\n            var body = document.getElementsByTagName('BODY')[0];\r\n            var bd = $(body);\r\n            if (!body) {\r\n                bd = $(document.createElement(\"body\"));\r\n            }\r\n            var _getUrl = \"/adiJed/ui/includes/confirm-dialog.jsp\";\r\n            $.get(_getUrl, function (contents) {\r\n                $(\"body\").attr(\"id\", \"bd\");\r\n                if (fitToScreen)\r\n                    fitToScreen();\r\n\r\n                $(\"<div>\" + contents + \"</div>\").appendTo(bd);\r\n                _getUrl = \"/adiJed/css/common.css\";\r\n                if (DialogManager.cssIsNeeded()) {\r\n                    $.get(_getUrl, function (contents) {\r\n                        $(\"<style type=\\\"text/css\\\">\" + contents + \"</style>\").appendTo(document.head);\r\n                        fn.apply(that, args);\r\n                    });\r\n                } else {\r\n                    fn.apply(that, args);\r\n                }\r\n            });\r\n            return false;\r\n        }\r\n        return true;\r\n    },\r\n    cssIsNeeded: function () {\r\n        var ss = document.styleSheets;\r\n        for (var i = 0, max = ss.length; i < max; i++) {\r\n            if (ss[i].href && ss[i].href.indexOf(\"/css/common.css\") != -1)\r\n                return false;\r\n        }\r\n        return true;\r\n    },\r\n    showConfirm: function (txt, fnOK, fnCancel, title, okLabel, cancelLabel) {\r\n        if (this.checkDialogMarkup(DialogManager.showConfirm, arguments)) {\r\n            $(\"#confim-dialog\").click(function (ev) {\r\n                ev.preventDefault();\r\n                ev.stopPropagation();\r\n            }).css('text-align', 'center');\r\n\r\n            $(\"#confim-dialog-message\").html(txt);\r\n            $(\"#confim-dialog > .adi-modal-title\").html(title || LangManager.get(\"ui.js.confirm.choice\")); //todo: multingua\r\n            $(\".adi-modal-button-bar\").css('text-align', 'auto');\r\n\r\n            var okBtn = $(\"#confim-dialog-ok\");\r\n            var cancelBtn = $(\"#confim-dialog-cancel\");\r\n\r\n            okBtn.unbind('click').one('click', function (ev) {\r\n                ev.preventDefault();\r\n                ev.stopPropagation();\r\n                (fnOK || DialogManager.closeDialog).call(this, ev);\r\n            });\r\n            cancelBtn.unbind('click').one('click', function (ev) {\r\n                ev.preventDefault();\r\n                ev.stopPropagation();\r\n                (fnCancel || DialogManager.closeDialog).call(this, ev);\r\n            });\r\n            okBtn.addClass('button-left');\r\n            cancelBtn.css('display', 'inline-block');\r\n            this.setButtonsLabel(okLabel, cancelLabel);\r\n            this.displayModal(true);\r\n        }\r\n    },\r\n    setButtonsLabel: function (okLabel, cancelLabel) {\r\n        var okBtn = $(\"#confim-dialog-ok\");\r\n        var cancelBtn = $(\"#confim-dialog-cancel\");\r\n        okBtn.val(okLabel !== undefined ? okLabel : LangManager.get(\"ui.generic.buttons.ok\"));\r\n        cancelBtn.val(cancelLabel !== undefined ? cancelLabel : LangManager.get(\"ui.generic.buttons.cancel\"));\r\n    },\r\n    showAlert: function (txt, fnOK, title, okLabel) {\r\n        if (this.checkDialogMarkup(DialogManager.showAlert, arguments)) {\r\n            $(\"#confim-dialog-message\").html(txt);\r\n            $(\"#confim-dialog > .adi-modal-title\").html(title || \"\");\r\n            $(\".adi-modal-button-bar\").css('text-align', 'center');\r\n            $(\"#confim-dialog\").css('text-align', 'center');\r\n            $(\"#confim-dialog-cancel\").css('display', 'none');\r\n            $(\"#confim-dialog-ok\").removeClass('button-left').unbind('click').one('click', fnOK || DialogManager.closeDialog);\r\n\r\n            this.setButtonsLabel(okLabel);\r\n            this.displayModal(false);\r\n        }\r\n    },\r\n    displayModal: function (overlayClose, idModal) {\r\n        //DialogManager.closeDialog();\r\n        var _overlayClose = arguments.length >= 1 ? overlayClose : true;\r\n\r\n        $(idModal || \"#confim-dialog\").modal({\r\n            overlayClose: _overlayClose,\r\n            escClose: _overlayClose,\r\n            opacity: 65,\r\n            zIndex: 100000,\r\n            overlayCss: {backgroundColor: \"#F8F8F8\"}\r\n        });\r\n    },\r\n    inputBox: function (txt, fnOK, fnCancel, title, def, textarea) {\r\n        if (this.checkDialogMarkup(DialogManager.inputBox, arguments)) {\r\n            var inputElement;\r\n            \r\n            if(textarea) {\r\n                $(\"#input-dialog-textbox\").css(\"display\",\"none\");\r\n                $(\"#input-dialog-textarea\").css(\"display\",\"inline-block\");\r\n                \r\n                inputElement = $(\"#input-dialog-textarea\");\r\n            }else{\r\n                $(\"#input-dialog-textbox\").css(\"display\",\"inline-block\");\r\n                $(\"#input-dialog-textarea\").css(\"display\",\"none\");\r\n                \r\n                inputElement = $(\"#input-dialog-textbox\");\r\n                inputElement.unbind('keypress').keypress(function (e) {\r\n                    if (e.which == 13) {\r\n                        event.preventDefault();\r\n                        event.stopPropagation();\r\n                        $(\"#input-dialog-ok\").trigger(\"click\");\r\n                        return false;\r\n                    }\r\n                });\r\n            }\r\n            \r\n            $(\"#input-dialog-message\").html(txt);\r\n            if (title)\r\n                $(\"#input-dialog > .adi-modal-title\").html(title);\r\n\r\n            $(\".adi-modal-button-bar\").css('text-align', 'auto');\r\n            $(\"#input-dialog\").css('text-align', 'center');\r\n            $(\"#input-dialog-ok\").addClass('button-left');\r\n            $(\"#input-dialog-cancel\").css('display', 'inline-block');\r\n            \r\n            if (def) {\r\n                inputElement.val(def);\r\n            }\r\n            \r\n            $(\"#input-dialog-ok\").unbind('click').one('click',\r\n                    function (event) {\r\n                        event.stopPropagation();\r\n                        fnOK(inputElement.val());\r\n                        return false;\r\n                    } || DialogManager.closeDialog\r\n                    );\r\n\r\n            $(\"#input-dialog-cancel\").unbind('click').one('click', fnCancel || DialogManager.closeDialog);\r\n\r\n            this.displayModal(false, \"#input-dialog\");\r\n        }\r\n    },\r\n    closeDialog: function () {\r\n        return $.modal.close();\r\n    }\r\n};\r\nDialogManagerImpl.constructor = DialogManagerImpl;\r\n\r\n__cl__.__create__(\"DialogManager\", DialogManagerImpl, IDialogManager);\r\n"
          },
