          "content": {
            "size": 1749,
            "mimeType": "text/javascript",
            "compression": -1,
            "text": "var ALL_INTRO =\r\n{\r\n    \"#/organigramma-anag/\":{\r\n        steps: [\r\n          {\r\n            element: '#delete',\r\n            intro: 'Elimina il nodo selezionato.',\r\n            position: 'right'\r\n          },\r\n          {\r\n            element: '#back',\r\n            intro: 'Torna alla pagina precedente',\r\n            position: 'right'\r\n          },\r\n          {\r\n            element: '#panelbar-entity',\r\n            intro: 'Tipi di entità utilizzabili nell\\'organigramma. Trascina nell\\'albero per aggiungerla',\r\n            position: 'right'\r\n          },\r\n          {\r\n            element: '#panelbar-qualif',\r\n            intro: 'Tipi di qualifiche da associare alle entità finali. Trascina nell\\'albero per associarla',\r\n            position: 'right'\r\n          }\r\n        ]\r\n    }\r\n}\r\n\r\nvar CURRENT_INTRO = null;\r\n\r\nfunction checkIsIntro()\r\n{\r\n    //ALL_INTRO_JSON = jQuery.parseJSON(ALL_INTRO);\r\n    document.onkeydown = function(ev) {\r\n        var key;\r\n        if (window.event) {\r\n            key = window.event.keyCode;\r\n        } else {\r\n            key = ev.which;\r\n        }\r\n        if(key == 112){\r\n            startIntro();\r\n            ev.preventDefault();\r\n            ev.stopPropagation();\r\n        }\r\n    };\r\n}\r\n\r\nfunction startIntro(){\r\n\r\n    loadCurrentIntro();\r\n    if(CURRENT_INTRO){\r\n        var intro = introJs();\r\n        intro.setOptions(CURRENT_INTRO);\r\n        intro.start();\r\n    }\r\n}\r\n\r\nfunction loadCurrentIntro(){\r\n    CURRENT_INTRO = null;\r\n    var current = document.location.hash.substring(0, document.location.hash.indexOf('?')!=-1?document.location.hash.indexOf('?'):document.location.hash.length);\r\n    //alert(current);\r\n    if(ALL_INTRO){\r\n        CURRENT_INTRO = ALL_INTRO[\"\"+current];\r\n    }\r\n}\r\n\r\n\r\n"
          },
